export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DEB_VERSION := $(shell dpkg-parsechangelog -S Version)
DEB_HOST_ARCH := $(shell dpkg-architecture -qDEB_HOST_ARCH)
DEB_HOST_GNU_TYPE := $(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=ON

override_dh_auto_test:
	mkdir -p "$(CURDIR)/debian/test-home/.config" "$(CURDIR)/debian/test-home/.local/share" "$(CURDIR)/debian/test-runtime"
	chmod 0700 "$(CURDIR)/debian/test-runtime"
	CTEST_OUTPUT_ON_FAILURE=1 \
	HOME="$(CURDIR)/debian/test-home" \
	XDG_CONFIG_HOME="$(CURDIR)/debian/test-home/.config" \
	XDG_DATA_HOME="$(CURDIR)/debian/test-home/.local/share" \
	XDG_RUNTIME_DIR="$(CURDIR)/debian/test-runtime" \
	QT_PLUGIN_PATH="$(CURDIR)/obj-$(DEB_HOST_GNU_TYPE)/bin" \
	xvfb-run -a dbus-run-session ctest --test-dir "obj-$(DEB_HOST_GNU_TYPE)" --output-on-failure

override_dh_builddeb:
	dh_builddeb
	lintian --fail-on error \
		"$(CURDIR)/../kdeconnect_$(DEB_VERSION)_$(DEB_HOST_ARCH).deb" \
		"$(CURDIR)/../kdeconnect-libs_$(DEB_VERSION)_$(DEB_HOST_ARCH).deb" \
		"$(CURDIR)/../qml6-module-org-kde-kdeconnect_$(DEB_VERSION)_$(DEB_HOST_ARCH).deb" \
		"$(CURDIR)/../nautilus-kdeconnect_$(DEB_VERSION)_all.deb"
