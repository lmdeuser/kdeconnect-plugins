-void BtAudioSwitchPlugin::selectPipeWireSinkForMac(const QString &canonicalMac)
+bool BtAudioSwitchPlugin::selectPipeWireSinkForMac(const QString &canonicalMac, quint64 transitionGen)
 {
     const QString prefix = BtAudioSwitch::bluezSinkPrefix(canonicalMac);
     PulseAudioQt::Context *ctx = PulseAudioQt::Context::instance();
     if (prefix.isEmpty() || !ctx) {
+        return false;
+    }
+    if (!m_sinkSignalConnected) {
+        connect(ctx, &PulseAudioQt::Context::sinkAdded, this, [this] {
+            tryApplyPendingSink();
+        });
+        m_sinkSignalConnected = true;
+    }
+    if (ctx->isValid()) {
+        const auto sinks = ctx->sinks();
+        for (PulseAudioQt::Sink *sink : sinks) {
+            if (sink && sink->name().startsWith(prefix, Qt::CaseInsensitive)) {
+                sink->setDefault(true);
+                clearPendingSinkForMac(canonicalMac);
+                return true;
+            }
+        }
+    }
+
+    m_pendingSinkMac = canonicalMac;
+    m_pendingSinkGen = transitionGen;
+    m_pendingSinkTimer->start(kPendingSinkTimeoutMs);
+    return false;
+}
+
+quint64 BtAudioSwitchPlugin::nextTransitionGeneration(const QString &canonicalMac)
+{
+    const quint64 next = m_transitionGeneration.value(canonicalMac, 0ULL) + 1ULL;
+    m_transitionGeneration.insert(canonicalMac, next);
+    return next;
+}
+
+void BtAudioSwitchPlugin::clearPendingSinkForMac(const QString &canonicalMac)
+{
+    if (m_pendingSinkMac == canonicalMac) {
+        m_pendingSinkMac.clear();
+        m_pendingSinkGen = 0;
+        if (m_pendingSinkTimer) {
+            m_pendingSinkTimer->stop();
+        }
+    }
+}
+
+void BtAudioSwitchPlugin::tryApplyPendingSink()
+{
+    if (m_pendingSinkMac.isEmpty()) {
         return;
     }
-    const auto sinks = ctx->sinks();
-    for (PulseAudioQt::Sink *sink : sinks) {
-        if (sink && sink->name().startsWith(prefix, Qt::CaseInsensitive)) {
-            sink->setDefault(true);
-            return;
+    if (m_transitionGeneration.value(m_pendingSinkMac) != m_pendingSinkGen
+        || m_coordinator.ownerFor(m_pendingSinkMac) != BtAudioSwitch::Owner::Desktop
+        || !m_coordinator.isAllowed(m_pendingSinkMac)) {
+        m_pendingSinkMac.clear();
+        m_pendingSinkGen = 0;
+        if (m_pendingSinkTimer) {
+            m_pendingSinkTimer->stop();
         }
+        return;
     }
+    selectPipeWireSinkForMac(m_pendingSinkMac, m_pendingSinkGen);
 }
 
