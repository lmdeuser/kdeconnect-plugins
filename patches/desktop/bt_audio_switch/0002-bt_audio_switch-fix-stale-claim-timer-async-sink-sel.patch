@@ -81,6 +81,35 @@ private Q_SLOTS:
         QCOMPARE(BtAudioSwitch::bluezSinkPrefix(QStringLiteral("aa:bb:cc:dd:ee:ff")),
                  QStringLiteral("bluez_output.AA_BB_CC_DD_EE_FF"));
     }
+
+    void testForceReleasePreservesReclaimDelay()
+    {
+        BtAudioSwitch::BtAudioCoordinator coord;
+        coord.setAllowlist({QStringLiteral("AA:BB:CC:DD:EE:FF")});
+        QCOMPARE(coord.ownerFor(QStringLiteral("AA:BB:CC:DD:EE:FF")), BtAudioSwitch::Owner::None);
+
+        const auto claimed = coord.evaluateTransition(
+            QStringLiteral("AA:BB:CC:DD:EE:FF"),
+            BtAudioSwitch::Owner::Desktop,
+            BtAudioSwitch::SwitchReason::Manual,
+            10000);
+        QVERIFY(claimed.accepted);
+        QCOMPARE(coord.ownerFor(QStringLiteral("AA:BB:CC:DD:EE:FF")), BtAudioSwitch::Owner::Desktop);
+
+        // User-initiated release inside cooldown window must still update coordinator owner to Remote.
+        QVERIFY(!coord.forceRelease(QStringLiteral("11:22:33:44:55:66"), 10500));
+        QVERIFY(coord.forceRelease(QStringLiteral("aa:bb:cc:dd:ee:ff"), 10500));
+        QCOMPARE(coord.ownerFor(QStringLiteral("AA:BB:CC:DD:EE:FF")), BtAudioSwitch::Owner::Remote);
+
+        // Subsequent desktop claim after cooldown must see prev.owner == Remote and apply single-point yield delay.
+        const auto reclaimed = coord.evaluateTransition(
+            QStringLiteral("AA:BB:CC:DD:EE:FF"),
+            BtAudioSwitch::Owner::Desktop,
+            BtAudioSwitch::SwitchReason::Manual,
+            15000);
+        QVERIFY(reclaimed.accepted);
+        QCOMPARE(reclaimed.delayMs, BtAudioSwitch::kSinglePointYieldMs);
+    }
 };
 
 QTEST_MAIN(BtAudioSwitchTest)
