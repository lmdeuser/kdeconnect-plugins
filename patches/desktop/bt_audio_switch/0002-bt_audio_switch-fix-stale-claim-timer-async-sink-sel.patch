+bool BtAudioCoordinator::forceRelease(const QString &rawMac, qint64 nowMs)
+{
+    const QString clean = normalizeMac(rawMac);
+    if (clean.isEmpty() || !m_allowlist.contains(clean)) {
+        return false;
+    }
+    EntryState next;
+    next.owner = Owner::Remote;
+    next.lastReason = SwitchReason::Manual;
+    next.lastTransitionMs = nowMs;
+    m_states.insert(clean, next);
+    return true;
+}
+
 Owner BtAudioCoordinator::ownerFor(const QString &rawMac) const
 {
     const QString clean = normalizeMac(rawMac);
