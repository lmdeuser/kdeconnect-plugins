+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include <QString>
+#include <QStringList>
+
+#include <core/kdeconnectplugin.h>
+
+#include "btaudioswitchlogic.h"
+
+#define PACKET_TYPE_BTAUDIOSWITCH QStringLiteral("kdeconnect.btaudioswitch")
+
+class BtAudioSwitchPlugin : public KdeConnectPlugin
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.kde.kdeconnect.device.btaudioswitch")
+    Q_PROPERTY(QStringList allowedHeadsetMacs READ allowedHeadsetMacs WRITE setAllowedHeadsetMacs NOTIFY allowedHeadsetMacsChanged)
+
+public:
+    explicit BtAudioSwitchPlugin(QObject *parent, const QVariantList &args);
+
+    void receivePacket(const NetworkPacket &np) override;
+    QString dbusPath() const override;
+
+    Q_SCRIPTABLE bool claimHeadset(const QString &mac, const QString &reason = QStringLiteral("manual"));
+    Q_SCRIPTABLE bool releaseHeadset(const QString &mac);
+    Q_SCRIPTABLE QStringList allowedHeadsetMacs() const;
+    Q_SCRIPTABLE void setAllowedHeadsetMacs(const QStringList &macs);
+
+Q_SIGNALS:
+    Q_SCRIPTABLE void headsetOwnerChanged(const QString &mac, const QString &owner, const QString &reason);
+    Q_SCRIPTABLE void allowedHeadsetMacsChanged(const QStringList &macs);
+
+private Q_SLOTS:
+    void onConfigChanged();
+
+private:
+    void sendSwitchPacket(const QString &action, const QString &canonicalMac, const QString &reason, qint64 timestampMs);
+    void disconnectBluezProfiles(const QString &canonicalMac);
+    void connectDesktopHeadset(const QString &canonicalMac, const QString &reason);
+    void selectPipeWireSinkForMac(const QString &canonicalMac);
+
+    BtAudioSwitch::BtAudioCoordinator m_coordinator;
+    bool m_autoSwitch = true;
+    QString m_adapterPath = QStringLiteral("/org/bluez/hci0");
+};
diff --git a/plugins/bt_audio_switch/btaudioswitchtest.cpp b/plugins/bt_audio_switch/btaudioswitchtest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..90f30892d6dcbb1b8522e35e84318d1a86fec075
--- /dev/null
+++ b/plugins/bt_audio_switch/btaudioswitchtest.cpp
@@ -0,0 +1,88 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "btaudioswitchlogic.h"
+
+#include <QtTest>
+
+class BtAudioSwitchTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void testMacNormalizationAndValidation()
+    {
+        QCOMPARE(BtAudioSwitch::normalizeMac(QStringLiteral(" aa:bb:cc:dd:ee:ff ")), QStringLiteral("AA:BB:CC:DD:EE:FF"));
+        QVERIFY(BtAudioSwitch::normalizeMac(QStringLiteral("ZZ:BB:CC:DD:EE:FF")).isEmpty());
+        QVERIFY(BtAudioSwitch::normalizeMac(QStringLiteral("AA:BB:CC")).isEmpty());
+
+        const QStringList list = BtAudioSwitch::parseAllowlist(
+            QStringLiteral("aa:bb:cc:dd:ee:ff, invalid, AA:BB:CC:DD:EE:FF, 11:22:33:44:55:66"));
+        QCOMPARE(list, QStringList({QStringLiteral("AA:BB:CC:DD:EE:FF"), QStringLiteral("11:22:33:44:55:66")}));
+    }
+
+    void testAllowlistHysteresisAndPriorityTieBreak()
+    {
+        BtAudioSwitch::BtAudioCoordinator coord;
+        coord.setAllowlist({QStringLiteral("AA:BB:CC:DD:EE:FF")});
+
+        const auto rejected = coord.evaluateTransition(
+            QStringLiteral("11:22:33:44:55:66"),
+            BtAudioSwitch::Owner::Remote,
+            BtAudioSwitch::SwitchReason::Media,
+            10000);
+        QVERIFY(!rejected.accepted);
+        QCOMPARE(rejected.rejectReason, QStringLiteral("not_allowlisted"));
+
+        const auto mediaRemote = coord.evaluateTransition(
+            QStringLiteral("aa:bb:cc:dd:ee:ff"),
+            BtAudioSwitch::Owner::Remote,
+            BtAudioSwitch::SwitchReason::Media,
+            10000);
+        QVERIFY(mediaRemote.accepted);
+        QCOMPARE(coord.ownerFor(QStringLiteral("AA:BB:CC:DD:EE:FF")), BtAudioSwitch::Owner::Remote);
+
+        // Same priority inside 3000 ms cooldown must be rejected.
+        const auto bounceDesktop = coord.evaluateTransition(
+            QStringLiteral("AA:BB:CC:DD:EE:FF"),
+            BtAudioSwitch::Owner::Desktop,
+            BtAudioSwitch::SwitchReason::Media,
+            11500);
+        QVERIFY(!bounceDesktop.accepted);
+        QCOMPARE(bounceDesktop.rejectReason, QStringLiteral("hysteresis_cooldown"));
+
+        // Higher-priority Call overrides active Media cooldown.
+        const auto callOverride = coord.evaluateTransition(
+            QStringLiteral("AA:BB:CC:DD:EE:FF"),
+            BtAudioSwitch::Owner::Remote,
+            BtAudioSwitch::SwitchReason::Call,
+            11600);
+        QVERIFY(callOverride.accepted);
+
+        // After >= 3000 ms, Desktop manual claim is accepted with single-point yield delay.
+        const auto manualAfterCooldown = coord.evaluateTransition(
+            QStringLiteral("AA:BB:CC:DD:EE:FF"),
+            BtAudioSwitch::Owner::Desktop,
+            BtAudioSwitch::SwitchReason::Manual,
+            15000);
+        QVERIFY(manualAfterCooldown.accepted);
+        QCOMPARE(manualAfterCooldown.delayMs, BtAudioSwitch::kSinglePointYieldMs);
+    }
+
+    void testBluezPathAndSinkPrefix()
+    {
+        QCOMPARE(BtAudioSwitch::bluezDevicePath(QStringLiteral("/org/bluez/hci1"), QStringLiteral("aa:bb:cc:dd:ee:ff")),
+                 QStringLiteral("/org/bluez/hci1/dev_AA_BB_CC_DD_EE_FF"));
+        QCOMPARE(BtAudioSwitch::bluezDevicePath(QStringLiteral("../bad/path"), QStringLiteral("aa:bb:cc:dd:ee:ff")),
+                 QStringLiteral("/org/bluez/hci0/dev_AA_BB_CC_DD_EE_FF"));
+        QCOMPARE(BtAudioSwitch::bluezSinkPrefix(QStringLiteral("aa:bb:cc:dd:ee:ff")),
+                 QStringLiteral("bluez_output.AA_BB_CC_DD_EE_FF"));
+    }
+};
+
+QTEST_MAIN(BtAudioSwitchTest)
