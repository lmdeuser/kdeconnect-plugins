diff --git a/plugins/bt_audio_switch/btaudioswitchlogic.cpp b/plugins/bt_audio_switch/btaudioswitchlogic.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0dd94bb2a2e0c62a6c7beaa57673264d3025bd1a
--- /dev/null
+++ b/plugins/bt_audio_switch/btaudioswitchlogic.cpp
@@ -0,0 +1,187 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "btaudioswitchlogic.h"
+
+#include <QRegularExpression>
+
+namespace BtAudioSwitch
+{
+namespace
+{
+const QRegularExpression &macRegex()
+{
+    static const QRegularExpression re(QStringLiteral("^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$"));
+    return re;
+}
+
+const QRegularExpression &adapterRegex()
+{
+    static const QRegularExpression re(QStringLiteral("^/org/bluez/hci[0-9]{1,2}$"));
+    return re;
+}
+}
+
+QString normalizeMac(const QString &raw)
+{
+    const QString trimmed = raw.trimmed();
+    if (!macRegex().match(trimmed).hasMatch()) {
+        return {};
+    }
+    return trimmed.toUpper();
+}
+
+QStringList parseAllowlist(const QString &raw)
+{
+    const QStringList parts = raw.split(QLatin1Char(','), Qt::SkipEmptyParts);
+    return normalizeAllowlist(parts);
+}
+
+QStringList normalizeAllowlist(const QStringList &rawList)
+{
+    QStringList out;
+    for (const QString &item : rawList) {
+        if (out.size() >= kMaxAllowlistEntries) {
+            break;
+        }
+        const QString canonical = normalizeMac(item);
+        if (!canonical.isEmpty() && !out.contains(canonical)) {
+            out.append(canonical);
+        }
+    }
+    return out;
+}
+
+QString bluezDevicePath(const QString &adapterPath, const QString &canonicalMac)
+{
+    const QString cleanMac = normalizeMac(canonicalMac);
+    if (cleanMac.isEmpty()) {
+        return {};
+    }
+    const QString trimmedAdapter = adapterPath.trimmed();
+    const QString safeAdapter = adapterRegex().match(trimmedAdapter).hasMatch() ? trimmedAdapter : QStringLiteral("/org/bluez/hci0");
+    QString underscored = cleanMac;
+    underscored.replace(QLatin1Char(':'), QLatin1Char('_'));
+    return safeAdapter + QStringLiteral("/dev_") + underscored;
+}
+
+QString bluezSinkPrefix(const QString &canonicalMac)
+{
+    const QString cleanMac = normalizeMac(canonicalMac);
+    if (cleanMac.isEmpty()) {
+        return {};
+    }
+    QString underscored = cleanMac;
+    underscored.replace(QLatin1Char(':'), QLatin1Char('_'));
+    return QStringLiteral("bluez_output.") + underscored;
+}
+
+bool isValidAction(const QString &action)
+{
+    return action == QLatin1String("claim") || action == QLatin1String("release") || action == QLatin1String("status");
+}
+
+SwitchReason reasonFromString(const QString &raw, bool *ok)
+{
+    const QString clean = raw.trimmed().toLower();
+    if (clean == QLatin1String("call")) {
+        if (ok) {
+            *ok = true;
+        }
+        return SwitchReason::Call;
+    }
+    if (clean == QLatin1String("manual")) {
+        if (ok) {
+            *ok = true;
+        }
+        return SwitchReason::Manual;
+    }
+    if (clean == QLatin1String("media")) {
+        if (ok) {
+            *ok = true;
+        }
+        return SwitchReason::Media;
+    }
+    if (ok) {
+        *ok = false;
+    }
+    return SwitchReason::Media;
+}
+
+QString reasonToString(SwitchReason reason)
+{
+    switch (reason) {
+    case SwitchReason::Call:
+        return QStringLiteral("call");
+    case SwitchReason::Manual:
+        return QStringLiteral("manual");
+    case SwitchReason::Media:
+        return QStringLiteral("media");
+    }
+    return QStringLiteral("media");
+}
+
+void BtAudioCoordinator::setAllowlist(const QStringList &rawMacs)
+{
+    m_allowlist = normalizeAllowlist(rawMacs);
+}
+
+QStringList BtAudioCoordinator::allowlist() const
+{
+    return m_allowlist;
+}
+
+bool BtAudioCoordinator::isAllowed(const QString &canonicalMac) const
+{
+    const QString clean = normalizeMac(canonicalMac);
+    return !clean.isEmpty() && m_allowlist.contains(clean);
+}
+
+TransitionDecision BtAudioCoordinator::evaluateTransition(const QString &rawMac, Owner targetOwner, SwitchReason reason, qint64 nowMs)
+{
+    TransitionDecision decision;
+    const QString clean = normalizeMac(rawMac);
+    if (clean.isEmpty()) {
+        decision.rejectReason = QStringLiteral("invalid_mac");
+        return decision;
+    }
+    if (!m_allowlist.contains(clean)) {
+        decision.canonicalMac = clean;
+        decision.rejectReason = QStringLiteral("not_allowlisted");
+        return decision;
+    }
+
+    const EntryState prev = m_states.value(clean);
+    const qint64 elapsed = nowMs - prev.lastTransitionMs;
+    if (prev.owner != Owner::None && elapsed >= 0 && elapsed < kHysteresisMs) {
+        const bool higherPriority = static_cast<int>(reason) > static_cast<int>(prev.lastReason);
+        if (!higherPriority) {
+            decision.canonicalMac = clean;
+            decision.rejectReason = QStringLiteral("hysteresis_cooldown");
+            return decision;
+        }
+    }
+
+    EntryState next;
+    next.owner = targetOwner;
+    next.lastReason = reason;
+    next.lastTransitionMs = nowMs;
+    m_states.insert(clean, next);
+
+    decision.accepted = true;
+    decision.canonicalMac = clean;
+    if (targetOwner == Owner::Desktop && prev.owner == Owner::Remote) {
+        decision.delayMs = kSinglePointYieldMs;
+    }
+    return decision;
+}
+
+Owner BtAudioCoordinator::ownerFor(const QString &rawMac) const
+{
+    const QString clean = normalizeMac(rawMac);
+    return clean.isEmpty() ? Owner::None : m_states.value(clean).owner;
+}
+}
diff --git a/plugins/bt_audio_switch/btaudioswitchlogic.h b/plugins/bt_audio_switch/btaudioswitchlogic.h
new file mode 100644
index 0000000000000000000000000000000000000000..66999267e404cef1c17ab7ff7c852688536776a0
--- /dev/null
+++ b/plugins/bt_audio_switch/btaudioswitchlogic.h
@@ -0,0 +1,77 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include <QHash>
+#include <QString>
+#include <QStringList>
+
+namespace BtAudioSwitch
+{
+inline constexpr qint64 kHysteresisMs = 3000;
+inline constexpr int kSinglePointYieldMs = 300;
+inline constexpr int kMaxAllowlistEntries = 16;
+
+inline QString a2dpUuid()
+{
+    return QStringLiteral("0000110b-0000-1000-8000-00805f9b34fb");
+}
+
+inline QString hfpUuid()
+{
+    return QStringLiteral("0000111e-0000-1000-8000-00805f9b34fb");
+}
+
+enum class Owner {
+    None,
+    Desktop,
+    Remote,
+};
+
+enum class SwitchReason {
+    Media = 1,
+    Manual = 2,
+    Call = 3,
+};
+
+QString normalizeMac(const QString &raw);
+QStringList parseAllowlist(const QString &raw);
+QStringList normalizeAllowlist(const QStringList &rawList);
+QString bluezDevicePath(const QString &adapterPath, const QString &canonicalMac);
+QString bluezSinkPrefix(const QString &canonicalMac);
+bool isValidAction(const QString &action);
+SwitchReason reasonFromString(const QString &raw, bool *ok = nullptr);
+QString reasonToString(SwitchReason reason);
+
+struct TransitionDecision {
+    bool accepted = false;
+    QString canonicalMac;
+    QString rejectReason;
+    int delayMs = 0;
+};
+
+class BtAudioCoordinator
+{
+public:
+    void setAllowlist(const QStringList &rawMacs);
+    QStringList allowlist() const;
+    bool isAllowed(const QString &canonicalMac) const;
+
+    TransitionDecision evaluateTransition(const QString &rawMac, Owner targetOwner, SwitchReason reason, qint64 nowMs);
+    Owner ownerFor(const QString &rawMac) const;
+
+private:
+    struct EntryState {
+        Owner owner = Owner::None;
+        SwitchReason lastReason = SwitchReason::Media;
+        qint64 lastTransitionMs = -kHysteresisMs - 1;
+    };
+
+    QStringList m_allowlist;
+    QHash<QString, EntryState> m_states;
+};
+}
diff --git a/plugins/bt_audio_switch/btaudioswitchplugin.cpp b/plugins/bt_audio_switch/btaudioswitchplugin.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3d8ac58c7eddec8c0c5515f974ea52a152266e0f
--- /dev/null
+++ b/plugins/bt_audio_switch/btaudioswitchplugin.cpp
@@ -0,0 +1,214 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "btaudioswitchplugin.h"
+
+#include "plugin_btaudioswitch_debug.h"
+
+#include <KPluginFactory>
+#include <PulseAudioQt/Context>
+#include <PulseAudioQt/Sink>
+
+#include <QDBusConnection>
+#include <QDBusInterface>
+#include <QDateTime>
+#include <QPointer>
+#include <QTimer>
+
+K_PLUGIN_CLASS_WITH_JSON(BtAudioSwitchPlugin, "kdeconnect_btaudioswitch.json")
+
+BtAudioSwitchPlugin::BtAudioSwitchPlugin(QObject *parent, const QVariantList &args)
+    : KdeConnectPlugin(parent, args)
+{
+    connect(config(), &KdeConnectPluginConfig::configChanged, this, &BtAudioSwitchPlugin::onConfigChanged);
+    onConfigChanged();
+}
+
+QString BtAudioSwitchPlugin::dbusPath() const
+{
+    return QLatin1String("/modules/kdeconnect/devices/%1/btaudioswitch").arg(device()->id());
+}
+
+void BtAudioSwitchPlugin::onConfigChanged()
+{
+    const QString rawMacs = config()->getString(QStringLiteral("allowedHeadsetMacs"), QString());
+    m_coordinator.setAllowlist(BtAudioSwitch::parseAllowlist(rawMacs));
+    m_autoSwitch = config()->getBool(QStringLiteral("autoSwitch"), true);
+    m_adapterPath = config()->getString(QStringLiteral("adapterPath"), QStringLiteral("/org/bluez/hci0"));
+}
+
+QStringList BtAudioSwitchPlugin::allowedHeadsetMacs() const
+{
+    return m_coordinator.allowlist();
+}
+
+void BtAudioSwitchPlugin::setAllowedHeadsetMacs(const QStringList &macs)
+{
+    const QStringList normalized = BtAudioSwitch::normalizeAllowlist(macs);
+    config()->set(QStringLiteral("allowedHeadsetMacs"), normalized.join(QLatin1Char(',')));
+    m_coordinator.setAllowlist(normalized);
+    Q_EMIT allowedHeadsetMacsChanged(normalized);
+}
+
+bool BtAudioSwitchPlugin::claimHeadset(const QString &mac, const QString &reason)
+{
+    bool okReason = false;
+    const BtAudioSwitch::SwitchReason parsedReason = BtAudioSwitch::reasonFromString(reason, &okReason);
+    if (!okReason) {
+        return false;
+    }
+
+    const qint64 nowMs = QDateTime::currentMSecsSinceEpoch();
+    const BtAudioSwitch::TransitionDecision decision =
+        m_coordinator.evaluateTransition(mac, BtAudioSwitch::Owner::Desktop, parsedReason, nowMs);
+    if (!decision.accepted) {
+        qCDebug(KDECONNECT_PLUGIN_BTAUDIOSWITCH) << "Claim rejected for" << mac << decision.rejectReason;
+        return false;
+    }
+
+    const QString reasonWire = BtAudioSwitch::reasonToString(parsedReason);
+    sendSwitchPacket(QStringLiteral("claim"), decision.canonicalMac, reasonWire, nowMs);
+
+    if (decision.delayMs > 0) {
+        QPointer<BtAudioSwitchPlugin> guard(this);
+        const QString canonical = decision.canonicalMac;
+        QTimer::singleShot(decision.delayMs, this, [guard, canonical, reasonWire] {
+            if (guard) {
+                guard->connectDesktopHeadset(canonical, reasonWire);
+            }
+        });
+    } else {
+        connectDesktopHeadset(decision.canonicalMac, reasonWire);
+    }
+    return true;
+}
+
+bool BtAudioSwitchPlugin::releaseHeadset(const QString &mac)
+{
+    const QString canonical = BtAudioSwitch::normalizeMac(mac);
+    if (canonical.isEmpty() || !m_coordinator.isAllowed(canonical)) {
+        return false;
+    }
+    const qint64 nowMs = QDateTime::currentMSecsSinceEpoch();
+    m_coordinator.evaluateTransition(canonical, BtAudioSwitch::Owner::Remote, BtAudioSwitch::SwitchReason::Manual, nowMs);
+    disconnectBluezProfiles(canonical);
+    sendSwitchPacket(QStringLiteral("release"), canonical, QStringLiteral("manual"), nowMs);
+    Q_EMIT headsetOwnerChanged(canonical, QStringLiteral("remote"), QStringLiteral("manual"));
+    return true;
+}
+
+void BtAudioSwitchPlugin::receivePacket(const NetworkPacket &np)
+{
+    if (np.type() != PACKET_TYPE_BTAUDIOSWITCH) {
+        return;
+    }
+
+    const QString action = np.get<QString>(QStringLiteral("action")).trimmed().toLower();
+    const QString mac = BtAudioSwitch::normalizeMac(np.get<QString>(QStringLiteral("mac")));
+    bool okReason = false;
+    const BtAudioSwitch::SwitchReason reason = BtAudioSwitch::reasonFromString(np.get<QString>(QStringLiteral("reason")), &okReason);
+
+    if (!BtAudioSwitch::isValidAction(action) || mac.isEmpty() || !okReason) {
+        qCWarning(KDECONNECT_PLUGIN_BTAUDIOSWITCH) << "Ignoring malformed btaudioswitch packet";
+        return;
+    }
+    if (!m_coordinator.isAllowed(mac)) {
+        qCWarning(KDECONNECT_PLUGIN_BTAUDIOSWITCH) << "Ignoring non-allowlisted Bluetooth MAC" << mac;
+        return;
+    }
+    if (action == QLatin1String("status")) {
+        return;
+    }
+    if (!m_autoSwitch && reason != BtAudioSwitch::SwitchReason::Manual) {
+        return;
+    }
+
+    const qint64 nowMs = QDateTime::currentMSecsSinceEpoch();
+    const QString reasonWire = BtAudioSwitch::reasonToString(reason);
+
+    if (action == QLatin1String("claim")) {
+        const BtAudioSwitch::TransitionDecision decision =
+            m_coordinator.evaluateTransition(mac, BtAudioSwitch::Owner::Remote, reason, nowMs);
+        if (!decision.accepted) {
+            qCDebug(KDECONNECT_PLUGIN_BTAUDIOSWITCH) << "Remote claim ignored for" << mac << decision.rejectReason;
+            return;
+        }
+        disconnectBluezProfiles(mac);
+        sendSwitchPacket(QStringLiteral("status"), mac, reasonWire, nowMs);
+        Q_EMIT headsetOwnerChanged(mac, QStringLiteral("remote"), reasonWire);
+        return;
+    }
+
+    if (action == QLatin1String("release")) {
+        const BtAudioSwitch::TransitionDecision decision =
+            m_coordinator.evaluateTransition(mac, BtAudioSwitch::Owner::Desktop, reason, nowMs);
+        if (!decision.accepted) {
+            return;
+        }
+        QPointer<BtAudioSwitchPlugin> guard(this);
+        QTimer::singleShot(BtAudioSwitch::kSinglePointYieldMs, this, [guard, mac, reasonWire] {
+            if (guard) {
+                guard->connectDesktopHeadset(mac, reasonWire);
+            }
+        });
+    }
+}
+
+void BtAudioSwitchPlugin::sendSwitchPacket(const QString &action, const QString &canonicalMac, const QString &reason, qint64 timestampMs)
+{
+    NetworkPacket np(PACKET_TYPE_BTAUDIOSWITCH);
+    np.set(QStringLiteral("action"), action);
+    np.set(QStringLiteral("mac"), canonicalMac);
+    np.set(QStringLiteral("reason"), reason);
+    np.set(QStringLiteral("timestampMs"), timestampMs);
+    sendPacket(np);
+}
+
+void BtAudioSwitchPlugin::disconnectBluezProfiles(const QString &canonicalMac)
+{
+    const QString devPath = BtAudioSwitch::bluezDevicePath(m_adapterPath, canonicalMac);
+    if (devPath.isEmpty()) {
+        return;
+    }
+    QDBusInterface bluezDev(QStringLiteral("org.bluez"), devPath, QStringLiteral("org.bluez.Device1"), QDBusConnection::systemBus());
+    if (!bluezDev.isValid()) {
+        return;
+    }
+    bluezDev.asyncCall(QStringLiteral("DisconnectProfile"), BtAudioSwitch::a2dpUuid());
+    bluezDev.asyncCall(QStringLiteral("DisconnectProfile"), BtAudioSwitch::hfpUuid());
+}
+
+void BtAudioSwitchPlugin::connectDesktopHeadset(const QString &canonicalMac, const QString &reason)
+{
+    const QString devPath = BtAudioSwitch::bluezDevicePath(m_adapterPath, canonicalMac);
+    if (!devPath.isEmpty()) {
+        QDBusInterface bluezDev(QStringLiteral("org.bluez"), devPath, QStringLiteral("org.bluez.Device1"), QDBusConnection::systemBus());
+        if (bluezDev.isValid()) {
+            bluezDev.asyncCall(QStringLiteral("Connect"));
+        }
+    }
+    selectPipeWireSinkForMac(canonicalMac);
+    Q_EMIT headsetOwnerChanged(canonicalMac, QStringLiteral("desktop"), reason);
+}
+
+void BtAudioSwitchPlugin::selectPipeWireSinkForMac(const QString &canonicalMac)
+{
+    const QString prefix = BtAudioSwitch::bluezSinkPrefix(canonicalMac);
+    PulseAudioQt::Context *ctx = PulseAudioQt::Context::instance();
+    if (prefix.isEmpty() || !ctx) {
+        return;
+    }
+    const auto sinks = ctx->sinks();
+    for (PulseAudioQt::Sink *sink : sinks) {
+        if (sink && sink->name().startsWith(prefix, Qt::CaseInsensitive)) {
+            sink->setDefault(true);
+            return;
+        }
+    }
+}
+
+#include "btaudioswitchplugin.moc"
+#include "moc_btaudioswitchplugin.cpp"
