diff --git a/plasmoid/package/contents/ui/BtAudioSwitch.qml b/plasmoid/package/contents/ui/BtAudioSwitch.qml
new file mode 100644
index 0000000000000000000000000000000000000000..8291233f85311466c0e79f72d66730012f18417e
--- /dev/null
+++ b/plasmoid/package/contents/ui/BtAudioSwitch.qml
@@ -0,0 +1,52 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+
+import org.kde.kdeconnect as KDEConnect
+
+QtObject {
+    id: root
+
+    required property KDEConnect.DeviceDbusInterface device
+
+    readonly property alias available: checker.available
+
+    readonly property KDEConnect.PluginChecker pluginChecker: KDEConnect.PluginChecker {
+        id: checker
+        pluginName: "btaudioswitch"
+        device: root.device
+    }
+
+    readonly property KDEConnect.BtAudioSwitchDbusInterface plugin:
+        available ? KDEConnect.BtAudioSwitchDbusInterfaceFactory.create(device.id()) : null
+
+    readonly property bool hasHeadsets: (plugin?.allowedHeadsetMacs?.length ?? 0) > 0
+
+    function applyToHeadsets(claim: bool): void {
+        if (!plugin) {
+            return;
+        }
+        const macs = plugin.allowedHeadsetMacs;
+        for (let i = 0; i < macs.length; ++i) {
+            if (claim) {
+                plugin.claimHeadset(macs[i], "manual");
+            } else {
+                plugin.releaseHeadset(macs[i]);
+            }
+        }
+    }
+
+    function claimHeadsets(): void {
+        applyToHeadsets(true);
+    }
+
+    function releaseHeadsets(): void {
+        applyToHeadsets(false);
+    }
+}
