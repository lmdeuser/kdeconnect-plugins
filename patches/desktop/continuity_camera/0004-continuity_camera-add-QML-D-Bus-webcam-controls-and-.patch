+++ b/plugins/continuity_camera/continuitycameraplugin.cpp
@@ -50,6 +50,14 @@ ContinuityCameraPlugin::~ContinuityCameraPlugin()
     teardownSession(true, false);
 }
 
+bool ContinuityCameraPlugin::active() const
+{
+    const auto st = m_session.state();
+    return st == ContinuityCameraProtocol::CameraSessionMachine::State::Starting
+        || st == ContinuityCameraProtocol::CameraSessionMachine::State::Streaming
+        || (m_bridgeProcess != nullptr && m_bridgeProcess->state() != QProcess::NotRunning);
+}
+
 bool ContinuityCameraPlugin::isStreaming() const
 {
     return m_session.state() == ContinuityCameraProtocol::CameraSessionMachine::State::Streaming;
@@ -60,16 +68,54 @@ QString ContinuityCameraPlugin::state() const
     return m_session.stateName();
 }
 
+QString ContinuityCameraPlugin::currentLens() const
+{
+    return m_currentLens;
+}
+
+QString ContinuityCameraPlugin::lastError() const
+{
+    return m_lastError;
+}
+
+void ContinuityCameraPlugin::setLastError(const QString &error)
+{
+    if (m_lastError != error) {
+        m_lastError = error;
+        Q_EMIT lastErrorChanged();
+    }
+}
+
+void ContinuityCameraPlugin::syncActiveSignal(bool wasActive)
+{
+    if (active() != wasActive) {
+        Q_EMIT activeChanged();
+    }
+}
+
 QString ContinuityCameraPlugin::dbusPath() const
 {
     return QLatin1String("/modules/kdeconnect/devices/%1/continuitycamera").arg(device()->id());
 }
 
+bool ContinuityCameraPlugin::startDefaultCamera()
+{
+    return startCamera(1280, 720, 30, true, m_currentLens);
+}
+
 bool ContinuityCameraPlugin::startCamera(int maxWidth, int maxHeight, int fps, bool includeMic, const QString &lens)
 {
     const ContinuityCameraProtocol::StreamConfig cfg = ContinuityCameraProtocol::clampStreamConfig(maxWidth, maxHeight, fps);
+    const QString normalizedLens = ContinuityCameraProtocol::normalizeLens(lens);
+    const bool wasActive = active();
     const bool wasStreaming = isStreaming();
     m_stopping = false;
+    setLastError(QString());
+
+    if (m_currentLens != normalizedLens) {
+        m_currentLens = normalizedLens;
+        Q_EMIT lensChanged();
+    }
 
     NetworkPacket np(PACKET_TYPE_CONTINUITYCAMERA_REQUEST);
     np.set(QStringLiteral("action"), QStringLiteral("start_stream"));
@@ -77,12 +123,14 @@ bool ContinuityCameraPlugin::startCamera(int maxWidth, int maxHeight, int fps, b
     np.set(QStringLiteral("maxHeight"), cfg.height);
     np.set(QStringLiteral("fps"), cfg.fps);
     np.set(QStringLiteral("includeMic"), includeMic);
-    np.set(QStringLiteral("lens"), ContinuityCameraProtocol::normalizeLens(lens));
+    np.set(QStringLiteral("lens"), normalizedLens);
     if (!sendPacket(np)) {
         m_session.onTeardown(true);
+        setLastError(i18n("Failed to send camera stream request."));
         if (wasStreaming) {
             Q_EMIT streamingChanged(false);
         }
+        syncActiveSignal(wasActive);
         Q_EMIT stateChanged();
         return false;
     }
@@ -91,27 +139,47 @@ bool ContinuityCameraPlugin::startCamera(int maxWidth, int maxHeight, int fps, b
     if (wasStreaming && !isStreaming()) {
         Q_EMIT streamingChanged(false);
     }
+    syncActiveSignal(wasActive);
     Q_EMIT stateChanged();
     return true;
 }
 
 void ContinuityCameraPlugin::stopCamera()
 {
+    const bool wasActive = active();
     m_stopping = true;
     m_session.beginStop();
     NetworkPacket np(PACKET_TYPE_CONTINUITYCAMERA_REQUEST, {{QStringLiteral("action"), QStringLiteral("stop_stream")}});
     sendPacket(np);
     teardownSession(true, false);
+    syncActiveSignal(wasActive);
 }
 
 void ContinuityCameraPlugin::switchLens(const QString &lens)
 {
+    const QString normalized = ContinuityCameraProtocol::normalizeLens(lens);
+    if (m_currentLens != normalized) {
+        m_currentLens = normalized;
+        Q_EMIT lensChanged();
+    }
     NetworkPacket np(PACKET_TYPE_CONTINUITYCAMERA_REQUEST);
     np.set(QStringLiteral("action"), QStringLiteral("switch_lens"));
-    np.set(QStringLiteral("lens"), ContinuityCameraProtocol::normalizeLens(lens));
+    np.set(QStringLiteral("lens"), normalized);
     sendPacket(np);
 }
 
+void ContinuityCameraPlugin::toggleLens()
+{
+    const QString nextLens = (m_currentLens == QLatin1String("front")) ? QStringLiteral("back") : QStringLiteral("front");
+    if (m_currentLens != nextLens) {
+        m_currentLens = nextLens;
+        Q_EMIT lensChanged();
+    }
+    if (active()) {
+        switchLens(nextLens);
+    }
+}
+
 void ContinuityCameraPlugin::requestPhotoCapture()
 {
     NetworkPacket np(PACKET_TYPE_CONTINUITYCAMERA_REQUEST, {{QStringLiteral("action"), QStringLiteral("capture_photo")}});
@@ -162,6 +230,7 @@ void ContinuityCameraPlugin::receivePacket(const NetworkPacket &np)
             teardownSession(true, true);
             return;
         }
+        const bool wasActive = active();
         const bool includeMic = np.get<bool>(QStringLiteral("audioEnabled"), false);
         teardownSession(true, false);
         m_stopping = false;
@@ -170,7 +239,9 @@ void ContinuityCameraPlugin::receivePacket(const NetworkPacket &np)
         m_pendingFrames.clear();
 
         if (!ensureLocalServer() || !launchBridge(includeMic)) {
+            setLastError(i18n("Failed to launch continuity camera PipeWire bridge."));
             teardownSession(true, true);
+            syncActiveSignal(wasActive);
             return;
         }
 
@@ -190,6 +261,8 @@ void ContinuityCameraPlugin::receivePacket(const NetworkPacket &np)
         }
 
         m_session.onStreamOpen();
+        setLastError(QString());
+        Q_EMIT activeChanged();
         Q_EMIT streamingChanged(true);
         Q_EMIT stateChanged();
 
@@ -331,6 +404,7 @@ bool ContinuityCameraPlugin::launchBridge(bool includeMic)
 
 void ContinuityCameraPlugin::teardownSession(bool terminateBridge, bool error)
 {
+    const bool wasActive = active();
     const bool wasStreaming = isStreaming();
     if (m_payload) {
         QSharedPointer<QIODevice> stalePayload = m_payload;
@@ -378,9 +452,13 @@ void ContinuityCameraPlugin::teardownSession(bool terminateBridge, bool error)
     m_pendingFrames.clear();
     m_parser.reset();
     m_session.onTeardown(error);
+    if (error && m_lastError.isEmpty()) {
+        setLastError(i18n("Continuity camera stream ended with an error."));
+    }
     if (wasStreaming) {
         Q_EMIT streamingChanged(false);
     }
+    syncActiveSignal(wasActive);
     Q_EMIT stateChanged();
 }
 
