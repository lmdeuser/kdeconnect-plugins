diff --git a/plugins/continuity_camera/continuitycameraplugin.cpp b/plugins/continuity_camera/continuitycameraplugin.cpp
index 2cd803eeb770de9c5b556b691198a25adf32f657..0e80865a302984f98d0d15feacc68690a6150454 100644
