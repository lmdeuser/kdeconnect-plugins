diff --git a/plugins/continuity_camera/bridge/main.cpp b/plugins/continuity_camera/bridge/main.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ad6660c6861169b1ad7762e2f16fb81da4a8b595
--- /dev/null
+++ b/plugins/continuity_camera/bridge/main.cpp
@@ -0,0 +1,82 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "pipewirebridge.h"
+
+#include <QCommandLineOption>
+#include <QCommandLineParser>
+#include <QCoreApplication>
+#include <QSocketNotifier>
+#include <QTextStream>
+
+#include <csignal>
+#include <sys/socket.h>
+#include <unistd.h>
+
+namespace
+{
+int g_sigFd[2] = {-1, -1};
+
+void unixSignalHandler(int /*sig*/)
+{
+    const char byte = 1;
+    if (g_sigFd[0] >= 0) {
+        const ssize_t ignored = ::write(g_sigFd[0], &byte, sizeof(byte));
+        (void)ignored;
+    }
+}
+}
+
+int main(int argc, char *argv[])
+{
+    QCoreApplication app(argc, argv);
+    app.setApplicationName(QStringLiteral("kdeconnect-continuitycamera-bridge"));
+
+    QCommandLineParser parser;
+    parser.addHelpOption();
+    QCommandLineOption deviceOpt(QStringLiteral("device"), QStringLiteral("Device ID"), QStringLiteral("id"));
+    QCommandLineOption nameOpt(QStringLiteral("device-name"), QStringLiteral("Device Name"), QStringLiteral("name"));
+    QCommandLineOption socketOpt(QStringLiteral("socket"), QStringLiteral("Local IPC Socket"), QStringLiteral("path"));
+    QCommandLineOption audioOpt(QStringLiteral("audio"), QStringLiteral("Enable mic audio stream"), QStringLiteral("0|1"), QStringLiteral("0"));
+    parser.addOption(deviceOpt);
+    parser.addOption(nameOpt);
+    parser.addOption(socketOpt);
+    parser.addOption(audioOpt);
+    parser.process(app);
+
+    const QString socketPath = parser.value(socketOpt);
+    if (socketPath.isEmpty()) {
+        QTextStream(stderr) << QStringLiteral("Missing --socket argument\n");
+        return 2;
+    }
+
+    if (::socketpair(AF_UNIX, SOCK_STREAM, 0, g_sigFd) == 0) {
+        auto *notifier = new QSocketNotifier(g_sigFd[1], QSocketNotifier::Read, &app);
+        QObject::connect(notifier, &QSocketNotifier::activated, &app, [&app](int fd) {
+            char tmp = 0;
+            const ssize_t ignored = ::read(fd, &tmp, sizeof(tmp));
+            (void)ignored;
+            app.quit();
+        });
+        struct sigaction sa{};
+        sa.sa_handler = unixSignalHandler;
+        sigemptyset(&sa.sa_mask);
+        sa.sa_flags = SA_RESTART;
+        ::sigaction(SIGINT, &sa, nullptr);
+        ::sigaction(SIGTERM, &sa, nullptr);
+    }
+
+    PipeWireBridge bridge(socketPath, parser.value(nameOpt), parser.value(audioOpt) == QLatin1String("1"));
+    QObject::connect(&app, &QCoreApplication::aboutToQuit, &bridge, &PipeWireBridge::shutdown);
+
+    QString err;
+    if (!bridge.start(&err)) {
+        QTextStream(stderr) << err << QStringLiteral("\n");
+        return 1;
+    }
+
+    return app.exec();
+}
diff --git a/plugins/continuity_camera/bridge/pipewirebridge.cpp b/plugins/continuity_camera/bridge/pipewirebridge.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f90dffbdcfe42ea953b966ef11043e68a63a3012
--- /dev/null
+++ b/plugins/continuity_camera/bridge/pipewirebridge.cpp
@@ -0,0 +1,314 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "pipewirebridge.h"
+
+#include <QCoreApplication>
+#include <QLocalSocket>
+
+#include <cstring>
+
+#include <gst/app/gstappsrc.h>
+#include <gst/gst.h>
+
+namespace
+{
+void configureLiveAppSrc(GstElement *appsrc, const char *capsString, guint64 maxBytes)
+{
+    GstCaps *caps = gst_caps_from_string(capsString);
+    g_object_set(appsrc,
+                 "is-live",
+                 TRUE,
+                 "format",
+                 GST_FORMAT_TIME,
+                 "stream-type",
+                 GST_APP_STREAM_TYPE_STREAM,
+                 "max-bytes",
+                 maxBytes,
+                 "caps",
+                 caps,
+                 nullptr);
+    gst_caps_unref(caps);
+}
+
+void configurePipeWireProvideSink(
+    GstElement *sink,
+    const QByteArray &clientName,
+    const char *mediaType,
+    const char *mediaRole,
+    const char *mediaClass,
+    const QByteArray &nodeDesc)
+{
+    GstStructure *props = gst_structure_new("props",
+                                            "media.type",
+                                            G_TYPE_STRING,
+                                            mediaType,
+                                            "media.category",
+                                            G_TYPE_STRING,
+                                            "Source",
+                                            "media.role",
+                                            G_TYPE_STRING,
+                                            mediaRole,
+                                            "media.class",
+                                            G_TYPE_STRING,
+                                            mediaClass,
+                                            "node.description",
+                                            G_TYPE_STRING,
+                                            nodeDesc.constData(),
+                                            nullptr);
+    g_object_set(sink,
+                 "mode",
+                 2,
+                 "client-name",
+                 clientName.constData(),
+                 "stream-properties",
+                 props,
+                 nullptr);
+    gst_structure_free(props);
+}
+
+bool pushBufferToAppSrc(GstElement *appsrc, const QByteArray &data, quint64 ptsUs, bool setKeyframeFlag, bool isKeyframe)
+{
+    if (!appsrc || data.isEmpty()) {
+        return false;
+    }
+    GstBuffer *buf = gst_buffer_new_allocate(nullptr, static_cast<gsize>(data.size()), nullptr);
+    if (!buf) {
+        return false;
+    }
+    GstMapInfo map;
+    if (!gst_buffer_map(buf, &map, GST_MAP_WRITE)) {
+        gst_buffer_unref(buf);
+        return false;
+    }
+    std::memcpy(map.data, data.constData(), static_cast<size_t>(data.size()));
+    gst_buffer_unmap(buf, &map);
+
+    GST_BUFFER_PTS(buf) = static_cast<GstClockTime>(ptsUs) * 1000ULL;
+    GST_BUFFER_DTS(buf) = GST_CLOCK_TIME_NONE;
+    if (setKeyframeFlag) {
+        if (isKeyframe) {
+            GST_BUFFER_FLAG_UNSET(buf, GST_BUFFER_FLAG_DELTA_UNIT);
+        } else {
+            GST_BUFFER_FLAG_SET(buf, GST_BUFFER_FLAG_DELTA_UNIT);
+        }
+    }
+    return gst_app_src_push_buffer(GST_APP_SRC(appsrc), buf) == GST_FLOW_OK;
+}
+
+void teardownGstPipeline(GstElement *&pipeline, GstElement *&appsrc)
+{
+    if (pipeline) {
+        gst_element_set_state(pipeline, GST_STATE_NULL);
+        gst_object_unref(pipeline);
+        pipeline = nullptr;
+    }
+    appsrc = nullptr;
+}
+}
+
+struct PipeWireBridge::Private {
+    GstElement *videoPipeline = nullptr;
+    GstElement *videoAppSrc = nullptr;
+    GstElement *audioPipeline = nullptr;
+    GstElement *audioAppSrc = nullptr;
+};
+
+PipeWireBridge::PipeWireBridge(const QString &socketPath, const QString &deviceName, bool enableAudio, QObject *parent)
+    : QObject(parent)
+    , m_socketPath(socketPath)
+    , m_deviceName(deviceName.isEmpty() ? QStringLiteral("Android Phone") : deviceName)
+    , m_enableAudio(enableAudio)
+    , d(new Private)
+{
+}
+
+PipeWireBridge::~PipeWireBridge()
+{
+    shutdown();
+    delete d;
+    d = nullptr;
+}
+
+bool PipeWireBridge::start(QString *errorOut)
+{
+    if (!initPipelines(errorOut)) {
+        return false;
+    }
+
+    m_socket = new QLocalSocket(this);
+    connect(m_socket, &QLocalSocket::readyRead, this, &PipeWireBridge::onSocketReadyRead);
+    connect(m_socket, &QLocalSocket::disconnected, this, &PipeWireBridge::onSocketDisconnected);
+    m_socket->connectToServer(m_socketPath);
+    if (!m_socket->waitForConnected(3000)) {
+        if (errorOut) {
+            *errorOut = QStringLiteral("Failed to connect to continuity camera socket: %1").arg(m_socket->errorString());
+        }
+        shutdown();
+        return false;
+    }
+    return true;
+}
+
+bool PipeWireBridge::initPipelines(QString *errorOut)
+{
+    GError *gerr = nullptr;
+    if (!gst_init_check(nullptr, nullptr, &gerr)) {
+        if (errorOut) {
+            *errorOut = gerr ? QString::fromUtf8(gerr->message) : QStringLiteral("Failed to initialize GStreamer");
+        }
+        if (gerr) {
+            g_error_free(gerr);
+        }
+        return false;
+    }
+
+    d->videoPipeline = gst_pipeline_new("continuity-camera-video");
+    d->videoAppSrc = gst_element_factory_make("appsrc", "vsrc");
+    GstElement *parser = gst_element_factory_make("h264parse", "vparse");
+    GstElement *decoder = gst_element_factory_make("avdec_h264", "vdec");
+    GstElement *convert = gst_element_factory_make("videoconvert", "vconv");
+    GstElement *pwSink = gst_element_factory_make("pipewiresink", "vsink");
+
+    if (!d->videoPipeline || !d->videoAppSrc || !parser || !decoder || !convert || !pwSink) {
+        if (errorOut) {
+            *errorOut = QStringLiteral("Missing GStreamer video elements (appsrc, h264parse, avdec_h264, videoconvert, pipewiresink)");
+        }
+        if (d->videoAppSrc && !GST_OBJECT_PARENT(d->videoAppSrc)) gst_object_unref(d->videoAppSrc);
+        if (parser && !GST_OBJECT_PARENT(parser)) gst_object_unref(parser);
+        if (decoder && !GST_OBJECT_PARENT(decoder)) gst_object_unref(decoder);
+        if (convert && !GST_OBJECT_PARENT(convert)) gst_object_unref(convert);
+        if (pwSink && !GST_OBJECT_PARENT(pwSink)) gst_object_unref(pwSink);
+        teardownGstPipeline(d->videoPipeline, d->videoAppSrc);
+        return false;
+    }
+
+    configureLiveAppSrc(d->videoAppSrc, "video/x-h264,stream-format=(string)byte-stream,alignment=(string)au", 4U * 1024U * 1024U);
+    g_object_set(parser, "config-interval", -1, nullptr);
+
+    const QByteArray clientName = QByteArrayLiteral("KDE Connect Continuity Camera");
+    const QByteArray camDesc = QStringLiteral("KDE Connect Camera (%1)").arg(m_deviceName).toUtf8();
+    configurePipeWireProvideSink(pwSink, clientName, "Video", "Camera", "Video/Source", camDesc);
+
+    gst_bin_add_many(GST_BIN(d->videoPipeline), d->videoAppSrc, parser, decoder, convert, pwSink, nullptr);
+    if (!gst_element_link_many(d->videoAppSrc, parser, decoder, convert, pwSink, nullptr)) {
+        if (errorOut) {
+            *errorOut = QStringLiteral("Failed to link Continuity Camera PipeWire video pipeline");
+        }
+        shutdown();
+        return false;
+    }
+
+    if (gst_element_set_state(d->videoPipeline, GST_STATE_PLAYING) == GST_STATE_CHANGE_FAILURE) {
+        if (errorOut) {
+            *errorOut = QStringLiteral("Failed to start Continuity Camera video pipeline");
+        }
+        shutdown();
+        return false;
+    }
+
+    if (m_enableAudio) {
+        d->audioPipeline = gst_pipeline_new("continuity-camera-audio");
+        d->audioAppSrc = gst_element_factory_make("appsrc", "asrc");
+        GstElement *aconv = gst_element_factory_make("audioconvert", "aconv");
+        GstElement *aresamp = gst_element_factory_make("audioresample", "aresamp");
+        GstElement *apwSink = gst_element_factory_make("pipewiresink", "asink");
+
+        if (d->audioPipeline && d->audioAppSrc && aconv && aresamp && apwSink) {
+            configureLiveAppSrc(d->audioAppSrc, "audio/x-raw,format=(string)S16LE,channels=(int)1,rate=(int)48000,layout=(string)interleaved", 512U * 1024U);
+            const QByteArray micDesc = QStringLiteral("KDE Connect Mic (%1)").arg(m_deviceName).toUtf8();
+            configurePipeWireProvideSink(apwSink, clientName, "Audio", "Communication", "Audio/Source", micDesc);
+            gst_bin_add_many(GST_BIN(d->audioPipeline), d->audioAppSrc, aconv, aresamp, apwSink, nullptr);
+            if (gst_element_link_many(d->audioAppSrc, aconv, aresamp, apwSink, nullptr)) {
+                gst_element_set_state(d->audioPipeline, GST_STATE_PLAYING);
+            } else {
+                teardownGstPipeline(d->audioPipeline, d->audioAppSrc);
+            }
+        } else {
+            if (d->audioAppSrc && !GST_OBJECT_PARENT(d->audioAppSrc)) gst_object_unref(d->audioAppSrc);
+            if (aconv && !GST_OBJECT_PARENT(aconv)) gst_object_unref(aconv);
+            if (aresamp && !GST_OBJECT_PARENT(aresamp)) gst_object_unref(aresamp);
+            if (apwSink && !GST_OBJECT_PARENT(apwSink)) gst_object_unref(apwSink);
+            teardownGstPipeline(d->audioPipeline, d->audioAppSrc);
+        }
+    }
+
+    return true;
+}
+
+void PipeWireBridge::shutdown()
+{
+    if (m_socket) {
+        disconnect(m_socket, nullptr, this, nullptr);
+        m_socket->close();
+        m_socket->deleteLater();
+        m_socket = nullptr;
+    }
+    if (d) {
+        teardownGstPipeline(d->videoPipeline, d->videoAppSrc);
+        teardownGstPipeline(d->audioPipeline, d->audioAppSrc);
+    }
+}
+
+void PipeWireBridge::onSocketReadyRead()
+{
+    if (!m_socket) {
+        return;
+    }
+    const QByteArray data = m_socket->readAll();
+    if (data.isEmpty()) {
+        return;
+    }
+
+    QList<ContinuityCameraProtocol::StreamFrame> frames;
+    if (!m_parser.feed(data, &frames)) {
+        shutdown();
+        QCoreApplication::quit();
+        return;
+    }
+
+    for (const auto &frame : std::as_const(frames)) {
+        if (frame.kind == ContinuityCameraProtocol::FrameKind::ControlEos) {
+            onSocketDisconnected();
+            return;
+        }
+        handleFrame(frame);
+    }
+}
+
+void PipeWireBridge::handleFrame(const ContinuityCameraProtocol::StreamFrame &frame)
+{
+    switch (frame.kind) {
+    case ContinuityCameraProtocol::FrameKind::CodecConfig:
+        m_codecConfig = frame.payload;
+        pushBufferToAppSrc(d->videoAppSrc, frame.payload, frame.ptsUs, true, true);
+        break;
+    case ContinuityCameraProtocol::FrameKind::VideoAccessUnit: {
+        const bool keyframe = (frame.flags & ContinuityCameraProtocol::FlagKeyframe) != 0;
+        QByteArray packet = frame.payload;
+        if (keyframe && !m_codecConfig.isEmpty() && !packet.startsWith(m_codecConfig)) {
+            packet.prepend(m_codecConfig);
+        }
+        pushBufferToAppSrc(d->videoAppSrc, packet, frame.ptsUs, true, keyframe);
+        break;
+    }
+    case ContinuityCameraProtocol::FrameKind::AudioPcmChunk:
+        if (d->audioAppSrc) {
+            pushBufferToAppSrc(d->audioAppSrc, frame.payload, frame.ptsUs, false, false);
+        }
+        break;
+    case ContinuityCameraProtocol::FrameKind::ControlEos:
+        break;
+    }
+}
+
+void PipeWireBridge::onSocketDisconnected()
+{
+    shutdown();
+    QCoreApplication::quit();
+}
+
+#include "moc_pipewirebridge.cpp"
