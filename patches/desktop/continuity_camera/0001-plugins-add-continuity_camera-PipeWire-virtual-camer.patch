+
+K_PLUGIN_CLASS_WITH_JSON(ContinuityCameraPlugin, "kdeconnect_continuitycamera.json")
+
+namespace
+{
+inline constexpr qsizetype kMaxPendingFrames = 32;
+inline constexpr qint64 kMaxBridgeWriteQueueBytes = 4LL * 1024LL * 1024LL;
+}
+
+ContinuityCameraPlugin::ContinuityCameraPlugin(QObject *parent, const QVariantList &args)
+    : KdeConnectPlugin(parent, args)
+{
+}
+
+ContinuityCameraPlugin::~ContinuityCameraPlugin()
+{
+    m_stopping = true;
+    teardownSession(true, false);
+}
+
+bool ContinuityCameraPlugin::isStreaming() const
+{
+    return m_session.state() == ContinuityCameraProtocol::CameraSessionMachine::State::Streaming;
+}
+
+QString ContinuityCameraPlugin::state() const
+{
+    return m_session.stateName();
+}
+
+QString ContinuityCameraPlugin::dbusPath() const
+{
+    return QLatin1String("/modules/kdeconnect/devices/%1/continuitycamera").arg(device()->id());
+}
+
+bool ContinuityCameraPlugin::startCamera(int maxWidth, int maxHeight, int fps, bool includeMic, const QString &lens)
+{
+    const ContinuityCameraProtocol::StreamConfig cfg = ContinuityCameraProtocol::clampStreamConfig(maxWidth, maxHeight, fps);
+    m_stopping = false;
+    m_session.beginStart();
+    Q_EMIT stateChanged();
+
+    NetworkPacket np(PACKET_TYPE_CONTINUITYCAMERA_REQUEST);
+    np.set(QStringLiteral("action"), QStringLiteral("start_stream"));
+    np.set(QStringLiteral("maxWidth"), cfg.width);
+    np.set(QStringLiteral("maxHeight"), cfg.height);
+    np.set(QStringLiteral("fps"), cfg.fps);
+    np.set(QStringLiteral("includeMic"), includeMic);
+    np.set(QStringLiteral("lens"), ContinuityCameraProtocol::normalizeLens(lens));
+    return sendPacket(np);
+}
+
+void ContinuityCameraPlugin::stopCamera()
+{
+    m_stopping = true;
+    m_session.beginStop();
+    NetworkPacket np(PACKET_TYPE_CONTINUITYCAMERA_REQUEST, {{QStringLiteral("action"), QStringLiteral("stop_stream")}});
+    sendPacket(np);
+    teardownSession(true, false);
+}
+
+void ContinuityCameraPlugin::switchLens(const QString &lens)
+{
+    NetworkPacket np(PACKET_TYPE_CONTINUITYCAMERA_REQUEST);
+    np.set(QStringLiteral("action"), QStringLiteral("switch_lens"));
+    np.set(QStringLiteral("lens"), ContinuityCameraProtocol::normalizeLens(lens));
+    sendPacket(np);
+}
+
+void ContinuityCameraPlugin::requestPhotoCapture()
+{
+    NetworkPacket np(PACKET_TYPE_CONTINUITYCAMERA_REQUEST, {{QStringLiteral("action"), QStringLiteral("capture_photo")}});
+    sendPacket(np);
+}
+
+void ContinuityCameraPlugin::requestDocumentScan()
+{
+    NetworkPacket np(PACKET_TYPE_CONTINUITYCAMERA_REQUEST, {{QStringLiteral("action"), QStringLiteral("scan_document")}});
+    sendPacket(np);
+}
+
+void ContinuityCameraPlugin::receivePacket(const NetworkPacket &np)
+{
+    if (np.type() != PACKET_TYPE_CONTINUITYCAMERA) {
+        return;
+    }
+
+    const QString event = np.get<QString>(QStringLiteral("event"));
+    if (event == QLatin1String("capture_result")) {
+        handleCaptureResult(np);
+        return;
+    }
+
+    if (event == QLatin1String("stopped")) {
+        teardownSession(true, false);
+        return;
+    }
+
+    if (event == QLatin1String("state")) {
+        const QString remoteState = np.get<QString>(QStringLiteral("state"));
+        if (remoteState == QLatin1String("error") || remoteState == QLatin1String("stopped")) {
+            teardownSession(true, remoteState == QLatin1String("error"));
+        }
+        return;
+    }
+
+    if (event == QLatin1String("stream_open")) {
+        if (!np.hasPayload() || !np.payload()) {
+            teardownSession(true, true);
+            return;
+        }
+        const bool includeMic = np.get<bool>(QStringLiteral("audioEnabled"), false);
+        teardownSession(true, false);
+        m_stopping = false;
+        m_parser.reset();
+        m_cachedCodecConfig.clear();
+        m_pendingFrames.clear();
+
+        if (!ensureLocalServer() || !launchBridge(includeMic)) {
+            teardownSession(true, true);
+            return;
+        }
+
+        m_payload = np.payload();
+        connect(m_payload.data(), &QIODevice::readyRead, this, &ContinuityCameraPlugin::onPayloadReadyRead);
+        connect(m_payload.data(), &QIODevice::readChannelFinished, this, &ContinuityCameraPlugin::onPayloadClosed);
+        connect(m_payload.data(), &QIODevice::aboutToClose, this, &ContinuityCameraPlugin::onPayloadClosed);
+
+        m_session.onStreamOpen();
+        Q_EMIT streamingChanged(true);
+        Q_EMIT stateChanged();
+
+        if (m_payload->bytesAvailable() > 0) {
+            onPayloadReadyRead();
+        }
+    }
+}
+
+void ContinuityCameraPlugin::handleCaptureResult(const NetworkPacket &np)
+{
+    if (!np.hasPayload() || np.payloadSize() <= 0 || np.payloadSize() > ContinuityCameraProtocol::kMaxCaptureBytes) {
+        qCWarning(KDECONNECT_PLUGIN_CONTINUITYCAMERA) << "Ignoring capture_result with missing or oversized payload:" << np.payloadSize();
+        return;
+    }
+
+    const QString mimeType = np.get<QString>(QStringLiteral("mimeType")).trimmed().toLower();
+    const QString safeName = ContinuityCameraProtocol::sanitizeCaptureFilename(np.get<QString>(QStringLiteral("filename")), mimeType);
+    if (safeName.isEmpty()) {
+        qCWarning(KDECONNECT_PLUGIN_CONTINUITYCAMERA) << "Ignoring capture_result with invalid filename or mimeType";
+        return;
+    }
+
+    QString dlDir = QStandardPaths::writableLocation(QStandardPaths::DownloadLocation);
+    if (dlDir.isEmpty()) {
+        dlDir = QDir::homePath();
+    }
+    QDir().mkpath(dlDir);
+    QString destPath = QDir(dlDir).filePath(safeName);
+    if (QFileInfo::exists(destPath)) {
+        const QFileInfo fi(safeName);
+        const QString unique = QStringLiteral("%1-%2.%3")
+                                   .arg(fi.completeBaseName())
+                                   .arg(QDateTime::currentMSecsSinceEpoch())
+                                   .arg(fi.suffix());
+        destPath = QDir(dlDir).filePath(unique);
+    }
+
+    FileTransferJob *job = np.createPayloadTransferJob(QUrl::fromLocalFile(destPath));
+    connect(job, &KJob::result, this, [this, job, destPath, mimeType] {
+        if (job->error()) {
+            qCWarning(KDECONNECT_PLUGIN_CONTINUITYCAMERA) << "Capture download failed:" << job->errorString();
+            QFile::remove(destPath);
+            return;
+        }
+        if (QFileInfo(destPath).size() > ContinuityCameraProtocol::kMaxCaptureBytes) {
+            qCWarning(KDECONNECT_PLUGIN_CONTINUITYCAMERA) << "Downloaded capture exceeded size bound";
+            QFile::remove(destPath);
+            return;
+        }
+        Daemon::instance()->sendSimpleNotification(
+            QStringLiteral("continuityCameraCapture"),
+            device()->name(),
+            i18n("Imported capture to %1", destPath),
+            QStringLiteral("camera-photo"));
+        Q_EMIT captureImported(destPath, mimeType);
+    });
+    job->start();
+}
+
+bool ContinuityCameraPlugin::ensureLocalServer()
+{
+    if (m_localServer) {
+        m_localServer->close();
+        m_localServer->deleteLater();
+        m_localServer = nullptr;
+    }
+    removeSocketFile();
+
+    QString baseDir = QStandardPaths::writableLocation(QStandardPaths::RuntimeLocation);
+    if (baseDir.isEmpty() || !QDir().mkpath(baseDir)) {
+        m_fallbackSocketDir = QDir(QDir::tempPath()).filePath(
+            QStringLiteral("kdeconnect-ccam-%1").arg(QUuid::createUuid().toString(QUuid::Id128).left(12)));
+        if (!QDir().mkpath(m_fallbackSocketDir)) {
+            return false;
+        }
+        QFile::setPermissions(m_fallbackSocketDir, QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ExeOwner);
+        baseDir = m_fallbackSocketDir;
+    }
+
+    m_socketPath = QDir(baseDir).filePath(
+        QStringLiteral("kdeconnect-ccam-%1-%2.sock")
+            .arg(QCoreApplication::applicationPid())
+            .arg(QUuid::createUuid().toString(QUuid::Id128).left(10)));
+    QLocalServer::removeServer(m_socketPath);
+
+    m_localServer = new QLocalServer(this);
+    m_localServer->setSocketOptions(QLocalServer::UserAccessOption);
+    connect(m_localServer, &QLocalServer::newConnection, this, &ContinuityCameraPlugin::onNewBridgeConnection);
+    return m_localServer->listen(m_socketPath);
+}
+
+bool ContinuityCameraPlugin::launchBridge(bool includeMic)
+{
+    QString bridgeExe = QStandardPaths::findExecutable(QStringLiteral("kdeconnect-continuitycamera-bridge"));
+    if (bridgeExe.isEmpty()) {
+        const QString sibling = QDir(QCoreApplication::applicationDirPath()).filePath(QStringLiteral("kdeconnect-continuitycamera-bridge"));
+        if (QFileInfo::exists(sibling) && QFileInfo(sibling).isExecutable()) {
+            bridgeExe = sibling;
+        }
+    }
+    if (bridgeExe.isEmpty()) {
+        qCWarning(KDECONNECT_PLUGIN_CONTINUITYCAMERA) << "kdeconnect-continuitycamera-bridge executable not found";
+        return false;
+    }
+
+    auto *process = new QProcess(this);
+#ifdef Q_OS_UNIX
+    process->setUnixProcessParameters(QProcess::UnixProcessFlag::CloseFileDescriptors);
+#endif
+    process->setProcessChannelMode(QProcess::ForwardedChannels);
+    process->setProgram(bridgeExe);
+    process->setArguments({
+        QStringLiteral("--device"),
+        device()->id(),
+        QStringLiteral("--device-name"),
+        device()->name(),
+        QStringLiteral("--socket"),
+        m_socketPath,
+        QStringLiteral("--audio"),
+        includeMic ? QStringLiteral("1") : QStringLiteral("0"),
+    });
+
+    connect(process, &QProcess::finished, this, &ContinuityCameraPlugin::onBridgeFinished);
+    m_bridgeProcess = process;
+    process->start();
+    if (!process->waitForStarted(3000)) {
+        disconnect(process, &QProcess::finished, this, nullptr);
+        process->deleteLater();
+        m_bridgeProcess = nullptr;
+        return false;
+    }
+    return true;
+}
+
+void ContinuityCameraPlugin::teardownSession(bool terminateBridge, bool error)
+{
+    const bool wasStreaming = isStreaming();
+    if (m_payload) {
+        disconnect(m_payload.data(), nullptr, this, nullptr);
+        m_payload.clear();
+    }
+    if (m_bridgeSocket) {
+        disconnect(m_bridgeSocket, nullptr, this, nullptr);
+        m_bridgeSocket->close();
+        m_bridgeSocket->deleteLater();
+        m_bridgeSocket = nullptr;
+    }
+    if (m_localServer) {
+        m_localServer->close();
+        m_localServer->deleteLater();
+        m_localServer = nullptr;
+    }
+    if (m_bridgeProcess) {
+        disconnect(m_bridgeProcess, nullptr, this, nullptr);
+        if (terminateBridge && m_bridgeProcess->state() != QProcess::NotRunning) {
+            m_bridgeProcess->terminate();
+            if (!m_bridgeProcess->waitForFinished(1500)) {
+                m_bridgeProcess->kill();
+            }
+        }
+        m_bridgeProcess->deleteLater();
+        m_bridgeProcess = nullptr;
+    }
+    removeSocketFile();
+    m_cachedCodecConfig.clear();
+    m_pendingFrames.clear();
+    m_parser.reset();
+    m_session.onTeardown(error);
+    if (wasStreaming) {
+        Q_EMIT streamingChanged(false);
+    }
+    Q_EMIT stateChanged();
+}
+
+void ContinuityCameraPlugin::removeSocketFile()
+{
+    if (!m_socketPath.isEmpty()) {
+        QLocalServer::removeServer(m_socketPath);
+        QFile::remove(m_socketPath);
+        m_socketPath.clear();
+    }
+    if (!m_fallbackSocketDir.isEmpty()) {
+        QDir(m_fallbackSocketDir).removeRecursively();
+        m_fallbackSocketDir.clear();
+    }
+}
+
+void ContinuityCameraPlugin::onNewBridgeConnection()
+{
+    if (!m_localServer) {
+        return;
+    }
+    while (QLocalSocket *sock = m_localServer->nextPendingConnection()) {
+        if (m_bridgeSocket) {
+            sock->close();
+            sock->deleteLater();
+            continue;
+        }
+        m_bridgeSocket = sock;
+        connect(sock, &QLocalSocket::disconnected, this, &ContinuityCameraPlugin::onBridgeSocketDisconnected);
+        flushPendingFrames();
+    }
+}
+
+void ContinuityCameraPlugin::onBridgeSocketDisconnected()
+{
+    if (m_bridgeSocket) {
+        m_bridgeSocket->deleteLater();
+        m_bridgeSocket = nullptr;
+    }
+}
+
+void ContinuityCameraPlugin::onBridgeFinished()
+{
+    if (!m_bridgeProcess) {
+        return;
+    }
+    const bool abnormal = m_bridgeProcess->exitStatus() != QProcess::NormalExit || m_bridgeProcess->exitCode() != 0;
+    m_bridgeProcess->deleteLater();
+    m_bridgeProcess = nullptr;
+    if (!m_stopping) {
+        stopCamera();
+        if (abnormal) {
+            m_session.onTeardown(true);
+            Q_EMIT stateChanged();
+        }
+    }
+}
+
+void ContinuityCameraPlugin::onPayloadReadyRead()
+{
+    if (!m_payload) {
+        return;
+    }
+    const QByteArray data = m_payload->readAll();
+    if (data.isEmpty()) {
+        return;
+    }
+
+    QList<ContinuityCameraProtocol::StreamFrame> frames;
+    if (!m_parser.feed(data, &frames)) {
+        teardownSession(true, true);
+        return;
+    }
+
+    for (const auto &frame : std::as_const(frames)) {
+        if (frame.kind == ContinuityCameraProtocol::FrameKind::ControlEos) {
+            onPayloadClosed();
+            return;
+        }
+        enqueueOrSendFrame(frame);
+    }
+}
+
+void ContinuityCameraPlugin::onPayloadClosed()
+{
+    if (m_bridgeSocket && m_bridgeSocket->state() == QLocalSocket::ConnectedState) {
+        m_bridgeSocket->write(ContinuityCameraProtocol::encodeFrame(ContinuityCameraProtocol::FrameKind::ControlEos, 0, 0, QByteArray()));
+        m_bridgeSocket->flush();
+    }
+    teardownSession(false, false);
+}
+
+void ContinuityCameraPlugin::enqueueOrSendFrame(const ContinuityCameraProtocol::StreamFrame &frame)
+{
+    const QByteArray encoded = ContinuityCameraProtocol::encodeFrame(frame.kind, frame.flags, frame.ptsUs, frame.payload);
+    if (frame.kind == ContinuityCameraProtocol::FrameKind::CodecConfig) {
+        m_cachedCodecConfig = encoded;
+    }
+
+    if (m_bridgeSocket && m_bridgeSocket->state() == QLocalSocket::ConnectedState) {
+        if (m_bridgeSocket->bytesToWrite() < kMaxBridgeWriteQueueBytes
+            || frame.kind == ContinuityCameraProtocol::FrameKind::CodecConfig
+            || (frame.flags & ContinuityCameraProtocol::FlagKeyframe) != 0) {
+            m_bridgeSocket->write(encoded);
+        }
+        return;
+    }
+
+    if (frame.kind == ContinuityCameraProtocol::FrameKind::VideoAccessUnit && (frame.flags & ContinuityCameraProtocol::FlagKeyframe) != 0) {
+        m_pendingFrames.clear();
+        if (!m_cachedCodecConfig.isEmpty()) {
+            m_pendingFrames.append(m_cachedCodecConfig);
+        }
+    }
+    if (m_pendingFrames.size() >= kMaxPendingFrames) {
+        m_pendingFrames.removeFirst();
+    }
+    m_pendingFrames.append(encoded);
+}
+
+void ContinuityCameraPlugin::flushPendingFrames()
+{
+    if (!m_bridgeSocket || m_bridgeSocket->state() != QLocalSocket::ConnectedState) {
+        return;
+    }
+    for (const QByteArray &item : std::as_const(m_pendingFrames)) {
+        m_bridgeSocket->write(item);
+    }
+    m_pendingFrames.clear();
+}
+
