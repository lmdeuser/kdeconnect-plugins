+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "continuitycameraprotocol.h"
+
+#include <QtEndian>
+
+#include <cstring>
+
+namespace ContinuityCameraProtocol
+{
+bool isValidFrameKind(quint8 rawKind, FrameKind *outKind)
+{
+    switch (rawKind) {
+    case 0x01:
+        if (outKind) {
+            *outKind = FrameKind::CodecConfig;
+        }
+        return true;
+    case 0x02:
+        if (outKind) {
+            *outKind = FrameKind::VideoAccessUnit;
+        }
+        return true;
+    case 0x03:
+        if (outKind) {
+            *outKind = FrameKind::AudioPcmChunk;
+        }
+        return true;
+    case 0x04:
+        if (outKind) {
+            *outKind = FrameKind::ControlEos;
+        }
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool isValidPayloadLength(FrameKind kind, quint32 length)
+{
+    switch (kind) {
+    case FrameKind::CodecConfig:
+    case FrameKind::VideoAccessUnit:
+        return length > 0 && length <= kMaxVideoFrameBytes;
+    case FrameKind::AudioPcmChunk:
+        return length > 0 && length <= kMaxAudioChunkBytes;
+    case FrameKind::ControlEos:
+        return length == 0;
+    }
+    return false;
+}
+
+QByteArray encodeFrame(FrameKind kind, quint8 flags, quint64 ptsUs, const QByteArray &payload)
+{
+    const quint32 len = static_cast<quint32>(payload.size());
+    QByteArray out(kHeaderBytes + payload.size(), Qt::Uninitialized);
+    char *raw = out.data();
+    qToBigEndian<quint16>(kStreamMagic, raw);
+    raw[2] = static_cast<char>(kind);
+    raw[3] = static_cast<char>(flags & FlagValidMask);
+    qToBigEndian<quint32>(len, raw + 4);
+    qToBigEndian<quint64>(ptsUs, raw + 8);
+    if (!payload.isEmpty()) {
+        std::memcpy(raw + kHeaderBytes, payload.constData(), static_cast<size_t>(payload.size()));
+    }
+    return out;
+}
+
+StreamConfig clampStreamConfig(int maxWidth, int maxHeight, int fps)
+{
+    int w = qBound(kMinDimension, maxWidth, kMaxDimension);
+    int h = qBound(kMinDimension, maxHeight, kMaxDimension);
+    w &= ~1;
+    h &= ~1;
+    StreamConfig cfg;
+    cfg.width = qMax(kMinDimension, w);
+    cfg.height = qMax(kMinDimension, h);
+    cfg.fps = qBound(kMinFps, fps, kMaxFps);
+    return cfg;
+}
+
+QString normalizeLens(const QString &raw)
+{
+    return raw.trimmed().compare(QLatin1String("front"), Qt::CaseInsensitive) == 0 ? QStringLiteral("front") : QStringLiteral("back");
+}
+
+QString sanitizeCaptureFilename(const QString &raw, const QString &mimeType)
+{
+    QString requiredExt;
+    QString altExt;
+    if (mimeType == QLatin1String("image/jpeg")) {
+        requiredExt = QStringLiteral(".jpg");
+        altExt = QStringLiteral(".jpeg");
+    } else if (mimeType == QLatin1String("application/pdf")) {
+        requiredExt = QStringLiteral(".pdf");
+    } else {
+        return {};
+    }
+
+    const QString trimmed = raw.trimmed();
+    if (trimmed.isEmpty() || trimmed.size() > 128) {
+        return {};
+    }
+    if (trimmed.contains(QLatin1Char('/')) || trimmed.contains(QLatin1Char('\\')) || trimmed.contains(QLatin1String(".."))) {
+        return {};
+    }
+
+    QString out;
+    out.reserve(trimmed.size());
+    for (const QChar ch : trimmed) {
+        const ushort code = ch.unicode();
+        if (code < 0x20 || code == 0x7F || ch == QLatin1Char(':')) {
+            return {};
+        }
+        out.append(ch);
+    }
+    if (out.startsWith(QLatin1Char('.'))) {
+        return {};
+    }
+
+    const QString lower = out.toLower();
+    if (lower.endsWith(requiredExt) || (!altExt.isEmpty() && lower.endsWith(altExt))) {
+        return out;
+    }
+    return {};
+}
+
+void StreamFrameParser::reset()
+{
+    m_buffer.clear();
+    m_hasError = false;
+    m_errorString.clear();
+}
+
+void StreamFrameParser::setError(const QString &message)
+{
+    m_hasError = true;
+    m_errorString = message;
+    m_buffer.clear();
+}
+
+bool StreamFrameParser::feed(const QByteArray &chunk, QList<StreamFrame> *outFrames)
+{
+    if (m_hasError) {
+        return false;
+    }
+    if (outFrames) {
+        outFrames->clear();
+    }
+    if (!chunk.isEmpty()) {
+        if (m_buffer.size() + chunk.size() > static_cast<qsizetype>(kMaxVideoFrameBytes * 2U + kHeaderBytes)) {
+            setError(QStringLiteral("Incoming continuity camera buffer overflow"));
+            return false;
+        }
+        m_buffer.append(chunk);
+    }
+
+    qsizetype pos = 0;
+    while (m_buffer.size() - pos >= kHeaderBytes) {
+        const char *hdr = m_buffer.constData() + pos;
+        const quint16 magic = qFromBigEndian<quint16>(hdr);
+        if (magic != kStreamMagic) {
+            setError(QStringLiteral("Invalid stream magic"));
+            return false;
+        }
+
+        const quint8 rawKind = static_cast<quint8>(hdr[2]);
+        FrameKind kind = FrameKind::ControlEos;
+        if (!isValidFrameKind(rawKind, &kind)) {
+            setError(QStringLiteral("Invalid frame kind"));
+            return false;
+        }
+
+        const quint8 flags = static_cast<quint8>(hdr[3]);
+        if ((flags & ~FlagValidMask) != 0) {
+            setError(QStringLiteral("Invalid frame flags"));
+            return false;
+        }
+
+        const quint32 len = qFromBigEndian<quint32>(hdr + 4);
+        if (!isValidPayloadLength(kind, len)) {
+            setError(QStringLiteral("Invalid payload length"));
+            return false;
+        }
+
+        const quint64 ptsUs = qFromBigEndian<quint64>(hdr + 8);
+        if (m_buffer.size() - pos < kHeaderBytes + static_cast<qsizetype>(len)) {
+            break;
+        }
+
+        if (outFrames) {
+            StreamFrame frame;
+            frame.kind = kind;
+            frame.flags = flags;
+            frame.ptsUs = ptsUs;
+            if (len > 0) {
+                frame.payload = QByteArray(hdr + kHeaderBytes, static_cast<qsizetype>(len));
+            }
+            outFrames->append(frame);
+        }
+        pos += kHeaderBytes + static_cast<qsizetype>(len);
+    }
+
+    if (pos > 0) {
+        m_buffer.remove(0, pos);
+    }
+    return true;
+}
+
+QString CameraSessionMachine::stateName() const
+{
+    switch (m_state) {
+    case State::Idle:
+        return QStringLiteral("idle");
+    case State::Starting:
+        return QStringLiteral("starting");
+    case State::Streaming:
+        return QStringLiteral("streaming");
+    case State::Stopping:
+        return QStringLiteral("stopping");
+    case State::Error:
+        return QStringLiteral("error");
+    }
+    return QStringLiteral("idle");
+}
+
+void CameraSessionMachine::beginStart()
+{
+    m_state = State::Starting;
+}
+
+void CameraSessionMachine::onStreamOpen()
+{
+    m_state = State::Streaming;
+}
+
+void CameraSessionMachine::beginStop()
+{
+    m_state = State::Stopping;
+}
+
+void CameraSessionMachine::onTeardown(bool error)
+{
+    m_state = error ? State::Error : State::Idle;
+}
+}
diff --git a/plugins/continuity_camera/continuitycameraprotocol.h b/plugins/continuity_camera/continuitycameraprotocol.h
new file mode 100644
index 0000000000000000000000000000000000000000..24d940a1d1d3e08b25ca2edd2074728c1310d91a
--- /dev/null
+++ b/plugins/continuity_camera/continuitycameraprotocol.h
@@ -0,0 +1,108 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include <QByteArray>
+#include <QList>
+#include <QString>
+
+namespace ContinuityCameraProtocol
+{
+inline constexpr quint16 kStreamMagic = 0x4B43;
+inline constexpr int kHeaderBytes = 16;
+inline constexpr quint32 kMaxVideoFrameBytes = 4U * 1024U * 1024U;
+inline constexpr quint32 kMaxAudioChunkBytes = 65536U;
+inline constexpr int kMaxControlJsonBytes = 8192;
+inline constexpr qint64 kMaxCaptureBytes = 50LL * 1024LL * 1024LL;
+
+inline constexpr int kMinDimension = 320;
+inline constexpr int kMaxDimension = 1920;
+inline constexpr int kMinFps = 10;
+inline constexpr int kMaxFps = 60;
+
+enum class FrameKind : quint8 {
+    CodecConfig = 0x01,
+    VideoAccessUnit = 0x02,
+    AudioPcmChunk = 0x03,
+    ControlEos = 0x04,
+};
+
+enum FrameFlags : quint8 {
+    FlagNone = 0x00,
+    FlagKeyframe = 0x01,
+    FlagValidMask = 0x01,
+};
+
+struct StreamFrame {
+    FrameKind kind = FrameKind::ControlEos;
+    quint8 flags = FlagNone;
+    quint64 ptsUs = 0;
+    QByteArray payload;
+};
+
+struct StreamConfig {
+    int width = 1280;
+    int height = 720;
+    int fps = 30;
+};
+
+bool isValidFrameKind(quint8 rawKind, FrameKind *outKind);
+bool isValidPayloadLength(FrameKind kind, quint32 length);
+QByteArray encodeFrame(FrameKind kind, quint8 flags, quint64 ptsUs, const QByteArray &payload);
+
+StreamConfig clampStreamConfig(int maxWidth, int maxHeight, int fps);
+QString normalizeLens(const QString &raw);
+QString sanitizeCaptureFilename(const QString &raw, const QString &mimeType);
+
+class StreamFrameParser
+{
+public:
+    bool feed(const QByteArray &chunk, QList<StreamFrame> *outFrames);
+    bool hasError() const
+    {
+        return m_hasError;
+    }
+    QString errorString() const
+    {
+        return m_errorString;
+    }
+    void reset();
+
+private:
+    void setError(const QString &message);
+
+    QByteArray m_buffer;
+    bool m_hasError = false;
+    QString m_errorString;
+};
+
+class CameraSessionMachine
+{
+public:
+    enum class State {
+        Idle,
+        Starting,
+        Streaming,
+        Stopping,
+        Error,
+    };
+
+    State state() const
+    {
+        return m_state;
+    }
+    QString stateName() const;
+
+    void beginStart();
+    void onStreamOpen();
+    void beginStop();
+    void onTeardown(bool error = false);
+
+private:
+    State m_state = State::Idle;
+};
+}
diff --git a/plugins/continuity_camera/continuitycameratest.cpp b/plugins/continuity_camera/continuitycameratest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fb2473ff7ad2e9be1f38d523b9549ca3491ce9e5
--- /dev/null
+++ b/plugins/continuity_camera/continuitycameratest.cpp
@@ -0,0 +1,105 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "continuitycameraprotocol.h"
+
+#include <QtTest>
+
+class ContinuityCameraTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void testStreamConfigClampingAndLens()
+    {
+        const auto low = ContinuityCameraProtocol::clampStreamConfig(100, 120, 2);
+        QCOMPARE(low.width, ContinuityCameraProtocol::kMinDimension);
+        QCOMPARE(low.height, ContinuityCameraProtocol::kMinDimension);
+        QCOMPARE(low.fps, ContinuityCameraProtocol::kMinFps);
+
+        const auto odd = ContinuityCameraProtocol::clampStreamConfig(1281, 721, 90);
+        QCOMPARE(odd.width, 1280);
+        QCOMPARE(odd.height, 720);
+        QCOMPARE(odd.fps, ContinuityCameraProtocol::kMaxFps);
+
+        QCOMPARE(ContinuityCameraProtocol::normalizeLens(QStringLiteral("FRONT")), QStringLiteral("front"));
+        QCOMPARE(ContinuityCameraProtocol::normalizeLens(QStringLiteral("weird")), QStringLiteral("back"));
+    }
+
+    void testFrameSerializationChunkedParsingAndBounds()
+    {
+        const QByteArray cfg = QByteArrayLiteral("\x00\x00\x00\x01\x67\x42");
+        const QByteArray vid = QByteArrayLiteral("\x00\x00\x00\x01\x65\x88");
+        const QByteArray pcm(640, 'P');
+        const QByteArray wire =
+            ContinuityCameraProtocol::encodeFrame(ContinuityCameraProtocol::FrameKind::CodecConfig, 0, 1000ULL, cfg)
+            + ContinuityCameraProtocol::encodeFrame(ContinuityCameraProtocol::FrameKind::VideoAccessUnit,
+                                                    ContinuityCameraProtocol::FlagKeyframe,
+                                                    2000ULL,
+                                                    vid)
+            + ContinuityCameraProtocol::encodeFrame(ContinuityCameraProtocol::FrameKind::AudioPcmChunk, 0, 2500ULL, pcm)
+            + ContinuityCameraProtocol::encodeFrame(ContinuityCameraProtocol::FrameKind::ControlEos, 0, 3000ULL, QByteArray());
+
+        ContinuityCameraProtocol::StreamFrameParser parser;
+        QList<ContinuityCameraProtocol::StreamFrame> parsed;
+        for (int i = 0; i < wire.size(); i += 7) {
+            QList<ContinuityCameraProtocol::StreamFrame> step;
+            QVERIFY(parser.feed(wire.mid(i, 7), &step));
+            parsed.append(step);
+        }
+        QCOMPARE(parsed.size(), 4);
+        QCOMPARE(parsed[0].kind, ContinuityCameraProtocol::FrameKind::CodecConfig);
+        QCOMPARE(parsed[1].kind, ContinuityCameraProtocol::FrameKind::VideoAccessUnit);
+        QCOMPARE(parsed[1].flags, static_cast<quint8>(ContinuityCameraProtocol::FlagKeyframe));
+        QCOMPARE(parsed[2].payload.size(), 640);
+        QCOMPARE(parsed[3].kind, ContinuityCameraProtocol::FrameKind::ControlEos);
+
+        ContinuityCameraProtocol::StreamFrameParser badMagic;
+        QList<ContinuityCameraProtocol::StreamFrame> out;
+        QVERIFY(!badMagic.feed(QByteArray(16, '\x00'), &out));
+        QVERIFY(badMagic.hasError());
+
+        QByteArray oversizedHdr = ContinuityCameraProtocol::encodeFrame(
+            ContinuityCameraProtocol::FrameKind::AudioPcmChunk,
+            0,
+            0,
+            QByteArray(4, 'A'));
+        // Patch payload length to > kMaxAudioChunkBytes
+        oversizedHdr[4] = '\x00';
+        oversizedHdr[5] = '\x02';
+        oversizedHdr[6] = '\x00';
+        oversizedHdr[7] = '\x00';
+        ContinuityCameraProtocol::StreamFrameParser badLen;
+        QVERIFY(!badLen.feed(oversizedHdr, &out));
+    }
+
+    void testCaptureFilenameSanitizationAndSessionMachine()
+    {
+        QCOMPARE(ContinuityCameraProtocol::sanitizeCaptureFilename(QStringLiteral("scan_01.pdf"), QStringLiteral("application/pdf")),
+                 QStringLiteral("scan_01.pdf"));
+        QCOMPARE(ContinuityCameraProtocol::sanitizeCaptureFilename(QStringLiteral("photo.jpeg"), QStringLiteral("image/jpeg")),
+                 QStringLiteral("photo.jpeg"));
+        QVERIFY(ContinuityCameraProtocol::sanitizeCaptureFilename(QStringLiteral("../evil.jpg"), QStringLiteral("image/jpeg")).isEmpty());
+        QVERIFY(ContinuityCameraProtocol::sanitizeCaptureFilename(QStringLiteral("sub/photo.jpg"), QStringLiteral("image/jpeg")).isEmpty());
+        QVERIFY(ContinuityCameraProtocol::sanitizeCaptureFilename(QStringLiteral("wrong.exe"), QStringLiteral("image/jpeg")).isEmpty());
+        QVERIFY(ContinuityCameraProtocol::sanitizeCaptureFilename(QStringLiteral("ok.jpg"), QStringLiteral("text/plain")).isEmpty());
+
+        ContinuityCameraProtocol::CameraSessionMachine fsm;
+        QCOMPARE(fsm.state(), ContinuityCameraProtocol::CameraSessionMachine::State::Idle);
+        fsm.beginStart();
+        QCOMPARE(fsm.stateName(), QStringLiteral("starting"));
+        fsm.onStreamOpen();
+        QCOMPARE(fsm.stateName(), QStringLiteral("streaming"));
+        fsm.beginStop();
+        QCOMPARE(fsm.stateName(), QStringLiteral("stopping"));
+        fsm.onTeardown(false);
+        QCOMPARE(fsm.stateName(), QStringLiteral("idle"));
+    }
+};
+
+QTEST_MAIN(ContinuityCameraTest)
+
+#include "continuitycameratest.moc"
