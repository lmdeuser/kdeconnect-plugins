+bool pushAudioBufferToAppSrc(
+    GstElement *pipeline,
+    GstElement *appsrc,
+    const QByteArray &data,
+    bool &initialized,
+    quint64 &nextPtsNs)
+{
+    const qsizetype aligned = data.size() - (data.size() % 2);
+    if (!pipeline || !appsrc || aligned <= 0) {
+        return false;
+    }
+
+    const int numSamples = static_cast<int>(aligned / 2);
+    const quint64 durationNs = gst_util_uint64_scale_int(numSamples, GST_SECOND, 48000);
+
+    GstBuffer *buf = gst_buffer_new_allocate(nullptr, static_cast<gsize>(aligned), nullptr);
+    if (!buf) {
+        return false;
+    }
+    GstMapInfo map;
+    if (!gst_buffer_map(buf, &map, GST_MAP_WRITE)) {
+        gst_buffer_unref(buf);
+        return false;
+    }
+    std::memcpy(map.data, data.constData(), static_cast<size_t>(aligned));
+    gst_buffer_unmap(buf, &map);
+
+    const GstClockTime rawRunning = gst_element_get_current_running_time(pipeline);
+    const bool hasClock = GST_CLOCK_TIME_IS_VALID(rawRunning);
+    const quint64 runningNs = hasClock ? static_cast<quint64>(rawRunning) : 0ULL;
+
+    bool resync = !initialized;
+    if (!resync && hasClock) {
+        const quint64 diff = (runningNs >= nextPtsNs) ? (runningNs - nextPtsNs) : (nextPtsNs - runningNs);
+        if (diff > kMaxAudioDriftNs) {
+            resync = true;
+        }
+    }
+
+    if (resync) {
+        nextPtsNs = runningNs;
+        initialized = true;
+        GST_BUFFER_FLAG_SET(buf, GST_BUFFER_FLAG_DISCONT);
+    }
+
+    GST_BUFFER_PTS(buf) = static_cast<GstClockTime>(nextPtsNs);
+    GST_BUFFER_DTS(buf) = GST_CLOCK_TIME_NONE;
+    GST_BUFFER_DURATION(buf) = static_cast<GstClockTime>(durationNs);
+    nextPtsNs += durationNs;
+
+    return gst_app_src_push_buffer(GST_APP_SRC(appsrc), buf) == GST_FLOW_OK;
+}
