+    void testZeroLengthMediaRejectedAndLargePtsSafe()
+    {
+        const QByteArray emptyVid = ContinuityCameraProtocol::encodeFrame(
+            ContinuityCameraProtocol::FrameKind::VideoAccessUnit,
+            ContinuityCameraProtocol::FlagKeyframe,
+            1234ULL,
+            QByteArray());
+        ContinuityCameraProtocol::StreamFrameParser emptyParser;
+        QList<ContinuityCameraProtocol::StreamFrame> out;
+        QVERIFY(!emptyParser.feed(emptyVid, &out));
+        QVERIFY(emptyParser.hasError());
+
+        const quint64 largePtsUs = 3600000000ULL;
+        const QByteArray wire = ContinuityCameraProtocol::encodeFrame(
+            ContinuityCameraProtocol::FrameKind::VideoAccessUnit,
+            ContinuityCameraProtocol::FlagKeyframe,
+            largePtsUs,
+            QByteArrayLiteral("\x00\x00\x00\x01\x65\x88"));
+        ContinuityCameraProtocol::StreamFrameParser parser;
+        QVERIFY(parser.feed(wire, &out));
+        QCOMPARE(out.size(), 1);
+        QCOMPARE(out.first().ptsUs, largePtsUs);
     }
