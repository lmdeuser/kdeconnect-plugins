+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include <QTimer>
+
+#include <core/kdeconnectplugin.h>
+
+#include "generated/systeminterfaces/login1.h"
+#include "remoteauthmanager.h"
+
+#define PACKET_TYPE_REMOTEAUTH QStringLiteral("kdeconnect.remoteauth")
+#define PACKET_TYPE_REMOTEAUTH_REQUEST QStringLiteral("kdeconnect.remoteauth.request")
+
+class RemoteAuthPlugin : public KdeConnectPlugin
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.kde.kdeconnect.device.remoteauth")
+    Q_PROPERTY(bool unlockAllowed READ unlockAllowed WRITE setUnlockAllowed NOTIFY unlockAllowedChanged)
+
+public:
+    explicit RemoteAuthPlugin(QObject *parent, const QVariantList &args);
+
+    void receivePacket(const NetworkPacket &np) override;
+    QString dbusPath() const override;
+
+    Q_SCRIPTABLE QString requestApproval(const QString &summary, int ttlMs = RemoteAuth::kDefaultTtlMs);
+    Q_SCRIPTABLE QString requestSessionUnlock(const QString &summary);
+    Q_SCRIPTABLE bool unlockAllowed() const;
+    Q_SCRIPTABLE void setUnlockAllowed(bool allowed);
+
+Q_SIGNALS:
+    Q_SCRIPTABLE void challengeResolved(const QString &challengeId, bool approved, const QString &reason);
+    Q_SCRIPTABLE void unlockAllowedChanged(bool allowed);
+
+private Q_SLOTS:
+    void onPruneTick();
+
+private:
+    QString sendChallenge(const QString &purpose, const QString &summary, int ttlMs);
+
+    RemoteAuth::RemoteAuthManager m_manager;
+    OrgFreedesktopLogin1SessionInterface m_login1Interface;
+    QTimer m_pruneTimer;
+};
diff --git a/plugins/remote_auth/remoteauthtest.cpp b/plugins/remote_auth/remoteauthtest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6145abd873dd0ba4937f47ed85d8bcf208b20059
--- /dev/null
+++ b/plugins/remote_auth/remoteauthtest.cpp
@@ -0,0 +1,95 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "remoteauthmanager.h"
+
+#include <QtTest>
+
+class RemoteAuthTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void testValidApprovalAndReplayRejected()
+    {
+        RemoteAuth::RemoteAuthManager mgr;
+        const qint64 t0 = 1000000;
+        const auto created = mgr.createChallenge(QStringLiteral("confirm"), QStringLiteral("Authorize action"), t0, 30000);
+        QVERIFY(created.ok);
+        QCOMPARE(created.challenge.nonce.size(), RemoteAuth::kNonceBytes);
+
+        const auto first = mgr.evaluateResponse(created.challenge.challengeId, created.challenge.nonceBase64, true, false, t0 + 1000);
+        QCOMPARE(first.status, RemoteAuth::EvalStatus::Approved);
+        QCOMPARE(first.purpose, QStringLiteral("confirm"));
+
+        // Replay of the same challengeId/nonce must fail.
+        const auto replay = mgr.evaluateResponse(created.challenge.challengeId, created.challenge.nonceBase64, true, false, t0 + 1100);
+        QCOMPARE(replay.status, RemoteAuth::EvalStatus::UnknownChallenge);
+    }
+
+    void testExpiredAndForgedNonceRejected()
+    {
+        RemoteAuth::RemoteAuthManager mgr;
+        const qint64 t0 = 2000000;
+        const auto c1 = mgr.createChallenge(QStringLiteral("confirm"), QStringLiteral("Test expiry"), t0, 30000);
+        QVERIFY(c1.ok);
+
+        const auto expired = mgr.evaluateResponse(c1.challenge.challengeId, c1.challenge.nonceBase64, true, false, t0 + 30001);
+        QCOMPARE(expired.status, RemoteAuth::EvalStatus::Expired);
+
+        const auto c2 = mgr.createChallenge(QStringLiteral("confirm"), QStringLiteral("Test forged"), t0, 30000);
+        QVERIFY(c2.ok);
+        QByteArray badNonce(RemoteAuth::kNonceBytes, 'A');
+        const auto forged = mgr.evaluateResponse(c2.challenge.challengeId, QString::fromLatin1(badNonce.toBase64()), true, false, t0 + 500);
+        QCOMPARE(forged.status, RemoteAuth::EvalStatus::InvalidNonce);
+    }
+
+    void testDeniedAndUnlockOptInGate()
+    {
+        RemoteAuth::RemoteAuthManager mgr;
+        const qint64 t0 = 3000000;
+        const auto c1 = mgr.createChallenge(QStringLiteral("confirm"), QStringLiteral("Deny test"), t0);
+        QVERIFY(c1.ok);
+        const auto denied = mgr.evaluateResponse(c1.challenge.challengeId, c1.challenge.nonceBase64, false, false, t0 + 200);
+        QCOMPARE(denied.status, RemoteAuth::EvalStatus::Denied);
+
+        const auto c2 = mgr.createChallenge(QStringLiteral("unlock"), QStringLiteral("Unlock PC"), t0);
+        QVERIFY(c2.ok);
+        const auto blocked = mgr.evaluateResponse(c2.challenge.challengeId, c2.challenge.nonceBase64, true, false, t0 + 300);
+        QCOMPARE(blocked.status, RemoteAuth::EvalStatus::UnlockDisabled);
+
+        const auto c3 = mgr.createChallenge(QStringLiteral("unlock"), QStringLiteral("Unlock PC"), t0);
+        QVERIFY(c3.ok);
+        const auto allowed = mgr.evaluateResponse(c3.challenge.challengeId, c3.challenge.nonceBase64, true, true, t0 + 400);
+        QCOMPARE(allowed.status, RemoteAuth::EvalStatus::Approved);
+        QCOMPARE(allowed.purpose, QStringLiteral("unlock"));
+    }
+
+    void testRateLimitingAndSummarySanitization()
+    {
+        RemoteAuth::RemoteAuthManager mgr;
+        const qint64 t0 = 4000000;
+        for (int i = 0; i < RemoteAuth::kRateLimitMaxFailures; ++i) {
+            const auto r = mgr.evaluateResponse(QStringLiteral("missing-id"), QString(), false, false, t0 + i * 100);
+            QCOMPARE(r.status, RemoteAuth::EvalStatus::UnknownChallenge);
+        }
+
+        const auto limited = mgr.createChallenge(QStringLiteral("confirm"), QStringLiteral("Blocked"), t0 + 1000);
+        QVERIFY(!limited.ok);
+        QCOMPARE(limited.error, QStringLiteral("rate_limited"));
+
+        const auto recovered = mgr.createChallenge(
+            QStringLiteral("confirm"),
+            QString(300, QLatin1Char('X')) + QStringLiteral("\n\tsecret"),
+            t0 + RemoteAuth::kRateLimitWindowMs + 2000);
+        QVERIFY(recovered.ok);
+        QCOMPARE(recovered.challenge.summary.size(), RemoteAuth::kMaxSummaryLength);
+    }
+};
