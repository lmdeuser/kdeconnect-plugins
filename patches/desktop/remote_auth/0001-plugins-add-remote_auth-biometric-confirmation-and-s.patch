diff --git a/plugins/remote_auth/remoteauthmanager.cpp b/plugins/remote_auth/remoteauthmanager.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..eb3b0bc713671ead7759e0a14f4b74680d9735e6
--- /dev/null
+++ b/plugins/remote_auth/remoteauthmanager.cpp
@@ -0,0 +1,220 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "remoteauthmanager.h"
+
+#include <QRandomGenerator>
+
+#include <limits>
+
+namespace RemoteAuth
+{
+namespace
+{
+bool isValidPurpose(const QString &purpose)
+{
+    return purpose == QLatin1String("confirm") || purpose == QLatin1String("unlock");
+}
+
+bool constantTimeEqual32(const QByteArray &a, const QByteArray &b)
+{
+    if (a.size() != kNonceBytes || b.size() != kNonceBytes) {
+        return false;
+    }
+    quint8 diff = 0;
+    for (int i = 0; i < kNonceBytes; ++i) {
+        diff |= static_cast<quint8>(a.at(i)) ^ static_cast<quint8>(b.at(i));
+    }
+    return diff == 0;
+}
+
+QByteArray generateRandomBytes(int count)
+{
+    QByteArray out(count, Qt::Uninitialized);
+    QRandomGenerator *rng = QRandomGenerator::system();
+    for (int offset = 0; offset < count; offset += 4) {
+        const quint32 word = rng->generate();
+        const int take = qMin(4, count - offset);
+        for (int j = 0; j < take; ++j) {
+            out[offset + j] = static_cast<char>((word >> (j * 8)) & 0xFF);
+        }
+    }
+    return out;
+}
+}
+
+QString RemoteAuthManager::sanitizeSummary(const QString &raw, const QString &purpose)
+{
+    QString cleaned;
+    cleaned.reserve(qMin(raw.size(), kMaxSummaryLength));
+    for (const QChar ch : raw) {
+        if (ch.unicode() < 0x20 || ch.unicode() == 0x7F) {
+            cleaned.append(QLatin1Char(' '));
+        } else {
+            cleaned.append(ch);
+        }
+    }
+    cleaned = cleaned.simplified();
+    if (cleaned.size() > kMaxSummaryLength) {
+        cleaned.truncate(kMaxSummaryLength);
+    }
+    if (cleaned.isEmpty()) {
+        return purpose == QLatin1String("unlock")
+            ? QStringLiteral("Unlock desktop session")
+            : QStringLiteral("Confirm desktop operation");
+    }
+    return cleaned;
+}
+
+CreateResult RemoteAuthManager::createChallenge(const QString &purpose, const QString &summary, qint64 nowMs, int ttlMs)
+{
+    CreateResult result;
+    pruneExpired(nowMs);
+
+    if (isRateLimited(nowMs)) {
+        result.error = QStringLiteral("rate_limited");
+        return result;
+    }
+
+    if (!isValidPurpose(purpose)) {
+        result.error = QStringLiteral("invalid_purpose");
+        return result;
+    }
+
+    while (m_pending.size() >= kMaxPendingChallenges) {
+        QString oldestId;
+        qint64 oldestCreated = std::numeric_limits<qint64>::max();
+        for (auto it = m_pending.cbegin(); it != m_pending.cend(); ++it) {
+            if (it.value().createdAtMs < oldestCreated) {
+                oldestCreated = it.value().createdAtMs;
+                oldestId = it.key();
+            }
+        }
+        if (oldestId.isEmpty()) {
+            break;
+        }
+        m_pending.remove(oldestId);
+    }
+
+    const int boundedTtl = (ttlMs <= 0) ? kDefaultTtlMs : qBound(kMinTtlMs, ttlMs, kMaxTtlMs);
+    Challenge ch;
+    ch.challengeId = QString::fromLatin1(generateRandomBytes(16).toHex());
+    ch.nonce = generateRandomBytes(kNonceBytes);
+    ch.nonceBase64 = QString::fromLatin1(ch.nonce.toBase64());
+    ch.purpose = purpose;
+    ch.summary = sanitizeSummary(summary, purpose);
+    ch.createdAtMs = nowMs;
+    ch.expiresAtMs = nowMs + boundedTtl;
+    ch.ttlMs = boundedTtl;
+
+    m_pending.insert(ch.challengeId, ch);
+
+    result.ok = true;
+    result.challenge = ch;
+    return result;
+}
+
+EvalResult RemoteAuthManager::evaluateResponse(
+    const QString &challengeId,
+    const QString &nonceBase64,
+    bool approved,
+    bool unlockAllowed,
+    qint64 nowMs)
+{
+    EvalResult res;
+    if (challengeId.isEmpty() || challengeId.size() > 128) {
+        pruneExpired(nowMs);
+        recordFailure(nowMs);
+        res.status = EvalStatus::InvalidInput;
+        res.reason = QStringLiteral("invalid_input");
+        return res;
+    }
+
+    if (!m_pending.contains(challengeId)) {
+        pruneExpired(nowMs);
+        recordFailure(nowMs);
+        res.status = EvalStatus::UnknownChallenge;
+        res.reason = QStringLiteral("unknown_challenge");
+        return res;
+    }
+
+    const Challenge ch = m_pending.take(challengeId);
+    pruneExpired(nowMs);
+    res.purpose = ch.purpose;
+
+    if (nowMs > ch.expiresAtMs) {
+        recordFailure(nowMs);
+        res.status = EvalStatus::Expired;
+        res.reason = QStringLiteral("expired");
+        return res;
+    }
+
+    const auto decoded = QByteArray::fromBase64Encoding(nonceBase64.toLatin1(), QByteArray::AbortOnBase64DecodingErrors);
+    if (!decoded || !constantTimeEqual32(*decoded, ch.nonce)) {
+        recordFailure(nowMs);
+        res.status = EvalStatus::InvalidNonce;
+        res.reason = QStringLiteral("invalid_nonce");
+        return res;
+    }
+
+    if (!approved) {
+        recordFailure(nowMs);
+        res.status = EvalStatus::Denied;
+        res.reason = QStringLiteral("denied");
+        return res;
+    }
+
+    if (ch.purpose == QLatin1String("unlock") && !unlockAllowed) {
+        recordFailure(nowMs);
+        res.status = EvalStatus::UnlockDisabled;
+        res.reason = QStringLiteral("unlock_disabled");
+        return res;
+    }
+
+    res.status = EvalStatus::Approved;
+    res.reason = QStringLiteral("approved");
+    return res;
+}
+
+QStringList RemoteAuthManager::pruneExpired(qint64 nowMs)
+{
+    QStringList expiredIds;
+    for (auto it = m_pending.begin(); it != m_pending.end();) {
+        if (nowMs > it.value().expiresAtMs) {
+            expiredIds.append(it.key());
+            it = m_pending.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    return expiredIds;
+}
+
+bool RemoteAuthManager::isRateLimited(qint64 nowMs)
+{
+    pruneFailures(nowMs);
+    return m_failureTimestampsMs.size() >= kRateLimitMaxFailures;
+}
+
+int RemoteAuthManager::pendingCount() const
+{
+    return m_pending.size();
+}
+
+void RemoteAuthManager::recordFailure(qint64 nowMs)
+{
+    pruneFailures(nowMs);
+    m_failureTimestampsMs.append(nowMs);
+}
+
+void RemoteAuthManager::pruneFailures(qint64 nowMs)
+{
+    const qint64 cutoff = nowMs - kRateLimitWindowMs;
+    while (!m_failureTimestampsMs.isEmpty() && m_failureTimestampsMs.first() < cutoff) {
+        m_failureTimestampsMs.removeFirst();
+    }
+}
+}
diff --git a/plugins/remote_auth/remoteauthmanager.h b/plugins/remote_auth/remoteauthmanager.h
new file mode 100644
index 0000000000000000000000000000000000000000..263ab495234ffc2727d9524814f400266e90685d
--- /dev/null
+++ b/plugins/remote_auth/remoteauthmanager.h
@@ -0,0 +1,77 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include <QByteArray>
+#include <QHash>
+#include <QList>
+#include <QString>
+#include <QStringList>
+
+namespace RemoteAuth
+{
+inline constexpr int kDefaultTtlMs = 30000;
+inline constexpr int kMinTtlMs = 5000;
+inline constexpr int kMaxTtlMs = 60000;
+inline constexpr int kMaxPendingChallenges = 4;
+inline constexpr int kMaxSummaryLength = 240;
+inline constexpr qint64 kRateLimitWindowMs = 60000;
+inline constexpr int kRateLimitMaxFailures = 5;
+inline constexpr int kNonceBytes = 32;
+
+struct Challenge {
+    QString challengeId;
+    QByteArray nonce;
+    QString nonceBase64;
+    QString purpose;
+    QString summary;
+    qint64 createdAtMs = 0;
+    qint64 expiresAtMs = 0;
+    int ttlMs = kDefaultTtlMs;
+};
+
+struct CreateResult {
+    bool ok = false;
+    Challenge challenge;
+    QString error;
+};
+
+enum class EvalStatus {
+    Approved,
+    Denied,
+    Expired,
+    UnknownChallenge,
+    InvalidNonce,
+    UnlockDisabled,
+    InvalidInput,
+};
+
+struct EvalResult {
+    EvalStatus status = EvalStatus::InvalidInput;
+    QString purpose;
+    QString reason;
+};
+
+class RemoteAuthManager
+{
+public:
+    static QString sanitizeSummary(const QString &raw, const QString &purpose);
+
+    CreateResult createChallenge(const QString &purpose, const QString &summary, qint64 nowMs, int ttlMs = kDefaultTtlMs);
+    EvalResult evaluateResponse(const QString &challengeId, const QString &nonceBase64, bool approved, bool unlockAllowed, qint64 nowMs);
+    QStringList pruneExpired(qint64 nowMs);
+    bool isRateLimited(qint64 nowMs);
+    int pendingCount() const;
+
+private:
+    void recordFailure(qint64 nowMs);
+    void pruneFailures(qint64 nowMs);
+
+    QHash<QString, Challenge> m_pending;
+    QList<qint64> m_failureTimestampsMs;
+};
+}
diff --git a/plugins/remote_auth/remoteauthplugin.cpp b/plugins/remote_auth/remoteauthplugin.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2f2f3a074755526006973e5e789b04091e263232
--- /dev/null
+++ b/plugins/remote_auth/remoteauthplugin.cpp
@@ -0,0 +1,126 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "remoteauthplugin.h"
+
+#include "plugin_remoteauth_debug.h"
+
+#include <KPluginFactory>
+#include <QDateTime>
+
+K_PLUGIN_CLASS_WITH_JSON(RemoteAuthPlugin, "kdeconnect_remoteauth.json")
+
+RemoteAuthPlugin::RemoteAuthPlugin(QObject *parent, const QVariantList &args)
+    : KdeConnectPlugin(parent, args)
+    , m_login1Interface(QStringLiteral("org.freedesktop.login1"), QStringLiteral("/org/freedesktop/login1/session/auto"), QDBusConnection::systemBus())
+{
+    m_pruneTimer.setInterval(1000);
+    connect(&m_pruneTimer, &QTimer::timeout, this, &RemoteAuthPlugin::onPruneTick);
+}
+
+QString RemoteAuthPlugin::dbusPath() const
+{
+    return QLatin1String("/modules/kdeconnect/devices/%1/remoteauth").arg(device()->id());
+}
+
+bool RemoteAuthPlugin::unlockAllowed() const
+{
+    return config()->getBool(QStringLiteral("unlockAllowed"), false);
+}
+
+void RemoteAuthPlugin::setUnlockAllowed(bool allowed)
+{
+    config()->set(QStringLiteral("unlockAllowed"), allowed);
+    Q_EMIT unlockAllowedChanged(allowed);
+}
+
+QString RemoteAuthPlugin::requestApproval(const QString &summary, int ttlMs)
+{
+    return sendChallenge(QStringLiteral("confirm"), summary, ttlMs);
+}
+
+QString RemoteAuthPlugin::requestSessionUnlock(const QString &summary)
+{
+    if (!unlockAllowed()) {
+        qCWarning(KDECONNECT_PLUGIN_REMOTEAUTH) << "Session unlock request rejected because unlockAllowed is disabled";
+        return {};
+    }
+    return sendChallenge(QStringLiteral("unlock"), summary, RemoteAuth::kDefaultTtlMs);
+}
+
+QString RemoteAuthPlugin::sendChallenge(const QString &purpose, const QString &summary, int ttlMs)
+{
+    const auto caps = device()->incomingCapabilities();
+    if (!caps.isEmpty() && !caps.contains(PACKET_TYPE_REMOTEAUTH_REQUEST)) {
+        qCDebug(KDECONNECT_PLUGIN_REMOTEAUTH) << "Remote peer does not advertise" << PACKET_TYPE_REMOTEAUTH_REQUEST;
+        return {};
+    }
+
+    const qint64 nowMs = QDateTime::currentMSecsSinceEpoch();
+    const RemoteAuth::CreateResult created = m_manager.createChallenge(purpose, summary, nowMs, ttlMs);
+    if (!created.ok) {
+        qCWarning(KDECONNECT_PLUGIN_REMOTEAUTH) << "Failed to create challenge:" << created.error;
+        return {};
+    }
+
+    NetworkPacket np(PACKET_TYPE_REMOTEAUTH_REQUEST);
+    np.set(QStringLiteral("challengeId"), created.challenge.challengeId);
+    np.set(QStringLiteral("nonce"), created.challenge.nonceBase64);
+    np.set(QStringLiteral("purpose"), created.challenge.purpose);
+    np.set(QStringLiteral("summary"), created.challenge.summary);
+    np.set(QStringLiteral("ttlMs"), created.challenge.ttlMs);
+    if (!sendPacket(np)) {
+        return {};
+    }
+
+    if (!m_pruneTimer.isActive()) {
+        m_pruneTimer.start();
+    }
+    return created.challenge.challengeId;
+}
+
+void RemoteAuthPlugin::receivePacket(const NetworkPacket &np)
+{
+    if (np.type() != PACKET_TYPE_REMOTEAUTH) {
+        return;
+    }
+
+    const QString challengeId = np.get<QString>(QStringLiteral("challengeId"));
+    const QString nonceBase64 = np.get<QString>(QStringLiteral("nonce"));
+    const bool approved = np.get<bool>(QStringLiteral("approved"), false);
+    const QString authType = np.get<QString>(QStringLiteral("authType"));
+    const qint64 nowMs = QDateTime::currentMSecsSinceEpoch();
+
+    const RemoteAuth::EvalResult res = m_manager.evaluateResponse(challengeId, nonceBase64, approved, unlockAllowed(), nowMs);
+    if (m_manager.pendingCount() == 0 && m_pruneTimer.isActive()) {
+        m_pruneTimer.stop();
+    }
+
+    if (res.status == RemoteAuth::EvalStatus::Approved) {
+        qCDebug(KDECONNECT_PLUGIN_REMOTEAUTH) << "Approved remoteauth challenge" << challengeId << "purpose" << res.purpose << "authType" << authType;
+        if (res.purpose == QLatin1String("unlock") && unlockAllowed()) {
+            m_login1Interface.Unlock();
+        }
+        Q_EMIT challengeResolved(challengeId, true, res.reason);
+    } else {
+        qCWarning(KDECONNECT_PLUGIN_REMOTEAUTH) << "Rejected remoteauth challenge" << challengeId << "reason" << res.reason;
+        Q_EMIT challengeResolved(challengeId, false, res.reason);
+    }
+}
+
+void RemoteAuthPlugin::onPruneTick()
+{
+    const QStringList expired = m_manager.pruneExpired(QDateTime::currentMSecsSinceEpoch());
+    for (const QString &id : expired) {
+        Q_EMIT challengeResolved(id, false, QStringLiteral("expired"));
+    }
+    if (m_manager.pendingCount() == 0) {
+        m_pruneTimer.stop();
+    }
+}
+
+#include "moc_remoteauthplugin.cpp"
+#include "remoteauthplugin.moc"
