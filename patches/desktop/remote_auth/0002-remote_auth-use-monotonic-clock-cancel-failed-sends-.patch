diff --git a/plugins/remote_auth/remoteauthtest.cpp b/plugins/remote_auth/remoteauthtest.cpp
index 6145abd873dd0ba4937f47ed85d8bcf208b20059..c48a07a1019cc40a78bab4226a25320b0b71001e 100644
--- a/plugins/remote_auth/remoteauthtest.cpp
+++ b/plugins/remote_auth/remoteauthtest.cpp
@@ -88,6 +88,44 @@ private Q_SLOTS:
         QVERIFY(recovered.ok);
         QCOMPARE(recovered.challenge.summary.size(), RemoteAuth::kMaxSummaryLength);
     }
+
+    void testCancelEvictionMonotonicAndBoundedFailures()
+    {
+        RemoteAuth::RemoteAuthManager mgr;
+        const qint64 t0 = 5000000;
+        const auto cCancel = mgr.createChallenge(QStringLiteral("confirm"), QStringLiteral("Offline fail"), t0, 30000);
+        QVERIFY(cCancel.ok);
+        QCOMPARE(mgr.pendingCount(), 1);
+        QVERIFY(mgr.cancelChallenge(cCancel.challenge.challengeId));
+        QCOMPARE(mgr.pendingCount(), 0);
+        QVERIFY(!mgr.cancelChallenge(cCancel.challenge.challengeId));
+
+        QList<QString> ids;
+        for (int i = 0; i < RemoteAuth::kMaxPendingChallenges + 1; ++i) {
+            const auto created = mgr.createChallenge(QStringLiteral("confirm"), QStringLiteral("Queue %1").arg(i), t0 + i * 10, 30000);
+            QVERIFY(created.ok);
+            ids.append(created.challenge.challengeId);
+            if (i < RemoteAuth::kMaxPendingChallenges) {
+                QVERIFY(created.evictedIds.isEmpty());
+            } else {
+                QCOMPARE(created.evictedIds, QStringList({ids.first()}));
+            }
+        }
+        QCOMPARE(mgr.pendingCount(), RemoteAuth::kMaxPendingChallenges);
+
+        // Defensively reject evaluation if monotonic nowMs appears before createdAtMs.
+        const auto cTime = mgr.createChallenge(QStringLiteral("confirm"), QStringLiteral("Time check"), t0 + 500, 30000);
+        QVERIFY(cTime.ok);
+        const auto backStep = mgr.evaluateResponse(cTime.challenge.challengeId, cTime.challenge.nonceBase64, true, false, t0 + 100);
+        QCOMPARE(backStep.status, RemoteAuth::EvalStatus::Expired);
+
+        // Flood invalid failures beyond kRateLimitMaxFailures * 2 and verify recovery after window still works cleanly.
+        for (int i = 0; i < RemoteAuth::kRateLimitMaxFailures * 4; ++i) {
+            mgr.evaluateResponse(QStringLiteral("bad"), QString(), false, false, t0 + 1000 + i);
+        }
+        QVERIFY(mgr.isRateLimited(t0 + 2000));
+        QVERIFY(!mgr.isRateLimited(t0 + 2000 + RemoteAuth::kRateLimitWindowMs + 100));
+    }
 };
 
 QTEST_MAIN(RemoteAuthTest)
