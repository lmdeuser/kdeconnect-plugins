Subject: [PATCH 2/2] remote_auth: use monotonic clock, cancel failed sends,
 emit evictions


diff --git a/plugins/remote_auth/remoteauthmanager.cpp b/plugins/remote_auth/remoteauthmanager.cpp
index eb3b0bc713671ead7759e0a14f4b74680d9735e6..bb3c1c019dca0d8814a4167ec48de750fd12c2b1 100644
--- a/plugins/remote_auth/remoteauthmanager.cpp
+++ b/plugins/remote_auth/remoteauthmanager.cpp
@@ -97,6 +97,7 @@ CreateResult RemoteAuthManager::createChallenge(const QString &purpose, const QS
             break;
         }
         m_pending.remove(oldestId);
+        result.evictedIds.append(oldestId);
     }
 
     const int boundedTtl = (ttlMs <= 0) ? kDefaultTtlMs : qBound(kMinTtlMs, ttlMs, kMaxTtlMs);
@@ -117,6 +118,11 @@ CreateResult RemoteAuthManager::createChallenge(const QString &purpose, const QS
     return result;
 }
 
+bool RemoteAuthManager::cancelChallenge(const QString &challengeId)
+{
+    return m_pending.remove(challengeId) > 0;
+}
+
 EvalResult RemoteAuthManager::evaluateResponse(
     const QString &challengeId,
     const QString &nonceBase64,
@@ -145,7 +151,7 @@ EvalResult RemoteAuthManager::evaluateResponse(
     pruneExpired(nowMs);
     res.purpose = ch.purpose;
 
-    if (nowMs > ch.expiresAtMs) {
+    if (nowMs < ch.createdAtMs || nowMs > ch.expiresAtMs) {
         recordFailure(nowMs);
         res.status = EvalStatus::Expired;
         res.reason = QStringLiteral("expired");
@@ -183,7 +189,7 @@ QStringList RemoteAuthManager::pruneExpired(qint64 nowMs)
 {
     QStringList expiredIds;
     for (auto it = m_pending.begin(); it != m_pending.end();) {
-        if (nowMs > it.value().expiresAtMs) {
+        if (nowMs < it.value().createdAtMs || nowMs > it.value().expiresAtMs) {
             expiredIds.append(it.key());
             it = m_pending.erase(it);
         } else {
@@ -207,6 +213,9 @@ int RemoteAuthManager::pendingCount() const
 void RemoteAuthManager::recordFailure(qint64 nowMs)
 {
     pruneFailures(nowMs);
+    while (m_failureTimestampsMs.size() >= kRateLimitMaxFailures * 2) {
+        m_failureTimestampsMs.removeFirst();
+    }
     m_failureTimestampsMs.append(nowMs);
 }
 
