+
+namespace OtpCodeExtractor
+{
+QString extractFromAction(const QString &action)
+{
+    if (action.isEmpty() || action.size() > MAX_ACTION_LENGTH) {
+        return {};
+    }
+
+    QString sanitized = action;
+    sanitized.remove(QChar(0x2063));
+
+    static const QRegularExpression actionCodeRegex(QStringLiteral("\\b(\\d{4,10})\\b"));
+    const QRegularExpressionMatch match = actionCodeRegex.match(sanitized);
+    return match.hasMatch() ? match.captured(1) : QString();
+}
+
+QString extractFromNotification(const QString &title, const QString &text, const QStringList &actions)
+{
+    if (title.size() > MAX_TITLE_LENGTH || text.size() > MAX_TEXT_LENGTH || actions.size() > MAX_ACTIONS_COUNT) {
+        return {};
+    }
+
+    for (const QString &action : actions) {
+        const QString code = extractFromAction(action);
+        if (!code.isEmpty()) {
+            return code;
+        }
+    }
+
+    QString cleanTitle = title;
+    cleanTitle.remove(QChar(0x2063));
+    QString cleanText = text;
+    cleanText.remove(QChar(0x2063));
+
+    static const QRegularExpression brSplitRegex(QStringLiteral("<br\\s*/?>"), QRegularExpression::CaseInsensitiveOption);
+    static const QRegularExpression boldSenderRegex(
+        QStringLiteral("<b>.*?</b>\\s*"),
+        QRegularExpression::CaseInsensitiveOption | QRegularExpression::DotMatchesEverythingOption);
+
+    const QStringList rawSegments = cleanText.split(brSplitRegex, Qt::SkipEmptyParts);
+    for (qsizetype i = rawSegments.size() - 1; i >= 0; --i) {
+        QString seg = rawSegments.at(i);
+        seg.remove(boldSenderRegex);
+        const bool segmentHasContext = hasOtpKeywordContext(seg)
+            || (rawSegments.size() == 1 && hasOtpKeywordContext(cleanTitle));
+        if (!segmentHasContext) {
+            continue;
+        }
+        const QString candidate = findFirstCodeCandidate(seg);
+        if (!candidate.isEmpty()) {
+            return candidate;
+        }
+    }
+
+    if (hasOtpKeywordContext(cleanTitle)) {
+        return findFirstCodeCandidate(cleanTitle);
+    }
+
+    return {};
+}
+}
