+namespace
+{
+void writeOtpToClipboard(const QString &code, bool markSecret)
+{
+    auto mimeData = new QMimeData;
+    mimeData->setText(code);
+    if (markSecret) {
+        mimeData->setData(QStringLiteral("x-kde-passwordManagerHint"), QByteArrayLiteral("secret"));
+    }
+    KSystemClipboard::instance()->setMimeData(mimeData, QClipboard::Clipboard);
+}
+}
+
 void NotificationsPlugin::copyAuthCodeIfPresent(const QString &action)
 {
-    // The auth code we receive has invisible characters in it for some reason.
-    // (U+2063 INVISIBLE SEPARATOR between each digit).
-    // Remove them if present before continuing.
-    QString sanitizedAction = action;
-    sanitizedAction.remove(QChar(0x2063));
+    const QString text = OtpCodeExtractor::extractFromAction(action);
+    if (text.isEmpty()) {
+        return;
+    }
+
+    writeOtpToClipboard(text, false);
+}
 
-    // Match blocks of digits, 4-10 digits long. This should match auth codes
-    // in any language without relying on the action text having a specific
-    // keyword in it such as "Copy" in English.
-    QRegularExpression authCodeRegex(QStringLiteral("\\b(\\d{4,10})\\b"));
-    QRegularExpressionMatch match = authCodeRegex.match(sanitizedAction);
+void NotificationsPlugin::maybeAutoCopyAuthCode(Notification *noti)
+{
+    if (!noti || noti->silent() || !config()->getBool(QStringLiteral("autoCopyAuthCode"), true)) {
+        return;
+    }
 
-    if (!match.hasMatch()) {
+    const QString code = OtpCodeExtractor::extractFromNotification(noti->title(), noti->text(), noti->actions());
+    if (code.isEmpty()) {
+        return;
+    }
+    if (m_lastAutoCopiedNotificationId == noti->internalId() && m_lastAutoCopiedCode == code) {
         return;
     }
 
-    QString text = match.captured(1);
-    auto mimeData = new QMimeData;
-    mimeData->setText(text);
-    KSystemClipboard::instance()->setMimeData(mimeData, QClipboard::Clipboard);
+    m_lastAutoCopiedNotificationId = noti->internalId();
+    m_lastAutoCopiedCode = code;
+    writeOtpToClipboard(code, true);
+
+    QPointer<NotificationsPlugin> guard(this);
+    QTimer::singleShot(60000, this, [guard, code] {
+        if (!guard) {
+            return;
+        }
+        if (KSystemClipboard::instance()->text(QClipboard::Clipboard) == code) {
+            KSystemClipboard::instance()->clear(QClipboard::Clipboard);
+        }
+    });
 }
 
 QString NotificationsPlugin::newId()
