diff --git a/plugins/notifications/otpcodeextractor.cpp b/plugins/notifications/otpcodeextractor.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..94926275361685b51cb1f81a77b66fdd746985e2
--- /dev/null
+++ b/plugins/notifications/otpcodeextractor.cpp
@@ -0,0 +1,209 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "otpcodeextractor.h"
+
+#include <QList>
+#include <QPair>
+#include <QRegularExpression>
+
+namespace
+{
+constexpr int MAX_ACTION_LENGTH = 256;
+constexpr int MAX_TITLE_LENGTH = 512;
+constexpr int MAX_TEXT_LENGTH = 4096;
+constexpr int MAX_ACTIONS_COUNT = 16;
+
+bool isCurrencyChar(QChar ch)
+{
+    return ch == QLatin1Char('$') || ch == QChar(0x20BD) || ch == QChar(0x20AC) || ch == QChar(0x00A3);
+}
+
+bool hasCurrencyPrefix(const QString &text, int start)
+{
+    if (start <= 0) {
+        return false;
+    }
+    const QString before = text.mid(qMax(0, start - 10), start - qMax(0, start - 10)).trimmed().toLower();
+    if (before.isEmpty()) {
+        return false;
+    }
+    if (isCurrencyChar(before.back())) {
+        return true;
+    }
+    static const QRegularExpression prefixRegex(
+        QStringLiteral("(?:^|[^\\p{L}])(?:rub|usd|eur|gbp|rur|kzt|\u0440\u0443\u0431)\\.?$"),
+        QRegularExpression::CaseInsensitiveOption | QRegularExpression::UseUnicodePropertiesOption);
+    return prefixRegex.match(before).hasMatch();
+}
+
+bool hasCurrencySuffix(const QString &text, int end)
+{
+    if (end >= text.size()) {
+        return false;
+    }
+    const QString after = text.mid(end, qMin(10, text.size() - end)).trimmed().toLower();
+    if (after.isEmpty()) {
+        return false;
+    }
+    if (isCurrencyChar(after.front())) {
+        return true;
+    }
+    static const QRegularExpression suffixRegex(
+        QStringLiteral("^(?:rub|usd|eur|gbp|rur|kzt|\u0440\u0443\u0431)(?:$|[^\\p{L}])"),
+        QRegularExpression::CaseInsensitiveOption | QRegularExpression::UseUnicodePropertiesOption);
+    if (suffixRegex.match(after).hasMatch()) {
+        return true;
+    }
+    return after == QStringLiteral("\u0440") || after.startsWith(QStringLiteral("\u0440."))
+        || after.startsWith(QStringLiteral("\u0440 ")) || after.startsWith(QStringLiteral("\u0440,"));
+}
+
+QList<QPair<int, int>> findPhoneSpans(const QString &text)
+{
+    static const QRegularExpression phoneRegex(QStringLiteral("\\+\\d[\\d\\s()-]{6,20}\\d"));
+    QList<QPair<int, int>> spans;
+    QRegularExpressionMatchIterator it = phoneRegex.globalMatch(text);
+    while (it.hasNext()) {
+        const QRegularExpressionMatch match = it.next();
+        spans.append({static_cast<int>(match.capturedStart()), static_cast<int>(match.capturedEnd())});
+    }
+    return spans;
+}
+
+bool overlapsAnySpan(int start, int end, const QList<QPair<int, int>> &spans)
+{
+    for (const auto &span : spans) {
+        if (start < span.second && end > span.first) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool hasOtpKeywordContext(const QString &text)
+{
+    static const QRegularExpression enKeywordRegex(
+        QStringLiteral("\\b(?:code|otp|verification|verify|passcode|2fa|one[- ]time|mfa|pin|auth(?:enticator|entication|orize|orized|orization)?)\\b"),
+        QRegularExpression::CaseInsensitiveOption | QRegularExpression::UseUnicodePropertiesOption);
+    if (enKeywordRegex.match(text).hasMatch()) {
+        return true;
+    }
+
+    static const QRegularExpression ruKeywordRegex(
+        QStringLiteral("(?:^|[^\\p{L}])(?:\u043a\u043e\u0434|\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434|\u043f\u0440\u043e\u0432\u0435\u0440\u043e\u0447\u043d|\u043e\u0434\u043d\u043e\u0440\u0430\u0437\u043e\u0432|\u043f\u0430\u0440\u043e\u043b)"),
+        QRegularExpression::CaseInsensitiveOption | QRegularExpression::UseUnicodePropertiesOption);
+    return ruKeywordRegex.match(text).hasMatch();
+}
+}
+
+namespace OtpCodeExtractor
+{
+QString extractFromAction(const QString &action)
+{
+    if (action.isEmpty() || action.size() > MAX_ACTION_LENGTH) {
+        return {};
+    }
+
+    QString sanitized = action;
+    sanitized.remove(QChar(0x2063));
+
+    static const QRegularExpression actionCodeRegex(QStringLiteral("\\b(\\d{4,10})\\b"));
+    const QRegularExpressionMatch match = actionCodeRegex.match(sanitized);
+    return match.hasMatch() ? match.captured(1) : QString();
+}
+
+QString extractFromNotification(const QString &title, const QString &text, const QStringList &actions)
+{
+    if (title.size() > MAX_TITLE_LENGTH || text.size() > MAX_TEXT_LENGTH || actions.size() > MAX_ACTIONS_COUNT) {
+        return {};
+    }
+
+    for (const QString &action : actions) {
+        const QString code = extractFromAction(action);
+        if (!code.isEmpty()) {
+            return code;
+        }
+    }
+
+    QString cleanTitle = title;
+    cleanTitle.remove(QChar(0x2063));
+    QString cleanText = text;
+    cleanText.remove(QChar(0x2063));
+
+    const QString combined = cleanTitle + QLatin1Char('\n') + cleanText;
+    if (!hasOtpKeywordContext(combined)) {
+        return {};
+    }
+
+    const QList<QPair<int, int>> phoneSpans = findPhoneSpans(combined);
+    static const QRegularExpression candidateRegex(QStringLiteral("(\\d{3}[-\\s]\\d{3}|\\d{4,8})"));
+    QRegularExpressionMatchIterator it = candidateRegex.globalMatch(combined);
+
+    while (it.hasNext()) {
+        const QRegularExpressionMatch match = it.next();
+        const int start = static_cast<int>(match.capturedStart(1));
+        const int end = static_cast<int>(match.capturedEnd(1));
+
+        if (overlapsAnySpan(start, end, phoneSpans)) {
+            continue;
+        }
+
+        if (start > 0) {
+            const QChar prev = combined.at(start - 1);
+            if (prev.isDigit() || prev.isLetter() || prev == QLatin1Char('+') || isCurrencyChar(prev)) {
+                continue;
+            }
+            if ((prev == QLatin1Char('-') || prev == QLatin1Char('.') || prev == QLatin1Char(','))
+                && start >= 2 && combined.at(start - 2).isDigit()) {
+                continue;
+            }
+        }
+        if (hasCurrencyPrefix(combined, start)) {
+            continue;
+        }
+
+        if (end < combined.size()) {
+            const QChar next = combined.at(end);
+            if (next.isDigit() || next.isLetter() || next == QLatin1Char('%')) {
+                continue;
+            }
+            if ((next == QLatin1Char('-') || next == QLatin1Char('.') || next == QLatin1Char(','))
+                && end + 1 < combined.size() && combined.at(end + 1).isDigit()) {
+                continue;
+            }
+        }
+        if (hasCurrencySuffix(combined, end)) {
+            continue;
+        }
+
+        const QString raw = match.captured(1);
+        const bool hasSeparator = raw.contains(QLatin1Char('-')) || raw.contains(QLatin1Char(' '))
+            || raw.contains(QLatin1Char('\t'));
+        QString digits;
+        digits.reserve(raw.size());
+        for (QChar ch : raw) {
+            if (ch.isDigit()) {
+                digits.append(ch);
+            }
+        }
+
+        if (digits.size() < 4 || digits.size() > 8) {
+            continue;
+        }
+        if (!hasSeparator && digits.size() == 4) {
+            const int year = digits.toInt();
+            if (year >= 1990 && year <= 2039) {
+                continue;
+            }
+        }
+
+        return digits;
+    }
+
+    return {};
+}
+}
