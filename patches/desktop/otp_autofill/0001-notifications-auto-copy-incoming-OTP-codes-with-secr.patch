diff --git a/tests/otpextractortest.cpp b/tests/otpextractortest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..29cd021b371e66efaf40e1e42a86cfa202062b8e
--- /dev/null
+++ b/tests/otpextractortest.cpp
@@ -0,0 +1,77 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "../plugins/notifications/otpcodeextractor.h"
+
+#include <QtTest>
+
+class OtpExtractorTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void testExtractFromActionInvisibleSeparators()
+    {
+        const QString action = QStringLiteral("Copy \"6\u20637\u20631\u20637\u20633\u20633\"");
+        QCOMPARE(OtpCodeExtractor::extractFromAction(action), QStringLiteral("671733"));
+        QCOMPARE(OtpCodeExtractor::extractFromNotification(QStringLiteral("Messages"), QStringLiteral("Code incoming"), {action}),
+                 QStringLiteral("671733"));
+    }
+
+    void testEnglishAndGoogleFormats()
+    {
+        QCOMPARE(OtpCodeExtractor::extractFromNotification(QStringLiteral("Security Alert"), QStringLiteral("Your verification code is 482910.")),
+                 QStringLiteral("482910"));
+        QCOMPARE(OtpCodeExtractor::extractFromNotification(QStringLiteral("Messages"), QStringLiteral("G-123456 is your Google verification code.")),
+                 QStringLiteral("123456"));
+        QCOMPARE(OtpCodeExtractor::extractFromNotification(QStringLiteral("GitHub"), QStringLiteral("Use 2FA code 123-456 to sign in.")),
+                 QStringLiteral("123456"));
+    }
+
+    void testRussianOtpFormats()
+    {
+        QCOMPARE(OtpCodeExtractor::extractFromNotification(
+                     QStringLiteral("\u0411\u0430\u043d\u043a"),
+                     QStringLiteral("\u0412\u0430\u0448 \u043a\u043e\u0434 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f: 7391")),
+                 QStringLiteral("7391"));
+        QCOMPARE(OtpCodeExtractor::extractFromNotification(
+                     QStringLiteral("\u0421\u0435\u0440\u0432\u0438\u0441"),
+                     QStringLiteral("\u041e\u0434\u043d\u043e\u0440\u0430\u0437\u043e\u0432\u044b\u0439 \u043f\u0430\u0440\u043e\u043b\u044c: 849201")),
+                 QStringLiteral("849201"));
+    }
+
+    void testMixedCurrencyAndOtpSelectsOtp()
+    {
+        QCOMPARE(OtpCodeExtractor::extractFromNotification(QStringLiteral("Bank"), QStringLiteral("Verification: 1500 RUB, code 482910")),
+                 QStringLiteral("482910"));
+        QCOMPARE(OtpCodeExtractor::extractFromNotification(
+                     QStringLiteral("\u0411\u0430\u043d\u043a"),
+                     QStringLiteral("\u041a\u043e\u0434 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u043e\u043f\u043b\u0430\u0442\u044b 1500 \u0440\u0443\u0431.: 482910")),
+                 QStringLiteral("482910"));
+    }
+
+    void testRejectsFalsePositives()
+    {
+        QVERIFY(OtpCodeExtractor::extractFromNotification(QStringLiteral("Support"), QStringLiteral("Verification from +79991234567")).isEmpty());
+        QVERIFY(OtpCodeExtractor::extractFromNotification(QStringLiteral("Support"), QStringLiteral("Verification from +7 999 123 4567")).isEmpty());
+        QVERIFY(OtpCodeExtractor::extractFromNotification(QStringLiteral("Bank"), QStringLiteral("Verify purchase 1500 RUB")).isEmpty());
+        QVERIFY(OtpCodeExtractor::extractFromNotification(QStringLiteral("Bank"), QStringLiteral("Verify charge $4500")).isEmpty());
+        QVERIFY(OtpCodeExtractor::extractFromNotification(QStringLiteral("Notice"), QStringLiteral("Verification policy updated for 2026")).isEmpty());
+        QVERIFY(OtpCodeExtractor::extractFromNotification(QStringLiteral("Shop"), QStringLiteral("Order 482910 shipped")).isEmpty());
+    }
+
+    void testRejectsOversizedInputs()
+    {
+        const QString oversizedBody = QString(5000, QLatin1Char('a')) + QStringLiteral(" code 123456");
+        QVERIFY(OtpCodeExtractor::extractFromNotification(QStringLiteral("Alert"), oversizedBody).isEmpty());
+        const QString oversizedAction = QString(300, QLatin1Char('a')) + QStringLiteral(" 123456");
+        QVERIFY(OtpCodeExtractor::extractFromAction(oversizedAction).isEmpty());
+    }
+};
+
+QTEST_MAIN(OtpExtractorTest)
+
+#include "otpextractortest.moc"
