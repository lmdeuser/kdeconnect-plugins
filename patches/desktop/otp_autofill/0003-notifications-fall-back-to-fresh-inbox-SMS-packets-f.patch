 {
-    if (!noti || noti->silent() || !config()->getBool(QStringLiteral("autoCopyAuthCode"), true)) {
+    if (code.isEmpty()) {
         return;
     }
-
-    const QString code = OtpCodeExtractor::extractFromNotification(noti->title(), noti->text(), noti->actions());
-    if (code.isEmpty()) {
+    const qint64 nowMs = QDateTime::currentMSecsSinceEpoch();
+    if (!sourceKey.isEmpty() && m_lastAutoCopiedSourceKey == sourceKey && m_lastAutoCopiedCode == code) {
         return;
     }
-    if (m_lastAutoCopiedNotificationId == noti->internalId() && m_lastAutoCopiedCode == code) {
+    if (m_lastAutoCopiedCode == code && (nowMs - m_lastAutoCopiedEpochMs) >= 0 && (nowMs - m_lastAutoCopiedEpochMs) <= 15000) {
         return;
     }
 
-    m_lastAutoCopiedNotificationId = noti->internalId();
+    m_lastAutoCopiedSourceKey = sourceKey;
     m_lastAutoCopiedCode = code;
+    m_lastAutoCopiedEpochMs = nowMs;
