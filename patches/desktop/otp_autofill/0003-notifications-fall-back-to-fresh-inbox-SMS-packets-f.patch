     QPointer<NotificationsPlugin> guard(this);
@@ -252,6 +258,31 @@ void NotificationsPlugin::maybeAutoCopyAuthCode(Notification *noti)
     });
 }
 
+void NotificationsPlugin::maybeAutoCopyAuthCode(Notification *noti)
+{
+    if (!noti || noti->silent() || !config()->getBool(QStringLiteral("autoCopyAuthCode"), true)) {
+        return;
+    }
+
+    const QString code = OtpCodeExtractor::extractFromNotification(noti->title(), noti->text(), noti->actions());
+    if (!code.isEmpty()) {
+        commitAutoCopiedOtp(noti->internalId(), code);
+    }
+}
+
+void NotificationsPlugin::maybeAutoCopyAuthCodeFromSms(const NetworkPacket &np)
+{
+    if (!config()->getBool(QStringLiteral("autoCopyAuthCode"), true)) {
+        return;
+    }
+
+    const QVariantList messages = np.get<QVariantList>(QStringLiteral("messages"));
+    const QString code = OtpCodeExtractor::extractFromSmsBatch(messages, QDateTime::currentMSecsSinceEpoch());
+    if (!code.isEmpty()) {
+        commitAutoCopiedOtp(QStringLiteral("sms:") + code, code);
+    }
+}
+
 QString NotificationsPlugin::newId()
 {
     return QString::number(++m_lastId);
