diff --git a/plugins/notifications/otpcodeextractor.cpp b/plugins/notifications/otpcodeextractor.cpp
index cc0a0858d2bb1f24be07efbe5a048396be6f1e6a..94ef05feb84f57b4bf9aeee35d2d547fadbf5273 100644
--- a/plugins/notifications/otpcodeextractor.cpp
+++ b/plugins/notifications/otpcodeextractor.cpp
@@ -9,6 +9,7 @@
 #include <QList>
 #include <QPair>
 #include <QRegularExpression>
+#include <QVariantMap>
 
 namespace
 {
@@ -16,6 +17,9 @@ constexpr int MAX_ACTION_LENGTH = 256;
 constexpr int MAX_TITLE_LENGTH = 512;
 constexpr int MAX_TEXT_LENGTH = 4096;
 constexpr int MAX_ACTIONS_COUNT = 16;
+constexpr qsizetype MAX_SMS_BATCH_FOR_OTP = 16;
+constexpr int SMS_MESSAGE_TYPE_INBOX = 1;
+constexpr qint64 SMS_FRESHNESS_WINDOW_MS = 120000;
 
 bool isCurrencyChar(QChar ch)
 {
@@ -230,4 +234,49 @@ QString extractFromNotification(const QString &title, const QString &text, const
 
     return {};
 }
+
+QString extractFromSmsBatch(const QVariantList &messages, qint64 nowEpochMs)
+{
+    if (messages.isEmpty() || messages.size() > MAX_SMS_BATCH_FOR_OTP) {
+        return {};
+    }
+
+    QString newestCode;
+    qint64 newestTimestamp = -1;
+
+    for (const QVariant &entry : messages) {
+        const QVariantMap msg = entry.toMap();
+        if (msg.value(QStringLiteral("type")).toInt() != SMS_MESSAGE_TYPE_INBOX) {
+            continue;
+        }
+
+        bool dateOk = false;
+        const qint64 msgDateMs = msg.value(QStringLiteral("date")).toLongLong(&dateOk);
+        if (!dateOk || msgDateMs <= 0) {
+            continue;
+        }
+        if (nowEpochMs > 0 && qAbs(nowEpochMs - msgDateMs) > SMS_FRESHNESS_WINDOW_MS) {
+            continue;
+        }
+
+        const QString body = msg.value(QStringLiteral("body")).toString();
+        if (body.isEmpty()) {
+            continue;
+        }
+
+        QString sender;
+        const QVariantList addresses = msg.value(QStringLiteral("addresses")).toList();
+        if (!addresses.isEmpty()) {
+            sender = addresses.constFirst().toMap().value(QStringLiteral("address")).toString();
+        }
+
+        const QString candidate = extractFromNotification(sender, body, {});
+        if (!candidate.isEmpty() && msgDateMs >= newestTimestamp) {
+            newestTimestamp = msgDateMs;
+            newestCode = candidate;
+        }
+    }
+
+    return newestCode;
+}
 }
