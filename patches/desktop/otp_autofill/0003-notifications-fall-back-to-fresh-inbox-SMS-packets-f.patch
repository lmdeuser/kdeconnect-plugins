diff --git a/tests/otpextractortest.cpp b/tests/otpextractortest.cpp
index 04a1623382b6a99acb2b745cbf8d048e072a31a3..16a2b7f7b1e394a3cc2ea1439437d1d6208de38a 100644
--- a/tests/otpextractortest.cpp
+++ b/tests/otpextractortest.cpp
@@ -89,6 +89,42 @@ private Q_SLOTS:
         const QString oversizedAction = QString(300, QLatin1Char('a')) + QStringLiteral(" 123456");
         QVERIFY(OtpCodeExtractor::extractFromAction(oversizedAction).isEmpty());
     }
+
+    void testSmsBatchFallbackAndGuards()
+    {
+        const qint64 nowMs = 1763550000000LL;
+        auto makeMsg = [](const QString &addr, const QString &body, qint64 dateMs, int type) -> QVariantMap {
+            return {
+                {QStringLiteral("body"), body},
+                {QStringLiteral("date"), dateMs},
+                {QStringLiteral("type"), type},
+                {QStringLiteral("addresses"), QVariantList{QVariantMap{{QStringLiteral("address"), addr}}}},
+            };
+        };
+
+        // Android 15 redacted notification yields nothing, while fresh inbox SMS extracts OTP.
+        QVERIFY(OtpCodeExtractor::extractFromNotification(QStringLiteral("Messages"), QStringLiteral("Sensitive notification content hidden"), {}).isEmpty());
+
+        const QVariantList enBatch = {makeMsg(QStringLiteral("32665"), QStringLiteral("Your verification code is 582941."), nowMs - 2000, 1)};
+        QCOMPARE(OtpCodeExtractor::extractFromSmsBatch(enBatch, nowMs), QStringLiteral("582941"));
+
+        const QVariantList ruBatch = {makeMsg(QStringLiteral("Bank"), QStringLiteral("\u041a\u043e\u0434 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f: 739104"), nowMs - 1000, 1)};
+        QCOMPARE(OtpCodeExtractor::extractFromSmsBatch(ruBatch, nowMs), QStringLiteral("739104"));
+
+        // Rejects outgoing (type == 2) and stale (> 120 s) messages.
+        const QVariantList sentOnly = {makeMsg(QStringLiteral("32665"), QStringLiteral("Your verification code is 111222."), nowMs - 1000, 2)};
+        QVERIFY(OtpCodeExtractor::extractFromSmsBatch(sentOnly, nowMs).isEmpty());
+
+        const QVariantList staleOnly = {makeMsg(QStringLiteral("32665"), QStringLiteral("Your verification code is 333444."), nowMs - 180000, 1)};
+        QVERIFY(OtpCodeExtractor::extractFromSmsBatch(staleOnly, nowMs).isEmpty());
+
+        // Rejects bulk conversation sync batches (> 16 messages).
+        QVariantList bulkBatch;
+        for (int i = 0; i < 17; ++i) {
+            bulkBatch.append(makeMsg(QStringLiteral("32665"), QStringLiteral("Your verification code is 582941."), nowMs - 1000, 1));
+        }
+        QVERIFY(OtpCodeExtractor::extractFromSmsBatch(bulkBatch, nowMs).isEmpty());
+    }
 };
 
 QTEST_MAIN(OtpExtractorTest)
