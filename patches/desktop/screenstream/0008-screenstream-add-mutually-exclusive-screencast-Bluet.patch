+void ScreenStreamPlugin::setAudioEnabled(bool enabled)
+{
+    if (m_sessionAudioEnabled != enabled) {
+        m_sessionAudioEnabled = enabled;
+        Q_EMIT audioEnabledChanged(enabled);
+    }
+
+    if (peerSupportsScreenStream() && active()) {
+        NetworkPacket np(PACKET_TYPE_SCREENSTREAM_REQUEST, ScreenStreamProtocol::buildSetAudioEnabledRequestBody(enabled));
+        sendPacket(np);
+    }
+
+    if (!enabled) {
+        m_audioAvailable = false;
+        m_audioReason = QStringLiteral("bluetooth_routed");
+        Q_EMIT audioStatusChanged(false, m_audioReason);
+    }
+}
