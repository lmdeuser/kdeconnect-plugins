@@ -299,6 +330,15 @@ void ScreenStreamPlugin::receivePacket(const NetworkPacket &np)
 
         m_audioAvailable = np.get<bool>(QStringLiteral("audioAvailable"), false);
         m_audioReason = np.get<QString>(QStringLiteral("audioReason"));
+        const bool nextAudioEnabled = m_audioAvailable
+            ? true
+            : ((m_audioReason == QLatin1String("bluetooth_routed") || m_audioReason == QLatin1String("disabled_by_user"))
+                   ? false
+                   : m_sessionAudioEnabled);
+        if (nextAudioEnabled != m_sessionAudioEnabled) {
+            m_sessionAudioEnabled = nextAudioEnabled;
+            Q_EMIT audioEnabledChanged(m_sessionAudioEnabled);
+        }
