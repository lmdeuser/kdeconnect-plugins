 }
 
+void ViewerWindow::onDbusHeadsetOwnerChanged(const QString &mac, const QString &owner, const QString &reason)
+{
+    Q_UNUSED(mac)
+    Q_UNUSED(reason)
+    if (m_closing) {
+        return;
+    }
+    if (owner == QLatin1String("remote") && !m_bluetoothAudioMode) {
+        m_bluetoothAudioMode = true;
+        if (m_audioRouteAction) {
+            const QSignalBlocker blocker(m_audioRouteAction);
+            m_audioRouteAction->setChecked(true);
+        }
+        if (m_audioPlayer) {
+            m_audioPlayer->setMuted(true);
+            m_audioPlayer->stop();
+        }
+        if (m_screenstreamIface && m_screenstreamIface->isValid()) {
+            m_screenstreamIface->asyncCall(QStringLiteral("setAudioEnabled"), false);
+        }
+        updateAudioRouteUi();
+        updateBannerAndInputGate();
+    }
+}
