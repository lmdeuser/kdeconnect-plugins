+void ViewerWindow::onAudioRouteToggled(bool bluetoothMode)
+{
+    m_bluetoothAudioMode = bluetoothMode;
+    updateAudioRouteUi();
+    updateBannerAndInputGate();
+
+    if (bluetoothMode) {
+        if (m_audioPlayer) {
+            m_audioPlayer->setMuted(true);
+            m_audioPlayer->stop();
+        }
+        if (m_screenstreamIface && m_screenstreamIface->isValid()) {
+            m_screenstreamIface->asyncCall(QStringLiteral("setAudioEnabled"), false);
+        }
+        if (m_btAudioSwitchIface && m_btAudioSwitchIface->isValid()) {
+            const QStringList macs = m_btAudioSwitchIface->property("allowedHeadsetMacs").toStringList();
+            for (const QString &mac : macs) {
+                m_btAudioSwitchIface->asyncCall(QStringLiteral("releaseHeadset"), mac);
+            }
+        }
+    } else {
+        if (m_audioPlayer) {
+            m_audioPlayer->setMuted(m_muteAction && m_muteAction->isChecked());
+        }
+        if (m_btAudioSwitchIface && m_btAudioSwitchIface->isValid()) {
+            const QStringList macs = m_btAudioSwitchIface->property("allowedHeadsetMacs").toStringList();
+            for (const QString &mac : macs) {
+                m_btAudioSwitchIface->asyncCall(QStringLiteral("claimHeadset"), mac, QStringLiteral("manual"));
+            }
+        }
+        if (m_screenstreamIface && m_screenstreamIface->isValid()) {
+            m_screenstreamIface->asyncCall(QStringLiteral("setAudioEnabled"), true);
+        }
+    }
+}
