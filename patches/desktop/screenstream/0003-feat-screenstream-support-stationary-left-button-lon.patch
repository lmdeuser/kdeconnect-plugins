 class QAction;
 class QCloseEvent;
 class QDBusInterface;
+class QFocusEvent;
 class QKeyEvent;
 class QLabel;
 class QLocalSocket;
 class QMouseEvent;
 class QPaintEvent;
+class QTimer;
 class QToolBar;
 class QWheelEvent;
 
@@ -68,15 +70,20 @@ protected:
     void mouseReleaseEvent(QMouseEvent *event) override;
     void wheelEvent(QWheelEvent *event) override;
     void keyPressEvent(QKeyEvent *event) override;
+    void focusOutEvent(QFocusEvent *event) override;
 
 private:
     std::optional<QPoint> mapEventPos(const QPointF &pos) const;
+    void cancelPendingOrActiveHold(bool emitRelease);
 
     QImage m_frame;
     QSize m_remoteDisplaySize;
     QPointF m_pressPos;
+    QPoint m_pressRemotePos;
+    QTimer *m_holdTimer = nullptr;
     bool m_leftButtonDown = false;
-    bool m_dragging = false;
+    bool m_holdActive = false;
+    bool m_dragMoved = false;
     bool m_inputEnabled = false;
