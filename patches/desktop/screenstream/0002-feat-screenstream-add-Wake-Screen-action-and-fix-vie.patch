+bool ScreenStreamPlugin::wakeScreen()
+{
+    if (!peerSupportsScreenStream()) {
+        setLastError(i18n("Screen streaming is not supported by this device."));
+        return false;
+    }
+    setLastError(QString());
+    NetworkPacket np(PACKET_TYPE_SCREENSTREAM_REQUEST, ScreenStreamProtocol::buildWakeRequestBody());
+    sendPacket(np);
+    return true;
+}
