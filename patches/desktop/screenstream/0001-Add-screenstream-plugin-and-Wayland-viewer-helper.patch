@@ -0,0 +1,285 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "gstvideodecoder.h"
+
+#include <QMetaObject>
+#include <QPointer>
+
+#include <atomic>
+#include <cstring>
+
+#include <gst/app/gstappsink.h>
+#include <gst/app/gstappsrc.h>
+#include <gst/gst.h>
+#include <gst/video/video.h>
+
+struct ScreenStreamVideoDecoder::Private {
+    ScreenStreamVideoDecoder *q = nullptr;
+    GstElement *pipeline = nullptr;
+    GstElement *appsrc = nullptr;
+    GstElement *videoconvert = nullptr;
+    GstElement *appsink = nullptr;
+    gulong decodebinPadSignal = 0;
+    GstElement *decodebin = nullptr;
+    std::atomic_bool alive{true};
+    bool initialized = false;
+
+    static void onDecodebinPadAdded(GstElement * /*src*/, GstPad *newPad, gpointer userData)
+    {
+        auto *self = static_cast<Private *>(userData);
+        if (!self || !self->alive.load() || !self->videoconvert) {
+            return;
+        }
+
+        GstPad *sinkPad = gst_element_get_static_pad(self->videoconvert, "sink");
+        if (!sinkPad) {
+            return;
+        }
+        if (gst_pad_is_linked(sinkPad)) {
+            gst_object_unref(sinkPad);
+            return;
+        }
+
+        GstCaps *caps = gst_pad_get_current_caps(newPad);
+        if (!caps) {
+            caps = gst_pad_query_caps(newPad, nullptr);
+        }
+        if (caps) {
+            const GstStructure *st = gst_caps_get_structure(caps, 0);
+            const char *name = st ? gst_structure_get_name(st) : nullptr;
+            if (name && g_str_has_prefix(name, "video/x-raw")) {
+                gst_pad_link(newPad, sinkPad);
+            }
+            gst_caps_unref(caps);
+        }
+        gst_object_unref(sinkPad);
+    }
+
+    static GstFlowReturn onNewSample(GstAppSink *sink, gpointer userData)
+    {
+        auto *self = static_cast<Private *>(userData);
+        if (!self || !self->alive.load()) {
+            return GST_FLOW_OK;
+        }
+
+        GstSample *sample = gst_app_sink_pull_sample(sink);
+        if (!sample) {
+            return GST_FLOW_OK;
+        }
+
+        GstCaps *caps = gst_sample_get_caps(sample);
+        GstBuffer *buffer = gst_sample_get_buffer(sample);
+        if (caps && buffer) {
+            GstVideoInfo vinfo;
+            if (gst_video_info_from_caps(&vinfo, caps) && GST_VIDEO_INFO_WIDTH(&vinfo) > 0 && GST_VIDEO_INFO_HEIGHT(&vinfo) > 0) {
+                GstMapInfo map;
+                if (gst_buffer_map(buffer, &map, GST_MAP_READ)) {
+                    const int width = GST_VIDEO_INFO_WIDTH(&vinfo);
+                    const int height = GST_VIDEO_INFO_HEIGHT(&vinfo);
+                    const int stride = GST_VIDEO_INFO_PLANE_STRIDE(&vinfo, 0);
+                    QImage img(map.data, width, height, stride, QImage::Format_RGBA8888);
+                    QImage detached = img.copy();
+                    gst_buffer_unmap(buffer, &map);
+
+                    QPointer<ScreenStreamVideoDecoder> target(self->q);
+                    if (target) {
+                        QMetaObject::invokeMethod(
+                            target.data(),
+                            [target, detached]() {
+                                if (target) {
+                                    Q_EMIT target->frameDecoded(detached);
+                                }
+                            },
+                            Qt::QueuedConnection);
+                    }
+                }
+            }
+        }
+
+        gst_sample_unref(sample);
+        return GST_FLOW_OK;
+    }
+};
+
+ScreenStreamVideoDecoder::ScreenStreamVideoDecoder(QObject *parent)
+    : QObject(parent)
+    , d(std::make_unique<Private>())
+{
+    d->q = this;
+}
+
+ScreenStreamVideoDecoder::~ScreenStreamVideoDecoder()
+{
+    shutdown();
+}
+
+bool ScreenStreamVideoDecoder::initialize(QString *errorOut)
+{
+    shutdown();
+    d->alive.store(true);
+
+    GError *gerr = nullptr;
+    if (!gst_init_check(nullptr, nullptr, &gerr)) {
+        const QString msg = gerr ? QString::fromUtf8(gerr->message) : QStringLiteral("Failed to initialize GStreamer");
+        if (gerr) {
+            g_error_free(gerr);
+        }
+        if (errorOut) {
+            *errorOut = msg;
+        }
+        Q_EMIT decoderError(msg);
+        return false;
+    }
+
+    d->pipeline = gst_pipeline_new("screenstream-decoder");
+    d->appsrc = gst_element_factory_make("appsrc", "src");
+    GstElement *parser = gst_element_factory_make("h264parse", "parser");
+    d->decodebin = gst_element_factory_make("decodebin", "decoder");
+    d->videoconvert = gst_element_factory_make("videoconvert", "convert");
+    GstElement *capsfilter = gst_element_factory_make("capsfilter", "rgba_filter");
+    d->appsink = gst_element_factory_make("appsink", "sink");
+
+    if (!d->pipeline || !d->appsrc || !parser || !d->decodebin || !d->videoconvert || !capsfilter || !d->appsink) {
+        const QString msg = QStringLiteral("Missing required GStreamer elements (appsrc, h264parse, decodebin, videoconvert, appsink)");
+        if (errorOut) {
+            *errorOut = msg;
+        }
+        Q_EMIT decoderError(msg);
+        if (d->appsrc && !GST_OBJECT_PARENT(d->appsrc)) gst_object_unref(d->appsrc);
+        if (parser && !GST_OBJECT_PARENT(parser)) gst_object_unref(parser);
+        if (d->decodebin && !GST_OBJECT_PARENT(d->decodebin)) gst_object_unref(d->decodebin);
+        if (d->videoconvert && !GST_OBJECT_PARENT(d->videoconvert)) gst_object_unref(d->videoconvert);
+        if (capsfilter && !GST_OBJECT_PARENT(capsfilter)) gst_object_unref(capsfilter);
+        if (d->appsink && !GST_OBJECT_PARENT(d->appsink)) gst_object_unref(d->appsink);
+        if (d->pipeline) {
+            gst_object_unref(d->pipeline);
+            d->pipeline = nullptr;
+        }
+        d->appsrc = nullptr;
+        d->decodebin = nullptr;
+        d->videoconvert = nullptr;
+        d->appsink = nullptr;
+        return false;
+    }
+
+    GstCaps *srcCaps = gst_caps_from_string("video/x-h264,stream-format=(string)byte-stream");
+    g_object_set(d->appsrc,
+                 "is-live",
+                 TRUE,
+                 "format",
+                 GST_FORMAT_TIME,
+                 "stream-type",
+                 GST_APP_STREAM_TYPE_STREAM,
+                 "max-bytes",
+                 static_cast<guint64>(2U * 1024U * 1024U),
+                 "caps",
+                 srcCaps,
+                 nullptr);
+    gst_caps_unref(srcCaps);
+
+    GstCaps *rawCaps = gst_caps_from_string("video/x-raw,format=(string)RGBA");
+    g_object_set(capsfilter, "caps", rawCaps, nullptr);
+    gst_caps_unref(rawCaps);
+
+    g_object_set(d->appsink,
+                 "emit-signals",
+                 FALSE,
+                 "sync",
+                 FALSE,
+                 "max-buffers",
+                 static_cast<guint>(2),
+                 "drop",
+                 TRUE,
+                 nullptr);
+
+    GstAppSinkCallbacks callbacks{};
+    callbacks.new_sample = &Private::onNewSample;
+    gst_app_sink_set_callbacks(GST_APP_SINK(d->appsink), &callbacks, d.get(), nullptr);
+
+    gst_bin_add_many(GST_BIN(d->pipeline), d->appsrc, parser, d->decodebin, d->videoconvert, capsfilter, d->appsink, nullptr);
+    if (!gst_element_link_many(d->appsrc, parser, d->decodebin, nullptr)
+        || !gst_element_link_many(d->videoconvert, capsfilter, d->appsink, nullptr)) {
+        const QString msg = QStringLiteral("Failed to link GStreamer video decoding pipeline");
+        if (errorOut) {
+            *errorOut = msg;
+        }
+        Q_EMIT decoderError(msg);
+        shutdown();
+        return false;
+    }
+
+    d->decodebinPadSignal = g_signal_connect(d->decodebin, "pad-added", G_CALLBACK(&Private::onDecodebinPadAdded), d.get());
+
+    const GstStateChangeReturn stateRet = gst_element_set_state(d->pipeline, GST_STATE_PLAYING);
+    if (stateRet == GST_STATE_CHANGE_FAILURE) {
+        const QString msg = QStringLiteral("Failed to start GStreamer pipeline");
+        if (errorOut) {
+            *errorOut = msg;
+        }
+        Q_EMIT decoderError(msg);
+        shutdown();
+        return false;
+    }
+
+    d->initialized = true;
+    return true;
+}
+
+void ScreenStreamVideoDecoder::shutdown()
+{
+    d->alive.store(false);
+    d->initialized = false;
+
+    if (d->decodebin && d->decodebinPadSignal != 0) {
+        g_signal_handler_disconnect(d->decodebin, d->decodebinPadSignal);
+        d->decodebinPadSignal = 0;
+    }
+    if (d->appsink) {
+        GstAppSinkCallbacks empty{};
+        gst_app_sink_set_callbacks(GST_APP_SINK(d->appsink), &empty, nullptr, nullptr);
+    }
+    if (d->pipeline) {
+        gst_element_set_state(d->pipeline, GST_STATE_NULL);
+        gst_object_unref(d->pipeline);
+        d->pipeline = nullptr;
+    }
+    d->appsrc = nullptr;
+    d->decodebin = nullptr;
+    d->videoconvert = nullptr;
+    d->appsink = nullptr;
+}
+
+bool ScreenStreamVideoDecoder::pushAccessUnit(const QByteArray &annexB, quint64 ptsUs, bool isKeyframe)
+{
+    if (!d->initialized || !d->appsrc || annexB.isEmpty()) {
+        return false;
+    }
+
+    GstBuffer *buf = gst_buffer_new_allocate(nullptr, static_cast<gsize>(annexB.size()), nullptr);
+    if (!buf) {
+        return false;
+    }
+
+    GstMapInfo map;
+    if (!gst_buffer_map(buf, &map, GST_MAP_WRITE)) {
+        gst_buffer_unref(buf);
+        return false;
+    }
+    std::memcpy(map.data, annexB.constData(), static_cast<size_t>(annexB.size()));
+    gst_buffer_unmap(buf, &map);
+
+    GST_BUFFER_PTS(buf) = static_cast<GstClockTime>(ptsUs) * 1000ULL;
+    GST_BUFFER_DTS(buf) = GST_CLOCK_TIME_NONE;
+    if (isKeyframe) {
+        GST_BUFFER_FLAG_UNSET(buf, GST_BUFFER_FLAG_DELTA_UNIT);
+    } else {
+        GST_BUFFER_FLAG_SET(buf, GST_BUFFER_FLAG_DELTA_UNIT);
+    }
+
+    const GstFlowReturn ret = gst_app_src_push_buffer(GST_APP_SRC(d->appsrc), buf);
+    return ret == GST_FLOW_OK;
+}
