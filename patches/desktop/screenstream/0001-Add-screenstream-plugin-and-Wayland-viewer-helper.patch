+
+ScreenCanvasWidget::ScreenCanvasWidget(QWidget *parent)
+    : QWidget(parent)
+{
+    setFocusPolicy(Qt::StrongFocus);
+    setMouseTracking(true);
+    setMinimumSize(240, 240);
+    setAutoFillBackground(true);
+    QPalette pal = palette();
+    pal.setColor(QPalette::Window, Qt::black);
+    setPalette(pal);
+}
+
+void ScreenCanvasWidget::setFrame(const QImage &frame)
+{
+    m_frame = frame;
+    update();
+}
+
+void ScreenCanvasWidget::setRemoteDisplaySize(const QSize &size)
+{
+    m_remoteDisplaySize = size;
+}
+
+void ScreenCanvasWidget::setInputEnabled(bool enabled)
+{
+    m_inputEnabled = enabled;
+    setCursor(enabled ? Qt::CrossCursor : Qt::ArrowCursor);
+}
+
+std::optional<QPoint> ScreenCanvasWidget::mapEventPos(const QPointF &pos) const
+{
+    if (m_frame.isNull()) {
+        return std::nullopt;
+    }
+    const QSize targetDisplay = m_remoteDisplaySize.isValid() ? m_remoteDisplaySize : m_frame.size();
+    return ScreenStreamProtocol::ScreenStreamCoordinateMapper::mapViewportToRemote(pos, size(), m_frame.size(), targetDisplay);
+}
+
+void ScreenCanvasWidget::paintEvent(QPaintEvent * /*event*/)
+{
+    QPainter painter(this);
+    painter.fillRect(rect(), Qt::black);
+    if (m_frame.isNull()) {
+        painter.setPen(Qt::white);
+        painter.drawText(rect(), Qt::AlignCenter, i18n("Waiting for Android screen frame..."));
+        return;
+    }
+
+    painter.setRenderHint(QPainter::SmoothPixmapTransform, true);
+    const QRectF dstRect = ScreenStreamProtocol::ScreenStreamCoordinateMapper::computeRenderedRect(size(), m_frame.size());
+    if (!dstRect.isEmpty()) {
+        painter.drawImage(dstRect, m_frame);
+    }
+}
+
+void ScreenCanvasWidget::mousePressEvent(QMouseEvent *event)
+{
+    setFocus();
+    if (!m_inputEnabled) {
+        return;
+    }
+    if (event->button() == Qt::LeftButton) {
+        const auto mapped = mapEventPos(event->position());
+        if (!mapped.has_value()) {
+            return;
+        }
+        m_leftButtonDown = true;
+        m_dragging = false;
+        m_pressPos = event->position();
+        Q_EMIT pointerMoved(*mapped);
+    }
+}
+
+void ScreenCanvasWidget::mouseMoveEvent(QMouseEvent *event)
+{
+    if (!m_inputEnabled) {
+        return;
+    }
+    const auto mapped = mapEventPos(event->position());
+    if (!mapped.has_value()) {
+        return;
+    }
+    if (m_leftButtonDown && !m_dragging) {
+        if ((event->position() - m_pressPos).manhattanLength() < 8.0) {
+            return;
+        }
+        m_dragging = true;
+        Q_EMIT dragStarted(*mapped);
+        Q_EMIT pointerMoved(*mapped);
+        return;
+    }
+    Q_EMIT pointerMoved(*mapped);
+}
+
+void ScreenCanvasWidget::mouseReleaseEvent(QMouseEvent *event)
+{
+    if (!m_inputEnabled) {
+        m_leftButtonDown = false;
+        m_dragging = false;
+        return;
+    }
+    if (event->button() == Qt::LeftButton) {
+        const auto mapped = mapEventPos(event->position());
+        if (m_dragging) {
+            if (mapped.has_value()) {
+                Q_EMIT pointerMoved(*mapped);
+                Q_EMIT dragEnded(*mapped);
+            } else {
+                Q_EMIT dragEnded(QPoint(1, 1));
+            }
+        } else if (mapped.has_value()) {
+            Q_EMIT pointerMoved(*mapped);
+            Q_EMIT pointerClicked(*mapped);
+        }
+        m_leftButtonDown = false;
+        m_dragging = false;
+        return;
+    }
+    if (event->button() == Qt::RightButton) {
+        Q_EMIT rightClicked();
+        return;
+    }
+    if (event->button() == Qt::MiddleButton) {
+        Q_EMIT middleClicked();
+    }
+}
+
+void ScreenCanvasWidget::wheelEvent(QWheelEvent *event)
+{
+    if (!m_inputEnabled) {
+        return;
+    }
+    if (!mapEventPos(event->position()).has_value()) {
+        return;
+    }
+    const QPoint angle = event->angleDelta();
+    if (angle.y() != 0) {
+        // KdeConnectAccessibilityService accumulates |dy| >= 500 per scroll gesture.
+        const int scaledDy = -angle.y() * 5;
+        Q_EMIT wheelScrolled(0, scaledDy);
+    }
+}
+
+void ScreenCanvasWidget::keyPressEvent(QKeyEvent *event)
+{
+    if (!m_inputEnabled) {
+        return;
+    }
+    QVariantMap payload;
+    payload.insert(QStringLiteral("key"), event->key());
+    payload.insert(QStringLiteral("modifiers"), static_cast<int>(event->modifiers()));
+    payload.insert(QStringLiteral("text"), event->text());
+    Q_EMIT keyEventCaptured(payload);
+}
+
+ViewerWindow::ViewerWindow(const ViewerLaunchConfig &config, QWidget *parent)
+    : QMainWindow(parent)
+    , m_config(config)
+    , m_decoder(new ScreenStreamVideoDecoder(this))
+    , m_audioPlayer(new PcmPlayer(this))
+    , m_socket(new QLocalSocket(this))
+{
+    if (m_config.displayWidth > 1 && m_config.displayHeight > 1) {
+        m_displaySize = QSize(m_config.displayWidth, m_config.displayHeight);
+    } else if (m_config.streamWidth > 1 && m_config.streamHeight > 1) {
+        m_displaySize = QSize(m_config.streamWidth, m_config.streamHeight);
+    }
+    if (m_config.streamWidth > 1 && m_config.streamHeight > 1) {
+        m_streamSize = QSize(m_config.streamWidth, m_config.streamHeight);
+    }
+
+    setupUi();
+    setupDbus();
+    refreshDbusProperties();
+
+    QString gstErr;
+    if (!m_decoder->initialize(&gstErr)) {
+        m_decoderError = gstErr;
+    }
+
+    connect(m_decoder, &ScreenStreamVideoDecoder::frameDecoded, this, &ViewerWindow::onFrameDecoded);
+    connect(m_decoder, &ScreenStreamVideoDecoder::decoderError, this, &ViewerWindow::onDecoderError);
+
+    connect(m_socket, &QLocalSocket::connected, this, &ViewerWindow::onSocketConnected);
+    connect(m_socket, &QLocalSocket::readyRead, this, &ViewerWindow::onSocketReadyRead);
+    connect(m_socket, &QLocalSocket::disconnected, this, &ViewerWindow::onSocketDisconnected);
+
+    updateBannerAndInputGate();
+    m_socket->connectToServer(m_config.socketPath);
+}
+
+ViewerWindow::~ViewerWindow() = default;
+
+void ViewerWindow::setupUi()
+{
+    const QString titleName = m_config.deviceName.isEmpty() ? m_config.deviceId : m_config.deviceName;
+    setWindowTitle(i18n("Screen Stream - %1", titleName));
+
+    m_toolbar = addToolBar(i18n("Screen Stream Controls"));
+    m_toolbar->setMovable(false);
+
+    auto *stopAct = m_toolbar->addAction(QIcon::fromTheme(QStringLiteral("media-playback-stop")), i18n("Stop"));
+    connect(stopAct, &QAction::triggered, this, &ViewerWindow::onStopClicked);
+
+    m_muteAction = m_toolbar->addAction(QIcon::fromTheme(QStringLiteral("audio-volume-muted")), i18n("Mute Audio"));
+    m_muteAction->setCheckable(true);
+    connect(m_muteAction, &QAction::toggled, this, &ViewerWindow::onMuteToggled);
+
+    auto *keyframeAct = m_toolbar->addAction(QIcon::fromTheme(QStringLiteral("view-refresh")), i18n("Refresh Keyframe"));
+    connect(keyframeAct, &QAction::triggered, this, &ViewerWindow::onKeyframeClicked);
+
+    auto *fitWindowAct = m_toolbar->addAction(QIcon::fromTheme(QStringLiteral("zoom-fit-best")), i18n("Fit Window"));
+    connect(fitWindowAct, &QAction::triggered, this, &ViewerWindow::onFitWindowClicked);
+
+    auto *clipboardAct = m_toolbar->addAction(QIcon::fromTheme(QStringLiteral("edit-paste")), i18n("Send Clipboard"));
+    connect(clipboardAct, &QAction::triggered, this, &ViewerWindow::onClipboardClicked);
+
+    auto *shareAct = m_toolbar->addAction(QIcon::fromTheme(QStringLiteral("document-send")), i18n("Share File..."));
+    connect(shareAct, &QAction::triggered, this, &ViewerWindow::onShareFileClicked);
+
+    m_toolbar->addSeparator();
+
+    m_backAction = m_toolbar->addAction(QIcon::fromTheme(QStringLiteral("go-previous")), i18n("Back"));
+    connect(m_backAction, &QAction::triggered, this, [this]() {
+        sendRemoteControlCommand({{QStringLiteral("backclick"), true}});
+    });
+
+    m_homeAction = m_toolbar->addAction(QIcon::fromTheme(QStringLiteral("go-home")), i18n("Home"));
+    connect(m_homeAction, &QAction::triggered, this, [this]() {
+        sendRemoteControlCommand({{QStringLiteral("middleclick"), true}});
+    });
+
+    m_recentsAction = m_toolbar->addAction(QIcon::fromTheme(QStringLiteral("view-grid")), i18n("Recents"));
+    connect(m_recentsAction, &QAction::triggered, this, [this]() {
+        sendRemoteControlCommand({{QStringLiteral("forwardclick"), true}});
+    });
+
+    auto *central = new QWidget(this);
+    auto *layout = new QVBoxLayout(central);
+    layout->setContentsMargins(0, 0, 0, 0);
+    layout->setSpacing(0);
+
+    m_banner = new QLabel(central);
+    m_banner->setWordWrap(true);
+    m_banner->setMargin(6);
+    m_banner->hide();
+    layout->addWidget(m_banner);
+
+    m_canvas = new ScreenCanvasWidget(central);
+    if (m_displaySize.isValid()) {
+        m_canvas->setRemoteDisplaySize(m_displaySize);
+    }
+    layout->addWidget(m_canvas, 1);
+
+    setCentralWidget(central);
+    fitWindowToStream(false);
+
+    connect(m_canvas, &ScreenCanvasWidget::pointerMoved, this, [this](const QPoint &pt) {
+        sendRemoteControlCommand({{QStringLiteral("x"), pt.x()}, {QStringLiteral("y"), pt.y()}});
+    });
+    connect(m_canvas, &ScreenCanvasWidget::pointerClicked, this, [this](const QPoint & /*pt*/) {
+        sendRemoteControlCommand({{QStringLiteral("singleclick"), true}});
+    });
+    connect(m_canvas, &ScreenCanvasWidget::dragStarted, this, [this](const QPoint & /*pt*/) {
+        sendRemoteControlCommand({{QStringLiteral("singlehold"), true}});
+    });
+    connect(m_canvas, &ScreenCanvasWidget::dragEnded, this, [this](const QPoint & /*pt*/) {
+        sendRemoteControlCommand({{QStringLiteral("singlerelease"), true}});
+    });
+    connect(m_canvas, &ScreenCanvasWidget::rightClicked, this, [this]() {
+        sendRemoteControlCommand({{QStringLiteral("backclick"), true}});
+    });
+    connect(m_canvas, &ScreenCanvasWidget::middleClicked, this, [this]() {
+        sendRemoteControlCommand({{QStringLiteral("middleclick"), true}});
+    });
+    connect(m_canvas, &ScreenCanvasWidget::wheelScrolled, this, [this](int dx, int dy) {
+        sendRemoteControlCommand({{QStringLiteral("scroll"), true}, {QStringLiteral("dx"), dx}, {QStringLiteral("dy"), dy}});
+    });
+    connect(m_canvas, &ScreenCanvasWidget::keyEventCaptured, this, [this](const QVariantMap &keyEvent) {
+        if (m_sessionActive && m_remoteKeyboardIface && m_remoteKeyboardIface->isValid()) {
+            m_remoteKeyboardIface->asyncCall(QStringLiteral("sendQKeyEvent"), keyEvent, false);
+        }
+    });
+}
+
+void ViewerWindow::setupDbus()
+{
+    QDBusConnection bus = QDBusConnection::sessionBus();
+    const QString service = QStringLiteral("org.kde.kdeconnect");
+    const QString basePath = QStringLiteral("/modules/kdeconnect/devices/%1").arg(m_config.deviceId);
+
+    m_screenstreamIface = new QDBusInterface(service, basePath + QStringLiteral("/screenstream"), QStringLiteral("org.kde.kdeconnect.device.screenstream"), bus, this);
+    m_remoteControlIface = new QDBusInterface(service, basePath + QStringLiteral("/remotecontrol"), QStringLiteral("org.kde.kdeconnect.device.remotecontrol"), bus, this);
+    m_remoteKeyboardIface = new QDBusInterface(service, basePath + QStringLiteral("/remotekeyboard"), QStringLiteral("org.kde.kdeconnect.device.remotekeyboard"), bus, this);
+    m_clipboardIface = new QDBusInterface(service, basePath + QStringLiteral("/clipboard"), QStringLiteral("org.kde.kdeconnect.device.clipboard"), bus, this);
+    m_shareIface = new QDBusInterface(service, basePath + QStringLiteral("/share"), QStringLiteral("org.kde.kdeconnect.device.share"), bus, this);
+
+    bus.connect(service,
+                basePath + QStringLiteral("/screenstream"),
+                QStringLiteral("org.kde.kdeconnect.device.screenstream"),
+                QStringLiteral("geometryChanged"),
+                this,
+                SLOT(onDbusGeometryChanged(int,int,int)));
+    bus.connect(service,
+                basePath + QStringLiteral("/screenstream"),
+                QStringLiteral("org.kde.kdeconnect.device.screenstream"),
+                QStringLiteral("audioStatusChanged"),
+                this,
+                SLOT(onDbusAudioStatusChanged(bool,QString)));
+    bus.connect(service,
+                basePath + QStringLiteral("/screenstream"),
+                QStringLiteral("org.kde.kdeconnect.device.screenstream"),
+                QStringLiteral("stateChanged"),
+                this,
+                SLOT(onDbusStateChanged()));
+    bus.connect(service,
+                basePath + QStringLiteral("/screenstream"),
+                QStringLiteral("org.kde.kdeconnect.device.screenstream"),
+                QStringLiteral("streamingChanged"),
+                this,
+                SLOT(onDbusStreamingChanged(bool)));
+}
+
+void ViewerWindow::refreshDbusProperties()
+{
+    if (!m_screenstreamIface || !m_screenstreamIface->isValid()) {
+        return;
+    }
+    m_accessibilityEnabled = m_screenstreamIface->property("accessibilityEnabled").toBool();
+    m_audioAvailable = m_screenstreamIface->property("audioAvailable").toBool();
+    m_audioReason = m_screenstreamIface->property("audioReason").toString();
+
+    const int dw = m_screenstreamIface->property("displayWidth").toInt();
+    const int dh = m_screenstreamIface->property("displayHeight").toInt();
+    if (dw > 1 && dh > 1) {
+        m_displaySize = QSize(dw, dh);
+        m_canvas->setRemoteDisplaySize(m_displaySize);
+    }
+    const int sw = m_screenstreamIface->property("streamWidth").toInt();
+    const int sh = m_screenstreamIface->property("streamHeight").toInt();
+    if (sw > 1 && sh > 1) {
+        m_streamSize = QSize(sw, sh);
+    }
+    updateBannerAndInputGate();
+}
+
+void ViewerWindow::updateBannerAndInputGate()
+{
+    const bool remoteCtrlValid = m_remoteControlIface && m_remoteControlIface->isValid();
+    const bool allowInput = m_sessionActive && remoteCtrlValid && m_accessibilityEnabled;
+    m_canvas->setInputEnabled(allowInput);
+    if (m_backAction) {
+        m_backAction->setEnabled(allowInput);
+    }
+    if (m_homeAction) {
+        m_homeAction->setEnabled(allowInput);
+    }
+    if (m_recentsAction) {
+        m_recentsAction->setEnabled(allowInput);
+    }
+
+    QStringList notices;
+    if (!m_decoderError.isEmpty()) {
+        notices << m_decoderError;
+    }
+    if (m_protectedContentActive) {
+        notices << i18n("Protected content is currently displayed on Android and masked from capture.");
+    }
+    if (!m_audioAvailable && !m_audioReason.isEmpty()) {
+        notices << i18n("Audio unavailable: %1", m_audioReason);
+    }
+    if (!allowInput && m_sessionActive) {
+        if (!remoteCtrlValid) {
+            notices << i18n("Remote input disabled: KDE Connect remotecontrol plugin is not active.");
+        } else if (!m_accessibilityEnabled) {
+            notices << i18n("Remote touch/key control disabled: enable KDE Connect Accessibility Service on Android.");
+        }
+    }
+
+    if (notices.isEmpty()) {
+        m_banner->hide();
+    } else {
+        m_banner->setText(notices.join(QStringLiteral(" | ")));
+        m_banner->show();
+    }
+}
+
+void ViewerWindow::sendRemoteControlCommand(const QVariantMap &body)
+{
+    if (!m_sessionActive || !m_accessibilityEnabled || !m_remoteControlIface || !m_remoteControlIface->isValid()) {
+        return;
+    }
+    m_remoteControlIface->asyncCall(QStringLiteral("sendCommand"), body);
+}
+
+QSize ViewerWindow::effectiveStreamSize() const
+{
+    if (m_lastFrameSize.width() > 1 && m_lastFrameSize.height() > 1) {
+        return m_lastFrameSize;
+    }
+    if (m_streamSize.width() > 1 && m_streamSize.height() > 1) {
+        return m_streamSize;
+    }
+    if (m_displaySize.width() > 1 && m_displaySize.height() > 1) {
+        return m_displaySize;
+    }
+    return QSize(540, 960);
+}
+
+void ViewerWindow::fitWindowToStream(bool force)
+{
+    if (!force && (isMaximized() || isFullScreen())) {
+        return;
+    }
+    if (force && (isMaximized() || isFullScreen())) {
+        showNormal();
+    }
+
+    QScreen *scr = screen() ? screen() : QGuiApplication::primaryScreen();
+    const QSize avail = scr ? scr->availableGeometry().size() : QSize(1920, 1080);
+    const int chromeHeight = (isVisible() && m_canvas && m_canvas->height() > 0 && height() >= m_canvas->height())
+        ? (height() - m_canvas->height())
+        : ((m_toolbar ? m_toolbar->sizeHint().height() : 40) + ((m_banner && !m_banner->isHidden()) ? m_banner->sizeHint().height() : 0));
+
+    const int maxCanvasW = std::max(240, static_cast<int>(avail.width() * 0.85));
+    const int maxCanvasH = std::max(240, static_cast<int>(avail.height() * 0.85) - chromeHeight);
+    const QSize targetCanvas = ScreenStreamProtocol::ScreenStreamCoordinateMapper::computeTargetCanvasSize(
+        effectiveStreamSize(),
+        QSize(maxCanvasW, maxCanvasH),
+        QSize(240, 240));
+    if (targetCanvas.isValid()) {
+        resize(targetCanvas.width(), targetCanvas.height() + chromeHeight);
+    }
+}
+
+void ViewerWindow::onSocketConnected()
+{
+    updateBannerAndInputGate();
+}
+
+void ViewerWindow::onSocketReadyRead()
+{
+    const QByteArray bytes = m_socket->readAll();
+    if (bytes.isEmpty()) {
+        return;
+    }
+
+    QList<ScreenStreamProtocol::ScreenStreamFrame> frames;
+    if (!m_parser.feed(bytes, &frames)) {
+        m_sessionActive = false;
+        m_decoderError = m_parser.errorString();
+        updateBannerAndInputGate();
+        m_socket->close();
+        return;
+    }
+
+    for (const auto &frame : std::as_const(frames)) {
+        const bool isProtected = (frame.flags & ScreenStreamProtocol::FlagProtectedContent) != 0;
+        if (isProtected != m_protectedContentActive) {
+            m_protectedContentActive = isProtected;
+            updateBannerAndInputGate();
+        }
+
+        switch (frame.kind) {
+        case ScreenStreamProtocol::FrameKind::CodecConfig:
+        case ScreenStreamProtocol::FrameKind::VideoAccessUnit: {
+            const bool isKey = (frame.kind == ScreenStreamProtocol::FrameKind::CodecConfig)
+                || ((frame.flags & ScreenStreamProtocol::FlagKeyframe) != 0);
+            m_decoder->pushAccessUnit(frame.payload, frame.ptsUs, isKey);
+            break;
+        }
+        case ScreenStreamProtocol::FrameKind::AudioPcmChunk:
+            m_audioPlayer->writePcm(frame.payload);
+            break;
+        case ScreenStreamProtocol::FrameKind::ControlEos:
+            onSocketDisconnected();
+            return;
+        }
+    }
+}
+
+void ViewerWindow::onSocketDisconnected()
+{
+    m_sessionActive = false;
+    updateBannerAndInputGate();
+    m_audioPlayer->stop();
+}
+
+void ViewerWindow::onFrameDecoded(const QImage &frame)
+{
+    if (!frame.isNull() && frame.size() != m_lastFrameSize) {
+        m_lastFrameSize = frame.size();
+        m_canvas->setFrame(frame);
+        fitWindowToStream(false);
+        return;
+    }
+    m_canvas->setFrame(frame);
+}
+
+void ViewerWindow::onDecoderError(const QString &message)
+{
+    m_decoderError = message;
+    updateBannerAndInputGate();
+}
+
+void ViewerWindow::onStopClicked()
+{
+    m_sessionActive = false;
+    updateBannerAndInputGate();
+    if (m_screenstreamIface && m_screenstreamIface->isValid()) {
+        m_screenstreamIface->asyncCall(QStringLiteral("stopStream"));
+    }
+    close();
+}
+
+void ViewerWindow::onMuteToggled(bool checked)
+{
+    m_audioPlayer->setMuted(checked);
+}
+
+void ViewerWindow::onKeyframeClicked()
+{
+    if (m_screenstreamIface && m_screenstreamIface->isValid()) {
+        m_screenstreamIface->asyncCall(QStringLiteral("requestKeyframe"));
+    }
+}
+
+void ViewerWindow::onFitWindowClicked()
+{
+    fitWindowToStream(true);
+}
+
+void ViewerWindow::onClipboardClicked()
+{
+    if (m_clipboardIface && m_clipboardIface->isValid()) {
+        m_clipboardIface->asyncCall(QStringLiteral("sendClipboard"));
+    }
+}
+
+void ViewerWindow::onShareFileClicked()
+{
+    if (!m_shareIface || !m_shareIface->isValid()) {
+        return;
+    }
+    const QList<QUrl> urls = QFileDialog::getOpenFileUrls(
+        this,
+        i18n("Select Files to Send to Android"),
+        QUrl::fromLocalFile(QStandardPaths::writableLocation(QStandardPaths::HomeLocation)));
+    if (urls.isEmpty()) {
+        return;
+    }
+    QStringList rawUrls;
+    rawUrls.reserve(urls.size());
+    for (const QUrl &url : urls) {
+        rawUrls.append(url.toString());
+    }
+    m_shareIface->asyncCall(QStringLiteral("shareUrls"), rawUrls);
+}
+
+void ViewerWindow::onDbusGeometryChanged(int width, int height, int rotation)
+{
+    Q_UNUSED(rotation)
+    if (width > 1 && height > 1) {
+        m_displaySize = QSize(width, height);
+        m_canvas->setRemoteDisplaySize(m_displaySize);
+        if (m_screenstreamIface && m_screenstreamIface->isValid()) {
+            const int sw = m_screenstreamIface->property("streamWidth").toInt();
+            const int sh = m_screenstreamIface->property("streamHeight").toInt();
+            if (sw > 1 && sh > 1) {
+                m_streamSize = QSize(sw, sh);
+            }
+        }
+        if (m_streamSize.isValid() && (width > height) != (m_streamSize.width() > m_streamSize.height())) {
+            m_streamSize = QSize();
+        }
+        if (m_lastFrameSize.isValid() && (width > height) != (m_lastFrameSize.width() > m_lastFrameSize.height())) {
+            m_lastFrameSize = QSize();
+        }
+        fitWindowToStream(false);
+    }
+}
+
+void ViewerWindow::onDbusAudioStatusChanged(bool available, const QString &reason)
+{
+    m_audioAvailable = available;
+    m_audioReason = reason;
+    updateBannerAndInputGate();
+}
+
+void ViewerWindow::onDbusStateChanged()
+{
+    refreshDbusProperties();
+}
+
+void ViewerWindow::onDbusStreamingChanged(bool streaming)
+{
+    m_sessionActive = streaming;
+    updateBannerAndInputGate();
+    if (!streaming) {
+        m_audioPlayer->stop();
+    }
+}
+
+void ViewerWindow::closeEvent(QCloseEvent *event)
+{
+    if (m_sessionActive && m_screenstreamIface && m_screenstreamIface->isValid()) {
+        m_sessionActive = false;
+        m_screenstreamIface->call(QDBus::NoBlock, QStringLiteral("stopStream"));
+    }
+    m_audioPlayer->stop();
+    m_decoder->shutdown();
+    QMainWindow::closeEvent(event);
+}
