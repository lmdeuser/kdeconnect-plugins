+    void testCoordinateMapperLetterboxPillarboxAndClamp()
+    {
+        // Portrait 1080x2460 stream in wide 1000x800 viewport -> centered vertically scaled rect with pillarbox bars.
+        const QSizeF wideViewport(1000.0, 800.0);
+        const QSize streamPortrait(540, 1230);
+        const QSize displayPortrait(1080, 2460);
+
+        const QRectF rendered = ScreenStreamCoordinateMapper::computeRenderedRect(wideViewport, streamPortrait);
+        QCOMPARE(rendered.height(), 800.0);
+        QVERIFY(rendered.left() > 0.0);
+
+        // Points in left/right pillarbox bars return std::nullopt.
+        QVERIFY(!ScreenStreamCoordinateMapper::mapViewportToRemote(QPointF(5.0, 400.0), wideViewport, streamPortrait, displayPortrait).has_value());
+        QVERIFY(!ScreenStreamCoordinateMapper::mapViewportToRemote(QPointF(995.0, 400.0), wideViewport, streamPortrait, displayPortrait).has_value());
+
+        // Top-left corner inside rendered rect clamps to >= (1, 1) to avoid MouseReceiverPlugin (0, 0) no-op.
+        const auto topLeft = ScreenStreamCoordinateMapper::mapViewportToRemote(rendered.topLeft(), wideViewport, streamPortrait, displayPortrait);
+        QVERIFY(topLeft.has_value());
+        QCOMPARE(*topLeft, QPoint(1, 1));
+
+        // Center maps near display center.
+        const auto center = ScreenStreamCoordinateMapper::mapViewportToRemote(rendered.center(), wideViewport, streamPortrait, displayPortrait);
+        QVERIFY(center.has_value());
+        QVERIFY(qAbs(center->x() - 540) <= 2);
+        QVERIFY(qAbs(center->y() - 1230) <= 2);
+
+        // Landscape rotation case: 1920x840 inside 800x1000 viewport (letterbox top/bottom bars) clamps inside [1, w-1] x [1, h-1].
+        const QSizeF tallViewport(800.0, 1000.0);
+        const QSize streamLandscape(1920, 840);
+        const QSize displayLandscape(2460, 1080);
+        const QRectF landRect = ScreenStreamCoordinateMapper::computeRenderedRect(tallViewport, streamLandscape);
+        QVERIFY(landRect.top() > 0.0);
+        QVERIFY(!ScreenStreamCoordinateMapper::mapViewportToRemote(QPointF(400.0, 5.0), tallViewport, streamLandscape, displayLandscape).has_value());
+
+        const QPointF bottomRightInside(landRect.right() - 0.001, landRect.bottom() - 0.001);
+        const auto br = ScreenStreamCoordinateMapper::mapViewportToRemote(bottomRightInside, tallViewport, streamLandscape, displayLandscape);
+        QVERIFY(br.has_value());
+        QCOMPARE(*br, QPoint(displayLandscape.width() - 1, displayLandscape.height() - 1));
+    }
