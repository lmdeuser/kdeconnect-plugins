+    void testSafePayloadReleaseDuringSignalEmission()
+    {
+        QTcpServer server;
+        QVERIFY(server.listen(QHostAddress::LocalHost, 0));
+
+        auto client = QSharedPointer<QTcpSocket>::create();
+        client->connectToHost(QHostAddress::LocalHost, server.serverPort());
+        QVERIFY(server.waitForNewConnection(2000));
+        QTcpSocket *peer = server.nextPendingConnection();
+        QVERIFY(peer != nullptr);
+        QVERIFY(client->waitForConnected(2000));
+
+        QObject::connect(client.data(), &QAbstractSocket::disconnected, client.data(), &QAbstractSocket::readChannelFinished);
+        QSharedPointer<QIODevice> payload = client;
+        client.reset();
+        QPointer<QIODevice> guard(payload.data());
+
+        QObject receiver;
+        bool trailingSlotSawAliveSender = false;
+        QObject::connect(payload.data(), &QIODevice::readChannelFinished, &receiver, [&payload, &receiver]() {
+            releaseStreamPayloadSafely(payload, &receiver);
+        });
+        auto *absSock = qobject_cast<QAbstractSocket *>(payload.data());
+        QVERIFY(absSock != nullptr);
+        QObject::connect(absSock, &QAbstractSocket::disconnected, &receiver, [&payload, &receiver]() {
+            releaseStreamPayloadSafely(payload, &receiver);
+        });
+        QObject::connect(payload.data(), &QIODevice::readChannelFinished, this, [&trailingSlotSawAliveSender, &guard]() {
+            trailingSlotSawAliveSender = !guard.isNull();
+        });
+
+        peer->abort();
+        QTRY_VERIFY(payload.isNull());
+        QVERIFY(trailingSlotSawAliveSender);
+        QTRY_VERIFY(guard.isNull());
+    }
