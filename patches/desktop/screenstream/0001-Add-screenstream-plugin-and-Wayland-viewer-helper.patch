+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "gstvideodecoder.h"
+#include "viewerwindow.h"
+
+#include <KLocalizedString>
+
+#include <QApplication>
+#include <QCommandLineOption>
+#include <QCommandLineParser>
+#include <QCoreApplication>
+
+#include <iostream>
+#include <memory>
+
+int main(int argc, char **argv)
+{
+    bool selfTest = false;
+    for (int i = 1; i < argc; ++i) {
+        if (qstrcmp(argv[i], "--self-test") == 0) {
+            selfTest = true;
+            break;
+        }
+    }
+
+    std::unique_ptr<QCoreApplication> app;
+    if (selfTest) {
+        app = std::make_unique<QCoreApplication>(argc, argv);
+    } else {
+        app = std::make_unique<QApplication>(argc, argv);
+    }
+
+    QCoreApplication::setApplicationName(QStringLiteral("kdeconnect-screenstream-viewer"));
+    QCoreApplication::setOrganizationDomain(QStringLiteral("kde.org"));
+    KLocalizedString::setApplicationDomain("kdeconnect-plugins");
+
+    if (selfTest) {
+        ScreenStreamVideoDecoder decoder;
+        QString err;
+        if (!decoder.initialize(&err)) {
+            std::cerr << "Self-test failed: " << err.toStdString() << std::endl;
+            return 1;
+        }
+        decoder.shutdown();
+        std::cout << "GStreamer pipeline self-test OK" << std::endl;
+        return 0;
+    }
+
+    QCommandLineParser parser;
+    parser.addHelpOption();
+    QCommandLineOption deviceOpt(QStringLiteral("device"), i18n("KDE Connect device ID"), QStringLiteral("id"));
+    QCommandLineOption nameOpt(QStringLiteral("device-name"), i18n("Display name of the device"), QStringLiteral("name"));
+    QCommandLineOption socketOpt(QStringLiteral("socket"), i18n("Local IPC socket path"), QStringLiteral("path"));
+    QCommandLineOption dwOpt(QStringLiteral("display-width"), i18n("Display width"), QStringLiteral("px"), QStringLiteral("0"));
+    QCommandLineOption dhOpt(QStringLiteral("display-height"), i18n("Display height"), QStringLiteral("px"), QStringLiteral("0"));
+    QCommandLineOption swOpt(QStringLiteral("stream-width"), i18n("Stream width"), QStringLiteral("px"), QStringLiteral("0"));
+    QCommandLineOption shOpt(QStringLiteral("stream-height"), i18n("Stream height"), QStringLiteral("px"), QStringLiteral("0"));
+    QCommandLineOption rotOpt(QStringLiteral("rotation"), i18n("Display rotation"), QStringLiteral("deg"), QStringLiteral("0"));
+
+    parser.addOptions({deviceOpt, nameOpt, socketOpt, dwOpt, dhOpt, swOpt, shOpt, rotOpt});
+    parser.process(*app);
+
+    ViewerLaunchConfig config;
+    config.deviceId = parser.value(deviceOpt);
+    config.deviceName = parser.value(nameOpt);
+    config.socketPath = parser.value(socketOpt);
+    config.displayWidth = parser.value(dwOpt).toInt();
+    config.displayHeight = parser.value(dhOpt).toInt();
+    config.streamWidth = parser.value(swOpt).toInt();
+    config.streamHeight = parser.value(shOpt).toInt();
+    config.rotation = parser.value(rotOpt).toInt();
+
+    if (config.deviceId.isEmpty() || config.socketPath.isEmpty()) {
+        std::cerr << "Both --device and --socket are required" << std::endl;
+        return 2;
+    }
+
+    ViewerWindow window(config);
+    window.show();
+    return app->exec();
+}
diff --git a/plugins/screenstream/viewer/pcmplayer.cpp b/plugins/screenstream/viewer/pcmplayer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..486074eff2663be73c3bfb2c554f66f6933b8abd
--- /dev/null
+++ b/plugins/screenstream/viewer/pcmplayer.cpp
@@ -0,0 +1,151 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "pcmplayer.h"
+
+#include <cstring>
+
+#include <gst/app/gstappsrc.h>
+#include <gst/gst.h>
+
+namespace
+{
+inline constexpr qsizetype kMaxBufferBytes = 7680; // 80 ms of 48 kHz mono s16le
+} // namespace
+
+struct PcmPlayer::Private {
+    GstElement *pipeline = nullptr;
+    GstElement *appsrc = nullptr;
+    bool muted = false;
+    bool unavailable = false;
+};
+
+PcmPlayer::PcmPlayer(QObject *parent)
+    : QObject(parent)
+    , d(std::make_unique<Private>())
+{
+}
+
+PcmPlayer::~PcmPlayer()
+{
+    stop();
+}
+
+bool PcmPlayer::ensureStarted()
+{
+    if (d->unavailable) {
+        return false;
+    }
+    if (d->pipeline && d->appsrc) {
+        return true;
+    }
+
+    if (!gst_init_check(nullptr, nullptr, nullptr)) {
+        d->unavailable = true;
+        return false;
+    }
+
+    GstElement *pipeline = gst_pipeline_new("screenstream-audio");
+    GstElement *appsrc = gst_element_factory_make("appsrc", "audio_src");
+    GstElement *convert = gst_element_factory_make("audioconvert", "audio_convert");
+    GstElement *resample = gst_element_factory_make("audioresample", "audio_resample");
+    GstElement *sink = gst_element_factory_make("autoaudiosink", "audio_sink");
+
+    if (!pipeline || !appsrc || !convert || !resample || !sink) {
+        if (appsrc) gst_object_unref(appsrc);
+        if (convert) gst_object_unref(convert);
+        if (resample) gst_object_unref(resample);
+        if (sink) gst_object_unref(sink);
+        if (pipeline) gst_object_unref(pipeline);
+        d->unavailable = true;
+        return false;
+    }
+
+    GstCaps *caps = gst_caps_from_string("audio/x-raw,format=(string)S16LE,layout=(string)interleaved,rate=(int)48000,channels=(int)1");
+    g_object_set(appsrc,
+                 "is-live",
+                 TRUE,
+                 "format",
+                 GST_FORMAT_TIME,
+                 "do-timestamp",
+                 TRUE,
+                 "stream-type",
+                 GST_APP_STREAM_TYPE_STREAM,
+                 "block",
+                 FALSE,
+                 "leaky-type",
+                 2,
+                 "max-bytes",
+                 static_cast<guint64>(kMaxBufferBytes),
+                 "caps",
+                 caps,
+                 nullptr);
+    gst_caps_unref(caps);
+
+    gst_bin_add_many(GST_BIN(pipeline), appsrc, convert, resample, sink, nullptr);
+    if (!gst_element_link_many(appsrc, convert, resample, sink, nullptr)) {
+        gst_object_unref(pipeline);
+        d->unavailable = true;
+        return false;
+    }
+
+    if (gst_element_set_state(pipeline, GST_STATE_PLAYING) == GST_STATE_CHANGE_FAILURE) {
+        gst_element_set_state(pipeline, GST_STATE_NULL);
+        gst_object_unref(pipeline);
+        d->unavailable = true;
+        return false;
+    }
+
+    d->pipeline = pipeline;
+    d->appsrc = appsrc;
+    return true;
+}
+
+void PcmPlayer::writePcm(const QByteArray &pcmBytes)
+{
+    const qsizetype aligned = pcmBytes.size() - (pcmBytes.size() % 2);
+    if (d->muted || aligned <= 0 || !ensureStarted()) {
+        return;
+    }
+
+    GstBuffer *buf = gst_buffer_new_allocate(nullptr, static_cast<gsize>(aligned), nullptr);
+    if (!buf) {
+        return;
+    }
+
+    GstMapInfo map;
+    if (!gst_buffer_map(buf, &map, GST_MAP_WRITE)) {
+        gst_buffer_unref(buf);
+        return;
+    }
+    std::memcpy(map.data, pcmBytes.constData(), static_cast<size_t>(aligned));
+    gst_buffer_unmap(buf, &map);
+
+    gst_app_src_push_buffer(GST_APP_SRC(d->appsrc), buf);
+}
+
+void PcmPlayer::setMuted(bool muted)
+{
+    d->muted = muted;
+    if (d->muted && d->pipeline) {
+        stop();
+    }
+}
+
+bool PcmPlayer::isMuted() const
+{
+    return d->muted;
+}
+
+void PcmPlayer::stop()
+{
+    if (d->pipeline) {
+        gst_element_set_state(d->pipeline, GST_STATE_NULL);
+        gst_object_unref(d->pipeline);
+        d->pipeline = nullptr;
+        d->appsrc = nullptr;
+    }
+}
