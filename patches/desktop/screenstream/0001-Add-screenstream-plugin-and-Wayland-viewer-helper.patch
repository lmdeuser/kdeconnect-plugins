+    void testPluginMetadataDiscovery()
+    {
+        const QList<KPluginMetaData> plugins = KPluginMetaData::findPlugins(QStringLiteral("kdeconnect"));
+        bool found = false;
+        for (const KPluginMetaData &meta : plugins) {
+            if (meta.pluginId() == QLatin1String("kdeconnect_screenstream")) {
+                found = true;
+                const QStringList incoming = meta.value(QStringLiteral("X-KdeConnect-SupportedPacketType"), QStringList());
+                const QStringList outgoing = meta.value(QStringLiteral("X-KdeConnect-OutgoingPacketType"), QStringList());
+                QVERIFY(incoming.contains(QStringLiteral("kdeconnect.screenstream")));
+                QVERIFY(outgoing.contains(QStringLiteral("kdeconnect.screenstream.request")));
+                break;
+            }
+        }
+        QVERIFY(found);
+    }
