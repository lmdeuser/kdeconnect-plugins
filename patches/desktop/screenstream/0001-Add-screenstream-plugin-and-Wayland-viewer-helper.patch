+#define PACKET_TYPE_SCREENSTREAM QStringLiteral("kdeconnect.screenstream")
+#define PACKET_TYPE_SCREENSTREAM_REQUEST QStringLiteral("kdeconnect.screenstream.request")
+
+class ScreenStreamPlugin : public KdeConnectPlugin
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.kde.kdeconnect.device.screenstream")
+    Q_PROPERTY(bool active READ active NOTIFY activeChanged)
+    Q_PROPERTY(bool isStreaming READ isStreaming NOTIFY streamingChanged)
+    Q_PROPERTY(QString state READ state NOTIFY stateChanged)
+    Q_PROPERTY(QString lastError READ lastError NOTIFY lastErrorChanged)
+    Q_PROPERTY(bool audioAvailable READ audioAvailable NOTIFY audioStatusChanged)
+    Q_PROPERTY(QString audioReason READ audioReason NOTIFY audioStatusChanged)
+    Q_PROPERTY(bool accessibilityEnabled READ accessibilityEnabled NOTIFY stateChanged)
+    Q_PROPERTY(int displayWidth READ displayWidth NOTIFY geometryChanged)
+    Q_PROPERTY(int displayHeight READ displayHeight NOTIFY geometryChanged)
+    Q_PROPERTY(int streamWidth READ streamWidth NOTIFY geometryChanged)
+    Q_PROPERTY(int streamHeight READ streamHeight NOTIFY geometryChanged)
+    Q_PROPERTY(int rotation READ rotation NOTIFY geometryChanged)
+
+public:
+    explicit ScreenStreamPlugin(QObject *parent, const QVariantList &args);
+    ~ScreenStreamPlugin() override;
+
+    bool active() const;
+    bool isStreaming() const;
+    QString state() const;
+    QString lastError() const;
+    bool audioAvailable() const;
+    QString audioReason() const;
+    bool accessibilityEnabled() const;
+    int displayWidth() const;
+    int displayHeight() const;
+    int streamWidth() const;
+    int streamHeight() const;
+    int rotation() const;
+
+    void connected() override;
+    QString dbusPath() const override;
+    void receivePacket(const NetworkPacket &np) override;
+
+    Q_SCRIPTABLE bool startStream();
+    Q_SCRIPTABLE void stopStream();
+    Q_SCRIPTABLE void requestKeyframe();
+
+Q_SIGNALS:
+    Q_SCRIPTABLE void activeChanged();
+    Q_SCRIPTABLE void streamingChanged(bool streaming);
+    Q_SCRIPTABLE void stateChanged();
+    Q_SCRIPTABLE void lastErrorChanged();
+    Q_SCRIPTABLE void audioStatusChanged(bool available, const QString &reason);
+    Q_SCRIPTABLE void geometryChanged(int width, int height, int rotation);
+
+private Q_SLOTS:
+    void onConfigChanged();
+    void onPayloadReadyRead();
+    void onPayloadClosed();
+    void onNewViewerConnection();
+    void onViewerSocketDisconnected();
+    void onViewerFinished();
+    void onReconnectTimeout();
+
+private:
+    bool peerSupportsScreenStream() const;
+    bool ensureLocalServer();
+    bool launchViewer();
+    void teardownSession(bool terminateViewer);
+    void removeSocketFile();
+    void setLastError(const QString &error);
+    void syncStateSignals(bool wasActive, bool wasStreaming);
+    void scheduleReconnectIfNeeded();
+    void sendStartPacket();
+    void enqueueOrSendFrame(const ScreenStreamProtocol::ScreenStreamFrame &frame);
+    void flushPendingFrames();
+
+    ScreenStreamProtocol::ScreenStreamSessionMachine m_session;
+    ScreenStreamProtocol::ScreenStreamFrameParser m_parser;
+
+    QSharedPointer<QIODevice> m_payload;
+    QLocalServer *m_localServer = nullptr;
+    QPointer<QLocalSocket> m_viewerSocket;
+    QProcess *m_viewerProcess = nullptr;
+    QTimer *m_reconnectTimer = nullptr;
+
+    QString m_socketPath;
+    QString m_fallbackSocketDir;
+    QString m_lastError;
+    QString m_audioReason;
+    bool m_audioAvailable = false;
+    bool m_accessibilityEnabled = false;
+    bool m_explicitStop = false;
+    bool m_autoStart = false;
+    bool m_requestAudio = true;
+    bool m_stopping = false;
+
+    int m_displayWidth = 0;
+    int m_displayHeight = 0;
+    int m_streamWidth = 0;
+    int m_streamHeight = 0;
+    int m_rotation = 0;
+    int m_fps = 60;
+    int m_maxWidth = 1920;
+    int m_maxHeight = 1920;
+    int m_maxFps = 60;
+    int m_maxBitrateKbps = 8000;
+
+    QByteArray m_cachedCodecConfig;
+    QList<QByteArray> m_pendingViewerFrames;
+};
