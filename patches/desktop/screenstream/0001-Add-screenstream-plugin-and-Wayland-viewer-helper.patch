+using namespace ScreenStreamProtocol;
+
+class ScreenStreamTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        QStandardPaths::setTestModeEnabled(true);
+    }
+
+    void testFrameRoundtripAndChunkSplits()
+    {
+        const QByteArray spsPps = QByteArrayLiteral("\x00\x00\x00\x01\x67\x42\x00\x1e\x00\x00\x00\x01\x68\xce\x38\x80");
+        const QByteArray idr = QByteArrayLiteral("\x00\x00\x00\x01\x65\x88\x84\x21");
+        const QByteArray pcm(1920, '\x2a');
+
+        QByteArray combined;
+        combined.append(encodeScreenStreamFrame(FrameKind::CodecConfig, FlagNone, 1000ULL, spsPps));
+        combined.append(encodeScreenStreamFrame(FrameKind::VideoAccessUnit, FlagKeyframe | FlagProtectedContent, 2000ULL, idr));
+        combined.append(encodeScreenStreamFrame(FrameKind::AudioPcmChunk, FlagNone, 3000ULL, pcm));
+        combined.append(encodeScreenStreamFrame(FrameKind::ControlEos, FlagNone, 4000ULL, {}));
+
+        ScreenStreamFrameParser parser;
+        QList<ScreenStreamFrame> frames;
+        for (qsizetype i = 0; i < combined.size(); ++i) {
+            QVERIFY(parser.feed(combined.mid(i, 1), &frames));
+        }
+
+        QVERIFY(!parser.hasError());
+        QCOMPARE(frames.size(), 4);
+
+        QCOMPARE(frames[0].kind, FrameKind::CodecConfig);
+        QCOMPARE(frames[0].flags, static_cast<quint8>(FlagNone));
+        QCOMPARE(frames[0].ptsUs, quint64(1000));
+        QCOMPARE(frames[0].payload, spsPps);
+
+        QCOMPARE(frames[1].kind, FrameKind::VideoAccessUnit);
+        QCOMPARE(frames[1].flags, static_cast<quint8>(FlagKeyframe | FlagProtectedContent));
+        QCOMPARE(frames[1].ptsUs, quint64(2000));
+        QCOMPARE(frames[1].payload, idr);
+
+        QCOMPARE(frames[2].kind, FrameKind::AudioPcmChunk);
+        QCOMPARE(frames[2].flags, static_cast<quint8>(FlagNone));
+        QCOMPARE(frames[2].ptsUs, quint64(3000));
+        QCOMPARE(frames[2].payload, pcm);
+
+        QCOMPARE(frames[3].kind, FrameKind::ControlEos);
+        QCOMPARE(frames[3].flags, static_cast<quint8>(FlagNone));
+        QCOMPARE(frames[3].ptsUs, quint64(4000));
+        QVERIFY(frames[3].payload.isEmpty());
+    }
+
+    void testFrameParserRejectsMalformedHeaders()
+    {
+        auto makeHeader = [](quint16 magic, quint8 kind, quint8 flags, quint32 len, quint64 pts) {
+            QByteArray hdr(kScreenStreamHeaderBytes, '\0');
+            auto *dst = reinterpret_cast<uchar *>(hdr.data());
+            qToBigEndian<quint16>(magic, dst);
+            dst[2] = kind;
+            dst[3] = flags;
+            qToBigEndian<quint32>(len, dst + 4);
+            qToBigEndian<quint64>(pts, dst + 8);
+            return hdr;
+        };
+
+        {
+            ScreenStreamFrameParser parser;
+            QList<ScreenStreamFrame> out;
+            QVERIFY(!parser.feed(makeHeader(0x1234, 0x02, 0x00, 4, 0), &out));
+            QVERIFY(parser.hasError());
+            QVERIFY(out.isEmpty());
+        }
+        {
+            ScreenStreamFrameParser parser;
+            QList<ScreenStreamFrame> out;
+            QVERIFY(!parser.feed(makeHeader(kScreenStreamMagic, 0x09, 0x00, 0, 0), &out));
+            QVERIFY(parser.hasError());
+        }
+        {
+            ScreenStreamFrameParser parser;
+            QList<ScreenStreamFrame> out;
+            QVERIFY(!parser.feed(makeHeader(kScreenStreamMagic, 0x04, 0x00, 1, 0), &out));
+            QVERIFY(parser.hasError());
+        }
+        {
+            ScreenStreamFrameParser parser;
+            QList<ScreenStreamFrame> out;
+            QVERIFY(!parser.feed(makeHeader(kScreenStreamMagic, 0x02, 0x00, kMaxVideoFrameBytes + 1U, 0), &out));
+            QVERIFY(parser.hasError());
+        }
+        {
+            ScreenStreamFrameParser parser;
+            QList<ScreenStreamFrame> out;
+            QVERIFY(!parser.feed(makeHeader(kScreenStreamMagic, 0x03, 0x00, kMaxAudioChunkBytes + 1U, 0), &out));
+            QVERIFY(parser.hasError());
+        }
+        {
+            ScreenStreamFrameParser parser;
+            QList<ScreenStreamFrame> out;
+            QVERIFY(!parser.feed(makeHeader(kScreenStreamMagic, 0x02, 0x04, 4, 0), &out));
+            QVERIFY(parser.hasError());
+        }
+    }
