+    void testSessionStateMachineAndReconnectSuppression()
+    {
+        ScreenStreamSessionMachine sm;
+        sm.configure(true, false);
+        QVERIFY(sm.shouldAutoStartOnConnect());
+        QVERIFY(!sm.canForwardInput());
+
+        sm.onExplicitStart();
+        QCOMPARE(sm.state(), ScreenStreamSessionMachine::State::AwaitingConsent);
+        QVERIFY(!sm.canForwardInput());
+
+        sm.onPeerState(ScreenStreamSessionMachine::State::Streaming, false);
+        QCOMPARE(sm.state(), ScreenStreamSessionMachine::State::Streaming);
+        QVERIFY(!sm.canForwardInput());
+
+        sm.setRemoteControlAllowed(true);
+        QVERIFY(sm.canForwardInput());
+
+        // Accidental transport loss with autoStart enabled schedules bounded reconnect delays (2s, 4s, 8s, then stop).
+        sm.onTransportLost();
+        QCOMPARE(sm.state(), ScreenStreamSessionMachine::State::Idle);
+        QVERIFY(!sm.canForwardInput());
+        QCOMPARE(sm.consumeReconnectDelayMs(), 2000);
+        sm.onReconnectStart();
+        QCOMPARE(sm.state(), ScreenStreamSessionMachine::State::AwaitingConsent);
+        sm.onTransportLost();
+        QCOMPARE(sm.consumeReconnectDelayMs(), 4000);
+        sm.onReconnectStart();
+        QCOMPARE(sm.state(), ScreenStreamSessionMachine::State::AwaitingConsent);
+        sm.onTransportLost();
+        QCOMPARE(sm.consumeReconnectDelayMs(), 8000);
+        sm.onReconnectStart();
+        QCOMPARE(sm.state(), ScreenStreamSessionMachine::State::AwaitingConsent);
+        sm.onTransportLost();
+        QCOMPARE(sm.consumeReconnectDelayMs(), -1);
+
+        // Explicit stop persists across reconnect and suppresses auto-start until manual start.
+        sm.onExplicitStart();
+        sm.onPeerState(ScreenStreamSessionMachine::State::Streaming, false);
+        QVERIFY(sm.canForwardInput());
+        sm.onLocalExplicitStop();
+        QCOMPARE(sm.state(), ScreenStreamSessionMachine::State::Stopped);
+        QVERIFY(sm.explicitStop());
+        QVERIFY(!sm.canForwardInput());
+        QVERIFY(!sm.shouldAutoStartOnConnect());
+        QCOMPARE(sm.consumeReconnectDelayMs(), -1);
+
+        // Simulated disconnect/reconnect cycle keeping persisted explicitStop=true.
+        ScreenStreamSessionMachine reconnected;
+        reconnected.configure(true, sm.explicitStop());
+        QVERIFY(!reconnected.shouldAutoStartOnConnect());
+        QCOMPARE(reconnected.consumeReconnectDelayMs(), -1);
+    }
