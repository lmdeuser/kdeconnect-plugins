+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+import org.kde.kdeconnect 1.0
+import org.kde.kirigami as Kirigami
+
+Kirigami.ScrollablePage {
+    id: root
+
+    property string device
+
+    Component.onCompleted: {
+        autoStartCheck.checked = config.getBool("autoStart", false)
+        requestAudioCheck.checked = config.getBool("requestAudio", true)
+        maxFpsSpin.value = config.getInt("maxFps", 60)
+        maxBitrateSpin.value = config.getInt("maxBitrateKbps", 8000)
+    }
+
+    Kirigami.FormLayout {
+        KdeConnectPluginConfig {
+            id: config
+            deviceId: root.device
+            pluginName: "kdeconnect_screenstream"
+        }
+
+        QQC2.CheckBox {
+            id: autoStartCheck
+            text: i18nd("kdeconnect-plugins", "Auto-start screen streaming when this device connects")
+            onClicked: {
+                config.set("autoStart", checked)
+                if (checked) {
+                    config.set("explicitStop", false)
+                }
+            }
+        }
+
+        QQC2.CheckBox {
+            id: requestAudioCheck
+            text: i18nd("kdeconnect-plugins", "Stream playback audio when supported")
+            onClicked: config.set("requestAudio", checked)
+        }
+
+        QQC2.SpinBox {
+            id: maxFpsSpin
+            Kirigami.FormData.label: i18nd("kdeconnect-plugins", "Maximum frame rate (FPS):")
+            from: 5
+            to: 60
+            onValueModified: config.set("maxFps", value)
+        }
+
+        QQC2.SpinBox {
+            id: maxBitrateSpin
+            Kirigami.FormData.label: i18nd("kdeconnect-plugins", "Maximum video bitrate (kbps):")
+            from: 500
+            to: 20000
+            stepSize: 500
+            onValueModified: config.set("maxBitrateKbps", value)
+        }
+    }
+}
diff --git a/plugins/screenstream/screenstreamplugin.cpp b/plugins/screenstream/screenstreamplugin.cpp
