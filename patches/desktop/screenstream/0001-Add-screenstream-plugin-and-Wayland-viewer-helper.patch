+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "screenstreamprotocol.h"
+
+#include <QCoreApplication>
+#include <QTimer>
+#include <QtEndian>
+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+namespace ScreenStreamProtocol
+{
+namespace
+{
+inline constexpr int kReconnectDelaysMs[] = {2000, 4000, 8000};
+}
+
+bool isValidFrameKind(quint8 rawKind, FrameKind *outKind)
+{
+    switch (rawKind) {
+    case 0x01:
+        if (outKind) {
+            *outKind = FrameKind::CodecConfig;
+        }
+        return true;
+    case 0x02:
+        if (outKind) {
+            *outKind = FrameKind::VideoAccessUnit;
+        }
+        return true;
+    case 0x03:
+        if (outKind) {
+            *outKind = FrameKind::AudioPcmChunk;
+        }
+        return true;
+    case 0x04:
+        if (outKind) {
+            *outKind = FrameKind::ControlEos;
+        }
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool isValidPayloadLength(FrameKind kind, quint32 length)
+{
+    switch (kind) {
+    case FrameKind::CodecConfig:
+    case FrameKind::VideoAccessUnit:
+        return length <= kMaxVideoFrameBytes;
+    case FrameKind::AudioPcmChunk:
+        return length <= kMaxAudioChunkBytes;
+    case FrameKind::ControlEos:
+        return length == 0;
+    }
+    return false;
+}
+
+QByteArray encodeScreenStreamFrame(FrameKind kind, quint8 flags, quint64 ptsUs, const QByteArray &payload)
+{
+    const quint32 payloadLen = static_cast<quint32>(payload.size());
+    QByteArray out;
+    out.resize(kScreenStreamHeaderBytes + payload.size());
+
+    auto *dst = reinterpret_cast<uchar *>(out.data());
+    qToBigEndian<quint16>(kScreenStreamMagic, dst);
+    dst[2] = static_cast<uchar>(kind);
+    dst[3] = static_cast<uchar>(flags & FlagValidMask);
+    qToBigEndian<quint32>(payloadLen, dst + 4);
+    qToBigEndian<quint64>(ptsUs, dst + 8);
+
+    if (!payload.isEmpty()) {
+        std::copy(payload.constBegin(), payload.constEnd(), out.data() + kScreenStreamHeaderBytes);
+    }
+    return out;
+}
+
+bool ScreenStreamFrameParser::feed(const QByteArray &chunk, QList<ScreenStreamFrame> *outFrames)
+{
+    if (m_hasError) {
+        return false;
+    }
+    if (!chunk.isEmpty()) {
+        m_buffer.append(chunk);
+    }
+
+    while (m_buffer.size() >= kScreenStreamHeaderBytes) {
+        const auto *hdr = reinterpret_cast<const uchar *>(m_buffer.constData());
+        const quint16 magic = qFromBigEndian<quint16>(hdr);
+        if (magic != kScreenStreamMagic) {
+            setError(QStringLiteral("Invalid stream frame magic header"));
+            return false;
+        }
+
+        FrameKind kind = FrameKind::ControlEos;
+        if (!isValidFrameKind(hdr[2], &kind)) {
+            setError(QStringLiteral("Unknown stream frame kind"));
+            return false;
+        }
+
+        const quint8 flags = hdr[3];
+        if ((flags & ~FlagValidMask) != 0) {
+            setError(QStringLiteral("Non-zero reserved flags in stream frame header"));
+            return false;
+        }
+
+        const quint32 payloadLength = qFromBigEndian<quint32>(hdr + 4);
+        if (!isValidPayloadLength(kind, payloadLength)) {
+            setError(QStringLiteral("Stream frame payload length exceeds protocol limit"));
+            return false;
+        }
+
+        const qsizetype totalNeeded = static_cast<qsizetype>(kScreenStreamHeaderBytes) + static_cast<qsizetype>(payloadLength);
+        if (m_buffer.size() < totalNeeded) {
+            break;
+        }
+
+        ScreenStreamFrame frame;
+        frame.kind = kind;
+        frame.flags = flags;
+        frame.ptsUs = qFromBigEndian<quint64>(hdr + 8);
+        if (payloadLength > 0) {
+            frame.payload = m_buffer.mid(kScreenStreamHeaderBytes, static_cast<qsizetype>(payloadLength));
+        }
+
+        m_buffer.remove(0, totalNeeded);
+        if (outFrames) {
+            outFrames->append(std::move(frame));
+        }
+    }
+
+    return true;
+}
+
+void ScreenStreamFrameParser::reset()
+{
+    m_buffer.clear();
+    m_hasError = false;
+    m_errorString.clear();
+}
+
+void ScreenStreamFrameParser::setError(const QString &message)
+{
+    m_hasError = true;
+    m_errorString = message;
+    m_buffer.clear();
+}
+
+QRectF ScreenStreamCoordinateMapper::computeRenderedRect(const QSizeF &viewportSize, const QSize &streamSize)
+{
+    if (viewportSize.width() <= 0.0 || viewportSize.height() <= 0.0 || streamSize.width() <= 0 || streamSize.height() <= 0) {
+        return {};
+    }
+
+    const qreal scale = std::min(viewportSize.width() / static_cast<qreal>(streamSize.width()),
+                                   viewportSize.height() / static_cast<qreal>(streamSize.height()));
+    const qreal width = static_cast<qreal>(streamSize.width()) * scale;
+    const qreal height = static_cast<qreal>(streamSize.height()) * scale;
+    const qreal x = (viewportSize.width() - width) * 0.5;
+    const qreal y = (viewportSize.height() - height) * 0.5;
+    return QRectF(x, y, width, height);
+}
+
+QSize ScreenStreamCoordinateMapper::computeTargetCanvasSize(const QSize &sourceSize, const QSize &maxCanvasSize, const QSize &minCanvasSize)
+{
+    if (sourceSize.width() <= 0 || sourceSize.height() <= 0 || maxCanvasSize.width() <= 0 || maxCanvasSize.height() <= 0) {
+        return {};
+    }
+
+    const qreal maxFitScale = std::min(static_cast<qreal>(maxCanvasSize.width()) / static_cast<qreal>(sourceSize.width()),
+                                       static_cast<qreal>(maxCanvasSize.height()) / static_cast<qreal>(sourceSize.height()));
+    qreal scale = std::min(qreal(1.0), maxFitScale);
+    if (minCanvasSize.width() > 0 && minCanvasSize.height() > 0) {
+        const qreal minScale = std::max(static_cast<qreal>(minCanvasSize.width()) / static_cast<qreal>(sourceSize.width()),
+                                        static_cast<qreal>(minCanvasSize.height()) / static_cast<qreal>(sourceSize.height()));
+        scale = std::clamp(scale, std::min(minScale, maxFitScale), maxFitScale);
+    }
+
+    return QSize(std::max(1, static_cast<int>(std::lround(static_cast<qreal>(sourceSize.width()) * scale))),
+                 std::max(1, static_cast<int>(std::lround(static_cast<qreal>(sourceSize.height()) * scale))));
+}
+
+std::optional<QPoint> ScreenStreamCoordinateMapper::mapViewportToRemote(
+    const QPointF &pos,
+    const QSizeF &viewportSize,
+    const QSize &streamSize,
+    const QSize &remoteDisplaySize)
+{
+    if (remoteDisplaySize.width() < 2 || remoteDisplaySize.height() < 2) {
+        return std::nullopt;
+    }
+
+    const QRectF rect = computeRenderedRect(viewportSize, streamSize);
+    if (rect.isEmpty() || rect.width() <= 0.0 || rect.height() <= 0.0) {
+        return std::nullopt;
+    }
+
+    if (!rect.contains(pos)) {
+        return std::nullopt;
+    }
+
+    const qreal u = (pos.x() - rect.left()) / rect.width();
+    const qreal v = (pos.y() - rect.top()) / rect.height();
+
+    // MouseReceiverPlugin treats x==0 && y==0 as no-op, so clamp inside [1, width-1] x [1, height-1].
+    const int mappedX = std::clamp(static_cast<int>(std::lround(u * static_cast<qreal>(remoteDisplaySize.width() - 1))),
+                                   1,
+                                   remoteDisplaySize.width() - 1);
+    const int mappedY = std::clamp(static_cast<int>(std::lround(v * static_cast<qreal>(remoteDisplaySize.height() - 1))),
+                                   1,
+                                   remoteDisplaySize.height() - 1);
+    return QPoint(mappedX, mappedY);
+}
+
+QString ScreenStreamSessionMachine::stateToString(State state)
+{
+    switch (state) {
+    case State::Idle:
+        return QStringLiteral("idle");
+    case State::AwaitingConsent:
+        return QStringLiteral("awaiting_consent");
+    case State::Streaming:
+        return QStringLiteral("streaming");
+    case State::Stopped:
+        return QStringLiteral("stopped");
+    case State::Error:
+        return QStringLiteral("error");
+    }
+    return QStringLiteral("idle");
+}
+
+std::optional<ScreenStreamSessionMachine::State> ScreenStreamSessionMachine::stateFromString(const QString &value)
+{
+    if (value == QLatin1String("idle")) {
+        return State::Idle;
+    }
+    if (value == QLatin1String("awaiting_consent")) {
+        return State::AwaitingConsent;
+    }
+    if (value == QLatin1String("streaming")) {
+        return State::Streaming;
+    }
+    if (value == QLatin1String("stopped")) {
+        return State::Stopped;
+    }
+    if (value == QLatin1String("error")) {
+        return State::Error;
+    }
+    return std::nullopt;
+}
+
+void ScreenStreamSessionMachine::configure(bool autoStartEnabled, bool explicitStop)
+{
+    m_autoStartEnabled = autoStartEnabled;
+    m_explicitStop = explicitStop;
+    if (m_explicitStop) {
+        m_shouldReconnect = false;
+        m_reconnectAttempt = 0;
+    }
+}
+
+void ScreenStreamSessionMachine::setRemoteControlAllowed(bool allowed)
+{
+    m_remoteControlAllowed = allowed;
+}
+
+void ScreenStreamSessionMachine::onExplicitStart()
+{
+    m_explicitStop = false;
+    m_shouldReconnect = false;
+    m_reconnectAttempt = 0;
+    m_state = State::AwaitingConsent;
+}
+
+void ScreenStreamSessionMachine::onReconnectStart()
+{
+    m_explicitStop = false;
+    m_state = State::AwaitingConsent;
+}
+
+void ScreenStreamSessionMachine::onLocalExplicitStop()
+{
+    m_explicitStop = true;
+    m_shouldReconnect = false;
+    m_reconnectAttempt = 0;
+    m_state = State::Stopped;
+}
+
+void ScreenStreamSessionMachine::onPeerState(State newState, bool peerExplicitStop)
+{
+    m_state = newState;
+    if (peerExplicitStop) {
+        m_explicitStop = true;
+        m_shouldReconnect = false;
+        m_reconnectAttempt = 0;
+    } else if (newState == State::Streaming) {
+        m_explicitStop = false;
+        m_shouldReconnect = false;
+        m_reconnectAttempt = 0;
+    }
+}
+
+void ScreenStreamSessionMachine::onTransportLost()
+{
+    const bool wasActive = (m_state == State::Streaming || m_state == State::AwaitingConsent);
+    if (wasActive && !m_explicitStop && m_autoStartEnabled) {
+        m_shouldReconnect = true;
+    } else {
+        m_shouldReconnect = false;
+    }
+    m_state = State::Idle;
+}
+
+bool ScreenStreamSessionMachine::shouldAutoStartOnConnect() const
+{
+    return m_autoStartEnabled && !m_explicitStop;
+}
+
+int ScreenStreamSessionMachine::consumeReconnectDelayMs()
+{
+    if (m_explicitStop) {
+        return -1;
+    }
+    if (!m_shouldReconnect && !shouldAutoStartOnConnect()) {
+        return -1;
+    }
+    if (m_reconnectAttempt < 0 || m_reconnectAttempt >= static_cast<int>(std::size(kReconnectDelaysMs))) {
+        m_shouldReconnect = false;
+        return -1;
+    }
+    const int delay = kReconnectDelaysMs[m_reconnectAttempt];
+    ++m_reconnectAttempt;
+    return delay;
+}
+
+bool ScreenStreamSessionMachine::canForwardInput() const
+{
+    return m_state == State::Streaming && m_remoteControlAllowed;
+}
+
+QVariantMap buildStartRequestBody(int maxWidth, int maxHeight, int maxFps, int maxBitrateKbps, bool requestAudio)
+{
+    return QVariantMap{
+        {QStringLiteral("action"), QStringLiteral("start")},
+        {QStringLiteral("maxWidth"), std::clamp(maxWidth, 320, 3840)},
+        {QStringLiteral("maxHeight"), std::clamp(maxHeight, 320, 3840)},
+        {QStringLiteral("maxFps"), std::clamp(maxFps, 5, 60)},
+        {QStringLiteral("maxBitrateKbps"), std::clamp(maxBitrateKbps, 500, 20000)},
+        {QStringLiteral("requestAudio"), requestAudio},
+    };
+}
+
+bool isValidRotation(int rotation)
+{
+    return rotation == 0 || rotation == 90 || rotation == 180 || rotation == 270;
+}
+
+void releaseStreamPayloadSafely(QSharedPointer<QIODevice> &payload, QObject *receiver)
+{
+    if (!payload) {
+        return;
+    }
+    QSharedPointer<QIODevice> closingPayload = std::move(payload);
+    if (receiver) {
+        QObject::disconnect(closingPayload.data(), nullptr, receiver, nullptr);
+    }
+    if (QCoreApplication::instance() && !QCoreApplication::closingDown()) {
+        QTimer::singleShot(0, QCoreApplication::instance(), [closingPayload = std::move(closingPayload)]() mutable {
+            if (closingPayload->isOpen()) {
+                closingPayload->close();
+            }
+            closingPayload.reset();
+        });
+    } else {
+        if (closingPayload->isOpen()) {
+            closingPayload->close();
+        }
+        closingPayload.reset();
+    }
+}
+
+} // namespace ScreenStreamProtocol
