+
+#pragma once
+
+#include <QByteArray>
+#include <QIODevice>
+#include <QList>
+#include <QObject>
+#include <QPoint>
+#include <QPointF>
+#include <QRectF>
+#include <QSharedPointer>
+#include <QSize>
+#include <QSizeF>
+#include <QString>
+#include <QVariantMap>
+
+#include <optional>
+
+namespace ScreenStreamProtocol
+{
+inline constexpr quint16 kScreenStreamMagic = 0x4B53;
+inline constexpr int kScreenStreamHeaderBytes = 16;
+inline constexpr quint32 kMaxVideoFrameBytes = 4U * 1024U * 1024U;
+inline constexpr quint32 kMaxAudioChunkBytes = 65536U;
+inline constexpr int kMaxControlJsonBytes = 8192;
+
+enum class FrameKind : quint8 {
+    CodecConfig = 0x01,
+    VideoAccessUnit = 0x02,
+    AudioPcmChunk = 0x03,
+    ControlEos = 0x04,
+};
+
+enum FrameFlags : quint8 {
+    FlagNone = 0x00,
+    FlagKeyframe = 0x01,
+    FlagProtectedContent = 0x02,
+    FlagValidMask = 0x03,
+};
+
+struct ScreenStreamFrame {
+    FrameKind kind = FrameKind::ControlEos;
+    quint8 flags = FlagNone;
+    quint64 ptsUs = 0;
+    QByteArray payload;
+};
+
+QByteArray encodeScreenStreamFrame(FrameKind kind, quint8 flags, quint64 ptsUs, const QByteArray &payload);
+
+bool isValidFrameKind(quint8 rawKind, FrameKind *outKind);
+bool isValidPayloadLength(FrameKind kind, quint32 length);
+
+class ScreenStreamFrameParser
+{
+public:
+    ScreenStreamFrameParser() = default;
+
+    bool feed(const QByteArray &chunk, QList<ScreenStreamFrame> *outFrames);
+
+    bool hasError() const
+    {
+        return m_hasError;
+    }
+
+    QString errorString() const
+    {
+        return m_errorString;
+    }
+
+    void reset();
+
+private:
+    void setError(const QString &message);
+
+    QByteArray m_buffer;
+    bool m_hasError = false;
+    QString m_errorString;
+};
+
+class ScreenStreamCoordinateMapper
+{
+public:
+    static QRectF computeRenderedRect(const QSizeF &viewportSize, const QSize &streamSize);
+    static QSize computeTargetCanvasSize(const QSize &sourceSize, const QSize &maxCanvasSize, const QSize &minCanvasSize = QSize(240, 240));
+    static std::optional<QPoint> mapViewportToRemote(
+        const QPointF &pos,
+        const QSizeF &viewportSize,
+        const QSize &streamSize,
+        const QSize &remoteDisplaySize);
+};
+
+class ScreenStreamSessionMachine
+{
+public:
+    enum class State {
+        Idle,
+        AwaitingConsent,
+        Streaming,
+        Stopped,
+        Error,
+    };
+
+    static QString stateToString(State state);
+    static std::optional<State> stateFromString(const QString &value);
+
+    State state() const
+    {
+        return m_state;
+    }
+
+    bool explicitStop() const
+    {
+        return m_explicitStop;
+    }
+
+    bool autoStartEnabled() const
+    {
+        return m_autoStartEnabled;
+    }
+
+    bool remoteControlAllowed() const
+    {
+        return m_remoteControlAllowed;
+    }
+
+    void configure(bool autoStartEnabled, bool explicitStop);
+    void setRemoteControlAllowed(bool allowed);
+    void onExplicitStart();
+    void onReconnectStart();
+    void onLocalExplicitStop();
+    void onPeerState(State newState, bool peerExplicitStop);
+    void onTransportLost();
+
+    bool shouldAutoStartOnConnect() const;
+    int consumeReconnectDelayMs();
+    bool canForwardInput() const;
+
+private:
+    State m_state = State::Idle;
+    bool m_explicitStop = false;
+    bool m_autoStartEnabled = false;
+    bool m_remoteControlAllowed = false;
+    bool m_shouldReconnect = false;
+    int m_reconnectAttempt = 0;
+};
+
+QVariantMap buildStartRequestBody(int maxWidth, int maxHeight, int maxFps, int maxBitrateKbps, bool requestAudio);
+bool isValidRotation(int rotation);
+void releaseStreamPayloadSafely(QSharedPointer<QIODevice> &payload, QObject *receiver = nullptr);
+
+} // namespace ScreenStreamProtocol
