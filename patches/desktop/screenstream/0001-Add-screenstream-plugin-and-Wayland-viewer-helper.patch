--- /dev/null
+++ b/plugins/screenstream/screenstreamplugin.cpp
@@ -0,0 +1,741 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "screenstreamplugin.h"
+
+#include "plugin_screenstream_debug.h"
+
+#include <KLocalizedString>
+#include <KPluginFactory>
+
+#include <QAbstractSocket>
+#include <QCoreApplication>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonDocument>
+#include <QLocalServer>
+#include <QLocalSocket>
+#include <QProcess>
+#include <QStandardPaths>
+#include <QTimer>
+#include <QUuid>
+
+#include <algorithm>
+
+K_PLUGIN_CLASS_WITH_JSON(ScreenStreamPlugin, "kdeconnect_screenstream.json")
+
+namespace
+{
+inline constexpr qsizetype kMaxPendingViewerFrames = 32;
+inline constexpr qint64 kMaxViewerWriteQueueBytes = 4LL * 1024LL * 1024LL;
+} // namespace
+
+ScreenStreamPlugin::ScreenStreamPlugin(QObject *parent, const QVariantList &args)
+    : KdeConnectPlugin(parent, args)
+    , m_reconnectTimer(new QTimer(this))
+{
+    m_reconnectTimer->setSingleShot(true);
+    connect(m_reconnectTimer, &QTimer::timeout, this, &ScreenStreamPlugin::onReconnectTimeout);
+    connect(config(), &KdeConnectPluginConfig::configChanged, this, &ScreenStreamPlugin::onConfigChanged);
+    onConfigChanged();
+}
+
+ScreenStreamPlugin::~ScreenStreamPlugin()
+{
+    m_stopping = true;
+    if (m_reconnectTimer) {
+        m_reconnectTimer->stop();
+    }
+    teardownSession(true);
+}
+
+bool ScreenStreamPlugin::active() const
+{
+    const auto st = m_session.state();
+    return st == ScreenStreamProtocol::ScreenStreamSessionMachine::State::AwaitingConsent
+        || st == ScreenStreamProtocol::ScreenStreamSessionMachine::State::Streaming
+        || (m_viewerProcess != nullptr && m_viewerProcess->state() != QProcess::NotRunning);
+}
+
+bool ScreenStreamPlugin::isStreaming() const
+{
+    return m_session.state() == ScreenStreamProtocol::ScreenStreamSessionMachine::State::Streaming;
+}
+
+QString ScreenStreamPlugin::state() const
+{
+    return ScreenStreamProtocol::ScreenStreamSessionMachine::stateToString(m_session.state());
+}
+
+QString ScreenStreamPlugin::lastError() const
+{
+    return m_lastError;
+}
+
+bool ScreenStreamPlugin::audioAvailable() const
+{
+    return m_audioAvailable;
+}
+
+QString ScreenStreamPlugin::audioReason() const
+{
+    return m_audioReason;
+}
+
+bool ScreenStreamPlugin::accessibilityEnabled() const
+{
+    return m_accessibilityEnabled;
+}
+
+int ScreenStreamPlugin::displayWidth() const
+{
+    return m_displayWidth;
+}
+
+int ScreenStreamPlugin::displayHeight() const
+{
+    return m_displayHeight;
+}
+
+int ScreenStreamPlugin::streamWidth() const
+{
+    return m_streamWidth;
+}
+
+int ScreenStreamPlugin::streamHeight() const
+{
+    return m_streamHeight;
+}
+
+int ScreenStreamPlugin::rotation() const
+{
+    return m_rotation;
+}
+
+QString ScreenStreamPlugin::dbusPath() const
+{
+    return QLatin1String("/modules/kdeconnect/devices/%1/screenstream").arg(device()->id());
+}
+
+void ScreenStreamPlugin::onConfigChanged()
+{
+    m_explicitStop = config()->getBool(QStringLiteral("explicitStop"), false);
+    m_autoStart = config()->getBool(QStringLiteral("autoStart"), false);
+    m_requestAudio = config()->getBool(QStringLiteral("requestAudio"), true);
+    m_maxWidth = std::clamp(config()->getInt(QStringLiteral("maxWidth"), 1920), 320, 3840);
+    m_maxHeight = std::clamp(config()->getInt(QStringLiteral("maxHeight"), 1920), 320, 3840);
+    m_maxFps = std::clamp(config()->getInt(QStringLiteral("maxFps"), 60), 5, 60);
+    m_maxBitrateKbps = std::clamp(config()->getInt(QStringLiteral("maxBitrateKbps"), 8000), 500, 20000);
+    m_session.configure(m_autoStart, m_explicitStop);
+}
+
+bool ScreenStreamPlugin::peerSupportsScreenStream() const
+{
+    const QSet<QString> caps = device()->incomingCapabilities();
+    if (caps.isEmpty()) {
+        return true;
+    }
+    return caps.contains(PACKET_TYPE_SCREENSTREAM_REQUEST);
+}
+
+void ScreenStreamPlugin::connected()
+{
+    onConfigChanged();
+    if (!peerSupportsScreenStream()) {
+        return;
+    }
+
+    NetworkPacket query(PACKET_TYPE_SCREENSTREAM_REQUEST, {{QStringLiteral("action"), QStringLiteral("query_state")}});
+    sendPacket(query);
+
+    if (m_session.state() == ScreenStreamProtocol::ScreenStreamSessionMachine::State::Idle && m_session.shouldAutoStartOnConnect()) {
+        startStream();
+    }
+}
+
+bool ScreenStreamPlugin::startStream()
+{
+    if (!peerSupportsScreenStream()) {
+        setLastError(i18n("Screen streaming is not supported by this device."));
+        return false;
+    }
+
+    const bool wasActive = active();
+    const bool wasStreaming = isStreaming();
+
+    m_stopping = false;
+    m_reconnectTimer->stop();
+    setLastError(QString());
+    m_explicitStop = false;
+    config()->set(QStringLiteral("explicitStop"), false);
+
+    m_session.setRemoteControlAllowed(device()->isPluginEnabled(QStringLiteral("kdeconnect_remotecontrol")));
+    m_session.onExplicitStart();
+    sendStartPacket();
+
+    syncStateSignals(wasActive, wasStreaming);
+    Q_EMIT stateChanged();
+    return true;
+}
+
+void ScreenStreamPlugin::sendStartPacket()
+{
+    const QVariantMap body = ScreenStreamProtocol::buildStartRequestBody(m_maxWidth, m_maxHeight, m_maxFps, m_maxBitrateKbps, m_requestAudio);
+    NetworkPacket np(PACKET_TYPE_SCREENSTREAM_REQUEST, body);
+    sendPacket(np);
+}
+
+void ScreenStreamPlugin::stopStream()
+{
+    const bool wasActive = active();
+    const bool wasStreaming = isStreaming();
+
+    m_stopping = true;
+    m_reconnectTimer->stop();
+    m_explicitStop = true;
+    config()->set(QStringLiteral("explicitStop"), true);
+    m_session.onLocalExplicitStop();
+
+    if (peerSupportsScreenStream()) {
+        NetworkPacket np(PACKET_TYPE_SCREENSTREAM_REQUEST,
+                         {
+                             {QStringLiteral("action"), QStringLiteral("stop")},
+                             {QStringLiteral("explicitStop"), true},
+                         });
+        sendPacket(np);
+    }
+
+    teardownSession(true);
+    syncStateSignals(wasActive, wasStreaming);
+    Q_EMIT stateChanged();
+}
+
+void ScreenStreamPlugin::requestKeyframe()
+{
+    if (!isStreaming() || !peerSupportsScreenStream()) {
+        return;
+    }
+    NetworkPacket np(PACKET_TYPE_SCREENSTREAM_REQUEST, {{QStringLiteral("action"), QStringLiteral("request_keyframe")}});
+    sendPacket(np);
+}
+
+void ScreenStreamPlugin::receivePacket(const NetworkPacket &np)
+{
+    if (np.type() != PACKET_TYPE_SCREENSTREAM) {
+        return;
+    }
+
+    const QByteArray compactJson = QJsonDocument::fromVariant(np.body()).toJson(QJsonDocument::Compact);
+    if (compactJson.size() > ScreenStreamProtocol::kMaxControlJsonBytes) {
+        qCWarning(KDECONNECT_PLUGIN_SCREENSTREAM) << "Rejecting oversized screenstream control packet";
+        return;
+    }
+
+    const QString event = np.get<QString>(QStringLiteral("event"));
+    const bool wasActive = active();
+    const bool wasStreaming = isStreaming();
+
+    if (event == QLatin1String("state")) {
+        const auto parsedState = ScreenStreamProtocol::ScreenStreamSessionMachine::stateFromString(np.get<QString>(QStringLiteral("state")));
+        if (!parsedState.has_value()) {
+            qCWarning(KDECONNECT_PLUGIN_SCREENSTREAM) << "Ignoring unknown state value in screenstream packet";
+            return;
+        }
+        const bool peerExplicitStop = np.get<bool>(QStringLiteral("explicitStop"), false);
+        if (peerExplicitStop != m_explicitStop) {
+            m_explicitStop = peerExplicitStop;
+            config()->set(QStringLiteral("explicitStop"), m_explicitStop);
+        }
+
+        m_audioAvailable = np.get<bool>(QStringLiteral("audioAvailable"), false);
+        m_audioReason = np.get<QString>(QStringLiteral("audioReason"));
+        m_accessibilityEnabled = np.get<bool>(QStringLiteral("accessibilityEnabled"), false);
+        const int dw = np.get<int>(QStringLiteral("displayWidth"), 0);
+        const int dh = np.get<int>(QStringLiteral("displayHeight"), 0);
+        const int rot = np.get<int>(QStringLiteral("rotation"), m_rotation);
+        if (dw > 0 && dh > 0 && ScreenStreamProtocol::isValidRotation(rot)) {
+            m_displayWidth = dw;
+            m_displayHeight = dh;
+            m_rotation = rot;
+            Q_EMIT geometryChanged(m_displayWidth, m_displayHeight, m_rotation);
+        }
+
+        m_session.onPeerState(*parsedState, peerExplicitStop);
+        if (*parsedState == ScreenStreamProtocol::ScreenStreamSessionMachine::State::Stopped
+            || *parsedState == ScreenStreamProtocol::ScreenStreamSessionMachine::State::Error) {
+            teardownSession(true);
+            if (*parsedState == ScreenStreamProtocol::ScreenStreamSessionMachine::State::Error) {
+                setLastError(np.get<QString>(QStringLiteral("reason"), i18n("Screen streaming failed on the remote device.")));
+            }
+        }
+
+        Q_EMIT audioStatusChanged(m_audioAvailable, m_audioReason);
+        syncStateSignals(wasActive, wasStreaming);
+        Q_EMIT stateChanged();
+        return;
+    }
+
+    if (event == QLatin1String("geometry_changed")) {
+        const int w = np.get<int>(QStringLiteral("width"), 0);
+        const int h = np.get<int>(QStringLiteral("height"), 0);
+        const int rot = np.get<int>(QStringLiteral("rotation"), m_rotation);
+        if (w < 2 || h < 2 || !ScreenStreamProtocol::isValidRotation(rot)) {
+            qCWarning(KDECONNECT_PLUGIN_SCREENSTREAM) << "Ignoring invalid geometry_changed values";
+            return;
+        }
+        m_streamWidth = w;
+        m_streamHeight = h;
+        m_rotation = rot;
+        if (m_displayWidth <= 0 || m_displayHeight <= 0) {
+            m_displayWidth = w;
+            m_displayHeight = h;
+        }
+        Q_EMIT geometryChanged(w, h, rot);
+        return;
+    }
+
+    if (event == QLatin1String("stopped")) {
+        const bool peerExplicitStop = np.get<bool>(QStringLiteral("explicitStop"), false);
+        const QString reason = np.get<QString>(QStringLiteral("reason"));
+        if (peerExplicitStop) {
+            m_explicitStop = true;
+            config()->set(QStringLiteral("explicitStop"), true);
+        }
+        m_session.onPeerState(ScreenStreamProtocol::ScreenStreamSessionMachine::State::Stopped, peerExplicitStop);
+        teardownSession(true);
+        if (!reason.isEmpty() && reason != QLatin1String("user_stopped") && reason != QLatin1String("remote_stopped")) {
+            setLastError(reason);
+        }
+        syncStateSignals(wasActive, wasStreaming);
+        Q_EMIT stateChanged();
+        return;
+    }
+
+    if (event == QLatin1String("stream_open")) {
+        const QString videoCodec = np.get<QString>(QStringLiteral("videoCodec"));
+        const QString audioCodec = np.get<QString>(QStringLiteral("audioCodec"), QStringLiteral("none"));
+        const int w = np.get<int>(QStringLiteral("width"), 0);
+        const int h = np.get<int>(QStringLiteral("height"), 0);
+        const int rot = np.get<int>(QStringLiteral("rotation"), 0);
+        const int fps = np.get<int>(QStringLiteral("fps"), m_maxFps);
+
+        if (videoCodec != QLatin1String("h264-annexb") || w < 2 || h < 2 || !ScreenStreamProtocol::isValidRotation(rot)
+            || !np.hasPayload() || !np.payload()) {
+            setLastError(i18n("Received invalid screen stream open packet."));
+            m_session.onPeerState(ScreenStreamProtocol::ScreenStreamSessionMachine::State::Error, false);
+            teardownSession(true);
+            syncStateSignals(wasActive, wasStreaming);
+            Q_EMIT stateChanged();
+            return;
+        }
+
+        teardownSession(true);
+        m_stopping = false;
+        m_reconnectTimer->stop();
+        m_parser.reset();
+        m_cachedCodecConfig.clear();
+        m_pendingViewerFrames.clear();
+
+        m_streamWidth = w;
+        m_streamHeight = h;
+        if (m_displayWidth <= 0 || m_displayHeight <= 0) {
+            m_displayWidth = w;
+            m_displayHeight = h;
+        }
+        m_rotation = rot;
+        m_fps = std::clamp(fps, 1, 120);
+        m_audioAvailable = (audioCodec == QLatin1String("pcm_s16le_48000_mono"));
+        if (!m_audioAvailable && m_audioReason.isEmpty()) {
+            m_audioReason = (audioCodec == QLatin1String("none")) ? i18n("Audio disabled for this session") : audioCodec;
+        }
+
+        if (!ensureLocalServer() || !launchViewer()) {
+            m_session.onPeerState(ScreenStreamProtocol::ScreenStreamSessionMachine::State::Error, false);
+            if (np.payload()) {
+                np.payload()->close();
+            }
+            teardownSession(true);
+            syncStateSignals(wasActive, wasStreaming);
+            Q_EMIT stateChanged();
+            return;
+        }
+
+        m_payload = np.payload();
+        connect(m_payload.data(), &QIODevice::readyRead, this, &ScreenStreamPlugin::onPayloadReadyRead);
+        connect(m_payload.data(), &QIODevice::readChannelFinished, this, &ScreenStreamPlugin::onPayloadClosed);
+        if (auto *absSock = qobject_cast<QAbstractSocket *>(m_payload.data())) {
+            connect(absSock, &QAbstractSocket::disconnected, this, &ScreenStreamPlugin::onPayloadClosed);
+        }
+
+        m_session.onPeerState(ScreenStreamProtocol::ScreenStreamSessionMachine::State::Streaming, false);
+        setLastError(QString());
+
+        Q_EMIT geometryChanged(m_streamWidth, m_streamHeight, m_rotation);
+        Q_EMIT audioStatusChanged(m_audioAvailable, m_audioReason);
+        syncStateSignals(wasActive, wasStreaming);
+        Q_EMIT stateChanged();
+
+        if (m_payload->bytesAvailable() > 0) {
+            onPayloadReadyRead();
+        }
+        return;
+    }
+
+    qCDebug(KDECONNECT_PLUGIN_SCREENSTREAM) << "Ignoring unrecognized screenstream event:" << event;
+}
+
+bool ScreenStreamPlugin::ensureLocalServer()
+{
+    if (m_localServer) {
+        m_localServer->close();
+        m_localServer->deleteLater();
+        m_localServer = nullptr;
+    }
+    removeSocketFile();
+
+    QString baseDir = QStandardPaths::writableLocation(QStandardPaths::RuntimeLocation);
+    if (baseDir.isEmpty() || !QDir().mkpath(baseDir)) {
+        m_fallbackSocketDir = QDir(QDir::tempPath()).filePath(
+            QStringLiteral("kdeconnect-screenstream-%1").arg(QUuid::createUuid().toString(QUuid::Id128).left(12)));
+        if (!QDir().mkpath(m_fallbackSocketDir)) {
+            setLastError(i18n("Unable to create local socket directory for screen stream viewer."));
+            return false;
+        }
+        QFile::setPermissions(m_fallbackSocketDir, QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ExeOwner);
+        baseDir = m_fallbackSocketDir;
+    }
+
+    m_socketPath = QDir(baseDir).filePath(
+        QStringLiteral("kdeconnect-screenstream-%1-%2.sock")
+            .arg(QCoreApplication::applicationPid())
+            .arg(QUuid::createUuid().toString(QUuid::Id128).left(10)));
+    QLocalServer::removeServer(m_socketPath);
+
+    m_localServer = new QLocalServer(this);
+    m_localServer->setSocketOptions(QLocalServer::UserAccessOption);
+    connect(m_localServer, &QLocalServer::newConnection, this, &ScreenStreamPlugin::onNewViewerConnection);
+    if (!m_localServer->listen(m_socketPath)) {
+        setLastError(i18n("Failed to open local IPC socket for viewer: %1", m_localServer->errorString()));
+        return false;
+    }
+    return true;
+}
+
+bool ScreenStreamPlugin::launchViewer()
+{
+    QString viewerExe = QStandardPaths::findExecutable(QStringLiteral("kdeconnect-screenstream-viewer"));
+    if (viewerExe.isEmpty()) {
+        const QString sibling = QDir(QCoreApplication::applicationDirPath()).filePath(QStringLiteral("kdeconnect-screenstream-viewer"));
+        if (QFileInfo::exists(sibling) && QFileInfo(sibling).isExecutable()) {
+            viewerExe = sibling;
+        }
+    }
+    if (viewerExe.isEmpty()) {
+        setLastError(i18n("kdeconnect-screenstream-viewer executable was not found."));
+        return false;
+    }
+
+    auto *process = new QProcess(this);
+#ifdef Q_OS_UNIX
+    process->setUnixProcessParameters(QProcess::UnixProcessFlag::CloseFileDescriptors);
+#endif
+    process->setProgram(viewerExe);
+    process->setArguments({
+        QStringLiteral("--device"),
+        device()->id(),
+        QStringLiteral("--device-name"),
+        device()->name(),
+        QStringLiteral("--socket"),
+        m_socketPath,
+        QStringLiteral("--display-width"),
+        QString::number(m_displayWidth),
+        QStringLiteral("--display-height"),
+        QString::number(m_displayHeight),
+        QStringLiteral("--stream-width"),
+        QString::number(m_streamWidth),
+        QStringLiteral("--stream-height"),
+        QString::number(m_streamHeight),
+        QStringLiteral("--rotation"),
+        QString::number(m_rotation),
+    });
+
+    connect(process, &QProcess::finished, this, &ScreenStreamPlugin::onViewerFinished);
+    m_viewerProcess = process;
+    process->start();
+    if (!process->waitForStarted(3000)) {
+        setLastError(i18n("Failed to launch kdeconnect-screenstream-viewer: %1", process->errorString()));
+        disconnect(process, &QProcess::finished, this, nullptr);
+        process->deleteLater();
+        m_viewerProcess = nullptr;
+        return false;
+    }
+    return true;
+}
+
+void ScreenStreamPlugin::onNewViewerConnection()
+{
+    if (!m_localServer) {
+        return;
+    }
+    while (QLocalSocket *sock = m_localServer->nextPendingConnection()) {
+        if (m_viewerSocket) {
+            sock->close();
+            sock->deleteLater();
+            continue;
+        }
+        m_viewerSocket = sock;
+        connect(sock, &QLocalSocket::disconnected, this, &ScreenStreamPlugin::onViewerSocketDisconnected);
+        flushPendingFrames();
+    }
+}
+
+void ScreenStreamPlugin::onViewerSocketDisconnected()
+{
+    if (m_viewerSocket) {
+        m_viewerSocket->deleteLater();
+        m_viewerSocket = nullptr;
+    }
+}
+
+void ScreenStreamPlugin::onViewerFinished()
+{
+    if (!m_viewerProcess) {
+        return;
+    }
+    QProcess *proc = m_viewerProcess;
+    const QProcess::ExitStatus exitStatus = proc->exitStatus();
+    const int exitCode = proc->exitCode();
+    m_viewerProcess = nullptr;
+    proc->deleteLater();
+
+    if (m_stopping) {
+        return;
+    }
+
+    if (exitStatus != QProcess::NormalExit || exitCode != 0) {
+        const bool wasActive = active();
+        const bool wasStreaming = isStreaming();
+        setLastError(i18n("Screen stream viewer exited unexpectedly (code %1).", exitCode));
+        m_session.onPeerState(ScreenStreamProtocol::ScreenStreamSessionMachine::State::Error, false);
+        if (peerSupportsScreenStream()) {
+            NetworkPacket np(PACKET_TYPE_SCREENSTREAM_REQUEST,
+                             {
+                                 {QStringLiteral("action"), QStringLiteral("stop")},
+                                 {QStringLiteral("explicitStop"), false},
+                             });
+            sendPacket(np);
+        }
+        teardownSession(false);
+        syncStateSignals(wasActive, wasStreaming);
+        Q_EMIT stateChanged();
+        return;
+    }
+
+    // If the user closed the viewer window directly, stop cleanly without auto-restarting.
+    stopStream();
+}
+
+void ScreenStreamPlugin::onPayloadReadyRead()
+{
+    if (!m_payload) {
+        return;
+    }
+    const QByteArray data = m_payload->readAll();
+    if (data.isEmpty()) {
+        return;
+    }
+
+    QList<ScreenStreamProtocol::ScreenStreamFrame> frames;
+    if (!m_parser.feed(data, &frames)) {
+        const QString err = m_parser.errorString();
+        qCWarning(KDECONNECT_PLUGIN_SCREENSTREAM) << "Closing corrupted stream payload:" << err;
+        const bool wasActive = active();
+        const bool wasStreaming = isStreaming();
+        setLastError(err);
+        m_session.onPeerState(ScreenStreamProtocol::ScreenStreamSessionMachine::State::Error, false);
+        teardownSession(true);
+        syncStateSignals(wasActive, wasStreaming);
+        Q_EMIT stateChanged();
+        return;
+    }
+
+    for (const auto &frame : std::as_const(frames)) {
+        if (frame.kind == ScreenStreamProtocol::FrameKind::ControlEos) {
+            onPayloadClosed();
+            return;
+        }
+        enqueueOrSendFrame(frame);
+    }
+}
+
+void ScreenStreamPlugin::enqueueOrSendFrame(const ScreenStreamProtocol::ScreenStreamFrame &frame)
+{
+    const QByteArray encoded = ScreenStreamProtocol::encodeScreenStreamFrame(frame.kind, frame.flags, frame.ptsUs, frame.payload);
+    if (frame.kind == ScreenStreamProtocol::FrameKind::CodecConfig) {
+        m_cachedCodecConfig = encoded;
+    }
+
+    if (m_viewerSocket && m_viewerSocket->state() == QLocalSocket::ConnectedState) {
+        if (m_viewerSocket->bytesToWrite() < kMaxViewerWriteQueueBytes) {
+            m_viewerSocket->write(encoded);
+        } else if (frame.kind == ScreenStreamProtocol::FrameKind::CodecConfig
+                   || (frame.flags & ScreenStreamProtocol::FlagKeyframe) != 0) {
+            m_viewerSocket->write(encoded);
+        }
+        return;
+    }
+
+    if (frame.kind == ScreenStreamProtocol::FrameKind::VideoAccessUnit && (frame.flags & ScreenStreamProtocol::FlagKeyframe) != 0) {
+        // Trim stale pre-connect video deltas before an IDR so startup latency stays bounded.
+        m_pendingViewerFrames.clear();
+        if (!m_cachedCodecConfig.isEmpty()) {
+            m_pendingViewerFrames.append(m_cachedCodecConfig);
+        }
+    }
+    if (m_pendingViewerFrames.size() >= kMaxPendingViewerFrames) {
+        m_pendingViewerFrames.removeFirst();
+    }
+    m_pendingViewerFrames.append(encoded);
+}
+
+void ScreenStreamPlugin::flushPendingFrames()
+{
+    if (!m_viewerSocket || m_viewerSocket->state() != QLocalSocket::ConnectedState) {
+        return;
+    }
+    bool sentCodecConfig = false;
+    if (!m_cachedCodecConfig.isEmpty() && (m_pendingViewerFrames.isEmpty() || m_pendingViewerFrames.first() != m_cachedCodecConfig)) {
+        m_viewerSocket->write(m_cachedCodecConfig);
+        sentCodecConfig = true;
+    }
+    Q_UNUSED(sentCodecConfig)
+    for (const QByteArray &item : std::as_const(m_pendingViewerFrames)) {
+        m_viewerSocket->write(item);
+    }
+    m_pendingViewerFrames.clear();
+    m_viewerSocket->flush();
+}
+
+void ScreenStreamPlugin::onPayloadClosed()
+{
+    if (!m_payload) {
+        return;
+    }
+    const bool wasActive = active();
+    const bool wasStreaming = isStreaming();
+
+    teardownSession(true);
+    m_session.onTransportLost();
+    syncStateSignals(wasActive, wasStreaming);
+    Q_EMIT stateChanged();
+    scheduleReconnectIfNeeded();
+}
+
+void ScreenStreamPlugin::scheduleReconnectIfNeeded()
+{
+    const int delayMs = m_session.consumeReconnectDelayMs();
+    if (delayMs < 0) {
+        return;
+    }
+    m_reconnectTimer->start(delayMs);
+}
+
+void ScreenStreamPlugin::onReconnectTimeout()
+{
+    if (m_stopping || m_explicitStop || !m_autoStart || !device()->isReachable() || !peerSupportsScreenStream()) {
+        return;
+    }
+    const auto st = m_session.state();
+    if (st == ScreenStreamProtocol::ScreenStreamSessionMachine::State::Streaming
+        || st == ScreenStreamProtocol::ScreenStreamSessionMachine::State::AwaitingConsent) {
+        return;
+    }
+
+    const bool wasActive = active();
+    const bool wasStreaming = isStreaming();
+
+    m_stopping = false;
+    setLastError(QString());
+    m_session.setRemoteControlAllowed(device()->isPluginEnabled(QStringLiteral("kdeconnect_remotecontrol")));
+    m_session.onReconnectStart();
+    sendStartPacket();
+
+    syncStateSignals(wasActive, wasStreaming);
+    Q_EMIT stateChanged();
+}
+
+void ScreenStreamPlugin::teardownSession(bool terminateViewer)
+{
+    ScreenStreamProtocol::releaseStreamPayloadSafely(m_payload, this);
+    if (m_viewerSocket) {
+        disconnect(m_viewerSocket.data(), nullptr, this, nullptr);
+        m_viewerSocket->close();
+        m_viewerSocket->deleteLater();
+        m_viewerSocket = nullptr;
+    }
+    if (m_localServer) {
+        m_localServer->close();
+        m_localServer->deleteLater();
+        m_localServer = nullptr;
+    }
+    removeSocketFile();
+
+    m_pendingViewerFrames.clear();
+    m_cachedCodecConfig.clear();
+    m_parser.reset();
+
+    if (terminateViewer && m_viewerProcess) {
+        QProcess *proc = m_viewerProcess;
+        m_viewerProcess = nullptr;
+        disconnect(proc, &QProcess::finished, this, nullptr);
+        if (proc->state() != QProcess::NotRunning) {
+            proc->terminate();
+            if (!proc->waitForFinished(1500)) {
+                proc->kill();
+                proc->waitForFinished(1000);
+            }
+        }
+        proc->deleteLater();
+    }
+}
+
+void ScreenStreamPlugin::removeSocketFile()
+{
+    if (!m_socketPath.isEmpty()) {
+        QLocalServer::removeServer(m_socketPath);
+        QFile::remove(m_socketPath);
+        m_socketPath.clear();
+    }
+    if (!m_fallbackSocketDir.isEmpty()) {
+        QDir(m_fallbackSocketDir).removeRecursively();
+        m_fallbackSocketDir.clear();
+    }
+}
+
+void ScreenStreamPlugin::setLastError(const QString &error)
+{
+    if (m_lastError == error) {
+        return;
+    }
+    m_lastError = error;
+    Q_EMIT lastErrorChanged();
+}
+
+void ScreenStreamPlugin::syncStateSignals(bool wasActive, bool wasStreaming)
+{
+    const bool nowActive = active();
+    const bool nowStreaming = isStreaming();
+    if (nowActive != wasActive) {
+        Q_EMIT activeChanged();
+    }
+    if (nowStreaming != wasStreaming) {
+        Q_EMIT streamingChanged(nowStreaming);
+    }
+}
+
+#include "moc_screenstreamplugin.cpp"
+#include "screenstreamplugin.moc"
