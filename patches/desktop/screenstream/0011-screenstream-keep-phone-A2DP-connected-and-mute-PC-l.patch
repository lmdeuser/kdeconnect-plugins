+void ScreenStreamPlugin::setPhoneBluezA2dpInputMuted(const QString &bluezDevPath, bool muted) const
+{
+    const qsizetype devIdx = bluezDevPath.lastIndexOf(QLatin1String("/dev_"));
+    if (devIdx < 0) {
+        return;
+    }
+    const QString macUnderscored = bluezDevPath.mid(devIdx + 5);
+    if (macUnderscored.isEmpty()) {
+        return;
+    }
+    QString macColon = macUnderscored;
+    macColon.replace(QLatin1Char('_'), QLatin1Char(':'));
+
+    const QString pactlExe = QStandardPaths::findExecutable(QStringLiteral("pactl"));
+    if (pactlExe.isEmpty()) {
+        return;
+    }
+
+    QProcess listProc;
+    QProcessEnvironment env = QProcessEnvironment::systemEnvironment();
+    env.insert(QStringLiteral("LC_ALL"), QStringLiteral("C"));
+    listProc.setProcessEnvironment(env);
+    listProc.start(pactlExe, {QStringLiteral("list"), QStringLiteral("sink-inputs")});
+    if (!listProc.waitForFinished(500) || listProc.exitCode() != 0) {
+        return;
+    }
+
+    const QString inputPrefix = QStringLiteral("bluez_input.") + macUnderscored;
+    const QString addrTarget = QStringLiteral("api.bluez5.address = \"") + macColon + QLatin1Char('"');
+    const QString output = QString::fromUtf8(listProc.readAllStandardOutput());
+    const QStringList lines = output.split(QLatin1Char('\n'));
+
+    QString currentId;
+    bool matchesMac = false;
+    bool isA2dpSource = false;
+
+    auto flushBlock = [&]() {
+        if (!currentId.isEmpty() && matchesMac && isA2dpSource) {
+            QProcess::startDetached(
+                pactlExe,
+                {QStringLiteral("set-sink-input-mute"), currentId, muted ? QStringLiteral("1") : QStringLiteral("0")});
+        }
+    };
+
+    for (const QString &rawLine : lines) {
+        const QString line = rawLine.trimmed();
+        if (line.startsWith(QLatin1String("Sink Input #"))) {
+            flushBlock();
+            currentId = line.mid(12).trimmed();
+            matchesMac = false;
+            isA2dpSource = false;
+            continue;
+        }
+        if (currentId.isEmpty()) {
+            continue;
+        }
+        if (line.contains(inputPrefix, Qt::CaseInsensitive) || line.contains(addrTarget, Qt::CaseInsensitive)) {
+            matchesMac = true;
+        }
+        if (line.contains(QLatin1String("api.bluez5.profile = \"a2dp-source\""))
+            || line.contains(QLatin1String("api.bluez5.a2dp.source"))) {
+            isA2dpSource = true;
+        }
+    }
+    flushBlock();
+}
