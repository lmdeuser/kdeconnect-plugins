+PcmTimestampTracker::PcmTimestampTracker(int sampleRate, int channels)
+{
+    setFormat(sampleRate, channels);
+}
+
+void PcmTimestampTracker::setFormat(int sampleRate, int channels)
+{
+    const int safeRate = std::clamp(sampleRate, 8000, 96000);
+    const int safeChannels = std::clamp(channels, 1, 2);
+    if (safeRate != m_sampleRate || safeChannels != m_channels) {
+        m_sampleRate = safeRate;
+        m_channels = safeChannels;
+        reset();
+    }
+}
+
+void PcmTimestampTracker::reset()
+{
+    m_initialized = false;
+    m_nextPtsNs = 0;
+}
+
+PcmTimestampTracker::BufferTiming PcmTimestampTracker::nextBuffer(qsizetype payloadBytes, quint64 pipelineRunningTimeNs)
+{
+    constexpr quint64 kMaxDriftNs = 160000000ULL;
+    constexpr quint64 kInvalidClock = std::numeric_limits<quint64>::max();
+
+    BufferTiming out;
+    const qsizetype frameBytes = static_cast<qsizetype>(m_channels) * 2;
+    if (payloadBytes < frameBytes || frameBytes <= 0) {
+        return out;
+    }
+
+    const quint64 numFrames = static_cast<quint64>(payloadBytes / frameBytes);
+    const quint64 durationNs = (numFrames * 1000000000ULL) / static_cast<quint64>(m_sampleRate);
+    const bool hasClock = (pipelineRunningTimeNs != kInvalidClock);
+
+    bool needResync = !m_initialized;
+    if (!needResync && hasClock) {
+        const quint64 diff = (pipelineRunningTimeNs >= m_nextPtsNs) ? (pipelineRunningTimeNs - m_nextPtsNs) : (m_nextPtsNs - pipelineRunningTimeNs);
+        if (diff > kMaxDriftNs) {
+            needResync = true;
+        }
+    }
+
+    if (needResync) {
+        m_nextPtsNs = hasClock ? pipelineRunningTimeNs : 0ULL;
+        m_initialized = true;
+        out.discont = true;
+    }
+
+    out.ptsNs = m_nextPtsNs;
+    out.durationNs = durationNs;
+    m_nextPtsNs += durationNs;
+    return out;
+}
