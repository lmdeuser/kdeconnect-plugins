+    void testStartRequestBodyAndPcmTimestampTracker()
+    {
+        const QVariantMap defaultStart = buildStartRequestBody(1920, 1920, 60, 8000, true);
+        QCOMPARE(defaultStart.value(QStringLiteral("autoRouteAudio")).toBool(), true);
+        QCOMPARE(defaultStart.value(QStringLiteral("requestAudio")).toBool(), true);
+
+        const QVariantMap manualStart = buildStartRequestBody(1280, 720, 30, 4000, true, false);
+        QCOMPARE(manualStart.value(QStringLiteral("autoRouteAudio")).toBool(), false);
+
+        // 48 kHz stereo: 960 frames = 3840 bytes = 20 ms
+        PcmTimestampTracker stereoTracker(48000, 2);
+        const auto first = stereoTracker.nextBuffer(3840, 100000000ULL);
+        QVERIFY(first.discont);
+        QCOMPARE(first.ptsNs, quint64(100000000ULL));
+        QCOMPARE(first.durationNs, quint64(20000000ULL));
+
+        // Within 160 ms drift tolerance: continuous sample-clock PTS without discont.
+        const auto second = stereoTracker.nextBuffer(3840, 125000000ULL);
+        QVERIFY(!second.discont);
+        QCOMPARE(second.ptsNs, quint64(120000000ULL));
+        QCOMPARE(second.durationNs, quint64(20000000ULL));
+
+        // Gap > 160 ms triggers resync + DISCONT flag.
+        const auto resynced = stereoTracker.nextBuffer(3840, 500000000ULL);
+        QVERIFY(resynced.discont);
+        QCOMPARE(resynced.ptsNs, quint64(500000000ULL));
+        QCOMPARE(resynced.durationNs, quint64(20000000ULL));
+
+        // Switching to mono: 960 frames = 1920 bytes = 20 ms and resets state.
+        stereoTracker.setFormat(48000, 1);
+        const auto monoFirst = stereoTracker.nextBuffer(1920, 700000000ULL);
+        QVERIFY(monoFirst.discont);
+        QCOMPARE(monoFirst.ptsNs, quint64(700000000ULL));
+        QCOMPARE(monoFirst.durationNs, quint64(20000000ULL));
+    }
