+void ScreenStreamPlugin::onBtHeadsetOwnerChanged(const QString &mac, const QString &owner, const QString &reason)
+{
+    if (owner == QLatin1String("remote")) {
+        m_claimedBtMacs.removeAll(mac);
+        if (reason != QLatin1String("call") && active() && m_sessionAudioEnabled) {
+            setAudioEnabled(false);
+        }
+    }
+}
+
+void ScreenStreamPlugin::claimBluetoothForScreencast(bool forceManual)
+{
+    if (!forceManual && (!m_autoRouteAudio || !m_sessionAudioEnabled)) {
+        return;
+    }
+    if (!device()) {
+        return;
+    }
+    const QString path = QStringLiteral("/modules/kdeconnect/devices/%1/btaudioswitch").arg(device()->id());
+    QDBusInterface btIface(
+        QStringLiteral("org.kde.kdeconnect"),
+        path,
+        QStringLiteral("org.kde.kdeconnect.device.btaudioswitch"),
+        QDBusConnection::sessionBus());
+    if (!btIface.isValid()) {
+        return;
+    }
+    const QStringList macs = btIface.property("allowedHeadsetMacs").toStringList();
+    for (const QString &mac : macs) {
+        if (mac.isEmpty()) {
+            continue;
+        }
+        btIface.asyncCall(QStringLiteral("claimHeadset"), mac, QStringLiteral("manual"));
+        if (!m_claimedBtMacs.contains(mac)) {
+            m_claimedBtMacs.append(mac);
+        }
+    }
+}
+
+void ScreenStreamPlugin::releaseClaimedBluetooth()
+{
+    if (m_claimedBtMacs.isEmpty() || !device()) {
+        return;
+    }
+    const QStringList toRelease = m_claimedBtMacs;
+    m_claimedBtMacs.clear();
+    const QString path = QStringLiteral("/modules/kdeconnect/devices/%1/btaudioswitch").arg(device()->id());
+    QDBusInterface btIface(
+        QStringLiteral("org.kde.kdeconnect"),
+        path,
+        QStringLiteral("org.kde.kdeconnect.device.btaudioswitch"),
+        QDBusConnection::sessionBus());
+    if (btIface.isValid()) {
+        for (const QString &mac : toRelease) {
+            btIface.call(QDBus::NoBlock, QStringLiteral("releaseHeadset"), mac);
+        }
+    }
+}
+
+int ScreenStreamPlugin::audioChannelsForCodec(const QString &audioCodec)
+{
+    if (audioCodec == QLatin1String("pcm_s16le_48000_mono")) {
+        return 1;
+    }
+    return 2;
+}
