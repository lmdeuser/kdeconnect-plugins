+QRect ScreenStreamCoordinateMapper::computeClampedWindowFrame(
+    const QRect &currentFrameRect,
+    const QSize &targetClientSize,
+    const QMargins &frameMargins,
+    const QRect &availableScreenRect,
+    bool anchorCenter)
+{
+    if (targetClientSize.width() <= 0 || targetClientSize.height() <= 0 || availableScreenRect.width() <= 0
+        || availableScreenRect.height() <= 0) {
+        return {};
+    }
+
+    const int extraW = std::max(0, frameMargins.left()) + std::max(0, frameMargins.right());
+    const int extraH = std::max(0, frameMargins.top()) + std::max(0, frameMargins.bottom());
+    const int outerW = std::min(availableScreenRect.width(), targetClientSize.width() + extraW);
+    const int outerH = std::min(availableScreenRect.height(), targetClientSize.height() + extraH);
+
+    int outerX = availableScreenRect.left() + (availableScreenRect.width() - outerW) / 2;
+    int outerY = availableScreenRect.top() + (availableScreenRect.height() - outerH) / 2;
+    if (currentFrameRect.isValid() && !currentFrameRect.isEmpty()) {
+        if (anchorCenter) {
+            const QPoint center = currentFrameRect.center();
+            outerX = center.x() - (outerW / 2);
+            outerY = center.y() - (outerH / 2);
+        } else {
+            outerX = currentFrameRect.left();
+            outerY = currentFrameRect.top();
+        }
+    }
+
+    const int minX = availableScreenRect.left();
+    const int minY = availableScreenRect.top();
+    const int maxX = minX + std::max(0, availableScreenRect.width() - outerW);
+    const int maxY = minY + std::max(0, availableScreenRect.height() - outerH);
+
+    outerX = std::clamp(outerX, minX, maxX);
+    outerY = std::clamp(outerY, minY, maxY);
+    return QRect(outerX, outerY, outerW, outerH);
+}
