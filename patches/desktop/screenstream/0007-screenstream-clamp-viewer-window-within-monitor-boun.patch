+bool ViewerWindow::clampWindowViaKWin(const QSize &targetClientSize, const QSize &previousClientSize, bool anchorCenter)
+{
+    if (m_closing || !isVisible() || isMaximized() || isFullScreen() || !targetClientSize.isValid()) {
+        return false;
+    }
+
+    const QMargins margins = windowHandle() ? windowHandle()->frameMargins() : QMargins();
+    const int fallbackExtraW = std::max(0, margins.left()) + std::max(0, margins.right());
+    const int fallbackExtraH = std::max(0, margins.top()) + std::max(0, margins.bottom());
+    const int prevClientW = previousClientSize.isValid() ? previousClientSize.width() : targetClientSize.width();
+    const int prevClientH = previousClientSize.isValid() ? previousClientSize.height() : targetClientSize.height();
+
+    QString tempBase = QStandardPaths::writableLocation(QStandardPaths::RuntimeLocation);
+    if (tempBase.isEmpty()) {
+        tempBase = QDir::tempPath();
+    }
+    QTemporaryFile scriptFile(tempBase + QStringLiteral("/kdeconnect-ss-clamp-XXXXXX.js"));
+    if (!scriptFile.open()) {
+        return false;
+    }
+    scriptFile.setPermissions(QFileDevice::ReadOwner | QFileDevice::WriteOwner);
+
+    const qint64 pid = QCoreApplication::applicationPid();
+    const QString script = QStringLiteral(
+        "(function(){\n"
+        "  const targetPid = %1;\n"
+        "  const targetClientW = %2;\n"
+        "  const targetClientH = %3;\n"
+        "  const prevClientW = %4;\n"
+        "  const prevClientH = %5;\n"
+        "  const fallbackExtraW = %6;\n"
+        "  const fallbackExtraH = %7;\n"
+        "  const anchorCenter = %8;\n"
+        "  for (const w of workspace.windowList()) {\n"
+        "    if (w.pid !== targetPid || !w.normalWindow || w.minimized || w.fullScreen) continue;\n"
+        "    const area = workspace.clientArea(2, w);\n"
+        "    if (!area || area.width <= 0 || area.height <= 0) continue;\n"
+        "    const fg = w.frameGeometry;\n"
+        "    const cg = w.clientGeometry;\n"
+        "    const extraW = (cg && cg.width > 0) ? Math.max(0, Math.round(fg.width - cg.width)) : fallbackExtraW;\n"
+        "    const extraH = (cg && cg.height > 0) ? Math.max(0, Math.round(fg.height - cg.height)) : fallbackExtraH;\n"
+        "    const areaLeft = Math.round(area.left);\n"
+        "    const areaTop = Math.round(area.top);\n"
+        "    const areaW = Math.round(area.width);\n"
+        "    const areaH = Math.round(area.height);\n"
+        "    const wantW = Math.min(areaW, targetClientW + extraW);\n"
+        "    const wantH = Math.min(areaH, targetClientH + extraH);\n"
+        "    let nx = Math.round(fg.x);\n"
+        "    let ny = Math.round(fg.y);\n"
+        "    if (anchorCenter) {\n"
+        "      const prevOuterW = Math.min(areaW, prevClientW + extraW);\n"
+        "      const prevOuterH = Math.min(areaH, prevClientH + extraH);\n"
+        "      nx = Math.round(fg.x + (prevOuterW - wantW) * 0.5);\n"
+        "      ny = Math.round(fg.y + (prevOuterH - wantH) * 0.5);\n"
+        "    }\n"
+        "    const maxX = areaLeft + Math.max(0, areaW - wantW);\n"
+        "    const maxY = areaTop + Math.max(0, areaH - wantH);\n"
+        "    nx = Math.max(areaLeft, Math.min(maxX, nx));\n"
+        "    ny = Math.max(areaTop, Math.min(maxY, ny));\n"
+        "    if (Math.round(fg.x) !== nx || Math.round(fg.y) !== ny || Math.round(fg.width) !== wantW || Math.round(fg.height) !== wantH) {\n"
+        "      w.frameGeometry = {x: nx, y: ny, width: wantW, height: wantH};\n"
+        "    }\n"
+        "  }\n"
+        "})();\n")
+                                 .arg(pid)
+                                 .arg(targetClientSize.width())
+                                 .arg(targetClientSize.height())
+                                 .arg(prevClientW)
+                                 .arg(prevClientH)
+                                 .arg(fallbackExtraW)
+                                 .arg(fallbackExtraH)
+                                 .arg(anchorCenter ? QStringLiteral("true") : QStringLiteral("false"));
+
+    if (scriptFile.write(script.toUtf8()) < 0 || !scriptFile.flush()) {
+        return false;
+    }
+
+    QDBusConnection bus = QDBusConnection::sessionBus();
+    QDBusInterface scripting(QStringLiteral("org.kde.KWin"), QStringLiteral("/Scripting"), QStringLiteral("org.kde.kwin.Scripting"), bus);
+    if (!scripting.isValid()) {
+        return false;
+    }
+
+    const QString pluginName = QStringLiteral("kdeconnect_screenstream_fit_%1_%2").arg(pid).arg(++m_kwinClampSeq);
+    QDBusReply<int> loadReply = scripting.call(QStringLiteral("loadScript"), scriptFile.fileName(), pluginName);
+    if (!loadReply.isValid() || loadReply.value() < 0) {
+        return false;
+    }
+
+    const QString scriptPath = QStringLiteral("/Scripting/Script%1").arg(loadReply.value());
+    QDBusInterface scriptObj(QStringLiteral("org.kde.KWin"), scriptPath, QStringLiteral("org.kde.kwin.Script"), bus);
+    if (scriptObj.isValid()) {
+        scriptObj.call(QStringLiteral("run"));
     }
+    scripting.call(QStringLiteral("unloadScript"), pluginName);
+    return true;
 }
 
