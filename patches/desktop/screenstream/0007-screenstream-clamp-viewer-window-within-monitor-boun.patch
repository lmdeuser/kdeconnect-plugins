+    void testWindowFrameRotationClamping()
+    {
+        const QRect avail(0, 0, 1280, 722);
+        const QMargins margins(0, 28, 0, 0);
+
+        // Portrait near right edge rotating to landscape must clamp cleanly inside work area.
+        const QRect portraitRight(920, 100, 320, 608);
+        const QRect clampedLand = ScreenStreamCoordinateMapper::computeClampedWindowFrame(portraitRight, QSize(960, 480), margins, avail, true);
+        QCOMPARE(clampedLand.size(), QSize(960, 508));
+        QVERIFY(avail.contains(clampedLand));
+        QCOMPARE(clampedLand.left() + clampedLand.width(), 1280);
+
+        // Landscape near bottom edge rotating to portrait must pull top up to fit within 722 px height.
+        const QRect landscapeBottom(200, 214, 960, 508);
+        const QRect clampedPort = ScreenStreamCoordinateMapper::computeClampedWindowFrame(landscapeBottom, QSize(320, 580), margins, avail, true);
+        QCOMPARE(clampedPort.size(), QSize(320, 608));
+        QVERIFY(avail.contains(clampedPort));
+        QCOMPARE(clampedPort.top(), 114);
+        QCOMPARE(clampedPort.top() + clampedPort.height(), 722);
+
+        // Multi-monitor negative and positive offsets remain inside the active screen bounds.
+        const QRect leftMonitor(-1920, 40, 1920, 1040);
+        const QRect clampedLeft = ScreenStreamCoordinateMapper::computeClampedWindowFrame(
+            QRect(-350, 200, 320, 608), QSize(960, 480), margins, leftMonitor, false);
+        QVERIFY(leftMonitor.contains(clampedLeft));
+        QCOMPARE(clampedLeft.left() + clampedLeft.width(), 0);
+
+        const QRect rightMonitor(1920, 0, 2560, 1400);
+        const QRect clampedRight = ScreenStreamCoordinateMapper::computeClampedWindowFrame(
+            QRect(4200, 950, 320, 608), QSize(1200, 700), margins, rightMonitor, true);
+        QVERIFY(rightMonitor.contains(clampedRight));
+
+        // Oversized target window clamps outer dimensions down to available work area.
+        const QRect oversized = ScreenStreamCoordinateMapper::computeClampedWindowFrame(
+            QRect(100, 100, 500, 500), QSize(2400, 1400), margins, avail, true);
+        QCOMPARE(oversized, avail);
+
+        // Empty initial frame rect centers inside the work area.
+        const QRect initialCentered = ScreenStreamCoordinateMapper::computeClampedWindowFrame(
+            QRect(), QSize(320, 580), margins, avail, true);
+        QCOMPARE(initialCentered, QRect(480, 57, 320, 608));
+    }
