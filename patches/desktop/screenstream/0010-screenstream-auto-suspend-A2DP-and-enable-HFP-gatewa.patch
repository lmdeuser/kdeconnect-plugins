+
+void ScreenStreamPlugin::activatePhoneBluetoothCallGateway()
+{
+    const QString phonePath = !m_suspendedPhoneBluezPath.isEmpty()
+        ? m_suspendedPhoneBluezPath
+        : discoverPairedPhoneBluezPath();
+    if (phonePath.isEmpty()) {
+        return;
     }
+    setPhoneBluezCardProfile(phonePath, true);
+    QDBusMessage connHfp = QDBusMessage::createMethodCall(
+        QStringLiteral("org.bluez"),
+        phonePath,
+        QStringLiteral("org.bluez.Device1"),
+        QStringLiteral("ConnectProfile"));
+    connHfp << hfpAgUuid();
+    QDBusConnection::systemBus().asyncCall(connHfp);
 }
 
