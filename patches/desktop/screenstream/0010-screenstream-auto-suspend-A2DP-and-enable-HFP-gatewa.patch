+QString ScreenStreamPlugin::discoverPairedPhoneBluezPath() const
+{
+    QDBusConnection sysBus = QDBusConnection::systemBus();
+    if (!sysBus.isConnected()) {
+        return {};
+    }
+
+    const QString devName = device() ? device()->name().trimmed() : QString();
+    QString bestPath;
+    int bestScore = 0;
+    int candidateCount = 0;
+
+    for (int idx = 0; idx < 4; ++idx) {
+        const QString adapterPath = QStringLiteral("/org/bluez/hci%1").arg(idx);
+        QDBusMessage introMsg = QDBusMessage::createMethodCall(
+            QStringLiteral("org.bluez"),
+            adapterPath,
+            QStringLiteral("org.freedesktop.DBus.Introspectable"),
+            QStringLiteral("Introspect"));
+        const QDBusReply<QString> introReply = sysBus.call(introMsg, QDBus::Block, 300);
+        if (!introReply.isValid()) {
             continue;
         }
-        btIface.asyncCall(QStringLiteral("claimHeadset"), mac, QStringLiteral("manual"));
-        if (!m_claimedBtMacs.contains(mac)) {
-            m_claimedBtMacs.append(mac);
+
+        QXmlStreamReader xml(introReply.value());
+        while (!xml.atEnd()) {
+            xml.readNext();
+            if (!xml.isStartElement() || xml.name() != QLatin1String("node")) {
+                continue;
+            }
+            const QString childName = xml.attributes().value(QLatin1String("name")).toString();
+            if (!childName.startsWith(QLatin1String("dev_"))) {
+                continue;
+            }
+            const QString candidatePath = adapterPath + QLatin1Char('/') + childName;
+            QDBusMessage propsMsg = QDBusMessage::createMethodCall(
+                QStringLiteral("org.bluez"),
+                candidatePath,
+                QStringLiteral("org.freedesktop.DBus.Properties"),
+                QStringLiteral("GetAll"));
+            propsMsg << QStringLiteral("org.bluez.Device1");
+            const QDBusReply<QVariantMap> propsReply = sysBus.call(propsMsg, QDBus::Block, 300);
+            if (!propsReply.isValid()) {
+                continue;
+            }
+
+            const QVariantMap props = propsReply.value();
+            if (!props.value(QStringLiteral("Paired")).toBool()) {
+                continue;
+            }
+            const QStringList uuids = props.value(QStringLiteral("UUIDs")).toStringList();
+            const QString icon = props.value(QStringLiteral("Icon")).toString();
+            const bool isPhoneGateway = uuids.contains(a2dpSourceUuid(), Qt::CaseInsensitive)
+                || uuids.contains(hfpAgUuid(), Qt::CaseInsensitive)
+                || icon == QLatin1String("phone");
+            if (!isPhoneGateway) {
+                continue;
+            }
+
+            ++candidateCount;
+            const QString btName = props.value(QStringLiteral("Name")).toString().trimmed();
+            const QString btAlias = props.value(QStringLiteral("Alias")).toString().trimmed();
+            const bool connected = props.value(QStringLiteral("Connected")).toBool();
+            const bool nameMatches = !devName.isEmpty()
+                && ((!btName.isEmpty()
+                     && (btName.compare(devName, Qt::CaseInsensitive) == 0 || devName.contains(btName, Qt::CaseInsensitive)
+                         || btName.contains(devName, Qt::CaseInsensitive)))
+                    || (!btAlias.isEmpty()
+                        && (btAlias.compare(devName, Qt::CaseInsensitive) == 0 || devName.contains(btAlias, Qt::CaseInsensitive)
+                            || btAlias.contains(devName, Qt::CaseInsensitive))));
+
+            int score = 1;
+            if (nameMatches && connected) {
+                score = 4;
+            } else if (nameMatches) {
+                score = 3;
+            } else if (connected) {
+                score = 2;
+            }
+
+            if (score > bestScore) {
+                bestScore = score;
+                bestPath = candidatePath;
+            }
         }
     }
+
+    if (bestScore >= 2 || candidateCount == 1) {
+        return bestPath;
+    }
+    return {};
 }
 
