+
+void ScreenStreamPlugin::releaseClaimedBluetooth()
+{
+    if (!m_claimedBtMacs.isEmpty() && device()) {
+        const QStringList toRelease = m_claimedBtMacs;
+        m_claimedBtMacs.clear();
+        const QString path = QStringLiteral("/modules/kdeconnect/devices/%1/btaudioswitch").arg(device()->id());
+        QDBusInterface btIface(
+            QStringLiteral("org.kde.kdeconnect"),
+            path,
+            QStringLiteral("org.kde.kdeconnect.device.btaudioswitch"),
+            QDBusConnection::sessionBus());
+        if (btIface.isValid()) {
+            for (const QString &mac : toRelease) {
+                btIface.call(QDBus::NoBlock, QStringLiteral("releaseHeadset"), mac);
+            }
+        }
+    }
+
+    if (!m_suspendedPhoneBluezPath.isEmpty()) {
+        const QString phonePath = m_suspendedPhoneBluezPath;
+        m_suspendedPhoneBluezPath.clear();
+        setPhoneBluezCardProfile(phonePath, true);
+        QDBusMessage connA2dp = QDBusMessage::createMethodCall(
+            QStringLiteral("org.bluez"),
+            phonePath,
+            QStringLiteral("org.bluez.Device1"),
+            QStringLiteral("ConnectProfile"));
+        connA2dp << a2dpSourceUuid();
+        QDBusConnection::systemBus().asyncCall(connA2dp);
+
+        QDBusMessage connDev = QDBusMessage::createMethodCall(
+            QStringLiteral("org.bluez"),
+            phonePath,
+            QStringLiteral("org.bluez.Device1"),
+            QStringLiteral("Connect"));
+        QDBusConnection::systemBus().asyncCall(connDev);
+    }
+}
