+void NotificationsPlugin::openNotification(const QString &key)
+{
+    NetworkPacket np(PACKET_TYPE_NOTIFICATION_ACTION);
+    np.set<QString>(QStringLiteral("key"), key);
+    np.set<bool>(QStringLiteral("open"), true);
+    sendPacket(np);
+
+    const QString streamPath = QStringLiteral("/modules/kdeconnect/devices/%1/screenstream").arg(device()->id());
+    QDBusInterface streamIface(QStringLiteral("org.kde.kdeconnect"),
+                               streamPath,
+                               QStringLiteral("org.kde.kdeconnect.device.screenstream"),
+                               QDBusConnection::sessionBus());
+    if (!streamIface.isValid()) {
+        return;
+    }
+    if (streamIface.property("isStreaming").toBool()) {
+        streamIface.asyncCall(QStringLiteral("wakeScreen"));
+    } else {
+        streamIface.asyncCall(QStringLiteral("startStream"));
+    }
+}
