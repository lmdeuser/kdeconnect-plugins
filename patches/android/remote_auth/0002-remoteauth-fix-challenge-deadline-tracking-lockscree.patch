+
+    @Test
+    fun notificationIdStaysBoundedNonNegativeAndDisjointFromContinuityCamera() {
+        // Includes a known string with Int.MIN_VALUE hashCode: "polygenelubricants"
+        val samples = listOf("", "dev1", "polygenelubricants", "01234567-89ab-cdef-0123-456789abcdef")
+        for (id in samples) {
+            val nid = RemoteAuthProtocol.notificationIdForDevice(id)
+            assertTrue("Expected $nid in [48100, 48199]", nid in 48100..48199)
+        }
+    }
+
+    @Test
+    fun remainingTtlUsesElapsedDeadlineAndClampsExpired() {
+        assertEquals(12_000L, RemoteAuthProtocol.remainingTtlMs(expiresAtElapsedMs = 50_000L, nowElapsedMs = 38_000L, fallbackTtlMs = 30_000))
+        assertEquals(0L, RemoteAuthProtocol.remainingTtlMs(expiresAtElapsedMs = 50_000L, nowElapsedMs = 55_000L, fallbackTtlMs = 30_000))
+        assertEquals(30_000L, RemoteAuthProtocol.remainingTtlMs(expiresAtElapsedMs = 0L, nowElapsedMs = 38_000L, fallbackTtlMs = 30_000))
+        assertEquals(RemoteAuthProtocol.MIN_TTL_MS.toLong(), RemoteAuthProtocol.remainingTtlMs(expiresAtElapsedMs = 0L, nowElapsedMs = 0L, fallbackTtlMs = 100))
+    }
