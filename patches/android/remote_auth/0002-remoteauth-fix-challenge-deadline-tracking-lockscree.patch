diff --git a/src/main/java/org/kde/kdeconnect/plugins/remoteauth/RemoteAuthProtocol.kt b/src/main/java/org/kde/kdeconnect/plugins/remoteauth/RemoteAuthProtocol.kt
index 9b3dcd01b0813c98c5a861a63726be6c1675abae..60ee236fb3aebd336a638ec97eeb577d2a1357ef 100644
--- a/src/main/java/org/kde/kdeconnect/plugins/remoteauth/RemoteAuthProtocol.kt
+++ b/src/main/java/org/kde/kdeconnect/plugins/remoteauth/RemoteAuthProtocol.kt
@@ -19,6 +19,19 @@ object RemoteAuthProtocol {
     const val MAX_SUMMARY_LENGTH = 240
     const val MIN_CHALLENGE_ID_LENGTH = 8
     const val MAX_CHALLENGE_ID_LENGTH = 128
+    const val NOTIFICATION_ID_BASE = 48100
+    const val NOTIFICATION_ID_SPAN = 100
+
+    fun notificationIdForDevice(deviceId: String): Int {
+        return NOTIFICATION_ID_BASE + ((deviceId.hashCode() and 0x7FFFFFFF) % NOTIFICATION_ID_SPAN)
+    }
+
+    fun remainingTtlMs(expiresAtElapsedMs: Long, nowElapsedMs: Long, fallbackTtlMs: Int): Long {
+        if (expiresAtElapsedMs <= 0L) {
+            return fallbackTtlMs.coerceIn(MIN_TTL_MS, MAX_TTL_MS).toLong()
+        }
+        return (expiresAtElapsedMs - nowElapsedMs).coerceAtLeast(0L)
+    }
 
     private val CHALLENGE_ID_REGEX = Regex("^[A-Za-z0-9_-]{8,128}$")
 
