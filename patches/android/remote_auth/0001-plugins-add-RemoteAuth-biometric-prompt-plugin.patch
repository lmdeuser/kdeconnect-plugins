diff --git a/src/test/java/org/kde/kdeconnect/plugins/remoteauth/RemoteAuthProtocolTest.kt b/src/test/java/org/kde/kdeconnect/plugins/remoteauth/RemoteAuthProtocolTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..01384f380ac722eedbd307fa9e1395a36036b28f
--- /dev/null
+++ b/src/test/java/org/kde/kdeconnect/plugins/remoteauth/RemoteAuthProtocolTest.kt
@@ -0,0 +1,71 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+package org.kde.kdeconnect.plugins.remoteauth
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.kde.kdeconnect.NetworkPacket
+import org.junit.Test
+import java.util.Base64
+
+class RemoteAuthProtocolTest {
+
+    private fun validNonceBase64(): String {
+        val bytes = ByteArray(RemoteAuthProtocol.NONCE_BYTES) { idx -> (idx + 1).toByte() }
+        return Base64.getEncoder().encodeToString(bytes)
+    }
+
+    @Test
+    fun parseChallengeAcceptsValidPacketAndClampsFields() {
+        val np = NetworkPacket(RemoteAuthProtocol.PACKET_TYPE_REMOTEAUTH_REQUEST).apply {
+            set("challengeId", "abc123def456")
+            set("nonce", validNonceBase64())
+            set("purpose", "confirm")
+            set("summary", "Authorize\n\t " + "A".repeat(300))
+            set("ttlMs", 999_999)
+        }
+        val ch = RemoteAuthProtocol.parseChallenge(np)
+        assertNotNull(ch)
+        assertEquals("abc123def456", ch!!.challengeId)
+        assertEquals("confirm", ch.purpose)
+        assertEquals(RemoteAuthProtocol.MAX_SUMMARY_LENGTH, ch.summary.length)
+        assertEquals(RemoteAuthProtocol.MAX_TTL_MS, ch.ttlMs)
+    }
+
+    @Test
+    fun parseChallengeRejectsInvalidIdsPurposesAndNonces() {
+        val badId = NetworkPacket(RemoteAuthProtocol.PACKET_TYPE_REMOTEAUTH_REQUEST).apply {
+            set("challengeId", "bad/id")
+            set("nonce", validNonceBase64())
+            set("purpose", "confirm")
+        }
+        assertNull(RemoteAuthProtocol.parseChallenge(badId))
+
+        val badPurpose = NetworkPacket(RemoteAuthProtocol.PACKET_TYPE_REMOTEAUTH_REQUEST).apply {
+            set("challengeId", "valid_id_123")
+            set("nonce", validNonceBase64())
+            set("purpose", "sudo_root")
+        }
+        assertNull(RemoteAuthProtocol.parseChallenge(badPurpose))
+
+        val shortNonce = NetworkPacket(RemoteAuthProtocol.PACKET_TYPE_REMOTEAUTH_REQUEST).apply {
+            set("challengeId", "valid_id_123")
+            set("nonce", Base64.getEncoder().encodeToString(ByteArray(16)))
+            set("purpose", "unlock")
+        }
+        assertNull(RemoteAuthProtocol.parseChallenge(shortNonce))
+    }
+
+    @Test
+    fun buildResponsePacketSanitizesAuthType() {
+        val np = RemoteAuthProtocol.buildResponsePacket("id_123456", validNonceBase64(), true, "unknown")
+        assertEquals(RemoteAuthProtocol.PACKET_TYPE_REMOTEAUTH, np.type)
+        assertEquals(true, np.getBoolean("approved", false))
+        assertEquals("biometric", np.getString("authType"))
+    }
+}
