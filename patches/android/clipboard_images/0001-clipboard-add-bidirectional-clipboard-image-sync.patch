+package org.kde.kdeconnect.plugins.clipboard
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Assert.fail
+import org.junit.Test
+import java.io.ByteArrayInputStream
+import java.io.File
+import java.io.IOException
+import java.nio.file.Files
+
+class ClipboardImageHelperTest {
+
+    @Test
+    fun sanitizeFilenameAcceptsValidImagesAndRejectsTraversalOrInvalidExtensions() {
+        assertEquals("screenshot.png", ClipboardImageHelper.sanitizeFilename(" screenshot.PNG "))
+        assertEquals("photo_2026.jpg", ClipboardImageHelper.sanitizeFilename("photo 2026.jpg"))
+
+        val rejected = listOf(
+            null,
+            "",
+            "   ",
+            "../secret.png",
+            "sub/dir/img.png",
+            "sub\\dir\\img.png",
+            "img\u0000.png",
+            ".png",
+            "noext",
+            "payload.apk",
+            "script.sh",
+        )
+        for (bad in rejected) {
+            assertNull("Expected null for $bad", ClipboardImageHelper.sanitizeFilename(bad))
+        }
+    }
+
+    @Test
+    fun mimeHelpersIdentifyImagesAndPickSafeExtensions() {
+        assertTrue(ClipboardImageHelper.isSupportedImageMime("image/png"))
+        assertTrue(ClipboardImageHelper.isSupportedImageMime("IMAGE/JPEG"))
+        assertFalse(ClipboardImageHelper.isSupportedImageMime(null))
+        assertFalse(ClipboardImageHelper.isSupportedImageMime("image/"))
+        assertFalse(ClipboardImageHelper.isSupportedImageMime("text/plain"))
+
+        assertEquals(".png", ClipboardImageHelper.extensionForMime("image/png"))
+        assertEquals(".jpg", ClipboardImageHelper.extensionForMime("image/jpeg"))
+        assertEquals(".webp", ClipboardImageHelper.extensionForMime("image/webp"))
+        assertEquals(".gif", ClipboardImageHelper.extensionForMime("image/gif"))
+        assertEquals(".bmp", ClipboardImageHelper.extensionForMime("image/bmp"))
+        assertEquals(".png", ClipboardImageHelper.extensionForMime("image/tiff"))
+    }
+
+    @Test
+    fun boundedCopyAndReadEnforceLimitsAndCleanupOnOverflow() {
+        val tempDir = Files.createTempDirectory("clipboard-test-").toFile()
+        try {
+            val outFile = File(tempDir, "valid.png")
+            val validData = ByteArray(128) { (it and 0xFF).toByte() }
+            val copied = ClipboardImageHelper.copyStreamBounded(
+                ByteArrayInputStream(validData),
+                outFile,
+                maxBytes = 256L,
+            )
+            assertEquals(128L, copied)
+            assertTrue(outFile.isFile)
+            assertArrayEquals(validData, outFile.readBytes())
+
+            val overflowFile = File(tempDir, "overflow.png")
+            val oversized = ByteArray(300) { 1 }
+            try {
+                ClipboardImageHelper.copyStreamBounded(
+                    ByteArrayInputStream(oversized),
+                    overflowFile,
+                    maxBytes = 256L,
+                )
+                fail("Expected IOException when payload exceeds maxBytes")
+            } catch (_: IOException) {
+                assertFalse("Overflow target must be deleted", overflowFile.exists())
+            }
+
+            assertArrayEquals(validData, ClipboardImageHelper.readBytesBounded(ByteArrayInputStream(validData), 256L))
+            assertNull(ClipboardImageHelper.readBytesBounded(ByteArrayInputStream(oversized), 256L))
+            assertNull(ClipboardImageHelper.readBytesBounded(ByteArrayInputStream(ByteArray(0)), 256L))
+        } finally {
+            tempDir.deleteRecursively()
+        }
+    }
+
+    @Test
+    fun pruneCacheDirectoryKeepsOnlyMostRecentEntries() {
+        val tempDir = Files.createTempDirectory("clipboard-prune-").toFile()
+        try {
+            for (i in 1..7) {
+                val f = File(tempDir, "img_$i.png")
+                f.writeBytes(byteArrayOf(i.toByte()))
+                f.setLastModified(1_000_000L + i * 1000L)
+            }
+            ClipboardImageHelper.pruneCacheDirectory(tempDir, keepCount = 5)
+            val remaining = tempDir.listFiles()?.map { it.name }?.sorted() ?: emptyList()
+            assertEquals(listOf("img_3.png", "img_4.png", "img_5.png", "img_6.png", "img_7.png"), remaining)
+        } finally {
+            tempDir.deleteRecursively()
+        }
+    }
+}
