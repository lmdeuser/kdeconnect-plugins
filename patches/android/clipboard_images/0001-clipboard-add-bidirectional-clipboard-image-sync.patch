+    private fun sendClipboardImageUri(uri: Uri, showToast: Boolean = true): Boolean {
+        val mime = try {
+            context.contentResolver.getType(uri)
+        } catch (_: SecurityException) {
+            null
+        }
+        if (!ClipboardImageHelper.isSupportedImageMime(mime)) {
+            return false
+        }
+
+        val appContext = context.applicationContext
+        val ext = ClipboardImageHelper.extensionForMime(mime)
+        ThreadHelper.runOnNewThread {
+            try {
+                val bytes = appContext.contentResolver.openInputStream(uri)?.use { stream ->
+                    ClipboardImageHelper.readBytesBounded(stream, ClipboardImageHelper.MAX_CLIPBOARD_IMAGE_BYTES)
+                } ?: return@runOnNewThread
+
+                val np = NetworkPacket(PACKET_TYPE_CLIPBOARD_FILE)
+                np["filename"] = "${System.currentTimeMillis()}$ext"
+                np.payload = NetworkPacket.Payload(bytes)
+                device.sendPacket(np)
+
+                if (showToast) {
+                    Handler(Looper.getMainLooper()).post {
+                        Toast.makeText(appContext, R.string.pref_plugin_clipboard_sent, Toast.LENGTH_SHORT).show()
+                    }
+                }
+            } catch (e: IOException) {
+                Log.w(TAG, "Failed to read clipboard image URI", e)
+            } catch (e: SecurityException) {
+                Log.w(TAG, "Permission denied reading clipboard image URI", e)
+            }
+        }
+        return true
+    }
