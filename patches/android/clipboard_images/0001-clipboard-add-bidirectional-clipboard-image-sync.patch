+            payload.use { p ->
+                val input = p.inputStream ?: return@runOnNewThread
+                val cacheDir = File(appContext.cacheDir, ClipboardImageHelper.CACHE_SUBDIR).apply {
+                    mkdirs()
+                }
+                val outFile = File(cacheDir, "${System.currentTimeMillis()}_$safeName")
+                try {
+                    ClipboardImageHelper.copyStreamBounded(
+                        input,
+                        outFile,
+                        ClipboardImageHelper.MAX_CLIPBOARD_IMAGE_BYTES,
+                    )
+                    ClipboardImageHelper.pruneCacheDirectory(cacheDir)
+                    val uri = FileProvider.getUriForFile(
+                        appContext,
+                        "${appContext.packageName}.fileprovider",
+                        outFile,
+                    )
+                    ClipboardListener.instance(appContext).setImageUri(uri, safeName)
+                } catch (e: IOException) {
+                    Log.w(TAG, "Failed to receive clipboard image", e)
+                    outFile.delete()
+                } catch (e: IllegalArgumentException) {
+                    Log.w(TAG, "Failed to share clipboard image via FileProvider", e)
+                    outFile.delete()
+                }
+            }
+        }
+        return true
+    }
