+package org.kde.kdeconnect.plugins.clipboard
+
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.io.InputStream
+import java.util.Locale
+
+internal object ClipboardImageHelper {
+    const val MAX_CLIPBOARD_IMAGE_BYTES = 20L * 1024L * 1024L
+    const val CACHE_SUBDIR = "clipboard_images"
+    private const val MAX_FILENAME_LENGTH = 128
+    private const val COPY_BUFFER_BYTES = 8192
+
+    private val SUPPORTED_EXTENSIONS = setOf(".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp")
+    private val SAFE_CHAR_RE = Regex("[^A-Za-z0-9._-]")
+
+    fun sanitizeFilename(raw: String?): String? {
+        val trimmed = raw?.trim() ?: return null
+        if (trimmed.isEmpty() ||
+            trimmed.length > MAX_FILENAME_LENGTH ||
+            trimmed.contains('\u0000') ||
+            trimmed.contains('/') ||
+            trimmed.contains('\\') ||
+            trimmed.contains("..")
+        ) {
+            return null
+        }
+        val cleaned = SAFE_CHAR_RE.replace(trimmed, "_")
+        val dotIndex = cleaned.lastIndexOf('.')
+        if (dotIndex <= 0 || dotIndex >= cleaned.length - 1) {
+            return null
+        }
+        val stem = cleaned.substring(0, dotIndex)
+        val ext = cleaned.substring(dotIndex).lowercase(Locale.ROOT)
+        if (stem.isEmpty() || ext !in SUPPORTED_EXTENSIONS) {
+            return null
+        }
+        return stem + ext
+    }
+
+    fun isSupportedImageMime(mime: String?): Boolean {
+        val normalized = mime?.trim()?.lowercase(Locale.ROOT) ?: return false
+        return normalized.startsWith("image/") && normalized.length > "image/".length
+    }
+
+    fun extensionForMime(mime: String?): String {
+        return when (mime?.trim()?.lowercase(Locale.ROOT)) {
+            "image/jpeg", "image/jpg" -> ".jpg"
+            "image/webp" -> ".webp"
+            "image/gif" -> ".gif"
+            "image/bmp", "image/x-ms-bmp" -> ".bmp"
+            else -> ".png"
+        }
+    }
+
+    @Throws(IOException::class)
+    fun copyStreamBounded(
+        input: InputStream,
+        outputFile: File,
+        maxBytes: Long = MAX_CLIPBOARD_IMAGE_BYTES,
+    ): Long {
+        var total = 0L
+        val buffer = ByteArray(COPY_BUFFER_BYTES)
+        try {
+            FileOutputStream(outputFile).use { out ->
+                while (true) {
+                    val read = input.read(buffer)
+                    if (read < 0) {
+                        break
+                    }
+                    total += read
+                    if (total > maxBytes) {
+                        throw IOException("Clipboard image exceeds limit of $maxBytes bytes")
+                    }
+                    if (read > 0) {
+                        out.write(buffer, 0, read)
+                    }
+                }
+            }
+            if (total <= 0L) {
+                throw IOException("Empty clipboard image payload")
+            }
+            return total
+        } catch (e: IOException) {
+            outputFile.delete()
+            throw e
+        }
+    }
+
+    fun readBytesBounded(
+        input: InputStream,
+        maxBytes: Long = MAX_CLIPBOARD_IMAGE_BYTES,
+    ): ByteArray? {
+        val out = ByteArrayOutputStream()
+        val buffer = ByteArray(COPY_BUFFER_BYTES)
+        var total = 0L
+        while (true) {
+            val read = input.read(buffer)
+            if (read < 0) {
+                break
+            }
+            total += read
+            if (total > maxBytes) {
+                return null
+            }
+            if (read > 0) {
+                out.write(buffer, 0, read)
+            }
+        }
+        val bytes = out.toByteArray()
+        return if (bytes.isEmpty()) null else bytes
+    }
+
+    fun pruneCacheDirectory(cacheDir: File, keepCount: Int = 5) {
+        if (!cacheDir.isDirectory || keepCount < 0) {
+            return
+        }
+        val files = cacheDir.listFiles()?.filter { it.isFile } ?: return
+        if (files.size <= keepCount) {
+            return
+        }
+        val sortedOldestFirst = files.sortedWith(compareBy<File>({ it.lastModified() }, { it.name }))
+        val removeCount = sortedOldestFirst.size - keepCount
+        for (i in 0 until removeCount) {
+            sortedOldestFirst[i].delete()
+        }
+    }
+}
