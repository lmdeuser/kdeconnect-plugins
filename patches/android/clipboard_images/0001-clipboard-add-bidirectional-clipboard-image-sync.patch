+    private fun handleIncomingClipboardFile(np: NetworkPacket): Boolean {
+        val payload = np.payload
+        if (!np.hasPayload() || payload == null) {
+            return false
+        }
+        val safeName = ClipboardImageHelper.sanitizeFilename(np.getStringOrNull("filename"))
+        if (safeName == null || payload.payloadSize > ClipboardImageHelper.MAX_CLIPBOARD_IMAGE_BYTES) {
+            payload.close()
+            return false
