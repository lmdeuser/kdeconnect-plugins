     private const val COPY_BUFFER_BYTES = 8192
 
     private val SUPPORTED_EXTENSIONS = setOf(".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp")
+    private val SUPPORTED_MIME_TO_EXT = mapOf(
+        "image/png" to ".png",
+        "image/jpeg" to ".jpg",
+        "image/jpg" to ".jpg",
+        "image/webp" to ".webp",
+        "image/gif" to ".gif",
+        "image/bmp" to ".bmp",
+        "image/x-ms-bmp" to ".bmp",
+    )
     private val SAFE_CHAR_RE = Regex("[^A-Za-z0-9._-]")
 
     fun sanitizeFilename(raw: String?): String? {
@@ -47,17 +56,19 @@ internal object ClipboardImageHelper {
 
     fun isSupportedImageMime(mime: String?): Boolean {
         val normalized = mime?.trim()?.lowercase(Locale.ROOT) ?: return false
-        return normalized.startsWith("image/") && normalized.length > "image/".length
+        return normalized in SUPPORTED_MIME_TO_EXT
     }
 
     fun extensionForMime(mime: String?): String {
-        return when (mime?.trim()?.lowercase(Locale.ROOT)) {
-            "image/jpeg", "image/jpg" -> ".jpg"
-            "image/webp" -> ".webp"
-            "image/gif" -> ".gif"
-            "image/bmp", "image/x-ms-bmp" -> ".bmp"
-            else -> ".png"
-        }
+        val normalized = mime?.trim()?.lowercase(Locale.ROOT) ?: return ".png"
+        return SUPPORTED_MIME_TO_EXT[normalized] ?: ".png"
+    }
+
+    fun isDeclaredSizeWithinLimit(
+        declaredLength: Long,
+        maxBytes: Long = MAX_CLIPBOARD_IMAGE_BYTES,
+    ): Boolean {
+        return declaredLength < 0L || declaredLength <= maxBytes
     }
 
     @Throws(IOException::class)
