diff --git a/src/test/java/org/kde/kdeconnect/plugins/btaudioswitch/BtAudioSwitchProtocolTest.kt b/src/test/java/org/kde/kdeconnect/plugins/btaudioswitch/BtAudioSwitchProtocolTest.kt
index 8c1b2082aae32a8711b13c6f3aea6dc07204b4b8..a6398ed0fdedf5d72e65a2907db19ffd37f7f4c7 100644
--- a/src/test/java/org/kde/kdeconnect/plugins/btaudioswitch/BtAudioSwitchProtocolTest.kt
+++ b/src/test/java/org/kde/kdeconnect/plugins/btaudioswitch/BtAudioSwitchProtocolTest.kt
@@ -87,4 +87,85 @@ class BtAudioSwitchProtocolTest {
         }
         assertNull(BtAudioSwitchProtocol.parsePacket(malformed))
     }
+
+    @Test
+    fun coordinatorSuppressesSameOwnerNonManualSpamWhileAllowingManualAndHigherPriority() {
+        val coord = BtAudioSwitchProtocol.Coordinator()
+        coord.setAllowlist(listOf("AA:BB:CC:DD:EE:FF"))
+
+        assertTrue(
+            coord.evaluateTransition(
+                rawMac = "AA:BB:CC:DD:EE:FF",
+                targetOwner = BtAudioSwitchProtocol.Owner.LOCAL,
+                reason = BtAudioSwitchProtocol.SwitchReason.MEDIA,
+                nowMs = 10_000L,
+            ).accepted
+        )
+
+        // Repeat same-owner non-MANUAL MEDIA claim is rejected even after hysteresis cooldown
+        val repeatMedia = coord.evaluateTransition(
+            rawMac = "AA:BB:CC:DD:EE:FF",
+            targetOwner = BtAudioSwitchProtocol.Owner.LOCAL,
+            reason = BtAudioSwitchProtocol.SwitchReason.MEDIA,
+            nowMs = 20_000L,
+        )
+        assertFalse(repeatMedia.accepted)
+        assertEquals("already_owned", repeatMedia.rejectReason)
+
+        // MANUAL claim by same owner succeeds
+        assertTrue(
+            coord.evaluateTransition(
+                rawMac = "AA:BB:CC:DD:EE:FF",
+                targetOwner = BtAudioSwitchProtocol.Owner.LOCAL,
+                reason = BtAudioSwitchProtocol.SwitchReason.MANUAL,
+                nowMs = 20_500L,
+            ).accepted
+        )
+
+        // Repeated MANUAL claim after hysteresis cooldown also succeeds
+        assertTrue(
+            coord.evaluateTransition(
+                rawMac = "AA:BB:CC:DD:EE:FF",
+                targetOwner = BtAudioSwitchProtocol.Owner.LOCAL,
+                reason = BtAudioSwitchProtocol.SwitchReason.MANUAL,
+                nowMs = 25_000L,
+            ).accepted
+        )
+
+        // Higher-priority CALL claim by same owner still succeeds within hysteresis
+        assertTrue(
+            coord.evaluateTransition(
+                rawMac = "AA:BB:CC:DD:EE:FF",
+                targetOwner = BtAudioSwitchProtocol.Owner.LOCAL,
+                reason = BtAudioSwitchProtocol.SwitchReason.CALL,
+                nowMs = 25_500L,
+            ).accepted
+        )
+    }
+
+    @Test
+    fun playbackSwitchReasonPrefersCallAndIgnoresEmpty() {
+        assertNull(BtAudioSwitchProtocol.resolvePlaybackSwitchReason(emptyList(), inCall = false))
+        assertEquals(
+            BtAudioSwitchProtocol.SwitchReason.MEDIA,
+            BtAudioSwitchProtocol.resolvePlaybackSwitchReason(
+                listOf(BtAudioSwitchProtocol.SwitchReason.MEDIA),
+                inCall = false,
+            ),
+        )
+        assertEquals(
+            BtAudioSwitchProtocol.SwitchReason.CALL,
+            BtAudioSwitchProtocol.resolvePlaybackSwitchReason(
+                listOf(BtAudioSwitchProtocol.SwitchReason.MEDIA),
+                inCall = true,
+            ),
+        )
+        assertEquals(
+            BtAudioSwitchProtocol.SwitchReason.CALL,
+            BtAudioSwitchProtocol.resolvePlaybackSwitchReason(
+                listOf(BtAudioSwitchProtocol.SwitchReason.MEDIA, BtAudioSwitchProtocol.SwitchReason.CALL),
+                inCall = false,
+            ),
+        )
+    }
