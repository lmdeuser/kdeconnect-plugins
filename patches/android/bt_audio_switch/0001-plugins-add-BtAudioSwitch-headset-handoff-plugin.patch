+/*
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+package org.kde.kdeconnect.plugins.btaudioswitch
+
+import android.Manifest
+import android.annotation.SuppressLint
+import android.bluetooth.BluetoothA2dp
+import android.bluetooth.BluetoothDevice
+import android.bluetooth.BluetoothHeadset
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.media.AudioDeviceInfo
+import android.media.AudioManager
+import android.media.AudioPlaybackConfiguration
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.widget.Toast
+import androidx.core.content.ContextCompat
+import androidx.core.content.getSystemService
+import org.kde.kdeconnect.plugins.Plugin
+import org.kde.kdeconnect.plugins.PluginFactory.LoadablePlugin
+import org.kde.kdeconnect.NetworkPacket
+import org.kde.kdeconnect_tp.R
+
+@LoadablePlugin
+class BtAudioSwitchPlugin : Plugin() {
+
+    private val coordinator = BtAudioSwitchProtocol.Coordinator()
+    private val mainHandler = Handler(Looper.getMainLooper())
+    private var btReceiver: BroadcastReceiver? = null
+    private var playbackCallback: AudioManager.AudioPlaybackCallback? = null
+
+    override val displayName: String
+        get() = context.getString(R.string.pref_plugin_btaudioswitch)
+
+    override val description: String
+        get() = context.getString(R.string.pref_plugin_btaudioswitch_desc)
+
+    override val supportedPacketTypes: Array<String>
+        get() = arrayOf(BtAudioSwitchProtocol.PACKET_TYPE_BT_AUDIO_SWITCH)
+
+    override val outgoingPacketTypes: Array<String>
+        get() = arrayOf(BtAudioSwitchProtocol.PACKET_TYPE_BT_AUDIO_SWITCH)
+
+    override val optionalPermissions: Array<String>
+        get() = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            arrayOf(Manifest.permission.BLUETOOTH_CONNECT)
+        } else {
+            emptyArray()
+        }
+
+    override val optionalPermissionExplanation: Int
+        get() = R.string.btaudioswitch_optional_permission_explanation
+
+    override val settingsScope: SettingsScope = SettingsScope.PER_DEVICE
+
+    override fun onCreate() {
+        refreshAllowlist()
+        registerBluetoothReceiver()
+        registerAudioPlaybackObserver()
+    }
+
+    override fun onDestroy() {
+        btReceiver?.let { receiver ->
+            try {
+                context.unregisterReceiver(receiver)
+            } catch (_: IllegalArgumentException) {
+            }
+        }
+        btReceiver = null
+
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            playbackCallback?.let { cb ->
+                context.getSystemService<AudioManager>()?.unregisterAudioPlaybackCallback(cb)
+            }
+        }
+        playbackCallback = null
+        mainHandler.removeCallbacksAndMessages(null)
+    }
+
+    override fun getUiButtons(): List<PluginUiButton> = listOf(
+        PluginUiButton(
+            context.getString(R.string.btaudioswitch_action_claim),
+            R.drawable.ic_volume,
+        ) {
+            claimFirstConnectedAllowlistedHeadset(BtAudioSwitchProtocol.SwitchReason.MANUAL, showFeedback = true)
+        },
+    )
+
+    override fun onPacketReceived(np: NetworkPacket): Boolean {
+        val msg = BtAudioSwitchProtocol.parsePacket(np) ?: return false
+        refreshAllowlist()
+        if (!coordinator.isAllowed(msg.mac)) {
+            return false
+        }
+        if (msg.action == "status") {
+            return true
+        }
+        val nowMs = System.currentTimeMillis()
+        if (msg.action == "claim") {
+            val decision = coordinator.evaluateTransition(
+                rawMac = msg.mac,
+                targetOwner = BtAudioSwitchProtocol.Owner.REMOTE,
+                reason = msg.reason,
+                nowMs = nowMs,
+            )
+            if (!decision.accepted) {
+                return false
+            }
+            yieldLocalBluetoothAudio()
+            device.sendPacket(
+                BtAudioSwitchProtocol.buildPacket(
+                    action = "status",
+                    canonicalMac = msg.mac,
+                    reason = msg.reason,
+                    timestampMs = nowMs,
+                ),
+            )
+            return true
+        }
+        if (msg.action == "release") {
+            coordinator.evaluateTransition(
+                rawMac = msg.mac,
+                targetOwner = BtAudioSwitchProtocol.Owner.LOCAL,
+                reason = msg.reason,
+                nowMs = nowMs,
+            )
+            return true
+        }
+        return false
+    }
+
+    private fun refreshAllowlist() {
+        val raw = preferences.getString(PREF_ALLOWED_HEADSET_MACS, "").orEmpty()
+        coordinator.setAllowlist(BtAudioSwitchProtocol.parseAllowlist(raw))
+    }
+
+    private fun registerBluetoothReceiver() {
+        if (!hasBluetoothPermission()) {
+            return
+        }
+        val filter = IntentFilter().apply {
+            addAction(BluetoothA2dp.ACTION_CONNECTION_STATE_CHANGED)
+            addAction(BluetoothHeadset.ACTION_CONNECTION_STATE_CHANGED)
+        }
+        val receiver = object : BroadcastReceiver() {
+            override fun onReceive(ctx: Context?, intent: Intent?) {
+                if (intent == null || !hasBluetoothPermission()) return
+                val btDevice = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+                    intent.getParcelableExtra(BluetoothDevice.EXTRA_DEVICE, BluetoothDevice::class.java)
+                } else {
+                    @Suppress("DEPRECATION")
+                    intent.getParcelableExtra(BluetoothDevice.EXTRA_DEVICE)
+                } ?: return
+                val mac = BtAudioSwitchProtocol.normalizeMac(readDeviceAddressSafe(btDevice)) ?: return
+                refreshAllowlist()
+                if (!coordinator.isAllowed(mac)) return
+
+                val state = intent.getIntExtra(android.bluetooth.BluetoothProfile.EXTRA_STATE, -1)
+                if (state == android.bluetooth.BluetoothProfile.STATE_CONNECTED) {
+                    val audioMgr = context.getSystemService<AudioManager>()
+                    val inCall = audioMgr != null &&
+                        (audioMgr.mode == AudioManager.MODE_IN_CALL || audioMgr.mode == AudioManager.MODE_IN_COMMUNICATION)
+                    val reason = if (inCall) BtAudioSwitchProtocol.SwitchReason.CALL else BtAudioSwitchProtocol.SwitchReason.MEDIA
+                    tryClaimMac(mac, reason)
+                }
+            }
+        }
+        btReceiver = receiver
+        ContextCompat.registerReceiver(context, receiver, filter, ContextCompat.RECEIVER_EXPORTED)
+    }
+
+    private fun registerAudioPlaybackObserver() {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) {
+            return
+        }
+        val audioMgr = context.getSystemService<AudioManager>() ?: return
+        val cb = object : AudioManager.AudioPlaybackCallback() {
+            override fun onPlaybackConfigChanged(configs: MutableList<AudioPlaybackConfiguration>?) {
+                if (configs.isNullOrEmpty() || !hasBluetoothPermission()) return
+                val inCall = audioMgr.mode == AudioManager.MODE_IN_CALL ||
+                    audioMgr.mode == AudioManager.MODE_IN_COMMUNICATION
+                val reason = if (inCall) BtAudioSwitchProtocol.SwitchReason.CALL else BtAudioSwitchProtocol.SwitchReason.MEDIA
+                claimFirstConnectedAllowlistedHeadset(reason, showFeedback = false)
+            }
+        }
+        playbackCallback = cb
+        audioMgr.registerAudioPlaybackCallback(cb, mainHandler)
+    }
+
+    private fun claimFirstConnectedAllowlistedHeadset(
+        reason: BtAudioSwitchProtocol.SwitchReason,
+        showFeedback: Boolean,
+    ) {
+        refreshAllowlist()
+        val mac = findConnectedAllowlistedOutputMac()
+        if (mac == null) {
+            if (showFeedback) {
+                Toast.makeText(context, R.string.btaudioswitch_no_allowlisted_headset, Toast.LENGTH_SHORT).show()
+            }
+            return
+        }
+        if (tryClaimMac(mac, reason) && showFeedback) {
+            Toast.makeText(context, R.string.btaudioswitch_claim_sent, Toast.LENGTH_SHORT).show()
+        }
+    }
+
+    private fun findConnectedAllowlistedOutputMac(): String? {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.P || !hasBluetoothPermission()) {
+            return null
+        }
+        val audioMgr = context.getSystemService<AudioManager>() ?: return null
+        for (info in audioMgr.getDevices(AudioManager.GET_DEVICES_OUTPUTS)) {
+            if (info.type == AudioDeviceInfo.TYPE_BLUETOOTH_A2DP || info.type == AudioDeviceInfo.TYPE_BLUETOOTH_SCO) {
+                val mac = BtAudioSwitchProtocol.normalizeMac(info.address) ?: continue
+                if (coordinator.isAllowed(mac)) {
+                    return mac
+                }
+            }
+        }
+        return null
+    }
+
+    private fun tryClaimMac(canonicalMac: String, reason: BtAudioSwitchProtocol.SwitchReason): Boolean {
+        val nowMs = System.currentTimeMillis()
+        val decision = coordinator.evaluateTransition(
+            rawMac = canonicalMac,
+            targetOwner = BtAudioSwitchProtocol.Owner.LOCAL,
+            reason = reason,
+            nowMs = nowMs,
+        )
+        if (!decision.accepted) {
+            return false
+        }
+        device.sendPacket(
+            BtAudioSwitchProtocol.buildPacket(
+                action = "claim",
+                canonicalMac = canonicalMac,
+                reason = reason,
+                timestampMs = nowMs,
+            ),
+        )
+        return true
+    }
+
+    private fun yieldLocalBluetoothAudio() {
+        val audioMgr = context.getSystemService<AudioManager>() ?: return
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            audioMgr.clearCommunicationDevice()
+        } else {
+            @Suppress("DEPRECATION")
+            audioMgr.stopBluetoothSco()
+        }
+    }
+
+    private fun hasBluetoothPermission(): Boolean {
+        return Build.VERSION.SDK_INT < Build.VERSION_CODES.S || isPermissionGranted(Manifest.permission.BLUETOOTH_CONNECT)
+    }
+
+    @SuppressLint("MissingPermission")
+    private fun readDeviceAddressSafe(btDevice: BluetoothDevice): String? {
+        return try {
+            btDevice.address
+        } catch (_: SecurityException) {
+            null
+        }
+    }
+
+    companion object {
+        private const val PREF_ALLOWED_HEADSET_MACS = "allowedHeadsetMacs"
+    }
+}
