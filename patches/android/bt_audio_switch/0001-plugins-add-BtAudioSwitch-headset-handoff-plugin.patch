+/*
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+package org.kde.kdeconnect.plugins.btaudioswitch
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.kde.kdeconnect.NetworkPacket
+
+class BtAudioSwitchProtocolTest {
+
+    @Test
+    fun normalizeAndAllowlistCanonicalizeMacs() {
+        assertEquals("AA:BB:CC:DD:EE:FF", BtAudioSwitchProtocol.normalizeMac(" aa:bb:cc:dd:ee:ff "))
+        assertNull(BtAudioSwitchProtocol.normalizeMac("ZZ:BB:CC:DD:EE:FF"))
+        assertNull(BtAudioSwitchProtocol.normalizeMac("AA:BB:CC"))
+
+        val parsed = BtAudioSwitchProtocol.parseAllowlist("aa:bb:cc:dd:ee:ff, bad, 11:22:33:44:55:66, AA:BB:CC:DD:EE:FF")
+        assertEquals(setOf("AA:BB:CC:DD:EE:FF", "11:22:33:44:55:66"), parsed)
+    }
+
+    @Test
+    fun coordinatorEnforcesAllowlistHysteresisAndCallPriority() {
+        val coord = BtAudioSwitchProtocol.Coordinator()
+        coord.setAllowlist(listOf("AA:BB:CC:DD:EE:FF"))
+
+        val unlisted = coord.evaluateTransition(
+            rawMac = "11:22:33:44:55:66",
+            targetOwner = BtAudioSwitchProtocol.Owner.LOCAL,
+            reason = BtAudioSwitchProtocol.SwitchReason.MEDIA,
+            nowMs = 10_000L,
+        )
+        assertFalse(unlisted.accepted)
+        assertEquals("not_allowlisted", unlisted.rejectReason)
+
+        val localMedia = coord.evaluateTransition(
+            rawMac = "aa:bb:cc:dd:ee:ff",
+            targetOwner = BtAudioSwitchProtocol.Owner.LOCAL,
+            reason = BtAudioSwitchProtocol.SwitchReason.MEDIA,
+            nowMs = 10_000L,
+        )
+        assertTrue(localMedia.accepted)
+
+        val bounce = coord.evaluateTransition(
+            rawMac = "AA:BB:CC:DD:EE:FF",
+            targetOwner = BtAudioSwitchProtocol.Owner.REMOTE,
+            reason = BtAudioSwitchProtocol.SwitchReason.MEDIA,
+            nowMs = 11_000L,
+        )
+        assertFalse(bounce.accepted)
+        assertEquals("hysteresis_cooldown", bounce.rejectReason)
+
+        val callOverride = coord.evaluateTransition(
+            rawMac = "AA:BB:CC:DD:EE:FF",
+            targetOwner = BtAudioSwitchProtocol.Owner.LOCAL,
+            reason = BtAudioSwitchProtocol.SwitchReason.CALL,
+            nowMs = 11_500L,
+        )
+        assertTrue(callOverride.accepted)
+    }
+
+    @Test
+    fun parseAndBuildPacketRoundTrip() {
+        val packet = BtAudioSwitchProtocol.buildPacket(
+            action = "claim",
+            canonicalMac = "AA:BB:CC:DD:EE:FF",
+            reason = BtAudioSwitchProtocol.SwitchReason.CALL,
+            timestampMs = 123456L,
+        )
+        val parsed = BtAudioSwitchProtocol.parsePacket(packet)
+        assertNotNull(parsed)
+        assertEquals("claim", parsed!!.action)
+        assertEquals("AA:BB:CC:DD:EE:FF", parsed.mac)
+        assertEquals(BtAudioSwitchProtocol.SwitchReason.CALL, parsed.reason)
+
+        val malformed = NetworkPacket(BtAudioSwitchProtocol.PACKET_TYPE_BT_AUDIO_SWITCH).apply {
+            set("action", "claim")
+            set("mac", "invalid")
+            set("reason", "media")
+        }
+        assertNull(BtAudioSwitchProtocol.parsePacket(malformed))
+    }
+}
