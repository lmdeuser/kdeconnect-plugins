+/*
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+package org.kde.kdeconnect.plugins.btaudioswitch
+
+import org.kde.kdeconnect.NetworkPacket
+
+object BtAudioSwitchProtocol {
+    const val PACKET_TYPE_BT_AUDIO_SWITCH = "kdeconnect.btaudioswitch"
+    const val HYSTERESIS_MS = 3_000L
+    const val YIELD_DELAY_MS = 300L
+    const val MAX_ALLOWLIST_ENTRIES = 16
+
+    private val MAC_REGEX = Regex("^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$")
+
+    enum class Owner {
+        NONE,
+        LOCAL,
+        REMOTE,
+    }
+
+    enum class SwitchReason(val wireName: String, val priority: Int) {
+        MEDIA("media", 1),
+        MANUAL("manual", 2),
+        CALL("call", 3);
+
+        companion object {
+            fun fromWire(raw: String?): SwitchReason? {
+                return when (raw?.trim()?.lowercase()) {
+                    "media" -> MEDIA
+                    "manual" -> MANUAL
+                    "call" -> CALL
+                    else -> null
+                }
+            }
+        }
+    }
+
+    data class SwitchMessage(
+        val action: String,
+        val mac: String,
+        val reason: SwitchReason,
+        val timestampMs: Long,
+    )
+
+    data class TransitionDecision(
+        val accepted: Boolean,
+        val canonicalMac: String? = null,
+        val rejectReason: String = "",
+    )
+
+    fun normalizeMac(raw: String?): String? {
+        val trimmed = raw?.trim().orEmpty()
+        return if (MAC_REGEX.matches(trimmed)) trimmed.uppercase() else null
+    }
+
+    fun parseAllowlist(raw: String?): Set<String> {
+        if (raw.isNullOrBlank()) return emptySet()
+        val result = LinkedHashSet<String>()
+        for (part in raw.split(',')) {
+            if (result.size >= MAX_ALLOWLIST_ENTRIES) break
+            val canonical = normalizeMac(part)
+            if (canonical != null) {
+                result.add(canonical)
+            }
+        }
+        return result
+    }
+
+    fun parsePacket(np: NetworkPacket): SwitchMessage? {
+        if (np.type != PACKET_TYPE_BT_AUDIO_SWITCH) return null
+        val action = np.getStringOrNull("action")?.trim()?.lowercase() ?: return null
+        if (action != "claim" && action != "release" && action != "status") return null
+        val mac = normalizeMac(np.getStringOrNull("mac")) ?: return null
+        val reason = SwitchReason.fromWire(np.getStringOrNull("reason")) ?: return null
+        val timestampMs = np.getLong("timestampMs", 0L)
+        return SwitchMessage(action = action, mac = mac, reason = reason, timestampMs = timestampMs)
+    }
+
+    fun buildPacket(action: String, canonicalMac: String, reason: SwitchReason, timestampMs: Long): NetworkPacket {
+        return NetworkPacket(PACKET_TYPE_BT_AUDIO_SWITCH).apply {
+            set("action", action)
+            set("mac", canonicalMac)
+            set("reason", reason.wireName)
+            set("timestampMs", timestampMs)
+        }
+    }
+
+    class Coordinator {
+        private data class EntryState(
+            val owner: Owner,
+            val lastReason: SwitchReason,
+            val lastTransitionMs: Long,
+        )
+
+        private var allowlist: Set<String> = emptySet()
+        private val states = HashMap<String, EntryState>()
+
+        fun setAllowlist(macs: Collection<String>) {
+            val clean = LinkedHashSet<String>()
+            for (raw in macs) {
+                if (clean.size >= MAX_ALLOWLIST_ENTRIES) break
+                val canonical = normalizeMac(raw)
+                if (canonical != null) {
+                    clean.add(canonical)
+                }
+            }
+            allowlist = clean
+        }
+
+        fun getAllowlist(): Set<String> = allowlist
+
+        fun isAllowed(mac: String?): Boolean {
+            val canonical = normalizeMac(mac) ?: return false
+            return canonical in allowlist
+        }
+
+        fun evaluateTransition(
+            rawMac: String?,
+            targetOwner: Owner,
+            reason: SwitchReason,
+            nowMs: Long,
+        ): TransitionDecision {
+            val canonical = normalizeMac(rawMac) ?: return TransitionDecision(false, null, "invalid_mac")
+            if (canonical !in allowlist) {
+                return TransitionDecision(false, canonical, "not_allowlisted")
+            }
+
+            val prev = states[canonical]
+            if (prev != null) {
+                val elapsed = nowMs - prev.lastTransitionMs
+                if (elapsed in 0 until HYSTERESIS_MS && reason.priority <= prev.lastReason.priority) {
+                    return TransitionDecision(false, canonical, "hysteresis_cooldown")
+                }
+            }
+
+            states[canonical] = EntryState(owner = targetOwner, lastReason = reason, lastTransitionMs = nowMs)
+            return TransitionDecision(true, canonical, "")
+        }
+
+        fun ownerFor(rawMac: String?): Owner {
+            val canonical = normalizeMac(rawMac) ?: return Owner.NONE
+            return states[canonical]?.owner ?: Owner.NONE
+        }
+    }
+}
