+class ScreenStreamSessionTracker(
+    initialExplicitStop: Boolean = false,
+    initialAutoStart: Boolean = false,
+) {
+    var state: ScreenStreamProtocol.SessionState = ScreenStreamProtocol.SessionState.IDLE
+        private set
+
+    var explicitStop: Boolean = initialExplicitStop
+        private set
+
+    var autoStartEnabled: Boolean = initialAutoStart
+        private set
+
+    val hasPendingReconnect: Boolean
+        get() = shouldReconnect && !explicitStop && autoStartEnabled
+
+    private var shouldReconnect = false
+    private var reconnectAttempt = 0
+
+    fun configure(autoStart: Boolean, explicitStop: Boolean) {
+        this.autoStartEnabled = autoStart
+        this.explicitStop = explicitStop
+        if (explicitStop || !autoStart) {
+            shouldReconnect = false
+            reconnectAttempt = 0
+        }
+    }
+
+    fun shouldAutoStartOnConnect(): Boolean {
+        return autoStartEnabled && !explicitStop
+    }
+
+    fun onStartRequested(isReconnectAttempt: Boolean = false) {
+        explicitStop = false
+        shouldReconnect = autoStartEnabled
+        if (!isReconnectAttempt) {
+            reconnectAttempt = 0
+        }
+        state = ScreenStreamProtocol.SessionState.AWAITING_CONSENT
+    }
+
+    fun onStreamingStarted() {
+        explicitStop = false
+        shouldReconnect = autoStartEnabled
+        reconnectAttempt = 0
+        state = ScreenStreamProtocol.SessionState.STREAMING
+    }
+
+    fun onExplicitStop(reason: String = "user_stopped") {
+        val cleanReason = reason.ifEmpty { "user_stopped" }
+        explicitStop = (cleanReason == "user_stopped" || cleanReason == "remote_stopped")
+        shouldReconnect = false
+        reconnectAttempt = 0
+        state = ScreenStreamProtocol.SessionState.STOPPED
+    }
+
+    fun onError() {
+        state = ScreenStreamProtocol.SessionState.ERROR
+    }
+
+    fun onLinkLost() {
+        if (state == ScreenStreamProtocol.SessionState.STREAMING || state == ScreenStreamProtocol.SessionState.AWAITING_CONSENT) {
+            state = ScreenStreamProtocol.SessionState.IDLE
+            if (!explicitStop && autoStartEnabled) {
+                shouldReconnect = true
+            }
+        }
+    }
+
+    fun consumeReconnectDelayMs(): Int? {
+        if (explicitStop || !autoStartEnabled || !shouldReconnect) {
+            return null
+        }
+        val delays = ScreenStreamProtocol.RECONNECT_DELAYS_MS
+        if (reconnectAttempt >= delays.size) {
+            shouldReconnect = false
+            return null
+        }
+        val delay = delays[reconnectAttempt]
+        reconnectAttempt += 1
+        return delay
+    }
+}
