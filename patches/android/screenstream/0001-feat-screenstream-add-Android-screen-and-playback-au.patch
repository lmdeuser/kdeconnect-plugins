+    @Test
+    fun testMuxerQueueDropsNonIdrOnPressureAndResumesOnKeyframe() {
+        val queue = StreamMuxerQueue(maxVideoFrames = 4, maxAudioChunks = 2)
+        val deltaPayload = byteArrayOf(0x00, 0x00, 0x00, 0x01, 0x41)
+        val idrPayload = byteArrayOf(0x00, 0x00, 0x00, 0x01, 0x65)
+
+        for (i in 0 until 4) {
+            val res = queue.offerVideoFrame(ScreenStreamProtocol.FLAG_NONE, i.toLong(), deltaPayload)
+            assertTrue(res.accepted)
+            assertFalse(res.requestSyncFrame)
+        }
+
+        // 5th non-IDR triggers backpressure purge and demands a sync frame
+        val overflowDelta = queue.offerVideoFrame(ScreenStreamProtocol.FLAG_NONE, 4L, deltaPayload)
+        assertFalse(overflowDelta.accepted)
+        assertTrue(overflowDelta.requestSyncFrame)
+
+        // Subsequent delta continues dropping while awaiting keyframe
+        val skippedDelta = queue.offerVideoFrame(ScreenStreamProtocol.FLAG_NONE, 5L, deltaPayload)
+        assertFalse(skippedDelta.accepted)
+        assertTrue(skippedDelta.requestSyncFrame)
+
+        // Fresh IDR recovers stream
+        val recovered = queue.offerVideoFrame(ScreenStreamProtocol.FLAG_KEYFRAME, 6L, idrPayload)
+        assertTrue(recovered.accepted)
+
+        // Bounded audio drops oldest when over maxAudioChunks=2
+        assertTrue(queue.offerAudioChunk(10L, byteArrayOf(1, 2)))
+        assertTrue(queue.offerAudioChunk(11L, byteArrayOf(3, 4)))
+        assertTrue(queue.offerAudioChunk(12L, byteArrayOf(5, 6)))
+        assertEquals(Pair(1, 2), queue.queuedCounts())
+
+        queue.offerEosAndFinish(20L)
+        val streamed = queue.readBytes()
+        val decoded = ScreenStreamProtocol.parseFrames(streamed)
+        assertEquals(ScreenStreamProtocol.FrameKind.VIDEO_ACCESS_UNIT, decoded[0].kind)
+        assertEquals(6L, decoded[0].ptsUs)
+        assertEquals(ScreenStreamProtocol.FrameKind.AUDIO_PCM_CHUNK, decoded[1].kind)
+        assertEquals(11L, decoded[1].ptsUs)
+        assertEquals(ScreenStreamProtocol.FrameKind.AUDIO_PCM_CHUNK, decoded[2].kind)
+        assertEquals(12L, decoded[2].ptsUs)
+        assertEquals(ScreenStreamProtocol.FrameKind.CONTROL_EOS, decoded[3].kind)
+    }
