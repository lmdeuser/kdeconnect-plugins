--- /dev/null
+++ b/src/main/java/org/kde/kdeconnect/plugins/screenstream/ScreenEncoder.kt
@@ -0,0 +1,264 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+package org.kde.kdeconnect.plugins.screenstream
+
+import android.media.MediaCodec
+import android.media.MediaCodecInfo
+import android.media.MediaFormat
+import android.os.Build
+import android.os.Bundle
+import android.os.SystemClock
+import android.util.Log
+import android.view.Surface
+import androidx.annotation.RequiresApi
+import java.io.ByteArrayOutputStream
+import java.nio.ByteBuffer
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicLong
+
+@RequiresApi(Build.VERSION_CODES.R)
+class ScreenEncoder(
+    val width: Int,
+    val height: Int,
+    private val fps: Int,
+    private val bitrateKbps: Int,
+    private val muxerQueue: StreamMuxerQueue,
+    private val protectedContentActive: AtomicBoolean,
+    private val lastPtsUs: AtomicLong,
+    private val onFatalError: (String) -> Unit,
+) {
+    private var codec: MediaCodec? = null
+    private var workerThread: Thread? = null
+    private val stopRequested = AtomicBoolean(false)
+    private val syncRequestPending = AtomicBoolean(false)
+    private val emitConfigBeforeNextKeyframe = AtomicBoolean(false)
+
+    @Volatile
+    private var cachedCodecConfig: ByteArray? = null
+
+    var inputSurface: Surface? = null
+        private set
+
+    fun start() {
+        val created = MediaCodec.createEncoderByType(MediaFormat.MIMETYPE_VIDEO_AVC)
+        val surface = configureAndCreateSurface(created)
+        created.start()
+        codec = created
+        inputSurface = surface
+        stopRequested.set(false)
+
+        val thread = Thread(::drainLoop, "ScreenStreamEncoder")
+        workerThread = thread
+        thread.start()
+    }
+
+    fun requestSyncFrame(forceCodecConfig: Boolean = false) {
+        if (forceCodecConfig) {
+            emitConfigBeforeNextKeyframe.set(true)
+        }
+        syncRequestPending.set(true)
+    }
+
+    fun stop() {
+        stopRequested.set(true)
+        val thread = workerThread
+        workerThread = null
+        if (thread != null && thread !== Thread.currentThread()) {
+            try {
+                thread.join(1500)
+            } catch (_: InterruptedException) {
+                Thread.currentThread().interrupt()
+            }
+        }
+        releaseCodecResources()
+    }
+
+    private fun configureAndCreateSurface(encoder: MediaCodec): Surface {
+        val baseFormat = buildVideoFormat(includeLowLatency = true)
+        try {
+            encoder.configure(baseFormat, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
+            return encoder.createInputSurface()
+        } catch (first: Exception) {
+            Log.w(TAG, "Low-latency AVC format rejected, retrying core format: ${first.message}")
+            encoder.reset()
+            val fallbackFormat = buildVideoFormat(includeLowLatency = false)
+            encoder.configure(fallbackFormat, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
+            return encoder.createInputSurface()
+        }
+    }
+
+    private fun buildVideoFormat(includeLowLatency: Boolean): MediaFormat {
+        return MediaFormat.createVideoFormat(MediaFormat.MIMETYPE_VIDEO_AVC, width, height).apply {
+            setInteger(MediaFormat.KEY_COLOR_FORMAT, MediaCodecInfo.CodecCapabilities.COLOR_FormatSurface)
+            setInteger(MediaFormat.KEY_BIT_RATE, bitrateKbps * 1000)
+            setInteger(MediaFormat.KEY_BITRATE_MODE, MediaCodecInfo.EncoderCapabilities.BITRATE_MODE_VBR)
+            setInteger(MediaFormat.KEY_FRAME_RATE, fps)
+            setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 2)
+            setLong(MediaFormat.KEY_REPEAT_PREVIOUS_FRAME_AFTER, 100_000L)
+            if (includeLowLatency) {
+                setInteger(MediaFormat.KEY_LOW_LATENCY, 1)
+            }
+        }
+    }
+
+    private fun drainLoop() {
+        val bufferInfo = MediaCodec.BufferInfo()
+        val encoder = codec ?: return
+        try {
+            while (!stopRequested.get() && !muxerQueue.isClosed) {
+                if (syncRequestPending.getAndSet(false)) {
+                    applySyncFrameRequest(encoder)
+                }
+
+                val index = encoder.dequeueOutputBuffer(bufferInfo, 25_000L)
+                if (index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+                    val csd = extractCodecConfigFromFormat(encoder.outputFormat)
+                    if (csd != null && csd.isNotEmpty()) {
+                        cachedCodecConfig = csd
+                        emitConfigBeforeNextKeyframe.set(false)
+                        muxerQueue.offerCodecConfig(nextMonotonicPts(0L), csd)
+                    }
+                    continue
+                }
+                if (index < 0) {
+                    continue
+                }
+
+                try {
+                    val outBuffer = encoder.getOutputBuffer(index) ?: continue
+                    if (bufferInfo.size <= 0) {
+                        continue
+                    }
+                    outBuffer.position(bufferInfo.offset)
+                    outBuffer.limit(bufferInfo.offset + bufferInfo.size)
+                    val bytes = ByteArray(bufferInfo.size)
+                    outBuffer.get(bytes)
+
+                    val ptsUs = nextMonotonicPts(bufferInfo.presentationTimeUs)
+                    if ((bufferInfo.flags and MediaCodec.BUFFER_FLAG_CODEC_CONFIG) != 0) {
+                        val normalized = normalizeCodecConfigToAnnexB(bytes)
+                        if (normalized.isNotEmpty()) {
+                            cachedCodecConfig = normalized
+                            emitConfigBeforeNextKeyframe.set(false)
+                            muxerQueue.offerCodecConfig(ptsUs, normalized)
+                        }
+                        continue
+                    }
+
+                    val isKeyframe = (bufferInfo.flags and MediaCodec.BUFFER_FLAG_KEY_FRAME) != 0
+                    if (isKeyframe && emitConfigBeforeNextKeyframe.getAndSet(false)) {
+                        cachedCodecConfig?.let { cfg ->
+                            muxerQueue.offerCodecConfig(ptsUs, cfg)
+                        }
+                    }
+
+                    var frameFlags = if (isKeyframe) {
+                        ScreenStreamProtocol.FLAG_KEYFRAME
+                    } else {
+                        ScreenStreamProtocol.FLAG_NONE
+                    }
+                    if (protectedContentActive.get()) {
+                        frameFlags = frameFlags or ScreenStreamProtocol.FLAG_PROTECTED_CONTENT
+                    }
+
+                    val offer = muxerQueue.offerVideoFrame(frameFlags, ptsUs, bytes)
+                    if (offer.requestSyncFrame) {
+                        syncRequestPending.set(true)
+                    }
+                } finally {
+                    encoder.releaseOutputBuffer(index, false)
+                }
+            }
+        } catch (e: Exception) {
+            if (!stopRequested.get()) {
+                Log.e(TAG, "Hardware screen encoder failed", e)
+                onFatalError("Screen encoder error: ${e.message ?: e.javaClass.simpleName}")
+            }
+        }
+    }
+
+    private fun applySyncFrameRequest(encoder: MediaCodec) {
+        try {
+            val params = Bundle().apply {
+                putInt(MediaCodec.PARAMETER_KEY_REQUEST_SYNC_FRAME, 0)
+            }
+            encoder.setParameters(params)
+        } catch (e: IllegalStateException) {
+            Log.w(TAG, "Unable to request sync frame during state transition", e)
+        }
+    }
+
+    private fun nextMonotonicPts(encoderPtsUs: Long): Long {
+        val clockNowUs = SystemClock.elapsedRealtimeNanos() / 1000L
+        val candidate = if (encoderPtsUs > 0L) encoderPtsUs else clockNowUs
+        while (true) {
+            val prev = lastPtsUs.get()
+            val next = if (candidate > prev) candidate else prev + 1L
+            if (lastPtsUs.compareAndSet(prev, next)) {
+                return next
+            }
+        }
+    }
+
+    private fun releaseCodecResources() {
+        val encoder = codec
+        codec = null
+        val surface = inputSurface
+        inputSurface = null
+        if (encoder != null) {
+            try {
+                encoder.stop()
+            } catch (_: IllegalStateException) {
+            }
+            try {
+                encoder.release()
+            } catch (_: RuntimeException) {
+            }
+        }
+        surface?.release()
+    }
+
+    companion object {
+        private const val TAG = "ScreenEncoder"
+
+        internal fun extractCodecConfigFromFormat(format: MediaFormat): ByteArray? {
+            val out = ByteArrayOutputStream()
+            listOf("csd-0", "csd-1", "csd-2").forEach { key ->
+                if (format.containsKey(key)) {
+                    val buf: ByteBuffer? = format.getByteBuffer(key)
+                    if (buf != null && buf.remaining() > 0) {
+                        val copy = buf.duplicate()
+                        val data = ByteArray(copy.remaining())
+                        copy.get(data)
+                        out.writeBytesCompat(normalizeCodecConfigToAnnexB(data))
+                    }
+                }
+            }
+            val result = out.toByteArray()
+            return if (result.isEmpty()) null else result
+        }
+
+        internal fun normalizeCodecConfigToAnnexB(raw: ByteArray): ByteArray {
+            if (raw.size >= 4 && raw[0].toInt() == 0 && raw[1].toInt() == 0 &&
+                (raw[2].toInt() == 1 || (raw[2].toInt() == 0 && raw[3].toInt() == 1))
+            ) {
+                return raw
+            }
+            val prefixed = ByteArray(4 + raw.size)
+            prefixed[0] = 0
+            prefixed[1] = 0
+            prefixed[2] = 0
+            prefixed[3] = 1
+            System.arraycopy(raw, 0, prefixed, 4, raw.size)
+            return prefixed
+        }
+
+        private fun ByteArrayOutputStream.writeBytesCompat(data: ByteArray) {
+            write(data, 0, data.size)
+        }
+    }
+}
