+/*
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+package org.kde.kdeconnect.plugins.screenstream
+
+import android.content.Context
+import android.content.Intent
+import android.media.projection.MediaProjectionManager
+import android.os.Build
+import android.os.Bundle
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.annotation.RequiresApi
+import androidx.appcompat.app.AppCompatActivity
+import androidx.core.content.ContextCompat
+import org.kde.kdeconnect.KdeConnect
+
+@RequiresApi(Build.VERSION_CODES.R)
+class ScreenStreamPermissionActivity : AppCompatActivity() {
+
+    private var deviceId: String? = null
+    private var maxWidth: Int = ScreenStreamProtocol.DEFAULT_MAX_WIDTH
+    private var maxHeight: Int = ScreenStreamProtocol.DEFAULT_MAX_HEIGHT
+    private var maxFps: Int = ScreenStreamProtocol.DEFAULT_MAX_FPS
+    private var maxBitrateKbps: Int = ScreenStreamProtocol.DEFAULT_BITRATE_KBPS
+    private var requestAudio: Boolean = true
+    private var handledResult = false
+
+    private val projectionLauncher = registerForActivityResult(
+        ActivityResultContracts.StartActivityForResult()
+    ) { result ->
+        handledResult = true
+        val data = result.data
+        val targetDeviceId = deviceId
+        if (result.resultCode == RESULT_OK && data != null && !targetDeviceId.isNullOrEmpty()) {
+            val serviceIntent = ScreenStreamService.createStartIntent(
+                context = this,
+                deviceId = targetDeviceId,
+                resultCode = result.resultCode,
+                consentData = data,
+                params = ScreenStreamProtocol.StartParams(
+                    maxWidth = maxWidth,
+                    maxHeight = maxHeight,
+                    maxFps = maxFps,
+                    maxBitrateKbps = maxBitrateKbps,
+                    requestAudio = requestAudio,
+                ),
+            )
+            ContextCompat.startForegroundService(this, serviceIntent)
+        } else if (!targetDeviceId.isNullOrEmpty()) {
+            KdeConnect.getInstance()
+                .getDevicePlugin(targetDeviceId, ScreenStreamPlugin::class.java)
+                ?.onConsentDenied()
+        }
+        finish()
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+
+        deviceId = intent.getStringExtra(EXTRA_DEVICE_ID)
+        maxWidth = intent.getIntExtra(EXTRA_MAX_WIDTH, ScreenStreamProtocol.DEFAULT_MAX_WIDTH)
+        maxHeight = intent.getIntExtra(EXTRA_MAX_HEIGHT, ScreenStreamProtocol.DEFAULT_MAX_HEIGHT)
+        maxFps = intent.getIntExtra(EXTRA_MAX_FPS, ScreenStreamProtocol.DEFAULT_MAX_FPS)
+        maxBitrateKbps = intent.getIntExtra(EXTRA_MAX_BITRATE_KBPS, ScreenStreamProtocol.DEFAULT_BITRATE_KBPS)
+        requestAudio = intent.getBooleanExtra(EXTRA_REQUEST_AUDIO, true)
+
+        if (deviceId.isNullOrEmpty()) {
+            finish()
+            return
+        }
+
+        if (savedInstanceState == null) {
+            val mgr = getSystemService(MediaProjectionManager::class.java)
+            if (mgr == null) {
+                KdeConnect.getInstance()
+                    .getDevicePlugin(deviceId, ScreenStreamPlugin::class.java)
+                    ?.onConsentDenied()
+                finish()
+                return
+            }
+            projectionLauncher.launch(mgr.createScreenCaptureIntent())
+        }
+    }
+
+    override fun onDestroy() {
+        if (isFinishing && !handledResult) {
+            val targetDeviceId = deviceId
+            if (!targetDeviceId.isNullOrEmpty()) {
+                KdeConnect.getInstance()
+                    .getDevicePlugin(targetDeviceId, ScreenStreamPlugin::class.java)
+                    ?.onConsentDenied()
+            }
+        }
+        super.onDestroy()
+    }
+
+    companion object {
+        const val EXTRA_DEVICE_ID = "screenstream_device_id"
+        const val EXTRA_MAX_WIDTH = "screenstream_max_width"
+        const val EXTRA_MAX_HEIGHT = "screenstream_max_height"
+        const val EXTRA_MAX_FPS = "screenstream_max_fps"
+        const val EXTRA_MAX_BITRATE_KBPS = "screenstream_max_bitrate_kbps"
+        const val EXTRA_REQUEST_AUDIO = "screenstream_request_audio"
+
+        fun createIntent(
+            context: Context,
+            deviceId: String,
+            params: ScreenStreamProtocol.StartParams,
+        ): Intent {
+            return Intent(context, ScreenStreamPermissionActivity::class.java).apply {
+                putExtra(EXTRA_DEVICE_ID, deviceId)
+                putExtra(EXTRA_MAX_WIDTH, params.maxWidth)
+                putExtra(EXTRA_MAX_HEIGHT, params.maxHeight)
+                putExtra(EXTRA_MAX_FPS, params.maxFps)
+                putExtra(EXTRA_MAX_BITRATE_KBPS, params.maxBitrateKbps)
+                putExtra(EXTRA_REQUEST_AUDIO, params.requestAudio)
+            }
+        }
+    }
+}
