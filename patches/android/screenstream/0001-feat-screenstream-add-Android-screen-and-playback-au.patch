+    @Test
+    fun testSessionTrackerExplicitStopPersistenceAndReconnectBackoff() {
+        val tracker = ScreenStreamSessionTracker(initialExplicitStop = false, initialAutoStart = true)
+        assertTrue(tracker.shouldAutoStartOnConnect())
+        tracker.onStreamingStarted()
+        tracker.onLinkLost()
+        assertEquals(2000, tracker.consumeReconnectDelayMs())
+        assertEquals(4000, tracker.consumeReconnectDelayMs())
+        assertEquals(8000, tracker.consumeReconnectDelayMs())
+        assertNull(tracker.consumeReconnectDelayMs())
+
+        tracker.onExplicitStop("user_stopped")
+        assertTrue(tracker.explicitStop)
+        assertFalse(tracker.shouldAutoStartOnConnect())
+        assertNull(tracker.consumeReconnectDelayMs())
+    }
+
+    @Test
+    fun testReconnectAttemptsStayBoundedAcrossFailedReconnectStarts() {
+        val tracker = ScreenStreamSessionTracker(initialExplicitStop = false, initialAutoStart = true)
+        tracker.onStreamingStarted()
+        tracker.onLinkLost()
+        assertTrue(tracker.hasPendingReconnect)
+
+        // Simulating reconnect attempts that fail to reach STREAMING must keep backoff bounded.
+        assertEquals(2000, tracker.consumeReconnectDelayMs())
+        tracker.onStartRequested(isReconnectAttempt = true)
+        tracker.onLinkLost()
+        tracker.configure(autoStart = true, explicitStop = false)
+        assertTrue(tracker.hasPendingReconnect)
+
+        assertEquals(4000, tracker.consumeReconnectDelayMs())
+        tracker.onStartRequested(isReconnectAttempt = true)
+        tracker.onLinkLost()
+
+        assertEquals(8000, tracker.consumeReconnectDelayMs())
+        tracker.onStartRequested(isReconnectAttempt = true)
+        tracker.onLinkLost()
+
+        assertNull(tracker.consumeReconnectDelayMs())
+        assertFalse(tracker.hasPendingReconnect)
+
+        // Successful stream resets reconnect attempt budget for future drops.
+        tracker.onStreamingStarted()
+        tracker.onLinkLost()
+        assertEquals(2000, tracker.consumeReconnectDelayMs())
+    }
