+    }
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        if (intent == null) {
+            stopSelf()
+            return START_NOT_STICKY
+        }
+
+        when (intent.action) {
+            ACTION_USER_STOP -> {
+                stopCaptureAndNotify(reason = "user_stopped", explicitStop = true)
+                return START_NOT_STICKY
+            }
+            ACTION_REQUEST_KEYFRAME -> {
+                screenEncoder?.requestSyncFrame(forceCodecConfig = true)
+                return START_NOT_STICKY
+            }
+            ACTION_START_CAPTURE -> {
+                val deviceId = intent.getStringExtra(EXTRA_DEVICE_ID)
+                val resultCode = intent.getIntExtra(EXTRA_RESULT_CODE, Activity.RESULT_CANCELED)
+                val consentData = IntentCompat.getParcelableExtra(intent, EXTRA_CONSENT_DATA, Intent::class.java)
+                if (deviceId.isNullOrEmpty() || resultCode != Activity.RESULT_OK || consentData == null) {
+                    Log.w(TAG, "Missing MediaProjection consent intent before foreground start")
+                    stopSelf()
+                    return START_NOT_STICKY
+                }
+
+                val params = ScreenStreamProtocol.StartParams(
+                    maxWidth = intent.getIntExtra(EXTRA_MAX_WIDTH, ScreenStreamProtocol.DEFAULT_MAX_WIDTH).coerceIn(320, 3840),
+                    maxHeight = intent.getIntExtra(EXTRA_MAX_HEIGHT, ScreenStreamProtocol.DEFAULT_MAX_HEIGHT).coerceIn(320, 3840),
+                    maxFps = intent.getIntExtra(EXTRA_MAX_FPS, ScreenStreamProtocol.DEFAULT_MAX_FPS).coerceIn(5, 60),
+                    maxBitrateKbps = intent.getIntExtra(EXTRA_MAX_BITRATE_KBPS, ScreenStreamProtocol.DEFAULT_BITRATE_KBPS).coerceIn(500, 20000),
+                    requestAudio = intent.getBooleanExtra(EXTRA_REQUEST_AUDIO, true),
+                )
+
+                val plugin = KdeConnect.getInstance().getDevicePlugin(deviceId, ScreenStreamPlugin::class.java)
+                val deviceName = plugin?.device?.name ?: deviceId
+
+                startForeground(
+                    NOTIFICATION_ID,
+                    buildOngoingNotification(deviceName),
+                    ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION,
+                )
+
+                teardownResources()
+                stopping.set(false)
+                protectedContentActive.set(false)
+                lastPtsUs.set(SystemClock.elapsedRealtimeNanos() / 1000L)
+                activeDeviceId = deviceId
+                startParams = params
+
+                beginCaptureSession(deviceId, resultCode, consentData, params)
+                return START_NOT_STICKY
+            }
+            else -> {
+                stopSelf()
+                return START_NOT_STICKY
+            }
+        }
+    }
+
+    private fun beginCaptureSession(
+        deviceId: String,
+        resultCode: Int,
+        consentData: Intent,
+        params: ScreenStreamProtocol.StartParams,
+    ) {
+        val mgr = getSystemService(MediaProjectionManager::class.java)
+        val projection = mgr?.getMediaProjection(resultCode, consentData)
+        if (projection == null) {
+            failStart(deviceId, "Unable to obtain MediaProjection from consent token")
+            return
+        }
+
+        val plugin = KdeConnect.getInstance().getDevicePlugin(deviceId, ScreenStreamPlugin::class.java)
+        if (plugin == null) {
+            projection.stop()
+            stopSelf()
+            return
+        }
+
+        try {
+            mediaProjection = projection
+            projection.registerCallback(projectionCallback, mainHandler)
+
+            val geom = queryDefaultDisplayGeometry()
+            currentDisplayGeometry = geom
+
+            val (streamW, streamH) = ScreenStreamProtocol.computeStreamGeometry(
+                geom.width,
+                geom.height,
+                params.maxWidth,
+                params.maxHeight,
+            )
+
+            val queue = StreamMuxerQueue(onClosedCallback = {
+                mainHandler.post {
+                    if (!stopping.get()) {
+                        stopCaptureAndNotify(reason = "stream_closed", explicitStop = false)
+                    }
+                }
+            })
+            muxerQueue = queue
+
+            val encoder = ScreenEncoder(
+                width = streamW,
+                height = streamH,
+                fps = params.maxFps,
+                bitrateKbps = params.maxBitrateKbps,
+                muxerQueue = queue,
+                protectedContentActive = protectedContentActive,
+                lastPtsUs = lastPtsUs,
+                onFatalError = { errorMsg ->
+                    mainHandler.post {
+                        failStart(deviceId, errorMsg)
+                    }
+                },
+            )
+            encoder.start()
+            screenEncoder = encoder
+
+            val surface = encoder.inputSurface
+                ?: throw IllegalStateException("MediaCodec encoder created no input surface")
+
+            virtualDisplay = projection.createVirtualDisplay(
+                VIRTUAL_DISPLAY_NAME,
+                streamW,
+                streamH,
+                geom.densityDpi,
+                DisplayManager.VIRTUAL_DISPLAY_FLAG_AUTO_MIRROR,
+                surface,
+                null,
+                mainHandler,
+            )
+
+            displayManager?.registerDisplayListener(displayListener, mainHandler)
+
+            var audioAvailable = false
+            var audioReason = if (params.requestAudio) "" else "Audio disabled by viewer request"
+            if (params.requestAudio) {
+                val capturer = AudioPlaybackCapturer(
+                    context = this,
+                    mediaProjection = projection,
+                    muxerQueue = queue,
+                    lastPtsUs = lastPtsUs,
+                    onAudioStatusChanged = { avail, reason ->
+                        mainHandler.post {
+                            KdeConnect.getInstance()
+                                .getDevicePlugin(deviceId, ScreenStreamPlugin::class.java)
+                                ?.onServiceAudioStatusChanged(avail, reason)
+                        }
+                    },
+                )
+                val audioRes = capturer.start()
+                audioAvailable = audioRes.available
+                audioReason = audioRes.reason
+                if (audioAvailable) {
+                    audioCapturer = capturer
+                }
+            }
+
+            currentInstance = this
+            plugin.onServiceStreamingStarted(
+                muxerQueue = queue,
+                displayWidth = geom.width,
+                displayHeight = geom.height,
+                streamWidth = streamW,
+                streamHeight = streamH,
+                rotationDegrees = geom.rotationDegrees,
+                fps = params.maxFps,
+                audioAvailable = audioAvailable,
+                audioReason = audioReason,
+            )
+        } catch (e: Exception) {
+            Log.e(TAG, "Failed to start MediaProjection capture", e)
+            failStart(deviceId, e.message ?: e.javaClass.simpleName)
+        }
+    }
+
+    private fun handleDisplayChanged() {
+        val vd = virtualDisplay ?: return
+        val deviceId = activeDeviceId ?: return
+        val queue = muxerQueue ?: return
+        if (queue.isClosed) return
+
+        val prev = currentDisplayGeometry
+        val next = queryDefaultDisplayGeometry()
+        if (prev != null &&
+            prev.width == next.width &&
+            prev.height == next.height &&
+            prev.rotationDegrees == next.rotationDegrees
+        ) {
+            return
+        }
+        currentDisplayGeometry = next
+
+        val (newStreamW, newStreamH) = ScreenStreamProtocol.computeStreamGeometry(
+            next.width,
+            next.height,
+            startParams.maxWidth,
+            startParams.maxHeight,
+        )
+
+        val oldEncoder = screenEncoder
+        if (oldEncoder != null && oldEncoder.width == newStreamW && oldEncoder.height == newStreamH) {
+            KdeConnect.getInstance()
+                .getDevicePlugin(deviceId, ScreenStreamPlugin::class.java)
+                ?.onServiceGeometryChanged(next.width, next.height, newStreamW, newStreamH, next.rotationDegrees)
+            return
+        }
+
+        try {
+            val replacement = ScreenEncoder(
+                width = newStreamW,
+                height = newStreamH,
+                fps = startParams.maxFps,
+                bitrateKbps = startParams.maxBitrateKbps,
+                muxerQueue = queue,
+                protectedContentActive = protectedContentActive,
+                lastPtsUs = lastPtsUs,
+                onFatalError = { errorMsg ->
+                    mainHandler.post {
+                        failStart(deviceId, errorMsg)
+                    }
+                },
+            )
+            replacement.start()
+            val newSurface = replacement.inputSurface
+                ?: throw IllegalStateException("Replacement encoder produced no input surface")
+
+            vd.resize(newStreamW, newStreamH, next.densityDpi)
+            vd.setSurface(newSurface)
+            screenEncoder = replacement
+            oldEncoder?.stop()
+
+            KdeConnect.getInstance()
+                .getDevicePlugin(deviceId, ScreenStreamPlugin::class.java)
+                ?.onServiceGeometryChanged(next.width, next.height, newStreamW, newStreamH, next.rotationDegrees)
+        } catch (e: Exception) {
+            Log.e(TAG, "Failed to reconfigure virtual display on rotation", e)
+            failStart(deviceId, "Rotation resize failed: ${e.message ?: e.javaClass.simpleName}")
+        }
+    }
+
+    private fun queryDefaultDisplayGeometry(): DisplayGeometry {
+        val display = displayManager?.getDisplay(Display.DEFAULT_DISPLAY)
+        if (display != null) {
+            val rotDegrees = ScreenStreamProtocol.surfaceRotationToDegrees(display.rotation)
+            val fallbackDensity = resources.configuration.densityDpi.coerceAtLeast(160)
+            try {
+                val windowCtx = createDisplayContext(display).createWindowContext(
+                    WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
+                    null,
+                )
+                val wm = windowCtx.getSystemService(WindowManager::class.java)
+                val bounds: Rect? = wm?.maximumWindowMetrics?.bounds
+                val density = windowCtx.resources.configuration.densityDpi.coerceAtLeast(160)
+                if (bounds != null && bounds.width() > 0 && bounds.height() > 0) {
+                    return DisplayGeometry(
+                        width = bounds.width(),
+                        height = bounds.height(),
+                        densityDpi = density,
+                        rotationDegrees = rotDegrees,
+                    )
+                }
+            } catch (e: RuntimeException) {
+                Log.w(TAG, "WindowContext bounds unavailable, falling back to Display.Mode: ${e.message}")
+            }
+
+            val mode = display.mode
+            val swap = rotDegrees == 90 || rotDegrees == 270
+            val w = if (swap) mode.physicalHeight else mode.physicalWidth
+            val h = if (swap) mode.physicalWidth else mode.physicalHeight
+            return DisplayGeometry(
+                width = w.coerceAtLeast(320),
+                height = h.coerceAtLeast(320),
+                densityDpi = fallbackDensity,
+                rotationDegrees = rotDegrees,
+            )
+        }
+        return DisplayGeometry(width = 1080, height = 1920, densityDpi = 420, rotationDegrees = 0)
+    }
+
+    private fun failStart(deviceId: String, reason: String) {
+        if (!stopping.compareAndSet(false, true)) {
+            return
+        }
+        val plugin = KdeConnect.getInstance().getDevicePlugin(deviceId, ScreenStreamPlugin::class.java)
+        teardownResources()
+        plugin?.onServiceError(reason)
+        stopForeground(STOP_FOREGROUND_REMOVE)
+        stopSelf()
+    }
+
+    private fun stopCaptureAndNotify(reason: String, explicitStop: Boolean) {
+        if (!stopping.compareAndSet(false, true)) {
+            return
+        }
+        val deviceId = activeDeviceId
+        val plugin = if (!deviceId.isNullOrEmpty()) {
+            KdeConnect.getInstance().getDevicePlugin(deviceId, ScreenStreamPlugin::class.java)
+        } else {
+            null
+        }
+        val queue = muxerQueue
+        if (plugin != null) {
+            teardownCaptureHardwareOnly()
+            plugin.onServiceStopped(reason = reason, explicitStop = explicitStop, queue = queue)
+            if (muxerQueue === queue) {
+                muxerQueue = null
+            }
+        } else {
+            teardownResources()
+        }
+        stopForeground(STOP_FOREGROUND_REMOVE)
+        stopSelf()
+    }
+
+    private fun teardownCaptureHardwareOnly() {
+        if (currentInstance === this) {
+            currentInstance = null
+        }
+        displayManager?.unregisterDisplayListener(displayListener)
+
+        audioCapturer?.stop()
+        audioCapturer = null
+
+        val encoder = screenEncoder
+        screenEncoder = null
+
+        virtualDisplay?.release()
+        virtualDisplay = null
+
+        encoder?.stop()
+
+        val projection = mediaProjection
+        mediaProjection = null
+        if (projection != null) {
+            try {
+                projection.unregisterCallback(projectionCallback)
+            } catch (_: RuntimeException) {
+            }
+            try {
+                projection.stop()
+            } catch (_: RuntimeException) {
+            }
+        }
+    }
+
+    private fun teardownResources() {
+        teardownCaptureHardwareOnly()
+        val queue = muxerQueue
+        muxerQueue = null
+        queue?.offerEosAndFinish(SystemClock.elapsedRealtimeNanos() / 1000L)
+        queue?.close()
+    }
+
+    private fun buildOngoingNotification(deviceName: String): Notification {
+        val stopIntent = Intent(this, ScreenStreamService::class.java).apply {
+            action = ACTION_USER_STOP
+        }
+        val stopPending = PendingIntent.getService(
+            this,
+            0,
+            stopIntent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+
+        return NotificationCompat.Builder(this, NotificationHelper.Channels.DEFAULT)
+            .setSmallIcon(R.drawable.ic_notification)
+            .setContentTitle(getString(R.string.screenstream_notification_title))
+            .setContentText(getString(R.string.screenstream_notification_body, deviceName))
+            .setOngoing(true)
+            .setOnlyAlertOnce(true)
+            .setCategory(NotificationCompat.CATEGORY_SERVICE)
+            .setVisibility(NotificationCompat.VISIBILITY_PUBLIC)
+            .setForegroundServiceBehavior(NotificationCompat.FOREGROUND_SERVICE_IMMEDIATE)
+            .setGroup(NOTIFICATION_GROUP)
+            .addAction(R.drawable.ic_stop, getString(R.string.screenstream_action_stop), stopPending)
+            .build()
+    }
+
+    override fun onDestroy() {
+        stopping.set(true)
+        teardownResources()
+        super.onDestroy()
+    }
+
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    companion object {
+        private const val TAG = "ScreenStreamService"
+        private const val NOTIFICATION_ID = 47291
+        private const val NOTIFICATION_GROUP = "ScreenStream"
+        private const val VIRTUAL_DISPLAY_NAME = "KDEConnectScreenStream"
+
+        private const val ACTION_START_CAPTURE = "org.kde.kdeconnect.plugins.screenstream.START"
+        private const val ACTION_USER_STOP = "org.kde.kdeconnect.plugins.screenstream.STOP"
+        private const val ACTION_REQUEST_KEYFRAME = "org.kde.kdeconnect.plugins.screenstream.KEYFRAME"
+
+        private const val EXTRA_DEVICE_ID = "device_id"
+        private const val EXTRA_RESULT_CODE = "result_code"
+        private const val EXTRA_CONSENT_DATA = "consent_data"
+        private const val EXTRA_MAX_WIDTH = "max_width"
+        private const val EXTRA_MAX_HEIGHT = "max_height"
+        private const val EXTRA_MAX_FPS = "max_fps"
+        private const val EXTRA_MAX_BITRATE_KBPS = "max_bitrate_kbps"
+        private const val EXTRA_REQUEST_AUDIO = "request_audio"
+
+        @Volatile
+        private var currentInstance: ScreenStreamService? = null
+
+        fun createStartIntent(
+            context: Context,
+            deviceId: String,
+            resultCode: Int,
+            consentData: Intent,
+            params: ScreenStreamProtocol.StartParams,
+        ): Intent {
+            return Intent(context, ScreenStreamService::class.java).apply {
+                action = ACTION_START_CAPTURE
+                putExtra(EXTRA_DEVICE_ID, deviceId)
+                putExtra(EXTRA_RESULT_CODE, resultCode)
+                putExtra(EXTRA_CONSENT_DATA, consentData)
+                putExtra(EXTRA_MAX_WIDTH, params.maxWidth)
+                putExtra(EXTRA_MAX_HEIGHT, params.maxHeight)
+                putExtra(EXTRA_MAX_FPS, params.maxFps)
+                putExtra(EXTRA_MAX_BITRATE_KBPS, params.maxBitrateKbps)
+                putExtra(EXTRA_REQUEST_AUDIO, params.requestAudio)
+            }
+        }
+
+        fun requestKeyframeIfRunning(deviceId: String) {
+            val active = currentInstance ?: return
+            if (active.activeDeviceId == deviceId) {
+                active.screenEncoder?.requestSyncFrame(forceCodecConfig = true)
+            }
+        }
+
+        fun stopCaptureForDevice(context: Context, deviceId: String, closeQueueImmediately: Boolean = true) {
+            val active = currentInstance
+            if (active != null && active.activeDeviceId == deviceId) {
+                active.mainHandler.post {
+                    if (currentInstance === active) {
+                        active.stopping.set(true)
+                        if (closeQueueImmediately) {
+                            active.teardownResources()
+                        } else {
+                            active.teardownCaptureHardwareOnly()
+                        }
+                        active.stopForeground(STOP_FOREGROUND_REMOVE)
+                        active.stopSelf()
+                    }
+                }
+            } else {
+                context.stopService(Intent(context, ScreenStreamService::class.java))
+            }
+        }
+    }
+}
