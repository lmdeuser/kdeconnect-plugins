+package org.kde.kdeconnect.plugins.screenstream
+
+import android.Manifest
+import android.app.Activity
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Intent
+import android.hardware.display.DisplayManager
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.view.Display
+import android.view.WindowManager
+import android.view.accessibility.AccessibilityManager
+import androidx.annotation.RequiresApi
+import androidx.core.app.NotificationCompat
+import androidx.core.content.edit
+import androidx.core.content.getSystemService
+import org.kde.kdeconnect.Device
+import org.kde.kdeconnect.KdeConnectAccessibilityService
+import org.kde.kdeconnect.NetworkPacket
+import org.kde.kdeconnect.helpers.LifecycleHelper
+import org.kde.kdeconnect.helpers.NotificationHelper
+import org.kde.kdeconnect.plugins.Plugin
+import org.kde.kdeconnect.plugins.PluginFactory
+import org.kde.kdeconnect.plugins.mousereceiver.MouseReceiverPlugin
+import org.kde.kdeconnect.plugins.remotekeyboard.RemoteKeyboardPlugin
+import org.kde.kdeconnect.ui.PluginSettingsFragment
+import org.kde.kdeconnect_tp.R
+
+@PluginFactory.LoadablePlugin
+@RequiresApi(Build.VERSION_CODES.R)
+class ScreenStreamPlugin : Plugin() {
+
+    private val mainHandler = Handler(Looper.getMainLooper())
+    private val sessionTracker = ScreenStreamSessionTracker()
+    private val reconnectRunnable = Runnable { attemptScheduledReconnect() }
+
+    @Volatile
+    private var activeMuxerQueue: StreamMuxerQueue? = null
+
+    @Volatile
+    private var activeStreamPacket: NetworkPacket? = null
+
+    @Volatile
+    private var pendingAccessibilityReload: Boolean = false
+
+    private var a11yStateListener: AccessibilityManager.AccessibilityStateChangeListener? = null
+    private var a11yServicesListener: Any? = null
+
+    private var audioAvailable: Boolean = false
+    private var audioReason: String = ""
+    private var lastDisplayWidth: Int = 0
+    private var lastDisplayHeight: Int = 0
+    private var lastRotationDegrees: Int = 0
+
+    override val minSdk: Int = Build.VERSION_CODES.R
+
+    override val keepAliveWhenUnreachable: Boolean = true
+
+    override val hasSettings: Boolean = true
+
+    override val settingsScope: SettingsScope = SettingsScope.PER_DEVICE
+
+    override val displayName: String
+        get() = context.getString(R.string.pref_plugin_screenstream)
+
+    override val description: String
+        get() = context.getString(R.string.pref_plugin_screenstream_desc)
+
+    override val supportedPacketTypes: Array<String>
+        get() = arrayOf(ScreenStreamProtocol.PACKET_TYPE_SCREENSTREAM_REQUEST)
+
+    override val outgoingPacketTypes: Array<String>
+        get() = arrayOf(ScreenStreamProtocol.PACKET_TYPE_SCREENSTREAM)
+
+    override val optionalPermissions: Array<String>
+        get() = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            arrayOf(Manifest.permission.RECORD_AUDIO, Manifest.permission.POST_NOTIFICATIONS)
+        } else {
+            arrayOf(Manifest.permission.RECORD_AUDIO)
+        }
+
+    override val optionalPermissionExplanation: Int
+        get() = R.string.screenstream_optional_permission_explanation
+
+    override fun getSettingsFragment(activity: Activity): PluginSettingsFragment {
+        return PluginSettingsFragment.newInstance(pluginKey, device.deviceId, R.xml.screenstreamplugin_preferences)
+    }
+
+    override fun getUiButtons(): List<PluginUiButton> {
+        val isActive = sessionTracker.state == ScreenStreamProtocol.SessionState.STREAMING ||
+            sessionTracker.state == ScreenStreamProtocol.SessionState.AWAITING_CONSENT
+        return listOf(
+            if (isActive) {
+                PluginUiButton(
+                    context.getString(R.string.screenstream_action_stop),
+                    R.drawable.ic_stop,
+                ) {
+                    stopStreamingByUser()
+                }
+            } else {
+                PluginUiButton(
+                    context.getString(R.string.screenstream_action_start),
+                    R.drawable.ic_phonelink_36dp,
+                ) { parentActivity ->
+                    startConsentFlowFromUi(parentActivity)
+                }
+            }
+        )
+    }
+
+    override fun onCreate() {
+        syncPreferencesIntoTracker()
+        refreshDefaultDisplayInfo()
+        registerAccessibilityListener()
+        sendStatePacket()
+
+        if (sessionTracker.hasPendingReconnect) {
+            scheduleReconnectIfEligible()
+        } else if (sessionTracker.shouldAutoStartOnConnect()) {
+            val audioWanted = isAudioEnabledInSettings()
+            initiateCapture(
+                params = ScreenStreamProtocol.StartParams(requestAudio = audioWanted),
+                uiActivity = null,
+                isReconnectAttempt = false,
+            )
+        }
+    }
+
+    override fun onDestroy() {
+        unregisterAccessibilityListener()
+        pendingAccessibilityReload = false
+        mainHandler.removeCallbacksAndMessages(null)
+        cancelPendingConsentNotification()
+        teardownActiveStream()
+        sessionTracker.onLinkLost()
+        device.onPluginsChanged()
+    }
+
+    override fun onPacketReceived(np: NetworkPacket): Boolean {
+        if (np.type != ScreenStreamProtocol.PACKET_TYPE_SCREENSTREAM_REQUEST) {
+            return false
+        }
+
+        val serializedSize = np.serialize().toByteArray(Charsets.UTF_8).size
+        val request = ScreenStreamProtocol.parseControlRequest(
+            action = np.getStringOrNull("action"),
+            rawJsonBytes = serializedSize,
+            maxWidth = np.getIntOrNull("maxWidth"),
+            maxHeight = np.getIntOrNull("maxHeight"),
+            maxFps = np.getIntOrNull("maxFps"),
+            maxBitrateKbps = np.getIntOrNull("maxBitrateKbps"),
+            requestAudio = if (np.has("requestAudio")) np.getBoolean("requestAudio", true) else null,
+            explicitStop = if (np.has("explicitStop")) np.getBoolean("explicitStop", true) else null,
+        ) ?: return false
+
+        when (request) {
+            is ScreenStreamProtocol.ControlRequest.QueryState -> {
+                refreshDefaultDisplayInfo()
+                sendStatePacket()
+            }
+            is ScreenStreamProtocol.ControlRequest.RequestKeyframe -> {
+                if (sessionTracker.state == ScreenStreamProtocol.SessionState.STREAMING) {
+                    ScreenStreamService.requestKeyframeIfRunning(device.deviceId)
+                }
+            }
+            is ScreenStreamProtocol.ControlRequest.Start -> {
+                val effectiveAudio = request.params.requestAudio && isAudioEnabledInSettings()
+                val effectiveParams = request.params.copy(requestAudio = effectiveAudio)
+                initiateCapture(params = effectiveParams, uiActivity = null)
+            }
+            is ScreenStreamProtocol.ControlRequest.Stop -> {
+                stopFromRemote(explicitStop = request.explicitStop)
+            }
+        }
+        return true
+    }
+
+    private fun startConsentFlowFromUi(parentActivity: Activity) {
+        syncPreferencesIntoTracker()
+        val params = ScreenStreamProtocol.StartParams(requestAudio = isAudioEnabledInSettings())
+        initiateCapture(params = params, uiActivity = parentActivity)
+    }
+
+    private fun stopStreamingByUser() {
+        cancelScheduledReconnect()
+        sessionTracker.onExplicitStop("user_stopped")
+        persistExplicitStop(true)
+        cancelPendingConsentNotification()
+        val packet = activeStreamPacket
+        val queue = activeMuxerQueue
+        activeStreamPacket = null
+        activeMuxerQueue = null
+        audioAvailable = false
+        ScreenStreamService.stopCaptureForDevice(context, device.deviceId, closeQueueImmediately = false)
+        sendStoppedPacketAndClose(explicitStop = true, reason = "user_stopped", packet = packet, queue = queue)
+        device.onPluginsChanged()
+    }
+
+    private fun stopFromRemote(explicitStop: Boolean) {
+        cancelScheduledReconnect()
+        cancelPendingConsentNotification()
+        val packet = activeStreamPacket
+        val queue = activeMuxerQueue
+        activeStreamPacket = null
+        activeMuxerQueue = null
+        audioAvailable = false
+        ScreenStreamService.stopCaptureForDevice(context, device.deviceId, closeQueueImmediately = false)
+
+        if (explicitStop) {
+            sessionTracker.onExplicitStop("remote_stopped")
+            persistExplicitStop(true)
+            sendStoppedPacketAndClose(explicitStop = true, reason = "remote_stopped", packet = packet, queue = queue)
+        } else {
+            handleTransportDropped(packet, queue)
+        }
+        device.onPluginsChanged()
+    }
+
+    private fun initiateCapture(
+        params: ScreenStreamProtocol.StartParams,
+        uiActivity: Activity?,
+        isReconnectAttempt: Boolean = false,
+    ) {
+        if (sessionTracker.state == ScreenStreamProtocol.SessionState.STREAMING) {
+            sendStatePacket()
+            return
+        }
+
+        cancelScheduledReconnect()
+        persistExplicitStop(false)
+        sessionTracker.onStartRequested(isReconnectAttempt = isReconnectAttempt)
+        audioReason = ""
+        refreshDefaultDisplayInfo()
+        sendStatePacket()
+        device.onPluginsChanged()
+
+        val consentIntent = ScreenStreamPermissionActivity.createIntent(
+            context = uiActivity ?: context,
+            deviceId = device.deviceId,
+            params = params,
+        )
+
+        if (uiActivity != null) {
+            uiActivity.startActivity(consentIntent)
+            return
+        }
+
+        if (LifecycleHelper.isInForeground) {
+            consentIntent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+            context.startActivity(consentIntent)
+        } else {
+            showConsentNotification(consentIntent)
+        }
+    }
+
+    private fun showConsentNotification(consentIntent: Intent) {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU &&
+            !isPermissionGranted(Manifest.permission.POST_NOTIFICATIONS)
+        ) {
+            return
+        }
+        val pending = PendingIntent.getActivity(
+            context,
+            CONSENT_NOTIFICATION_ID,
+            consentIntent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+        val notification = NotificationCompat.Builder(context, NotificationHelper.Channels.HIGHPRIORITY)
+            .setSmallIcon(R.drawable.ic_notification)
+            .setContentTitle(context.getString(R.string.screenstream_consent_notif_title, device.name))
+            .setContentText(context.getString(R.string.screenstream_consent_notif_body))
+            .setPriority(NotificationCompat.PRIORITY_HIGH)
+            .setAutoCancel(true)
+            .setContentIntent(pending)
+            .build()
+
+        context.getSystemService<NotificationManager>()?.notify(CONSENT_NOTIFICATION_ID, notification)
+    }
+
+    private fun cancelPendingConsentNotification() {
+        context.getSystemService<NotificationManager>()?.cancel(CONSENT_NOTIFICATION_ID)
+    }
+
+    internal fun onConsentDenied() {
+        if (!isDeviceInitialized) return
+        cancelPendingConsentNotification()
+        sessionTracker.onExplicitStop("consent_denied")
+        audioReason = ""
+        sendStoppedPacketAndClose(explicitStop = false, reason = "consent_denied", packet = null, queue = null)
+        device.onPluginsChanged()
+    }
+
+    internal fun onServiceStreamingStarted(
+        muxerQueue: StreamMuxerQueue,
+        displayWidth: Int,
+        displayHeight: Int,
+        streamWidth: Int,
+        streamHeight: Int,
+        rotationDegrees: Int,
+        fps: Int,
+        audioAvailable: Boolean,
+        audioReason: String,
+    ) {
+        if (!isDeviceInitialized) {
+            muxerQueue.close()
+            return
+        }
+        cancelScheduledReconnect()
+        cancelPendingConsentNotification()
+        closeActiveStreamObjects()
+        val validRotation = if (ScreenStreamProtocol.isValidRotation(rotationDegrees)) rotationDegrees else 0
+        this.activeMuxerQueue = muxerQueue
+        this.lastDisplayWidth = displayWidth
+        this.lastDisplayHeight = displayHeight
+        this.lastRotationDegrees = validRotation
+        this.audioAvailable = audioAvailable
+        this.audioReason = audioReason
+
+        sessionTracker.onStreamingStarted()
+        persistExplicitStop(false)
+        sendStatePacket()
+
+        val streamNp = NetworkPacket(ScreenStreamProtocol.PACKET_TYPE_SCREENSTREAM).apply {
+            this["event"] = "stream_open"
+            this["videoCodec"] = ScreenStreamProtocol.VIDEO_CODEC_H264_ANNEXB
+            this["audioCodec"] = if (audioAvailable) {
+                ScreenStreamProtocol.AUDIO_CODEC_PCM_S16LE
+            } else {
+                ScreenStreamProtocol.AUDIO_CODEC_NONE
+            }
+            this["width"] = streamWidth
+            this["height"] = streamHeight
+            this["rotation"] = validRotation
+            this["fps"] = fps
+            payload = NetworkPacket.Payload(muxerQueue, -1L)
+        }
+        activeStreamPacket = streamNp
+        device.sendPacket(streamNp)
+        device.onPluginsChanged()
+    }
+
+    internal fun onServiceGeometryChanged(
+        displayWidth: Int,
+        displayHeight: Int,
+        streamWidth: Int,
+        streamHeight: Int,
+        rotationDegrees: Int,
+    ) {
+        if (!isDeviceInitialized) return
+        val validRotation = if (ScreenStreamProtocol.isValidRotation(rotationDegrees)) rotationDegrees else 0
+        lastDisplayWidth = displayWidth
+        lastDisplayHeight = displayHeight
+        lastRotationDegrees = validRotation
+
+        val geomNp = NetworkPacket(ScreenStreamProtocol.PACKET_TYPE_SCREENSTREAM).apply {
+            this["event"] = "geometry_changed"
+            this["width"] = streamWidth
+            this["height"] = streamHeight
+            this["rotation"] = validRotation
+        }
+        device.sendPacket(geomNp)
+        sendStatePacket()
+    }
+
+    internal fun onServiceAudioStatusChanged(available: Boolean, reason: String) {
+        if (!isDeviceInitialized) return
+        audioAvailable = available
+        audioReason = reason
+        sendStatePacket()
+    }
+
+    internal fun onServiceStopped(reason: String, explicitStop: Boolean, queue: StreamMuxerQueue? = null) {
+        if (!isDeviceInitialized) {
+            queue?.close()
+            return
+        }
+        cancelScheduledReconnect()
+        val packet = activeStreamPacket
+        val targetQueue = queue ?: activeMuxerQueue
+        activeMuxerQueue = null
+        activeStreamPacket = null
+        audioAvailable = false
+
+        if (explicitStop) {
+            sessionTracker.onExplicitStop(reason)
+            persistExplicitStop(true)
+            sendStoppedPacketAndClose(explicitStop = true, reason = reason, packet = packet, queue = targetQueue)
+        } else if (reason == "stream_closed") {
+            handleTransportDropped(packet, targetQueue)
+        } else {
+            sessionTracker.onExplicitStop(reason)
+            sendStoppedPacketAndClose(explicitStop = false, reason = reason, packet = packet, queue = targetQueue)
+        }
+        device.onPluginsChanged()
+    }
+
+    internal fun onServiceError(reason: String) {
+        if (!isDeviceInitialized) return
+        cancelScheduledReconnect()
+        activeMuxerQueue = null
+        activeStreamPacket?.cancel()
+        activeStreamPacket = null
+        audioAvailable = false
+        sessionTracker.onError()
+
+        val np = NetworkPacket(ScreenStreamProtocol.PACKET_TYPE_SCREENSTREAM).apply {
+            this["event"] = "state"
+            this["state"] = ScreenStreamProtocol.SessionState.ERROR.wireName
+            this["explicitStop"] = sessionTracker.explicitStop
+            this["reason"] = reason
+            this["audioAvailable"] = false
+            this["audioReason"] = audioReason
+            this["accessibilityEnabled"] = (KdeConnectAccessibilityService.instance != null)
+            this["displayWidth"] = lastDisplayWidth
+            this["displayHeight"] = lastDisplayHeight
+            this["rotation"] = lastRotationDegrees
+        }
+        device.sendPacket(np)
+        device.onPluginsChanged()
+    }
+
+    private fun closeActiveStreamObjects() {
+        val packet = activeStreamPacket
+        activeStreamPacket = null
+        packet?.cancel()
+        val queue = activeMuxerQueue
+        activeMuxerQueue = null
+        queue?.close()
+    }
+
+    private fun teardownActiveStream() {
+        if (isDeviceInitialized) {
+            ScreenStreamService.stopCaptureForDevice(context, device.deviceId)
+        }
+        closeActiveStreamObjects()
+        audioAvailable = false
+    }
+
+    private fun handleTransportDropped(packet: NetworkPacket?, queue: StreamMuxerQueue?) {
+        packet?.cancel()
+        queue?.close()
+        syncPreferencesIntoTracker()
+        sessionTracker.onLinkLost()
+        sendStatePacket()
+        if (device.isReachable) {
+            scheduleReconnectIfEligible()
+        }
+    }
+
+    private fun cancelScheduledReconnect() {
+        mainHandler.removeCallbacks(reconnectRunnable)
+    }
+
+    private fun scheduleReconnectIfEligible() {
+        if (!isDeviceInitialized) return
+        val delayMs = sessionTracker.consumeReconnectDelayMs() ?: return
+        mainHandler.removeCallbacks(reconnectRunnable)
+        mainHandler.postDelayed(reconnectRunnable, delayMs.toLong())
+    }
+
+    private fun attemptScheduledReconnect() {
+        if (!isDeviceInitialized || !device.isReachable) {
+            return
+        }
+        syncPreferencesIntoTracker()
+        if (sessionTracker.explicitStop || !sessionTracker.autoStartEnabled) {
+            return
+        }
+        if (sessionTracker.state == ScreenStreamProtocol.SessionState.STREAMING ||
+            sessionTracker.state == ScreenStreamProtocol.SessionState.AWAITING_CONSENT
+        ) {
+            return
+        }
+        initiateCapture(
+            params = ScreenStreamProtocol.StartParams(requestAudio = isAudioEnabledInSettings()),
+            uiActivity = null,
+            isReconnectAttempt = true,
+        )
+    }
+
+    private fun registerAccessibilityListener() {
+        val am = context.getSystemService(AccessibilityManager::class.java) ?: return
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            if (a11yServicesListener != null) return
+            val listener = AccessibilityManager.AccessibilityServicesStateChangeListener {
+                scheduleAccessibilitySync()
+            }
+            a11yServicesListener = listener
+            am.addAccessibilityServicesStateChangeListener(listener)
+        } else {
+            if (a11yStateListener != null) return
+            @Suppress("DEPRECATION")
+            val listener = AccessibilityManager.AccessibilityStateChangeListener {
+                scheduleAccessibilitySync()
+            }
+            a11yStateListener = listener
+            @Suppress("DEPRECATION")
+            am.addAccessibilityStateChangeListener(listener)
+        }
+    }
+
+    private fun unregisterAccessibilityListener() {
+        val am = context.getSystemService(AccessibilityManager::class.java) ?: return
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            val listener = a11yServicesListener as? AccessibilityManager.AccessibilityServicesStateChangeListener
+            if (listener != null) {
+                am.removeAccessibilityServicesStateChangeListener(listener)
+            }
+            a11yServicesListener = null
+        } else {
+            val listener = a11yStateListener
+            if (listener != null) {
+                @Suppress("DEPRECATION")
+                am.removeAccessibilityStateChangeListener(listener)
+            }
+            a11yStateListener = null
+        }
+    }
+
+    private fun scheduleAccessibilitySync() {
+        mainHandler.postDelayed({
+            if (isDeviceInitialized && device.isReachable) {
+                sendStatePacket()
+            }
+        }, 250L)
+    }
+
+    private fun isRemoteInputReady(): Boolean {
+        if (KdeConnectAccessibilityService.instance == null) {
+            pendingAccessibilityReload = false
+            return false
+        }
+        val mouseLoaded = device.getPlugin(MouseReceiverPlugin::class.java) != null
+        val kbdLoaded = device.getPlugin(RemoteKeyboardPlugin::class.java) != null
+        val mouseEnabled = device.isPluginEnabled(getPluginKey(MouseReceiverPlugin::class.java))
+        val kbdEnabled = device.isPluginEnabled(getPluginKey(RemoteKeyboardPlugin::class.java))
+        if (((!mouseLoaded && mouseEnabled) || (!kbdLoaded && kbdEnabled)) && !pendingAccessibilityReload) {
+            pendingAccessibilityReload = true
+            device.launchBackgroundReloadPluginsFromSettings()
+            mainHandler.postDelayed({
+                pendingAccessibilityReload = false
+                if (isDeviceInitialized && device.isReachable) {
+                    sendStatePacket()
+                }
+            }, 350L)
+        }
+        return device.getPlugin(MouseReceiverPlugin::class.java) != null
+    }
+
+    private fun sendStatePacket() {
+        val np = NetworkPacket(ScreenStreamProtocol.PACKET_TYPE_SCREENSTREAM).apply {
+            this["event"] = "state"
+            this["state"] = sessionTracker.state.wireName
+            this["explicitStop"] = sessionTracker.explicitStop
+            this["audioAvailable"] = audioAvailable
+            this["audioReason"] = audioReason
+            this["accessibilityEnabled"] = isRemoteInputReady()
+            this["displayWidth"] = lastDisplayWidth
+            this["displayHeight"] = lastDisplayHeight
+            this["rotation"] = lastRotationDegrees
+        }
+        device.sendPacket(np)
+    }
+
+    private fun sendStoppedPacketAndClose(
+        explicitStop: Boolean,
+        reason: String,
+        packet: NetworkPacket?,
+        queue: StreamMuxerQueue?,
+    ) {
+        val closeAction = {
+            packet?.cancel()
+            queue?.close()
+        }
+        val np = NetworkPacket(ScreenStreamProtocol.PACKET_TYPE_SCREENSTREAM).apply {
+            this["event"] = "stopped"
+            this["explicitStop"] = explicitStop
+            this["reason"] = reason
+        }
+        mainHandler.postDelayed({ closeAction() }, 400L)
+        device.sendPacket(np, object : Device.SendPacketStatusCallback() {
+            override fun onSuccess() {
+                mainHandler.post { closeAction() }
+            }
+
+            override fun onFailure(e: Throwable) {
+                mainHandler.post { closeAction() }
+            }
+        })
+    }
+
+    private fun syncPreferencesIntoTracker() {
+        val explicit = preferences.getBoolean(PREF_EXPLICIT_STOP, false)
+        val autoStart = preferences.getBoolean(
+            context.getString(R.string.screenstream_pref_auto_start_key),
+            false,
+        )
+        sessionTracker.configure(autoStart = autoStart, explicitStop = explicit)
+    }
+
+    private fun persistExplicitStop(explicitStop: Boolean) {
+        preferences.edit {
+            putBoolean(PREF_EXPLICIT_STOP, explicitStop)
+        }
+    }
+
+    private fun isAudioEnabledInSettings(): Boolean {
+        return preferences.getBoolean(
+            context.getString(R.string.screenstream_pref_send_audio_key),
+            true,
+        )
+    }
+
+    private fun refreshDefaultDisplayInfo() {
+        val displayManager = context.getSystemService(DisplayManager::class.java) ?: return
+        val display = displayManager.getDisplay(Display.DEFAULT_DISPLAY) ?: return
+        lastRotationDegrees = ScreenStreamProtocol.surfaceRotationToDegrees(display.rotation)
+        try {
+            val windowCtx = context.createDisplayContext(display).createWindowContext(
+                WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
+                null,
+            )
+            val bounds = windowCtx.getSystemService(WindowManager::class.java)?.maximumWindowMetrics?.bounds
+            if (bounds != null && bounds.width() > 0 && bounds.height() > 0) {
+                lastDisplayWidth = bounds.width()
+                lastDisplayHeight = bounds.height()
+                return
+            }
+        } catch (_: RuntimeException) {
+        }
+
+        val mode = display.mode
+        val swap = lastRotationDegrees == 90 || lastRotationDegrees == 270
+        lastDisplayWidth = if (swap) mode.physicalHeight else mode.physicalWidth
+        lastDisplayHeight = if (swap) mode.physicalWidth else mode.physicalHeight
+    }
+
+    companion object {
+        private const val PREF_EXPLICIT_STOP = "screenstream_explicit_stop"
+        private const val CONSENT_NOTIFICATION_ID = 47292
+    }
+}
