+package org.kde.kdeconnect.plugins.screenstream
+
+import java.io.ByteArrayOutputStream
+import java.io.InputStream
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.util.ArrayDeque
+import java.util.concurrent.locks.ReentrantLock
+import kotlin.concurrent.withLock
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.roundToInt
+
+object ScreenStreamProtocol {
+    const val PACKET_TYPE_SCREENSTREAM_REQUEST = "kdeconnect.screenstream.request"
+    const val PACKET_TYPE_SCREENSTREAM = "kdeconnect.screenstream"
+
+    const val STREAM_MAGIC = 0x4B53
+    const val HEADER_BYTES = 16
+    const val MAX_VIDEO_FRAME_BYTES = 4 * 1024 * 1024
+    const val MAX_AUDIO_CHUNK_BYTES = 65536
+    const val MAX_CONTROL_JSON_BYTES = 8192
+
+    const val MAX_VIDEO_QUEUE_FRAMES = 8
+    const val MAX_AUDIO_QUEUE_CHUNKS = 16
+
+    const val FLAG_NONE = 0x00
+    const val FLAG_KEYFRAME = 0x01
+    const val FLAG_PROTECTED_CONTENT = 0x02
+    const val FLAG_VALID_MASK = 0x03
+
+    const val VIDEO_CODEC_H264_ANNEXB = "h264-annexb"
+    const val AUDIO_CODEC_PCM_S16LE = "pcm_s16le_48000_mono"
+    const val AUDIO_CODEC_NONE = "none"
+
+    const val DEFAULT_MAX_WIDTH = 1920
+    const val DEFAULT_MAX_HEIGHT = 1920
+    const val DEFAULT_MAX_FPS = 60
+    const val DEFAULT_BITRATE_KBPS = 8000
+
+    val RECONNECT_DELAYS_MS = intArrayOf(2000, 4000, 8000)
+
+    enum class FrameKind(val id: Int) {
+        CODEC_CONFIG(0x01),
+        VIDEO_ACCESS_UNIT(0x02),
+        AUDIO_PCM_CHUNK(0x03),
+        CONTROL_EOS(0x04);
+
+        companion object {
+            fun fromId(raw: Int): FrameKind? = entries.firstOrNull { it.id == raw }
+        }
+    }
+
+    data class Frame(
+        val kind: FrameKind,
+        val flags: Int,
+        val ptsUs: Long,
+        val payload: ByteArray,
+    ) {
+        override fun equals(other: Any?): Boolean {
+            if (this === other) return true
+            if (other !is Frame) return false
+            return kind == other.kind &&
+                flags == other.flags &&
+                ptsUs == other.ptsUs &&
+                payload.contentEquals(other.payload)
+        }
+
+        override fun hashCode(): Int {
+            var result = kind.hashCode()
+            result = 31 * result + flags
+            result = 31 * result + ptsUs.hashCode()
+            result = 31 * result + payload.contentHashCode()
+            return result
+        }
+    }
+
+    data class StartParams(
+        val maxWidth: Int = DEFAULT_MAX_WIDTH,
+        val maxHeight: Int = DEFAULT_MAX_HEIGHT,
+        val maxFps: Int = DEFAULT_MAX_FPS,
+        val maxBitrateKbps: Int = DEFAULT_BITRATE_KBPS,
+        val requestAudio: Boolean = true,
+    )
+
+    sealed class ControlRequest {
+        data object QueryState : ControlRequest()
+        data class Start(val params: StartParams) : ControlRequest()
+        data object RequestKeyframe : ControlRequest()
+        data class Stop(val explicitStop: Boolean) : ControlRequest()
+    }
+
+    enum class SessionState(val wireName: String) {
+        IDLE("idle"),
+        AWAITING_CONSENT("awaiting_consent"),
+        STREAMING("streaming"),
+        STOPPED("stopped"),
+        ERROR("error");
+
+        companion object {
+            fun fromWireName(value: String?): SessionState? =
+                entries.firstOrNull { it.wireName == value }
+        }
+    }
+
+    fun isValidPayloadLength(kind: FrameKind, length: Int): Boolean {
+        if (length < 0) return false
+        return when (kind) {
+            FrameKind.CODEC_CONFIG, FrameKind.VIDEO_ACCESS_UNIT -> length <= MAX_VIDEO_FRAME_BYTES
+            FrameKind.AUDIO_PCM_CHUNK -> length <= MAX_AUDIO_CHUNK_BYTES
+            FrameKind.CONTROL_EOS -> length == 0
+        }
+    }
+
+    fun encodeFrame(
+        kind: FrameKind,
+        flags: Int,
+        ptsUs: Long,
+        payload: ByteArray,
+        offset: Int = 0,
+        length: Int = payload.size,
+    ): ByteArray {
+        require(offset >= 0 && length >= 0 && offset + length <= payload.size) {
+            "Invalid payload slice: offset=$offset length=$length size=${payload.size}"
+        }
+        require((flags and FLAG_VALID_MASK.inv()) == 0) {
+            "Reserved frame flags set: 0x${flags.toString(16)}"
+        }
+        require(isValidPayloadLength(kind, length)) {
+            "Payload length $length out of bounds for frame kind $kind"
+        }
+
+        val buf = ByteBuffer.allocate(HEADER_BYTES + length).order(ByteOrder.BIG_ENDIAN)
+        buf.putShort(STREAM_MAGIC.toShort())
+        buf.put(kind.id.toByte())
+        buf.put(flags.toByte())
+        buf.putInt(length)
+        buf.putLong(ptsUs)
+        if (length > 0) {
+            buf.put(payload, offset, length)
+        }
+        return buf.array()
+    }
+
+    fun parseControlRequest(
+        action: String?,
+        rawJsonBytes: Int,
+        maxWidth: Int? = null,
+        maxHeight: Int? = null,
+        maxFps: Int? = null,
+        maxBitrateKbps: Int? = null,
+        requestAudio: Boolean? = null,
+        explicitStop: Boolean? = null,
+    ): ControlRequest? {
+        if (rawJsonBytes <= 0 || rawJsonBytes > MAX_CONTROL_JSON_BYTES || action == null) {
+            return null
+        }
+        return when (action) {
+            "query_state" -> ControlRequest.QueryState
+            "request_keyframe" -> ControlRequest.RequestKeyframe
+            "stop" -> ControlRequest.Stop(explicitStop ?: true)
+            "start" -> {
+                val clampedW = (maxWidth ?: DEFAULT_MAX_WIDTH).coerceIn(320, 3840)
+                val clampedH = (maxHeight ?: DEFAULT_MAX_HEIGHT).coerceIn(320, 3840)
+                val clampedFps = (maxFps ?: DEFAULT_MAX_FPS).coerceIn(5, 60)
+                val clampedBitrate = (maxBitrateKbps ?: DEFAULT_BITRATE_KBPS).coerceIn(500, 20000)
+                val audio = requestAudio ?: true
+                ControlRequest.Start(
+                    StartParams(
+                        maxWidth = clampedW,
+                        maxHeight = clampedH,
+                        maxFps = clampedFps,
+                        maxBitrateKbps = clampedBitrate,
+                        requestAudio = audio,
+                    )
+                )
+            }
+            else -> null
+        }
+    }
+
+    fun isValidRotation(degrees: Int): Boolean {
+        return degrees == 0 || degrees == 90 || degrees == 180 || degrees == 270
+    }
+
+    fun surfaceRotationToDegrees(surfaceRotation: Int): Int {
+        return when (surfaceRotation) {
+            1 -> 90
+            2 -> 180
+            3 -> 270
+            else -> 0
+        }
+    }
+
+    fun computeStreamGeometry(
+        displayWidth: Int,
+        displayHeight: Int,
+        maxWidth: Int,
+        maxHeight: Int,
+    ): Pair<Int, Int> {
+        val safeW = max(16, displayWidth)
+        val safeH = max(16, displayHeight)
+        val boundW = maxWidth.coerceIn(320, 3840)
+        val boundH = maxHeight.coerceIn(320, 3840)
+
+        val scale = min(1.0, min(boundW.toDouble() / safeW, boundH.toDouble() / safeH))
+        val rawW = (safeW * scale).roundToInt().coerceAtLeast(160)
+        val rawH = (safeH * scale).roundToInt().coerceAtLeast(160)
+
+        fun align16(value: Int, maxBound: Int): Int {
+            val aligned = ((value + 8) / 16) * 16
+            return aligned.coerceIn(160, (maxBound / 16) * 16).let { if (it % 2 != 0) it - 1 else it }
+        }
+
+        return Pair(align16(rawW, boundW), align16(rawH, boundH))
+    }
+
+    fun parseFrames(data: ByteArray): List<Frame> {
+        val reader = FrameReader()
+        val out = mutableListOf<Frame>()
+        require(reader.feed(data, out)) { reader.error ?: "Invalid stream bytes" }
+        require(reader.bufferedBytes == 0) { "Trailing incomplete frame bytes: ${reader.bufferedBytes}" }
+        return out
+    }
+
+    class FrameReader {
+        private val buffer = ByteArrayOutputStream()
+        private var consumedOffset = 0
+        var error: String? = null
+            private set
+
+        val bufferedBytes: Int
+            get() = buffer.size() - consumedOffset
+
+        fun reset() {
+            buffer.reset()
+            consumedOffset = 0
+            error = null
+        }
+
+        fun feed(chunk: ByteArray, outFrames: MutableList<Frame>): Boolean {
+            if (error != null) return false
+            if (chunk.isNotEmpty()) {
+                buffer.write(chunk)
+            }
+
+            val bytes = buffer.toByteArray()
+            var pos = consumedOffset
+
+            while (bytes.size - pos >= HEADER_BYTES) {
+                val bb = ByteBuffer.wrap(bytes, pos, HEADER_BYTES).order(ByteOrder.BIG_ENDIAN)
+                val magic = bb.short.toInt() and 0xFFFF
+                if (magic != STREAM_MAGIC) {
+                    error = "Invalid stream magic: 0x${magic.toString(16)}"
+                    return false
+                }
+                val rawKind = bb.get().toInt() and 0xFF
+                val kind = FrameKind.fromId(rawKind)
+                if (kind == null) {
+                    error = "Unknown frame kind: 0x${rawKind.toString(16)}"
+                    return false
+                }
+                val flags = bb.get().toInt() and 0xFF
+                if ((flags and FLAG_VALID_MASK.inv()) != 0) {
+                    error = "Invalid reserved flags: 0x${flags.toString(16)}"
+                    return false
+                }
+                val lengthLong = bb.int.toLong() and 0xFFFFFFFFL
+                if (lengthLong > MAX_VIDEO_FRAME_BYTES.toLong()) {
+                    error = "Oversized frame length: $lengthLong"
+                    return false
+                }
+                val length = lengthLong.toInt()
+                if (!isValidPayloadLength(kind, length)) {
+                    error = "Invalid payload length $length for kind $kind"
+                    return false
+                }
+                val ptsUs = bb.long
+
+                if (bytes.size - pos < HEADER_BYTES + length) {
+                    break
+                }
+
+                val payload = if (length == 0) {
+                    ByteArray(0)
+                } else {
+                    bytes.copyOfRange(pos + HEADER_BYTES, pos + HEADER_BYTES + length)
+                }
+                outFrames.add(Frame(kind = kind, flags = flags, ptsUs = ptsUs, payload = payload))
+                pos += HEADER_BYTES + length
+            }
+
+            if (pos > 0) {
+                val remaining = if (pos < bytes.size) bytes.copyOfRange(pos, bytes.size) else ByteArray(0)
+                buffer.reset()
+                if (remaining.isNotEmpty()) {
+                    buffer.write(remaining)
+                }
+                consumedOffset = 0
+            } else {
+                consumedOffset = pos
+            }
+            return true
+        }
+    }
+}
+
+class StreamMuxerQueue(
+    private val maxVideoFrames: Int = ScreenStreamProtocol.MAX_VIDEO_QUEUE_FRAMES,
+    private val maxAudioChunks: Int = ScreenStreamProtocol.MAX_AUDIO_QUEUE_CHUNKS,
+    private val onClosedCallback: (() -> Unit)? = null,
+) : InputStream() {
+
+    data class OfferResult(
+        val accepted: Boolean,
+        val requestSyncFrame: Boolean,
+    )
+
+    private class QueuedPacket(
+        val kind: ScreenStreamProtocol.FrameKind,
+        val isKeyframe: Boolean,
+        val encoded: ByteArray,
+    )
+
+    private val lock = ReentrantLock()
+    private val notEmpty = lock.newCondition()
+    private val queue = ArrayDeque<QueuedPacket>()
+    private var currentChunk: ByteArray? = null
+    private var currentOffset = 0
+    private var queuedVideoFrames = 0
+    private var queuedAudioChunks = 0
+    private var droppingUntilKeyframe = false
+    private var closed = false
+    private var eosQueued = false
+    private var closedNotified = false
+
+    val isClosed: Boolean
+        get() = lock.withLock { closed }
+
+    fun queuedCounts(): Pair<Int, Int> = lock.withLock {
+        Pair(queuedVideoFrames, queuedAudioChunks)
+    }
+
+    fun offerCodecConfig(ptsUs: Long, annexBConfig: ByteArray): Boolean {
+        if (annexBConfig.isEmpty() || annexBConfig.size > ScreenStreamProtocol.MAX_VIDEO_FRAME_BYTES) {
+            return false
+        }
+        val encoded = ScreenStreamProtocol.encodeFrame(
+            kind = ScreenStreamProtocol.FrameKind.CODEC_CONFIG,
+            flags = ScreenStreamProtocol.FLAG_NONE,
+            ptsUs = ptsUs,
+            payload = annexBConfig,
+        )
+        lock.withLock {
+            if (closed || eosQueued) return false
+            queue.addLast(
+                QueuedPacket(
+                    kind = ScreenStreamProtocol.FrameKind.CODEC_CONFIG,
+                    isKeyframe = true,
+                    encoded = encoded,
+                )
+            )
+            notEmpty.signalAll()
+            return true
+        }
+    }
+
+    fun offerVideoFrame(flags: Int, ptsUs: Long, payload: ByteArray): OfferResult {
+        if (payload.size > ScreenStreamProtocol.MAX_VIDEO_FRAME_BYTES) {
+            return OfferResult(accepted = false, requestSyncFrame = false)
+        }
+        val isKeyframe = (flags and ScreenStreamProtocol.FLAG_KEYFRAME) != 0
+        val encoded = ScreenStreamProtocol.encodeFrame(
+            kind = ScreenStreamProtocol.FrameKind.VIDEO_ACCESS_UNIT,
+            flags = flags and ScreenStreamProtocol.FLAG_VALID_MASK,
+            ptsUs = ptsUs,
+            payload = payload,
+        )
+
+        lock.withLock {
+            if (closed || eosQueued) {
+                return OfferResult(accepted = false, requestSyncFrame = false)
+            }
+
+            if (droppingUntilKeyframe && !isKeyframe) {
+                return OfferResult(accepted = false, requestSyncFrame = true)
+            }
+
+            var triggerSync = false
+            if (queuedVideoFrames >= maxVideoFrames) {
+                purgeQueuedNonKeyframesLocked()
+                triggerSync = true
+
+                if (!isKeyframe) {
+                    droppingUntilKeyframe = true
+                    return OfferResult(accepted = false, requestSyncFrame = true)
+                }
+
+                while (queuedVideoFrames >= maxVideoFrames) {
+                    if (!dropOldestPacketOfKindLocked(ScreenStreamProtocol.FrameKind.VIDEO_ACCESS_UNIT)) {
+                        break
+                    }
+                }
+            }
+
+            if (isKeyframe) {
+                droppingUntilKeyframe = false
+            }
+
+            queue.addLast(
+                QueuedPacket(
+                    kind = ScreenStreamProtocol.FrameKind.VIDEO_ACCESS_UNIT,
+                    isKeyframe = isKeyframe,
+                    encoded = encoded,
+                )
+            )
+            queuedVideoFrames += 1
+            notEmpty.signalAll()
+            return OfferResult(accepted = true, requestSyncFrame = triggerSync)
+        }
+    }
+
+    fun offerAudioChunk(ptsUs: Long, pcmBytes: ByteArray, length: Int = pcmBytes.size): Boolean {
+        if (length <= 0 || length > ScreenStreamProtocol.MAX_AUDIO_CHUNK_BYTES || length > pcmBytes.size) {
+            return false
+        }
+        val encoded = ScreenStreamProtocol.encodeFrame(
+            kind = ScreenStreamProtocol.FrameKind.AUDIO_PCM_CHUNK,
+            flags = ScreenStreamProtocol.FLAG_NONE,
+            ptsUs = ptsUs,
+            payload = pcmBytes,
+            offset = 0,
+            length = length,
+        )
+
+        lock.withLock {
+            if (closed || eosQueued) return false
+            while (queuedAudioChunks >= maxAudioChunks) {
+                if (!dropOldestPacketOfKindLocked(ScreenStreamProtocol.FrameKind.AUDIO_PCM_CHUNK)) {
+                    break
+                }
+            }
+            queue.addLast(
+                QueuedPacket(
+                    kind = ScreenStreamProtocol.FrameKind.AUDIO_PCM_CHUNK,
+                    isKeyframe = false,
+                    encoded = encoded,
+                )
+            )
+            queuedAudioChunks += 1
+            notEmpty.signalAll()
+            return true
+        }
+    }
+
+    fun offerEosAndFinish(ptsUs: Long) {
+        val encoded = ScreenStreamProtocol.encodeFrame(
+            kind = ScreenStreamProtocol.FrameKind.CONTROL_EOS,
+            flags = ScreenStreamProtocol.FLAG_NONE,
+            ptsUs = ptsUs,
+            payload = ByteArray(0),
+        )
+        lock.withLock {
+            if (!closed && !eosQueued) {
+                eosQueued = true
+                queue.addLast(
+                    QueuedPacket(
+                        kind = ScreenStreamProtocol.FrameKind.CONTROL_EOS,
+                        isKeyframe = true,
+                        encoded = encoded,
+                    )
+                )
+                closed = true
+                notEmpty.signalAll()
+            }
+        }
+    }
+
+    override fun read(): Int {
+        val single = ByteArray(1)
+        val n = read(single, 0, 1)
+        return if (n == -1) -1 else (single[0].toInt() and 0xFF)
+    }
+
+    override fun read(b: ByteArray, off: Int, len: Int): Int {
+        if (off < 0 || len < 0 || off + len > b.size) {
+            throw IndexOutOfBoundsException("Invalid read bounds")
+        }
+        if (len == 0) return 0
+
+        lock.withLock {
+            while (currentChunk == null && queue.isEmpty()) {
+                if (closed) return -1
+                try {
+                    notEmpty.await()
+                } catch (_: InterruptedException) {
+                    Thread.currentThread().interrupt()
+                    return -1
+                }
+            }
+
+            var copied = 0
+            while (copied < len) {
+                if (currentChunk == null) {
+                    val next = queue.pollFirst() ?: break
+                    decrementCountsLocked(next)
+                    currentChunk = next.encoded
+                    currentOffset = 0
+                }
+
+                val active = currentChunk!!
+                val avail = active.size - currentOffset
+                val toCopy = min(len - copied, avail)
+                System.arraycopy(active, currentOffset, b, off + copied, toCopy)
+                currentOffset += toCopy
+                copied += toCopy
+
+                if (currentOffset >= active.size) {
+                    currentChunk = null
+                    currentOffset = 0
+                }
+            }
+
+            return if (copied > 0) copied else if (closed) -1 else 0
+        }
+    }
+
+    override fun available(): Int = lock.withLock {
+        val headAvail = currentChunk?.let { it.size - currentOffset } ?: 0
+        val queuedBytes = queue.sumOf { it.encoded.size }
+        headAvail + queuedBytes
+    }
+
+    override fun close() {
+        var callbackToRun: (() -> Unit)? = null
+        lock.withLock {
+            closed = true
+            eosQueued = true
+            queue.clear()
+            currentChunk = null
+            currentOffset = 0
+            queuedVideoFrames = 0
+            queuedAudioChunks = 0
+            if (!closedNotified) {
+                closedNotified = true
+                callbackToRun = onClosedCallback
+            }
+            notEmpty.signalAll()
+        }
+        callbackToRun?.invoke()
+    }
+
+    private fun purgeQueuedNonKeyframesLocked() {
+        val retained = ArrayDeque<QueuedPacket>(queue.size)
+        for (pkt in queue) {
+            if (pkt.kind == ScreenStreamProtocol.FrameKind.VIDEO_ACCESS_UNIT && !pkt.isKeyframe) {
+                queuedVideoFrames -= 1
+            } else {
+                retained.addLast(pkt)
+            }
+        }
+        queue.clear()
+        queue.addAll(retained)
+    }
+
+    private fun dropOldestPacketOfKindLocked(kind: ScreenStreamProtocol.FrameKind): Boolean {
+        val it = queue.iterator()
+        while (it.hasNext()) {
+            val pkt = it.next()
+            if (pkt.kind == kind) {
+                it.remove()
+                decrementCountsLocked(pkt)
+                return true
+            }
+        }
+        return false
+    }
+
+    private fun decrementCountsLocked(pkt: QueuedPacket) {
+        when (pkt.kind) {
+            ScreenStreamProtocol.FrameKind.VIDEO_ACCESS_UNIT -> {
+                if (queuedVideoFrames > 0) queuedVideoFrames -= 1
+            }
+            ScreenStreamProtocol.FrameKind.AUDIO_PCM_CHUNK -> {
+                if (queuedAudioChunks > 0) queuedAudioChunks -= 1
+            }
+            ScreenStreamProtocol.FrameKind.CODEC_CONFIG,
+            ScreenStreamProtocol.FrameKind.CONTROL_EOS -> Unit
+        }
+    }
+}
