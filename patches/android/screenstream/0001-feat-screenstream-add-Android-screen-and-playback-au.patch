diff --git a/src/test/java/org/kde/kdeconnect/plugins/screenstream/ScreenStreamProtocolTest.kt b/src/test/java/org/kde/kdeconnect/plugins/screenstream/ScreenStreamProtocolTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..48ffdf19b978095216ebe4a64365c16a0c34cd56
--- /dev/null
+++ b/src/test/java/org/kde/kdeconnect/plugins/screenstream/ScreenStreamProtocolTest.kt
@@ -0,0 +1,246 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+package org.kde.kdeconnect.plugins.screenstream
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.ByteArrayOutputStream
+
+class ScreenStreamProtocolTest {
+
+    @Test
+    fun testEncodeAndDecodeRoundTripAllFrameKinds() {
+        val sps = byteArrayOf(0x00, 0x00, 0x00, 0x01, 0x67, 0x42, 0x00, 0x1E)
+        val idr = byteArrayOf(0x00, 0x00, 0x00, 0x01, 0x65, 0x11, 0x22, 0x33)
+        val pcm = byteArrayOf(0x01, 0x02, 0x03, 0x04)
+
+        val packet = ByteArrayOutputStream().apply {
+            write(ScreenStreamProtocol.encodeFrame(ScreenStreamProtocol.FrameKind.CODEC_CONFIG, ScreenStreamProtocol.FLAG_NONE, 100L, sps))
+            write(
+                ScreenStreamProtocol.encodeFrame(
+                    ScreenStreamProtocol.FrameKind.VIDEO_ACCESS_UNIT,
+                    ScreenStreamProtocol.FLAG_KEYFRAME or ScreenStreamProtocol.FLAG_PROTECTED_CONTENT,
+                    200L,
+                    idr,
+                )
+            )
+            write(ScreenStreamProtocol.encodeFrame(ScreenStreamProtocol.FrameKind.AUDIO_PCM_CHUNK, ScreenStreamProtocol.FLAG_NONE, 300L, pcm))
+            write(ScreenStreamProtocol.encodeFrame(ScreenStreamProtocol.FrameKind.CONTROL_EOS, ScreenStreamProtocol.FLAG_NONE, 400L, ByteArray(0)))
+        }.toByteArray()
+
+        val frames = ScreenStreamProtocol.parseFrames(packet)
+        assertEquals(4, frames.size)
+        assertEquals(ScreenStreamProtocol.FrameKind.CODEC_CONFIG, frames[0].kind)
+        assertArrayEquals(sps, frames[0].payload)
+        assertEquals(ScreenStreamProtocol.FrameKind.VIDEO_ACCESS_UNIT, frames[1].kind)
+        assertEquals(ScreenStreamProtocol.FLAG_KEYFRAME or ScreenStreamProtocol.FLAG_PROTECTED_CONTENT, frames[1].flags)
+        assertEquals(200L, frames[1].ptsUs)
+        assertArrayEquals(idr, frames[1].payload)
+        assertEquals(ScreenStreamProtocol.FrameKind.AUDIO_PCM_CHUNK, frames[2].kind)
+        assertArrayEquals(pcm, frames[2].payload)
+        assertEquals(ScreenStreamProtocol.FrameKind.CONTROL_EOS, frames[3].kind)
+        assertEquals(0, frames[3].payload.size)
+    }
+
+    @Test
+    fun testFrameReaderRejectsInvalidMagicAndOversizedAudio() {
+        val badMagic = ByteArray(16)
+        val reader = ScreenStreamProtocol.FrameReader()
+        val out = mutableListOf<ScreenStreamProtocol.Frame>()
+        assertFalse(reader.feed(badMagic, out))
+        assertNotNull(reader.error)
+
+        val oversizedAudioHeader = ScreenStreamProtocol.encodeFrame(
+            ScreenStreamProtocol.FrameKind.VIDEO_ACCESS_UNIT,
+            ScreenStreamProtocol.FLAG_NONE,
+            10L,
+            ByteArray(4),
+        )
+        // Corrupt kind byte (index 2) to AUDIO_PCM_CHUNK (0x03) and length (index 4..7) to 70000
+        oversizedAudioHeader[2] = 0x03
+        oversizedAudioHeader[4] = 0x00
+        oversizedAudioHeader[5] = 0x01
+        oversizedAudioHeader[6] = 0x11
+        oversizedAudioHeader[7] = 0x70
+
+        val audioReader = ScreenStreamProtocol.FrameReader()
+        assertFalse(audioReader.feed(oversizedAudioHeader, out))
+        assertNotNull(audioReader.error)
+    }
+
+    @Test
+    fun testControlRequestValidationAndClamping() {
+        assertNull(ScreenStreamProtocol.parseControlRequest("start", ScreenStreamProtocol.MAX_CONTROL_JSON_BYTES + 1))
+        assertNull(ScreenStreamProtocol.parseControlRequest("unknown", 32))
+        assertNull(ScreenStreamProtocol.parseControlRequest(null, 32))
+
+        val req = ScreenStreamProtocol.parseControlRequest(
+            action = "start",
+            rawJsonBytes = 128,
+            maxWidth = 99999,
+            maxHeight = 100,
+            maxFps = 240,
+            maxBitrateKbps = 500000,
+            requestAudio = false,
+        ) as ScreenStreamProtocol.ControlRequest.Start
+
+        assertEquals(3840, req.params.maxWidth)
+        assertEquals(320, req.params.maxHeight)
+        assertEquals(60, req.params.maxFps)
+        assertEquals(20000, req.params.maxBitrateKbps)
+        assertFalse(req.params.requestAudio)
+    }
+
+    @Test
+    fun testComputeStreamGeometryPreservesAspectAndAligns16() {
+        val portrait = ScreenStreamProtocol.computeStreamGeometry(1080, 2460, 1920, 1920)
+        assertEquals(0, portrait.first % 16)
+        assertEquals(0, portrait.second % 16)
+        assertTrue(portrait.first <= 1920 && portrait.second <= 1920)
+        assertEquals(Pair(848, 1920), portrait)
+
+        val landscape = ScreenStreamProtocol.computeStreamGeometry(2460, 1080, 1920, 1920)
+        assertEquals(Pair(1920, 848), landscape)
+    }
