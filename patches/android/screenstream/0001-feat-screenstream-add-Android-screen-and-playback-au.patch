index 0000000000000000000000000000000000000000..00f31bcbdafb9533ec4004041afc512128cce6cc
--- /dev/null
+++ b/src/main/java/org/kde/kdeconnect/plugins/screenstream/AudioPlaybackCapturer.kt
@@ -0,0 +1,173 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+package org.kde.kdeconnect.plugins.screenstream
+
+import android.Manifest
+import android.annotation.SuppressLint
+import android.content.Context
+import android.content.pm.PackageManager
+import android.media.AudioAttributes
+import android.media.AudioFormat
+import android.media.AudioPlaybackCaptureConfiguration
+import android.media.AudioRecord
+import android.media.projection.MediaProjection
+import android.os.Build
+import android.os.SystemClock
+import android.util.Log
+import androidx.annotation.RequiresApi
+import androidx.core.content.ContextCompat
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicLong
+import kotlin.math.max
+
+@RequiresApi(Build.VERSION_CODES.R)
+class AudioPlaybackCapturer(
+    private val context: Context,
+    private val mediaProjection: MediaProjection,
+    private val muxerQueue: StreamMuxerQueue,
+    private val lastPtsUs: AtomicLong,
+    private val onAudioStatusChanged: (available: Boolean, reason: String) -> Unit,
+) {
+    data class StartResult(
+        val available: Boolean,
+        val reason: String,
+    )
+
+    private var audioRecord: AudioRecord? = null
+    private var workerThread: Thread? = null
+    private val running = AtomicBoolean(false)
+
+    @SuppressLint("MissingPermission")
+    fun start(): StartResult {
+        if (ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
+            return StartResult(available = false, reason = "RECORD_AUDIO permission not granted")
+        }
+
+        return try {
+            val minBytes = AudioRecord.getMinBufferSize(
+                SAMPLE_RATE_HZ,
+                AudioFormat.CHANNEL_IN_MONO,
+                AudioFormat.ENCODING_PCM_16BIT,
+            )
+            if (minBytes <= 0) {
+                return StartResult(available = false, reason = "Incompatible audio capture buffer on device")
+            }
+
+            val captureConfig = AudioPlaybackCaptureConfiguration.Builder(mediaProjection)
+                .addMatchingUsage(AudioAttributes.USAGE_MEDIA)
+                .addMatchingUsage(AudioAttributes.USAGE_GAME)
+                .addMatchingUsage(AudioAttributes.USAGE_UNKNOWN)
+                .build()
+
+            val format = AudioFormat.Builder()
+                .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                .setSampleRate(SAMPLE_RATE_HZ)
+                .setChannelMask(AudioFormat.CHANNEL_IN_MONO)
+                .build()
+
+            val recorder = AudioRecord.Builder()
+                .setAudioFormat(format)
+                .setBufferSizeInBytes(max(minBytes, CHUNK_BYTES * 4))
+                .setAudioPlaybackCaptureConfig(captureConfig)
+                .build()
+
+            if (recorder.state != AudioRecord.STATE_INITIALIZED) {
+                recorder.release()
+                return StartResult(available = false, reason = "AudioRecord failed to initialize")
+            }
+
+            audioRecord = recorder
+            running.set(true)
+            recorder.startRecording()
+
+            val thread = Thread({ readLoop(recorder) }, "ScreenStreamAudio")
+            workerThread = thread
+            thread.start()
+
+            StartResult(available = true, reason = "")
+        } catch (e: SecurityException) {
+            Log.w(TAG, "Audio capture permission error", e)
+            stop()
+            StartResult(available = false, reason = "RECORD_AUDIO permission denied")
+        } catch (e: RuntimeException) {
+            Log.w(TAG, "Playback audio capture unavailable", e)
+            stop()
+            StartResult(available = false, reason = "Playback audio unavailable: ${e.javaClass.simpleName}")
+        }
+    }
+
+    fun stop() {
+        running.set(false)
+        val recorder = audioRecord
+        audioRecord = null
+        if (recorder != null) {
+            try {
+                recorder.stop()
+            } catch (_: IllegalStateException) {
+            }
+        }
+        val thread = workerThread
+        workerThread = null
+        if (thread != null && thread !== Thread.currentThread()) {
+            try {
+                thread.join(1000)
+            } catch (_: InterruptedException) {
+                Thread.currentThread().interrupt()
+            }
+        }
+        recorder?.release()
+    }
+
+    private fun readLoop(recorder: AudioRecord) {
+        val samples = ShortArray(CHUNK_SAMPLES)
+        val pcmBytes = ByteArray(CHUNK_BYTES)
+        try {
+            while (running.get() && !muxerQueue.isClosed) {
+                val readCount = recorder.read(samples, 0, samples.size)
+                if (readCount < 0) {
+                    if (running.get()) {
+                        onAudioStatusChanged(false, "Audio playback read stopped (code $readCount)")
+                    }
+                    break
+                }
+                if (readCount == 0) {
+                    continue
+                }
+                for (i in 0 until readCount) {
+                    val sample = samples[i].toInt()
+                    pcmBytes[i * 2] = (sample and 0xFF).toByte()
+                    pcmBytes[i * 2 + 1] = ((sample ushr 8) and 0xFF).toByte()
+                }
+                val ptsUs = nextMonotonicPts()
+                muxerQueue.offerAudioChunk(ptsUs, pcmBytes, readCount * 2)
+            }
+        } catch (e: RuntimeException) {
+            if (running.get()) {
+                Log.w(TAG, "Audio read loop aborted", e)
+                onAudioStatusChanged(false, "Playback audio interrupted")
+            }
+        }
+    }
+
+    private fun nextMonotonicPts(): Long {
+        val clockNowUs = SystemClock.elapsedRealtimeNanos() / 1000L
+        while (true) {
+            val prev = lastPtsUs.get()
+            val next = if (clockNowUs > prev) clockNowUs else prev + 1L
+            if (lastPtsUs.compareAndSet(prev, next)) {
+                return next
+            }
+        }
+    }
+
+    companion object {
+        private const val TAG = "AudioPlaybackCapturer"
+        const val SAMPLE_RATE_HZ = 48000
+        private const val CHUNK_SAMPLES = 960
+        private const val CHUNK_BYTES = CHUNK_SAMPLES * 2
+    }
+}
