+    @Test
+    fun testIncrementalFrameReaderResetAndWireHelpers() {
+        for (state in ScreenStreamProtocol.SessionState.entries) {
+            assertEquals(state, ScreenStreamProtocol.SessionState.fromWireName(state.wireName))
+        }
+        assertNull(ScreenStreamProtocol.SessionState.fromWireName("unknown_state"))
+
+        assertTrue(ScreenStreamProtocol.isValidRotation(0))
+        assertTrue(ScreenStreamProtocol.isValidRotation(90))
+        assertTrue(ScreenStreamProtocol.isValidRotation(180))
+        assertTrue(ScreenStreamProtocol.isValidRotation(270))
+        assertFalse(ScreenStreamProtocol.isValidRotation(-90))
+        assertFalse(ScreenStreamProtocol.isValidRotation(45))
+        assertFalse(ScreenStreamProtocol.isValidRotation(360))
+
+        val validFrame = ScreenStreamProtocol.encodeFrame(
+            ScreenStreamProtocol.FrameKind.VIDEO_ACCESS_UNIT,
+            ScreenStreamProtocol.FLAG_KEYFRAME,
+            500L,
+            byteArrayOf(0x00, 0x00, 0x00, 0x01, 0x65),
+        )
+        val reader = ScreenStreamProtocol.FrameReader()
+        val parsed = mutableListOf<ScreenStreamProtocol.Frame>()
+
+        // Corrupt stream first, verify reset() restores clean parsing.
+        assertFalse(reader.feed(ByteArray(16), parsed))
+        assertNotNull(reader.error)
+        reader.reset()
+        assertNull(reader.error)
+        assertEquals(0, reader.bufferedBytes)
+
+        assertTrue(reader.feed(validFrame.copyOfRange(0, 7), parsed))
+        assertEquals(0, parsed.size)
+        assertEquals(7, reader.bufferedBytes)
+        assertTrue(reader.feed(validFrame.copyOfRange(7, validFrame.size), parsed))
+        assertEquals(1, parsed.size)
+        assertEquals(0, reader.bufferedBytes)
+        assertEquals(500L, parsed[0].ptsUs)
+    }
