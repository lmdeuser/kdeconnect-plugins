+    private val audioDeviceCallback = object : AudioDeviceCallback() {
+        override fun onAudioDevicesAdded(addedDevices: Array<out AudioDeviceInfo>?) {
+            if (stopping.get() || mediaProjection == null || addedDevices.isNullOrEmpty()) {
+                return
+            }
+            if (addedDevices.any { isBluetoothAudioSink(it) } && audioCapturer != null) {
+                Log.i(TAG, "Bluetooth audio sink connected during stream; routing audio to Bluetooth")
+                applyAudioEnabledState(enabled = false, reasonWhenDisabled = AUDIO_REASON_BLUETOOTH_ROUTED)
+            }
+        }
+
+        override fun onAudioDevicesRemoved(removedDevices: Array<out AudioDeviceInfo>?) {
+            if (stopping.get() || mediaProjection == null || removedDevices.isNullOrEmpty()) {
+                return
+            }
+            if (removedDevices.any { isBluetoothAudioSink(it) } &&
+                audioRequestedByUser &&
+                !hasConnectedBluetoothAudioOutput() &&
+                audioCapturer == null
+            ) {
+                Log.i(TAG, "Bluetooth audio sink disconnected; resuming screencast audio capture")
+                applyAudioEnabledState(enabled = true, reasonWhenDisabled = "")
+            }
+        }
+    }
