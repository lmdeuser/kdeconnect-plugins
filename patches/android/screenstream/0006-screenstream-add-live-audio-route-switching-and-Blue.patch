+        fun setAudioEnabledIfRunning(
+            deviceId: String,
+            enabled: Boolean,
+            forceOverrideBluetooth: Boolean,
+        ) {
+            val active = currentInstance ?: return
+            if (active.activeDeviceId == deviceId) {
+                active.mainHandler.post {
+                    if (currentInstance === active && !active.stopping.get() && active.activeDeviceId == deviceId) {
+                        active.audioRequestedByUser = enabled
+                        active.applyAudioEnabledState(
+                            enabled = enabled,
+                            reasonWhenDisabled = AUDIO_REASON_BLUETOOTH_ROUTED,
+                            forceOverrideBluetooth = forceOverrideBluetooth,
+                        )
+                    }
+                }
+            }
+        }
