+    private fun isBluetoothAudioSink(info: AudioDeviceInfo): Boolean {
+        if (!info.isSink) {
+            return false
+        }
+        val t = info.type
+        return t == AudioDeviceInfo.TYPE_BLUETOOTH_A2DP ||
+            t == AudioDeviceInfo.TYPE_BLUETOOTH_SCO ||
+            (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S &&
+                (t == AudioDeviceInfo.TYPE_BLE_HEADSET || t == AudioDeviceInfo.TYPE_BLE_SPEAKER))
+    }
+
+    private fun hasConnectedBluetoothAudioOutput(): Boolean {
+        val am = audioManager ?: return false
+        return am.getDevices(AudioManager.GET_DEVICES_OUTPUTS).any { isBluetoothAudioSink(it) }
+    }
+
+    private fun setArbiterScreencastAudioActive(active: Boolean) {
+        getSharedPreferences("${packageName}_audio_arbiter", Context.MODE_PRIVATE).edit {
+            putBoolean("screenstream_audio_active", active)
+        }
+    }
+
+    private fun applyAudioEnabledState(
+        enabled: Boolean,
+        reasonWhenDisabled: String,
+        forceOverrideBluetooth: Boolean = false,
+    ) {
+        if (stopping.get()) {
+            return
+        }
+        val deviceId = activeDeviceId ?: return
+        val projection = mediaProjection ?: return
+        val queue = muxerQueue ?: return
+        if (queue.isClosed) {
+            return
+        }
+
+        if (!enabled) {
+            audioCapturer?.stop()
+            audioCapturer = null
+            setArbiterScreencastAudioActive(false)
+            KdeConnect.getInstance()
+                .getDevicePlugin(deviceId, ScreenStreamPlugin::class.java)
+                ?.onServiceAudioStatusChanged(false, reasonWhenDisabled)
+            return
+        }
+
+        if (!forceOverrideBluetooth && hasConnectedBluetoothAudioOutput()) {
+            audioCapturer?.stop()
+            audioCapturer = null
+            setArbiterScreencastAudioActive(false)
+            KdeConnect.getInstance()
+                .getDevicePlugin(deviceId, ScreenStreamPlugin::class.java)
+                ?.onServiceAudioStatusChanged(false, AUDIO_REASON_BLUETOOTH_ROUTED)
+            return
+        }
+
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S && forceOverrideBluetooth) {
+            try {
+                audioManager?.clearCommunicationDevice()
+            } catch (_: RuntimeException) {
+            }
+        }
+
+        val existing = audioCapturer
+        if (existing != null) {
+            setArbiterScreencastAudioActive(true)
+            KdeConnect.getInstance()
+                .getDevicePlugin(deviceId, ScreenStreamPlugin::class.java)
+                ?.onServiceAudioStatusChanged(true, "")
+            return
+        }
+
+        val capturer = AudioPlaybackCapturer(
+            context = this,
+            mediaProjection = projection,
+            muxerQueue = queue,
+            lastPtsUs = lastPtsUs,
+            onAudioStatusChanged = { avail, reason ->
+                mainHandler.post {
+                    setArbiterScreencastAudioActive(avail)
+                    KdeConnect.getInstance()
+                        .getDevicePlugin(deviceId, ScreenStreamPlugin::class.java)
+                        ?.onServiceAudioStatusChanged(avail, reason)
+                }
+            },
+        )
+        val res = capturer.start()
+        if (res.available) {
+            audioCapturer = capturer
+        } else {
+            capturer.stop()
+        }
+        setArbiterScreencastAudioActive(res.available)
+        KdeConnect.getInstance()
+            .getDevicePlugin(deviceId, ScreenStreamPlugin::class.java)
+            ?.onServiceAudioStatusChanged(res.available, res.reason)
+    }
