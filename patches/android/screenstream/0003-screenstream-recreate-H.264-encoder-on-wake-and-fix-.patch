+    private fun queryDefaultDisplayState(): Int {
+        return displayManager?.getDisplay(Display.DEFAULT_DISPLAY)?.state ?: Display.STATE_UNKNOWN
+    }
+
+    private fun scheduleWakeRecovery(reason: String) {
+        if (stopping.get() || virtualDisplay == null || muxerQueue == null) {
+            return
+        }
+        pendingWakeRecoveryReason = reason
+        mainHandler.removeCallbacks(wakeRecoveryRunnable)
+        mainHandler.postDelayed(wakeRecoveryRunnable, WAKE_RECOVERY_DELAY_MS)
+    }
+
+    private fun replaceEncoder(
+        deviceId: String,
+        queue: StreamMuxerQueue,
+        vd: VirtualDisplay,
+        streamW: Int,
+        streamH: Int,
+        densityDpi: Int,
+        resizeVirtualDisplay: Boolean,
+        reason: String,
+    ) {
+        val oldEncoder = screenEncoder
+        screenEncoder = null
+        vd.setSurface(null)
+        oldEncoder?.stop()
+
+        val replacement = ScreenEncoder(
+            width = streamW,
+            height = streamH,
+            fps = startParams.maxFps,
+            bitrateKbps = startParams.maxBitrateKbps,
+            muxerQueue = queue,
+            protectedContentActive = protectedContentActive,
+            lastPtsUs = lastPtsUs,
+            onFatalError = { errorMsg ->
+                mainHandler.post {
+                    failStart(deviceId, errorMsg)
+                }
+            },
+        )
+        replacement.start()
+        try {
+            val newSurface = replacement.inputSurface
+                ?: throw IllegalStateException("Replacement encoder produced no input surface")
+            if (resizeVirtualDisplay) {
+                vd.resize(streamW, streamH, densityDpi)
+            }
+            vd.setSurface(newSurface)
+            screenEncoder = replacement
+            Log.i(TAG, "Recreated ScreenEncoder ($reason): ${streamW}x${streamH}")
+        } catch (e: Exception) {
+            replacement.stop()
+            throw e
+        }
+    }
+
+    private fun recoverEncoderAfterWake() {
+        if (stopping.get()) {
+            return
+        }
+        val vd = virtualDisplay ?: return
+        val deviceId = activeDeviceId ?: return
+        val queue = muxerQueue ?: return
+        if (queue.isClosed) {
+            return
+        }
+
+        val displayState = queryDefaultDisplayState()
+        lastDisplayState = displayState
+        if (displayState != Display.STATE_ON) {
+            return
+        }
+
+        val geom = queryDefaultDisplayGeometry()
+        currentDisplayGeometry = geom
+        val (streamW, streamH) = ScreenStreamProtocol.computeStreamGeometry(
+            geom.width,
+            geom.height,
+            startParams.maxWidth,
+            startParams.maxHeight,
+        )
+
+        val currentEncoder = screenEncoder
+        val resizeVirtualDisplay = (currentEncoder == null || currentEncoder.width != streamW || currentEncoder.height != streamH)
+        try {
+            replaceEncoder(
+                deviceId = deviceId,
+                queue = queue,
+                vd = vd,
+                streamW = streamW,
+                streamH = streamH,
+                densityDpi = geom.densityDpi,
+                resizeVirtualDisplay = resizeVirtualDisplay,
+                reason = pendingWakeRecoveryReason,
+            )
+        } catch (e: Exception) {
+            Log.e(TAG, "Failed to recreate encoder after wake ($pendingWakeRecoveryReason)", e)
+            failStart(deviceId, "Wake recovery failed: ${e.message ?: e.javaClass.simpleName}")
+        }
+    }
+
