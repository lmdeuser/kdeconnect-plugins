+    @Test
+    fun testCanInitiateStartBlocksDuplicateConsentAndActiveStream() {
+        val tracker = ScreenStreamSessionTracker()
+        assertTrue(ScreenStreamProtocol.canInitiateStart(tracker.state))
+
+        tracker.onStartRequested()
+        assertEquals(ScreenStreamProtocol.SessionState.AWAITING_CONSENT, tracker.state)
+        assertFalse(ScreenStreamProtocol.canInitiateStart(tracker.state))
+
+        tracker.onStreamingStarted()
+        assertEquals(ScreenStreamProtocol.SessionState.STREAMING, tracker.state)
+        assertFalse(ScreenStreamProtocol.canInitiateStart(tracker.state))
+
+        tracker.onExplicitStop("consent_denied")
+        assertTrue(ScreenStreamProtocol.canInitiateStart(tracker.state))
+
+        tracker.onError()
+        assertTrue(ScreenStreamProtocol.canInitiateStart(tracker.state))
+    }
