         sessionTracker.onLinkLost()
@@ -166,12 +171,19 @@ class ScreenStreamPlugin : Plugin() {
                 refreshDefaultDisplayInfo()
                 sendStatePacket()
             }
+            is ScreenStreamProtocol.ControlRequest.Wake -> {
+                wakeDeviceScreen()
+                if (sessionTracker.state == ScreenStreamProtocol.SessionState.STREAMING) {
+                    ScreenStreamService.requestKeyframeIfRunning(device.deviceId)
+                }
+            }
             is ScreenStreamProtocol.ControlRequest.RequestKeyframe -> {
                 if (sessionTracker.state == ScreenStreamProtocol.SessionState.STREAMING) {
                     ScreenStreamService.requestKeyframeIfRunning(device.deviceId)
                 }
             }
             is ScreenStreamProtocol.ControlRequest.Start -> {
+                wakeDeviceScreen()
                 val effectiveAudio = request.params.requestAudio && isAudioEnabledInSettings()
                 val effectiveParams = request.params.copy(requestAudio = effectiveAudio)
                 initiateCapture(params = effectiveParams, uiActivity = null)
@@ -246,6 +258,7 @@ class ScreenStreamPlugin : Plugin() {
             context = uiActivity ?: context,
             deviceId = device.deviceId,
             params = params,
+            keepScreenOn = isKeepScreenOnEnabledInSettings(),
         )
 
         if (uiActivity != null) {
@@ -619,6 +632,39 @@ class ScreenStreamPlugin : Plugin() {
         )
     }
 
+    private fun isKeepScreenOnEnabledInSettings(): Boolean {
+        return preferences.getBoolean(
+            context.getString(R.string.screenstream_pref_keep_screen_on_key),
+            true,
+        )
+    }
+
+    @Suppress("DEPRECATION")
+    private fun wakeDeviceScreen() {
+        mainHandler.removeCallbacks(releaseWakePulseRunnable)
+        releaseWakePulseLock()
+        val pm = context.getSystemService(PowerManager::class.java) ?: return
+        val lock = pm.newWakeLock(
+            PowerManager.SCREEN_BRIGHT_WAKE_LOCK or PowerManager.ACQUIRE_CAUSES_WAKEUP or PowerManager.ON_AFTER_RELEASE,
+            "kdeconnect:screenstream_wake",
+        )
+        lock.setReferenceCounted(false)
+        lock.acquire(WAKE_PULSE_TIMEOUT_MS)
+        wakePulseLock = lock
+        mainHandler.postDelayed(releaseWakePulseRunnable, WAKE_PULSE_RELEASE_DELAY_MS)
+    }
+
+    private fun releaseWakePulseLock() {
+        val lock = wakePulseLock ?: return
+        wakePulseLock = null
+        try {
+            if (lock.isHeld) {
+                lock.release()
+            }
+        } catch (_: RuntimeException) {
+        }
+    }
+
     private fun refreshDefaultDisplayInfo() {
         val displayManager = context.getSystemService(DisplayManager::class.java) ?: return
         val display = displayManager.getDisplay(Display.DEFAULT_DISPLAY) ?: return
@@ -646,5 +692,7 @@ class ScreenStreamPlugin : Plugin() {
     companion object {
         private const val PREF_EXPLICIT_STOP = "screenstream_explicit_stop"
         private const val CONSENT_NOTIFICATION_ID = 47292
+        private const val WAKE_PULSE_TIMEOUT_MS = 3000L
+        private const val WAKE_PULSE_RELEASE_DELAY_MS = 1500L
     }
 }
