+    @Test
+    fun testMuxerQueuePrioritizesAudioAheadOfQueuedVideoFrames() {
+        val queue = StreamMuxerQueue(maxVideoFrames = 4, maxAudioChunks = 4)
+        val sps = byteArrayOf(0x00, 0x00, 0x00, 0x01, 0x67)
+        val idr = byteArrayOf(0x00, 0x00, 0x00, 0x01, 0x65)
+        val delta = byteArrayOf(0x00, 0x00, 0x00, 0x01, 0x41)
+
+        assertTrue(queue.offerCodecConfig(1L, sps))
+        assertTrue(queue.offerVideoFrame(ScreenStreamProtocol.FLAG_KEYFRAME, 2L, idr).accepted)
+        assertTrue(queue.offerVideoFrame(ScreenStreamProtocol.FLAG_NONE, 3L, delta).accepted)
+        assertTrue(queue.offerAudioChunk(4L, byteArrayOf(10, 20)))
+        assertTrue(queue.offerAudioChunk(5L, byteArrayOf(30, 40)))
+        queue.offerEosAndFinish(6L)
+
+        val decoded = ScreenStreamProtocol.parseFrames(queue.readBytes())
+        assertEquals(6, decoded.size)
+        assertEquals(ScreenStreamProtocol.FrameKind.CODEC_CONFIG, decoded[0].kind)
+        assertEquals(ScreenStreamProtocol.FrameKind.AUDIO_PCM_CHUNK, decoded[1].kind)
+        assertEquals(4L, decoded[1].ptsUs)
+        assertEquals(ScreenStreamProtocol.FrameKind.AUDIO_PCM_CHUNK, decoded[2].kind)
+        assertEquals(5L, decoded[2].ptsUs)
+        assertEquals(ScreenStreamProtocol.FrameKind.VIDEO_ACCESS_UNIT, decoded[3].kind)
+        assertEquals(2L, decoded[3].ptsUs)
+        assertEquals(ScreenStreamProtocol.FrameKind.VIDEO_ACCESS_UNIT, decoded[4].kind)
+        assertEquals(3L, decoded[4].ptsUs)
+        assertEquals(ScreenStreamProtocol.FrameKind.CONTROL_EOS, decoded[5].kind)
+    }
