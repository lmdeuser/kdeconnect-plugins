+            val usage = cfg.audioAttributes.usage
+            usage == AudioAttributes.USAGE_VOICE_COMMUNICATION ||
+                usage == AudioAttributes.USAGE_VOICE_COMMUNICATION_SIGNALLING
+        }
+    }
