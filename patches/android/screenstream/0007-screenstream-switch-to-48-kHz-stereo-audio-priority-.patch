+    @SuppressLint("MissingPermission")
+    private fun createRecorder(
+        captureConfig: AudioPlaybackCaptureConfiguration,
+        channelMask: Int,
+        channels: Int,
+        codec: String,
+    ): RecorderSetup? {
+        val minBytes = AudioRecord.getMinBufferSize(
+            SAMPLE_RATE_HZ,
+            channelMask,
+            AudioFormat.ENCODING_PCM_16BIT,
+        )
+        if (minBytes <= 0) {
+            return null
+        }
+
+        val chunkSamples = CHUNK_FRAMES * channels
+        val chunkBytes = chunkSamples * 2
+        val format = AudioFormat.Builder()
+            .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+            .setSampleRate(SAMPLE_RATE_HZ)
+            .setChannelMask(channelMask)
+            .build()
+
+        val recorder = try {
+            AudioRecord.Builder()
+                .setAudioFormat(format)
+                .setBufferSizeInBytes(max(minBytes * 2, chunkBytes * 6))
+                .setAudioPlaybackCaptureConfig(captureConfig)
+                .build()
+        } catch (e: SecurityException) {
+            throw e
+        } catch (e: RuntimeException) {
+            Log.w(TAG, "AudioRecord init failed for $codec: ${e.message}")
+            return null
+        }
+
+        if (recorder.state != AudioRecord.STATE_INITIALIZED) {
+            recorder.release()
+            return null
+        }
+        return RecorderSetup(recorder = recorder, chunkSamples = chunkSamples, codec = codec)
+    }
+
