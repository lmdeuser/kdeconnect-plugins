+    @Test
+    fun keyframeQueueStaysBoundedAndDropsDeltasUntilNextKeyframe() {
+        val q = ContinuityStreamQueue(maxVideoFrames = 2, maxAudioChunks = 1)
+        val key1 = byteArrayOf(0, 0, 0, 1, 0x65, 1)
+        val key2 = byteArrayOf(0, 0, 0, 1, 0x65, 2)
+        val key3 = byteArrayOf(0, 0, 0, 1, 0x65, 3)
+        val key4 = byteArrayOf(0, 0, 0, 1, 0x65, 4)
+        val delta = byteArrayOf(0, 0, 0, 1, 0x41, 9)
+
+        assertTrue(q.offerVideoFrame(100L, key1, isKeyframe = true))
+        assertTrue(q.offerVideoFrame(200L, key2, isKeyframe = true))
+        // Delta triggers droppingUntilKeyframe when queue is full.
+        assertFalse(q.offerVideoFrame(300L, delta, isKeyframe = false))
+        // Next keyframes remain accepted while total queued video stays bounded at 2 (evicting key1, key2).
+        assertTrue(q.offerVideoFrame(400L, key3, isKeyframe = true))
+        assertTrue(q.offerVideoFrame(500L, key4, isKeyframe = true))
+
+        // Read everything: only key3 and key4 must be present (bounded cap = 2).
+        q.finish()
+        val all = ByteArrayOutputStream()
+        val buf = ByteArray(256)
+        while (true) {
+            val n = q.read(buf)
+            if (n <= 0) break
+            all.write(buf, 0, n)
+        }
+        q.close()
+
+        val reader = ContinuityCameraProtocol.FrameReader()
+        val out = mutableListOf<ContinuityCameraProtocol.Frame>()
+        assertTrue(reader.feed(all.toByteArray(), out))
+        assertEquals(3, out.size) // key3, key4, CONTROL_EOS
+        assertArrayEquals(key3, out[0].payload)
+        assertArrayEquals(key4, out[1].payload)
+        assertEquals(ContinuityCameraProtocol.FrameKind.CONTROL_EOS, out[2].kind)
+    }
