+/*
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+package org.kde.kdeconnect.plugins.continuitycamera
+
+import android.Manifest
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.widget.Toast
+import androidx.annotation.RequiresApi
+import androidx.core.app.NotificationCompat
+import androidx.core.content.ContextCompat
+import androidx.core.content.getSystemService
+import org.kde.kdeconnect.NetworkPacket
+import org.kde.kdeconnect.helpers.NotificationHelper
+import org.kde.kdeconnect.plugins.Plugin
+import org.kde.kdeconnect.plugins.PluginFactory.LoadablePlugin
+import org.kde.kdeconnect_tp.R
+import kotlin.math.abs
+
+@LoadablePlugin
+@RequiresApi(Build.VERSION_CODES.R)
+class ContinuityCameraPlugin : Plugin() {
+
+    private val mainHandler = Handler(Looper.getMainLooper())
+
+    @Volatile
+    private var activeQueue: ContinuityStreamQueue? = null
+
+    @Volatile
+    private var isStreaming: Boolean = false
+
+    override val minSdk: Int = Build.VERSION_CODES.R
+
+    override val keepAliveWhenUnreachable: Boolean = true
+
+    override val displayName: String
+        get() = context.getString(R.string.pref_plugin_continuitycamera)
+
+    override val description: String
+        get() = context.getString(R.string.pref_plugin_continuitycamera_desc)
+
+    override val supportedPacketTypes: Array<String>
+        get() = arrayOf(ContinuityCameraProtocol.PACKET_TYPE_CONTINUITYCAMERA_REQUEST)
+
+    override val outgoingPacketTypes: Array<String>
+        get() = arrayOf(ContinuityCameraProtocol.PACKET_TYPE_CONTINUITYCAMERA)
+
+    override val requiredPermissions: Array<String>
+        get() = arrayOf(Manifest.permission.CAMERA)
+
+    override val permissionExplanation: Int
+        get() = R.string.continuitycamera_permission_explanation
+
+    override val optionalPermissions: Array<String>
+        get() = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            arrayOf(Manifest.permission.RECORD_AUDIO, Manifest.permission.POST_NOTIFICATIONS)
+        } else {
+            arrayOf(Manifest.permission.RECORD_AUDIO)
+        }
+
+    override val optionalPermissionExplanation: Int
+        get() = R.string.continuitycamera_optional_permission_explanation
+
+    override fun onDestroy() {
+        stopLocalService()
+        mainHandler.removeCallbacksAndMessages(null)
+    }
+
+    override fun getUiButtons(): List<PluginUiButton> {
+        return listOf(
+            if (isStreaming) {
+                PluginUiButton(
+                    context.getString(R.string.continuitycamera_action_stop),
+                    R.drawable.ic_stop,
+                ) {
+                    stopLocalService()
+                }
+            } else {
+                PluginUiButton(
+                    context.getString(R.string.continuitycamera_action_capture),
+                    R.drawable.ic_phonelink_36dp,
+                ) { parentActivity ->
+                    parentActivity.startActivity(
+                        ContinuityCameraCaptureActivity.createIntent(
+                            parentActivity,
+                            device.deviceId,
+                            ContinuityCameraCaptureActivity.MODE_PHOTO,
+                        ),
+                    )
+                }
+            },
+        )
+    }
+
+    override fun onPacketReceived(np: NetworkPacket): Boolean {
+        val req = ContinuityCameraProtocol.parseRequest(np) ?: return false
+        when (req) {
+            is ContinuityCameraProtocol.Request.StartStream -> {
+                if (ContextCompat.checkSelfPermission(context, Manifest.permission.CAMERA) != PackageManager.PERMISSION_GRANTED) {
+                    sendStatePacket("error")
+                    return true
+                }
+                val startIntent = ContinuityCameraService.createStartIntent(context, device.deviceId, req.config)
+                ContextCompat.startForegroundService(context, startIntent)
+            }
+            ContinuityCameraProtocol.Request.StopStream -> {
+                stopLocalService()
+            }
+            is ContinuityCameraProtocol.Request.SwitchLens -> {
+                if (isStreaming) {
+                    context.startService(ContinuityCameraService.createSwitchLensIntent(context, req.lens))
+                }
+            }
+            ContinuityCameraProtocol.Request.CapturePhoto -> {
+                launchCaptureUi(ContinuityCameraCaptureActivity.MODE_PHOTO)
+            }
+            ContinuityCameraProtocol.Request.ScanDocument -> {
+                launchCaptureUi(ContinuityCameraCaptureActivity.MODE_SCAN)
+            }
+        }
+        return true
+    }
+
+    internal fun onServiceStreamStarted(queue: ContinuityStreamQueue, audioEnabled: Boolean) {
+        if (!isDeviceInitialized) {
+            queue.close()
+            return
+        }
+        activeQueue = queue
+        isStreaming = true
+        val openNp = NetworkPacket(ContinuityCameraProtocol.PACKET_TYPE_CONTINUITYCAMERA).apply {
+            set("event", "stream_open")
+            set("audioEnabled", audioEnabled)
+            payload = NetworkPacket.Payload(queue, -1L)
+        }
+        device.sendPacket(openNp)
+        device.onPluginsChanged()
+    }
+
+    internal fun onServiceStreamStopped(isError: Boolean) {
+        activeQueue?.close()
+        activeQueue = null
+        if (isStreaming) {
+            isStreaming = false
+            sendStatePacket(if (isError) "error" else "stopped")
+            device.onPluginsChanged()
+        }
+    }
+
+    internal fun deliverCaptureResult(filename: String, mimeType: String, bytes: ByteArray) {
+        if (!isDeviceInitialized) return
+        val packet = ContinuityCameraProtocol.buildCaptureResultPacket(filename, mimeType, bytes) ?: return
+        device.sendPacket(packet)
+        mainHandler.post {
+            Toast.makeText(context, R.string.continuitycamera_capture_sent, Toast.LENGTH_SHORT).show()
+        }
+    }
+
+    private fun stopLocalService() {
+        context.startService(ContinuityCameraService.createStopIntent(context))
+        activeQueue?.close()
+        activeQueue = null
+        if (isStreaming) {
+            isStreaming = false
+            sendStatePacket("stopped")
+            if (isDeviceInitialized) {
+                device.onPluginsChanged()
+            }
+        }
+    }
+
+    private fun sendStatePacket(state: String) {
+        if (!isDeviceInitialized) return
+        val np = NetworkPacket(ContinuityCameraProtocol.PACKET_TYPE_CONTINUITYCAMERA).apply {
+            set("event", "state")
+            set("state", state)
+        }
+        device.sendPacket(np)
+    }
+
+    private fun launchCaptureUi(mode: String) {
+        val intent = ContinuityCameraCaptureActivity.createIntent(context, device.deviceId, mode)
+        val pending = PendingIntent.getActivity(
+            context,
+            captureNotificationId(),
+            intent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+        val notification = NotificationCompat.Builder(context, NotificationHelper.Channels.HIGHPRIORITY)
+            .setSmallIcon(R.drawable.ic_phonelink_36dp)
+            .setContentTitle(context.getString(R.string.continuitycamera_capture_request_title, device.name))
+            .setContentText(context.getString(R.string.continuitycamera_capture_request_body))
+            .setPriority(NotificationCompat.PRIORITY_HIGH)
+            .setAutoCancel(true)
+            .setContentIntent(pending)
+            .setFullScreenIntent(pending, true)
+            .build()
+
+        context.getSystemService<NotificationManager>()?.notify(captureNotificationId(), notification)
+        try {
+            context.startActivity(intent)
+        } catch (_: RuntimeException) {
+        }
+    }
+
+    private fun captureNotificationId(): Int {
+        return CAPTURE_NOTIFICATION_BASE + (abs(device.deviceId.hashCode()) % 10000)
+    }
+
+    companion object {
+        private const val CAPTURE_NOTIFICATION_BASE = 48300
+    }
+}
