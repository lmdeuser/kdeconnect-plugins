+
+package org.kde.kdeconnect.plugins.continuitycamera
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.kde.kdeconnect.NetworkPacket
+import java.io.ByteArrayOutputStream
+
+class ContinuityCameraProtocolTest {
+
+    @Test
+    fun clampConfigAndParseRequestsEnforceBounds() {
+        val cfg = ContinuityCameraProtocol.clampConfig(1281, 100, 120, true, "FRONT")
+        assertEquals(1280, cfg.width)
+        assertEquals(ContinuityCameraProtocol.MIN_DIMENSION, cfg.height)
+        assertEquals(ContinuityCameraProtocol.MAX_FPS, cfg.fps)
+        assertEquals("front", cfg.lens)
+
+        val np = NetworkPacket(ContinuityCameraProtocol.PACKET_TYPE_CONTINUITYCAMERA_REQUEST).apply {
+            set("action", "start_stream")
+            set("maxWidth", 2560)
+            set("maxHeight", 720)
+            set("fps", 2)
+            set("includeMic", false)
+            set("lens", "weird")
+        }
+        val req = ContinuityCameraProtocol.parseRequest(np) as ContinuityCameraProtocol.Request.StartStream
+        assertEquals(1920, req.config.width)
+        assertEquals(ContinuityCameraProtocol.MIN_FPS, req.config.fps)
+        assertEquals("back", req.config.lens)
+        assertFalse(req.config.includeMic)
+    }
+
+    @Test
+    fun frameRoundTripAndQueueBackpressureWork() {
+        val q = ContinuityStreamQueue(maxVideoFrames = 1, maxAudioChunks = 1)
+        val cfg = byteArrayOf(0, 0, 0, 1, 0x67, 0x42)
+        val key = byteArrayOf(0, 0, 0, 1, 0x65, 0x88.toByte())
+        val delta = byteArrayOf(0, 0, 0, 1, 0x41, 0x11)
+        assertTrue(q.offerCodecConfig(100L, cfg))
+        assertTrue(q.offerVideoFrame(200L, key, isKeyframe = true))
+        // Delta rejected while video queue already at cap = 1
+        assertFalse(q.offerVideoFrame(300L, delta, isKeyframe = false))
+        assertTrue(q.offerAudioChunk(400L, byteArrayOf(1, 2, 3, 4)))
+        q.finish()
+
+        val allBytes = ByteArrayOutputStream()
+        val buf = ByteArray(19)
+        while (true) {
+            val n = q.read(buf)
+            if (n <= 0) break
+            allBytes.write(buf, 0, n)
+        }
+        q.close()
+
+        val reader = ContinuityCameraProtocol.FrameReader()
+        val frames = mutableListOf<ContinuityCameraProtocol.Frame>()
+        val wire = allBytes.toByteArray()
+        assertTrue(reader.feed(wire.copyOfRange(0, 21), frames))
+        assertTrue(reader.feed(wire.copyOfRange(21, wire.size), frames))
+        assertEquals(4, frames.size)
+        assertEquals(ContinuityCameraProtocol.FrameKind.CODEC_CONFIG, frames[0].kind)
+        assertArrayEquals(key, frames[1].payload)
+        assertEquals(ContinuityCameraProtocol.FrameKind.AUDIO_PCM_CHUNK, frames[2].kind)
+        assertEquals(ContinuityCameraProtocol.FrameKind.CONTROL_EOS, frames[3].kind)
+    }
+
+    @Test
+    fun invalidHeaderAndOversizedCaptureRejected() {
+        val reader = ContinuityCameraProtocol.FrameReader()
+        val out = mutableListOf<ContinuityCameraProtocol.Frame>()
+        assertFalse(reader.feed(ByteArray(16), out))
+        assertNotNull(reader.error)
+
+        assertNull(
+            ContinuityCameraProtocol.buildCaptureResultPacket(
+                "shot.jpg",
+                "image/jpeg",
+                ByteArray(0),
+            ),
+        )
+    }
+}
