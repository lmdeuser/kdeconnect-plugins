@@ -0,0 +1,354 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+package org.kde.kdeconnect.plugins.continuitycamera
+
+import org.kde.kdeconnect.NetworkPacket
+import java.io.ByteArrayOutputStream
+import java.io.InputStream
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.util.ArrayDeque
+import java.util.concurrent.locks.ReentrantLock
+import kotlin.concurrent.withLock
+
+object ContinuityCameraProtocol {
+    const val PACKET_TYPE_CONTINUITYCAMERA = "kdeconnect.continuitycamera"
+    const val PACKET_TYPE_CONTINUITYCAMERA_REQUEST = "kdeconnect.continuitycamera.request"
+
+    const val STREAM_MAGIC = 0x4B43
+    const val HEADER_BYTES = 16
+    const val MAX_VIDEO_FRAME_BYTES = 4 * 1024 * 1024
+    const val MAX_AUDIO_CHUNK_BYTES = 65536
+    const val MAX_CAPTURE_BYTES = 50 * 1024 * 1024
+
+    const val MIN_DIMENSION = 320
+    const val MAX_DIMENSION = 1920
+    const val MIN_FPS = 10
+    const val MAX_FPS = 60
+
+    const val MAX_VIDEO_QUEUE_FRAMES = 8
+    const val MAX_AUDIO_QUEUE_CHUNKS = 16
+
+    const val FLAG_NONE = 0x00
+    const val FLAG_KEYFRAME = 0x01
+    const val FLAG_VALID_MASK = 0x01
+
+    enum class FrameKind(val id: Int) {
+        CODEC_CONFIG(0x01),
+        VIDEO_ACCESS_UNIT(0x02),
+        AUDIO_PCM_CHUNK(0x03),
+        CONTROL_EOS(0x04);
+
+        companion object {
+            fun fromId(raw: Int): FrameKind? = entries.firstOrNull { it.id == raw }
+        }
+    }
+
+    data class StreamConfig(
+        val width: Int = 1280,
+        val height: Int = 720,
+        val fps: Int = 30,
+        val includeMic: Boolean = true,
+        val lens: String = "back",
+    )
+
+    data class Frame(
+        val kind: FrameKind,
+        val flags: Int,
+        val ptsUs: Long,
+        val payload: ByteArray,
+    )
+
+    sealed class Request {
+        data class StartStream(val config: StreamConfig) : Request()
+        data object StopStream : Request()
+        data class SwitchLens(val lens: String) : Request()
+        data object CapturePhoto : Request()
+        data object ScanDocument : Request()
+    }
+
+    fun clampConfig(
+        maxWidth: Int,
+        maxHeight: Int,
+        fps: Int,
+        includeMic: Boolean,
+        lens: String?,
+    ): StreamConfig {
+        val w = (maxWidth.coerceIn(MIN_DIMENSION, MAX_DIMENSION) and 1.inv()).coerceAtLeast(MIN_DIMENSION)
+        val h = (maxHeight.coerceIn(MIN_DIMENSION, MAX_DIMENSION) and 1.inv()).coerceAtLeast(MIN_DIMENSION)
+        val safeFps = fps.coerceIn(MIN_FPS, MAX_FPS)
+        return StreamConfig(
+            width = w,
+            height = h,
+            fps = safeFps,
+            includeMic = includeMic,
+            lens = normalizeLens(lens),
+        )
+    }
+
+    fun normalizeLens(raw: String?): String {
+        return if (raw?.trim()?.equals("front", ignoreCase = true) == true) "front" else "back"
+    }
+
+    fun parseRequest(np: NetworkPacket): Request? {
+        if (np.type != PACKET_TYPE_CONTINUITYCAMERA_REQUEST) return null
+        return when (np.getStringOrNull("action")) {
+            "start_stream" -> Request.StartStream(
+                clampConfig(
+                    maxWidth = np.getInt("maxWidth", 1280),
+                    maxHeight = np.getInt("maxHeight", 720),
+                    fps = np.getInt("fps", 30),
+                    includeMic = np.getBoolean("includeMic", true),
+                    lens = np.getStringOrNull("lens"),
+                ),
+            )
+            "stop_stream" -> Request.StopStream
+            "switch_lens" -> Request.SwitchLens(normalizeLens(np.getStringOrNull("lens")))
+            "capture_photo" -> Request.CapturePhoto
+            "scan_document" -> Request.ScanDocument
+            else -> null
+        }
+    }
+
+    fun buildCaptureResultPacket(filename: String, mimeType: String, bytes: ByteArray): NetworkPacket? {
+        if (bytes.isEmpty() || bytes.size > MAX_CAPTURE_BYTES || filename.isBlank()) {
+            return null
+        }
+        return NetworkPacket(PACKET_TYPE_CONTINUITYCAMERA).apply {
+            set("event", "capture_result")
+            set("filename", filename)
+            set("mimeType", mimeType)
+            payload = NetworkPacket.Payload(bytes)
+        }
+    }
+
+    fun isValidPayloadLength(kind: FrameKind, length: Int): Boolean {
+        return when (kind) {
+            FrameKind.CODEC_CONFIG, FrameKind.VIDEO_ACCESS_UNIT -> length in 1..MAX_VIDEO_FRAME_BYTES
+            FrameKind.AUDIO_PCM_CHUNK -> length in 1..MAX_AUDIO_CHUNK_BYTES
+            FrameKind.CONTROL_EOS -> length == 0
+        }
+    }
+
+    fun encodeFrame(kind: FrameKind, flags: Int, ptsUs: Long, payload: ByteArray): ByteArray {
+        require((flags and FLAG_VALID_MASK.inv()) == 0) { "Invalid flags" }
+        require(isValidPayloadLength(kind, payload.size)) { "Out-of-bounds payload for $kind" }
+        val bb = ByteBuffer.allocate(HEADER_BYTES + payload.size).order(ByteOrder.BIG_ENDIAN)
+        bb.putShort(STREAM_MAGIC.toShort())
+        bb.put(kind.id.toByte())
+        bb.put(flags.toByte())
+        bb.putInt(payload.size)
+        bb.putLong(ptsUs)
+        if (payload.isNotEmpty()) {
+            bb.put(payload)
+        }
+        return bb.array()
+    }
+
+    class FrameReader {
+        private val buffer = ByteArrayOutputStream()
+        var error: String? = null
+            private set
+
+        fun feed(chunk: ByteArray, outFrames: MutableList<Frame>): Boolean {
+            if (error != null) return false
+            if (chunk.isNotEmpty()) buffer.write(chunk)
+            val bytes = buffer.toByteArray()
+            var pos = 0
+
+            while (bytes.size - pos >= HEADER_BYTES) {
+                val bb = ByteBuffer.wrap(bytes, pos, HEADER_BYTES).order(ByteOrder.BIG_ENDIAN)
+                val magic = bb.short.toInt() and 0xFFFF
+                if (magic != STREAM_MAGIC) {
+                    error = "Invalid magic"
+                    return false
+                }
+                val kind = FrameKind.fromId(bb.get().toInt() and 0xFF)
+                if (kind == null) {
+                    error = "Unknown kind"
+                    return false
+                }
+                val flags = bb.get().toInt() and 0xFF
+                if ((flags and FLAG_VALID_MASK.inv()) != 0) {
+                    error = "Invalid flags"
+                    return false
+                }
+                val lenLong = bb.int.toLong() and 0xFFFFFFFFL
+                if (lenLong > MAX_VIDEO_FRAME_BYTES.toLong() || !isValidPayloadLength(kind, lenLong.toInt())) {
+                    error = "Invalid payload length"
+                    return false
+                }
+                val len = lenLong.toInt()
+                val ptsUs = bb.long
+                if (bytes.size - pos < HEADER_BYTES + len) {
+                    break
+                }
+                val payload = if (len == 0) ByteArray(0) else bytes.copyOfRange(pos + HEADER_BYTES, pos + HEADER_BYTES + len)
+                outFrames.add(Frame(kind = kind, flags = flags, ptsUs = ptsUs, payload = payload))
+                pos += HEADER_BYTES + len
+            }
+
+            if (pos > 0) {
+                val rem = if (pos < bytes.size) bytes.copyOfRange(pos, bytes.size) else ByteArray(0)
+                buffer.reset()
+                if (rem.isNotEmpty()) buffer.write(rem)
+            }
+            return true
+        }
+    }
+}
+
+class ContinuityStreamQueue(
+    private val maxVideoFrames: Int = ContinuityCameraProtocol.MAX_VIDEO_QUEUE_FRAMES,
+    private val maxAudioChunks: Int = ContinuityCameraProtocol.MAX_AUDIO_QUEUE_CHUNKS,
+    private val onClosedCallback: (() -> Unit)? = null,
+) : InputStream() {
+
+    private class QueuedPacket(
+        val kind: ContinuityCameraProtocol.FrameKind,
+        val encoded: ByteArray,
+    )
+
+    private val lock = ReentrantLock()
+    private val notEmpty = lock.newCondition()
+    private val queue = ArrayDeque<QueuedPacket>()
+    private var currentChunk: ByteArray? = null
+    private var currentOffset = 0
+    private var queuedVideo = 0
+    private var queuedAudio = 0
+    private var closed = false
+    private var eosQueued = false
+
+    fun offerCodecConfig(ptsUs: Long, data: ByteArray): Boolean {
+        if (data.isEmpty() || data.size > ContinuityCameraProtocol.MAX_VIDEO_FRAME_BYTES) return false
+        val encoded = ContinuityCameraProtocol.encodeFrame(
+            ContinuityCameraProtocol.FrameKind.CODEC_CONFIG,
+            ContinuityCameraProtocol.FLAG_NONE,
+            ptsUs,
+            data,
+        )
+        lock.withLock {
+            if (closed || eosQueued) return false
+            queue.addLast(QueuedPacket(ContinuityCameraProtocol.FrameKind.CODEC_CONFIG, encoded))
+            notEmpty.signalAll()
+            return true
+        }
+    }
+
+    fun offerVideoFrame(ptsUs: Long, data: ByteArray, isKeyframe: Boolean): Boolean {
+        if (data.isEmpty() || data.size > ContinuityCameraProtocol.MAX_VIDEO_FRAME_BYTES) return false
+        val flags = if (isKeyframe) ContinuityCameraProtocol.FLAG_KEYFRAME else ContinuityCameraProtocol.FLAG_NONE
+        val encoded = ContinuityCameraProtocol.encodeFrame(
+            ContinuityCameraProtocol.FrameKind.VIDEO_ACCESS_UNIT,
+            flags,
+            ptsUs,
+            data,
+        )
+        lock.withLock {
+            if (closed || eosQueued) return false
+            if (queuedVideo >= maxVideoFrames && !isKeyframe) {
+                return false
+            }
+            queue.addLast(QueuedPacket(ContinuityCameraProtocol.FrameKind.VIDEO_ACCESS_UNIT, encoded))
+            queuedVideo++
+            notEmpty.signalAll()
+            return true
+        }
+    }
+
+    fun offerAudioChunk(ptsUs: Long, data: ByteArray): Boolean {
+        if (data.isEmpty() || data.size > ContinuityCameraProtocol.MAX_AUDIO_CHUNK_BYTES) return false
+        val encoded = ContinuityCameraProtocol.encodeFrame(
+            ContinuityCameraProtocol.FrameKind.AUDIO_PCM_CHUNK,
+            ContinuityCameraProtocol.FLAG_NONE,
+            ptsUs,
+            data,
+        )
+        lock.withLock {
+            if (closed || eosQueued || queuedAudio >= maxAudioChunks) return false
+            queue.addLast(QueuedPacket(ContinuityCameraProtocol.FrameKind.AUDIO_PCM_CHUNK, encoded))
+            queuedAudio++
+            notEmpty.signalAll()
+            return true
+        }
+    }
+
+    fun finish() {
+        val eos = ContinuityCameraProtocol.encodeFrame(
+            ContinuityCameraProtocol.FrameKind.CONTROL_EOS,
+            ContinuityCameraProtocol.FLAG_NONE,
+            0L,
+            ByteArray(0),
+        )
+        lock.withLock {
+            if (closed || eosQueued) return
+            eosQueued = true
+            queue.addLast(QueuedPacket(ContinuityCameraProtocol.FrameKind.CONTROL_EOS, eos))
+            notEmpty.signalAll()
+        }
+    }
+
+    override fun read(): Int {
+        val single = ByteArray(1)
+        val n = read(single, 0, 1)
+        return if (n == 1) single[0].toInt() and 0xFF else -1
+    }
+
+    override fun read(b: ByteArray, off: Int, len: Int): Int {
+        if (len == 0) return 0
+        lock.withLock {
+            while (currentChunk == null) {
+                if (queue.isNotEmpty()) {
+                    val pkt = queue.removeFirst()
+                    if (pkt.kind == ContinuityCameraProtocol.FrameKind.VIDEO_ACCESS_UNIT && queuedVideo > 0) {
+                        queuedVideo--
+                    } else if (pkt.kind == ContinuityCameraProtocol.FrameKind.AUDIO_PCM_CHUNK && queuedAudio > 0) {
+                        queuedAudio--
+                    }
+                    currentChunk = pkt.encoded
+                    currentOffset = 0
+                    break
+                }
+                if (closed || eosQueued) {
+                    return -1
+                }
+                try {
+                    notEmpty.await()
+                } catch (_: InterruptedException) {
+                    Thread.currentThread().interrupt()
+                    return -1
+                }
+            }
+            val chunk = currentChunk ?: return -1
+            val avail = chunk.size - currentOffset
+            val toCopy = minOf(len, avail)
+            System.arraycopy(chunk, currentOffset, b, off, toCopy)
+            currentOffset += toCopy
+            if (currentOffset >= chunk.size) {
+                currentChunk = null
+                currentOffset = 0
+            }
+            return toCopy
+        }
+    }
+
+    override fun close() {
+        var notify = false
+        lock.withLock {
+            if (!closed) {
+                closed = true
+                queue.clear()
+                currentChunk = null
+                notEmpty.signalAll()
+                notify = true
+            }
+        }
+        if (notify) {
+            onClosedCallback?.invoke()
+        }
+    }
+}
