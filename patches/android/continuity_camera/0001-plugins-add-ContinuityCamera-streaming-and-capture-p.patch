+
+package org.kde.kdeconnect.plugins.continuitycamera
+
+import android.Manifest
+import android.annotation.SuppressLint
+import android.content.Context
+import android.content.pm.PackageManager
+import android.hardware.camera2.CameraAccessException
+import android.hardware.camera2.CameraCaptureSession
+import android.hardware.camera2.CameraCharacteristics
+import android.hardware.camera2.CameraDevice
+import android.hardware.camera2.CameraManager
+import android.hardware.camera2.params.OutputConfiguration
+import android.hardware.camera2.params.SessionConfiguration
+import android.media.AudioFormat
+import android.media.AudioRecord
+import android.media.MediaCodec
+import android.media.MediaCodecInfo
+import android.media.MediaFormat
+import android.media.MediaRecorder
+import android.os.Build
+import android.os.Handler
+import android.os.HandlerThread
+import android.util.Log
+import android.view.Surface
+import androidx.annotation.RequiresApi
+import androidx.core.content.ContextCompat
+import java.io.ByteArrayOutputStream
+import java.nio.ByteBuffer
+import java.util.concurrent.Executor
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicLong
+
+@RequiresApi(Build.VERSION_CODES.R)
+class CameraH264Encoder(
+    private val context: Context,
+    private val config: ContinuityCameraProtocol.StreamConfig,
+    private val queue: ContinuityStreamQueue,
+    private val onFatalError: (String) -> Unit,
+) {
+    private val stopRequested = AtomicBoolean(false)
+    private val lastPtsUs = AtomicLong(0L)
+
+    private var codec: MediaCodec? = null
+    private var inputSurface: Surface? = null
+    private var drainThread: Thread? = null
+    private var cameraThread: HandlerThread? = null
+    private var cameraHandler: Handler? = null
+    private var cameraDevice: CameraDevice? = null
+    private var captureSession: CameraCaptureSession? = null
+    private var audioThread: Thread? = null
+    private var audioRecord: AudioRecord? = null
+
+    @Volatile
+    private var cachedConfig: ByteArray? = null
+
+    fun start(enableMic: Boolean) {
+        if (ContextCompat.checkSelfPermission(context, Manifest.permission.CAMERA) != PackageManager.PERMISSION_GRANTED) {
+            onFatalError("CAMERA permission not granted")
+            return
+        }
+
+        stopRequested.set(false)
+        val createdCodec = MediaCodec.createEncoderByType(MediaFormat.MIMETYPE_VIDEO_AVC)
+        val surface = configureEncoder(createdCodec)
+        createdCodec.start()
+        codec = createdCodec
+        inputSurface = surface
+
+        val dThread = Thread(::drainVideoLoop, "ContinuityCamDrain").apply { start() }
+        drainThread = dThread
+
+        val cThread = HandlerThread("ContinuityCamCamera").apply { start() }
+        cameraThread = cThread
+        val handler = Handler(cThread.looper)
+        cameraHandler = handler
+
+        openCamera(config.lens, surface, handler)
+
+        if (enableMic &&
+            ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED
+        ) {
+            startMicCapture()
+        }
+    }
+
+    fun switchLens(newLens: String) {
+        val surface = inputSurface ?: return
+        val handler = cameraHandler ?: return
+        if (stopRequested.get()) return
+
+        handler.post {
+            closeCameraOnly()
+            openCamera(ContinuityCameraProtocol.normalizeLens(newLens), surface, handler)
+        }
+    }
+
+    fun stop() {
+        stopRequested.set(true)
+        closeCameraOnly()
+
+        cameraThread?.quitSafely()
+        try {
+            cameraThread?.join(1000)
+        } catch (_: InterruptedException) {
+            Thread.currentThread().interrupt()
+        }
+        cameraThread = null
+        cameraHandler = null
+
+        val aThread = audioThread
+        audioThread = null
+        try {
+            audioRecord?.stop()
+        } catch (_: IllegalStateException) {
+        }
+        audioRecord?.release()
+        audioRecord = null
+        aThread?.join(800)
+
+        val dThread = drainThread
+        drainThread = null
+        if (dThread != null && dThread !== Thread.currentThread()) {
+            try {
+                dThread.join(1200)
+            } catch (_: InterruptedException) {
+                Thread.currentThread().interrupt()
+            }
+        }
+
+        try {
+            codec?.stop()
+        } catch (_: IllegalStateException) {
+        }
+        try {
+            codec?.release()
+        } catch (_: RuntimeException) {
+        }
+        codec = null
+        inputSurface?.release()
+        inputSurface = null
+    }
+
+    private fun configureEncoder(encoder: MediaCodec): Surface {
+        val format = MediaFormat.createVideoFormat(MediaFormat.MIMETYPE_VIDEO_AVC, config.width, config.height).apply {
+            setInteger(MediaFormat.KEY_COLOR_FORMAT, MediaCodecInfo.CodecCapabilities.COLOR_FormatSurface)
+            setInteger(MediaFormat.KEY_BIT_RATE, 4_000_000)
+            setInteger(MediaFormat.KEY_FRAME_RATE, config.fps)
+            setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 2)
+            setInteger(MediaFormat.KEY_MAX_B_FRAMES, 0)
+        }
+        try {
+            encoder.configure(format, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
+            return encoder.createInputSurface()
+        } catch (e: Exception) {
+            Log.w(TAG, "Retrying AVC configure without optional keys: ${e.message}")
+            encoder.reset()
+            val fallback = MediaFormat.createVideoFormat(MediaFormat.MIMETYPE_VIDEO_AVC, config.width, config.height).apply {
+                setInteger(MediaFormat.KEY_COLOR_FORMAT, MediaCodecInfo.CodecCapabilities.COLOR_FormatSurface)
+                setInteger(MediaFormat.KEY_BIT_RATE, 4_000_000)
+                setInteger(MediaFormat.KEY_FRAME_RATE, config.fps)
+                setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 2)
+            }
+            encoder.configure(fallback, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
+            return encoder.createInputSurface()
+        }
+    }
+
+    @SuppressLint("MissingPermission")
+    private fun openCamera(lens: String, surface: Surface, handler: Handler) {
+        if (ContextCompat.checkSelfPermission(context, Manifest.permission.CAMERA) != PackageManager.PERMISSION_GRANTED) {
+            onFatalError("CAMERA permission not granted")
+            return
+        }
+        val cm = context.getSystemService(CameraManager::class.java) ?: run {
+            onFatalError("CameraManager unavailable")
+            return
+        }
+        val targetFacing = if (lens == "front") {
+            CameraCharacteristics.LENS_FACING_FRONT
+        } else {
+            CameraCharacteristics.LENS_FACING_BACK
+        }
+        val cameraId = selectCameraId(cm, targetFacing) ?: run {
+            onFatalError("No suitable camera available")
+            return
+        }
+
+        try {
+            cm.openCamera(
+                cameraId,
+                Executor { runnable -> handler.post(runnable) },
+                object : CameraDevice.StateCallback() {
+                    override fun onOpened(camera: CameraDevice) {
+                        if (stopRequested.get()) {
+                            camera.close()
+                            return
+                        }
+                        cameraDevice = camera
+                        createRepeatingSession(camera, surface, handler)
+                    }
+
+                    override fun onDisconnected(camera: CameraDevice) {
+                        camera.close()
+                        if (cameraDevice === camera) cameraDevice = null
+                    }
+
+                    override fun onError(camera: CameraDevice, error: Int) {
+                        camera.close()
+                        if (cameraDevice === camera) cameraDevice = null
+                        if (!stopRequested.get()) {
+                            onFatalError("Camera error $error")
+                        }
+                    }
+                },
+            )
+        } catch (e: CameraAccessException) {
+            onFatalError("CameraAccessException: ${e.message}")
+        }
+    }
+
+    private fun selectCameraId(cm: CameraManager, preferredFacing: Int): String? {
+        var fallback: String? = null
+        for (id in cm.cameraIdList) {
+            if (fallback == null) fallback = id
+            val facing = cm.getCameraCharacteristics(id).get(CameraCharacteristics.LENS_FACING)
+            if (facing == preferredFacing) {
+                return id
+            }
+        }
+        return fallback
+    }
+
+    private fun createRepeatingSession(camera: CameraDevice, surface: Surface, handler: Handler) {
+        try {
+            val sessionCfg = SessionConfiguration(
+                SessionConfiguration.SESSION_REGULAR,
+                listOf(OutputConfiguration(surface)),
+                Executor { r -> handler.post(r) },
+                object : CameraCaptureSession.StateCallback() {
+                    override fun onConfigured(session: CameraCaptureSession) {
+                        if (stopRequested.get()) {
+                            session.close()
+                            return
+                        }
+                        captureSession = session
+                        try {
+                            val req = camera.createCaptureRequest(CameraDevice.TEMPLATE_RECORD).apply {
+                                addTarget(surface)
+                            }
+                            session.setRepeatingRequest(req.build(), null, handler)
+                        } catch (e: Exception) {
+                            if (!stopRequested.get()) onFatalError("Capture request failed: ${e.message}")
+                        }
+                    }
+
+                    override fun onConfigureFailed(session: CameraCaptureSession) {
+                        if (!stopRequested.get()) {
+                            onFatalError("Camera session configuration failed")
+                        }
+                    }
+                },
+            )
+            camera.createCaptureSession(sessionCfg)
+        } catch (e: CameraAccessException) {
+            onFatalError("Failed creating capture session: ${e.message}")
+        }
+    }
+
+    private fun closeCameraOnly() {
+        try {
+            captureSession?.stopRepeating()
+        } catch (_: Exception) {
+        }
+        try {
+            captureSession?.close()
+        } catch (_: Exception) {
+        }
+        captureSession = null
+        try {
+            cameraDevice?.close()
+        } catch (_: Exception) {
+        }
+        cameraDevice = null
+    }
+
+    private fun drainVideoLoop() {
+        val encoder = codec ?: return
+        val info = MediaCodec.BufferInfo()
+        try {
+            while (!stopRequested.get()) {
+                val outIndex = encoder.dequeueOutputBuffer(info, 15_000L)
+                if (outIndex < 0) continue
+                try {
+                    val buf: ByteBuffer? = encoder.getOutputBuffer(outIndex)
+                    if (buf != null && info.size > 0) {
+                        buf.position(info.offset)
+                        buf.limit(info.offset + info.size)
+                        val bytes = ByteArray(info.size)
+                        buf.get(bytes)
+
+                        val pts = nextMonotonicPtsUs()
+                        if ((info.flags and MediaCodec.BUFFER_FLAG_CODEC_CONFIG) != 0) {
+                            cachedConfig = bytes
+                            queue.offerCodecConfig(pts, bytes)
+                        } else {
+                            val keyframe = (info.flags and MediaCodec.BUFFER_FLAG_KEY_FRAME) != 0
+                            val payload = if (keyframe && cachedConfig != null) {
+                                ByteArrayOutputStream(cachedConfig!!.size + bytes.size).apply {
+                                    write(cachedConfig!!)
+                                    write(bytes)
+                                }.toByteArray()
+                            } else {
+                                bytes
+                            }
+                            queue.offerVideoFrame(pts, payload, keyframe)
+                        }
+                    }
+                } finally {
+                    encoder.releaseOutputBuffer(outIndex, false)
+                }
+            }
+        } catch (e: Exception) {
+            if (!stopRequested.get()) {
+                Log.w(TAG, "Encoder loop stopped: ${e.message}")
+            }
+        }
+    }
+
+    @SuppressLint("MissingPermission")
+    private fun startMicCapture() {
+        if (ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
+            return
+        }
+        val sampleRate = 48_000
+        val minBuf = AudioRecord.getMinBufferSize(sampleRate, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
+        if (minBuf <= 0) return
+
+        val record = AudioRecord(
+            MediaRecorder.AudioSource.VOICE_COMMUNICATION,
+            sampleRate,
+            AudioFormat.CHANNEL_IN_MONO,
+            AudioFormat.ENCODING_PCM_16BIT,
+            maxOf(minBuf * 2, 4096),
+        )
+        if (record.state != AudioRecord.STATE_INITIALIZED) {
+            record.release()
+            return
+        }
+        audioRecord = record
+        record.startRecording()
+
+        val thread = Thread({
+            val chunk = ByteArray(3840)
+            while (!stopRequested.get()) {
+                val read = record.read(chunk, 0, chunk.size)
+                if (read > 0) {
+                    val copy = chunk.copyOf(read)
+                    queue.offerAudioChunk(nextMonotonicPtsUs(), copy)
+                } else if (read < 0) {
+                    break
+                }
+            }
+        }, "ContinuityCamAudio").apply { start() }
+        audioThread = thread
+    }
+
+    private fun nextMonotonicPtsUs(): Long {
+        val candidate = System.nanoTime() / 1000L
+        while (true) {
+            val prev = lastPtsUs.get()
+            val next = if (candidate > prev) candidate else prev + 1L
+            if (lastPtsUs.compareAndSet(prev, next)) return next
+        }
+    }
+
+    companion object {
+        private const val TAG = "KDE/CameraH264Encoder"
+    }
+}
