+/*
+ * SPDX-FileCopyrightText: 2026 Dmitriy Volkov <dennshield@duck.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+package org.kde.kdeconnect.plugins.continuitycamera
+
+import android.Manifest
+import android.app.PendingIntent
+import android.app.Service
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.content.pm.ServiceInfo
+import android.os.Build
+import android.os.Handler
+import android.os.IBinder
+import android.os.Looper
+import androidx.annotation.RequiresApi
+import androidx.core.app.NotificationCompat
+import androidx.core.app.ServiceCompat
+import androidx.core.content.ContextCompat
+import org.kde.kdeconnect.KdeConnect
+import org.kde.kdeconnect.helpers.NotificationHelper
+import org.kde.kdeconnect_tp.R
+import java.util.concurrent.atomic.AtomicBoolean
+
+@RequiresApi(Build.VERSION_CODES.R)
+class ContinuityCameraService : Service() {
+
+    private val mainHandler = Handler(Looper.getMainLooper())
+    private val stopping = AtomicBoolean(false)
+
+    private var activeDeviceId: String? = null
+    private var encoder: CameraH264Encoder? = null
+    private var streamQueue: ContinuityStreamQueue? = null
+
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        when (intent?.action) {
+            ACTION_STOP -> {
+                stopSession(notifyPlugin = true)
+                return START_NOT_STICKY
+            }
+            ACTION_SWITCH_LENS -> {
+                val lens = ContinuityCameraProtocol.normalizeLens(intent.getStringExtra(EXTRA_LENS))
+                encoder?.switchLens(lens)
+                return START_NOT_STICKY
+            }
+            ACTION_START -> {
+                val devId = intent.getStringExtra(EXTRA_DEVICE_ID)
+                if (devId.isNullOrEmpty()) {
+                    stopSelf()
+                    return START_NOT_STICKY
+                }
+                val cfg = ContinuityCameraProtocol.clampConfig(
+                    maxWidth = intent.getIntExtra(EXTRA_WIDTH, 1280),
+                    maxHeight = intent.getIntExtra(EXTRA_HEIGHT, 720),
+                    fps = intent.getIntExtra(EXTRA_FPS, 30),
+                    includeMic = intent.getBooleanExtra(EXTRA_INCLUDE_MIC, true),
+                    lens = intent.getStringExtra(EXTRA_LENS),
+                )
+                startSession(devId, cfg)
+                return START_NOT_STICKY
+            }
+            else -> {
+                stopSelf()
+                return START_NOT_STICKY
+            }
+        }
+    }
+
+    private fun startSession(deviceId: String, config: ContinuityCameraProtocol.StreamConfig) {
+        stopSession(notifyPlugin = false)
+        stopping.set(false)
+        activeDeviceId = deviceId
+
+        val plugin = KdeConnect.getInstance().getDevicePlugin(deviceId, ContinuityCameraPlugin::class.java)
+        if (plugin == null) {
+            stopSelf()
+            return
+        }
+
+        val audioPermGranted = ContextCompat.checkSelfPermission(this, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED
+        val enableMic = config.includeMic && audioPermGranted
+
+        var fgsType = ServiceInfo.FOREGROUND_SERVICE_TYPE_CAMERA
+        if (enableMic) {
+            fgsType = fgsType or ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE
+        }
+
+        val stopIntent = Intent(this, ContinuityCameraService::class.java).apply { action = ACTION_STOP }
+        val stopPending = PendingIntent.getService(
+            this,
+            0,
+            stopIntent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+        val notification = NotificationCompat.Builder(this, NotificationHelper.Channels.DEFAULT)
+            .setSmallIcon(R.drawable.ic_phonelink_36dp)
+            .setContentTitle(getString(R.string.continuitycamera_notif_title))
+            .setContentText(getString(R.string.continuitycamera_notif_body, plugin.device.name))
+            .setOngoing(true)
+            .addAction(R.drawable.ic_stop, getString(R.string.continuitycamera_action_stop), stopPending)
+            .build()
+
+        ServiceCompat.startForeground(this, NOTIFICATION_ID, notification, fgsType)
+
+        val queue = ContinuityStreamQueue(onClosedCallback = {
+            mainHandler.post {
+                if (!stopping.get()) {
+                    stopSession(notifyPlugin = true)
+                }
+            }
+        })
+        streamQueue = queue
+
+        val enc = CameraH264Encoder(
+            context = this,
+            config = config,
+            queue = queue,
+            onFatalError = {
+                mainHandler.post {
+                    stopSession(notifyPlugin = true, isError = true)
+                }
+            },
+        )
+        encoder = enc
+        enc.start(enableMic)
+
+        plugin.onServiceStreamStarted(queue, enableMic)
+    }
+
+    private fun stopSession(notifyPlugin: Boolean, isError: Boolean = false) {
+        stopping.set(true)
+        encoder?.stop()
+        encoder = null
+
+        val queue = streamQueue
+        streamQueue = null
+        queue?.finish()
+        queue?.close()
+
+        val devId = activeDeviceId
+        activeDeviceId = null
+        if (notifyPlugin && !devId.isNullOrEmpty()) {
+            KdeConnect.getInstance()
+                .getDevicePlugin(devId, ContinuityCameraPlugin::class.java)
+                ?.onServiceStreamStopped(isError)
+        }
+        ServiceCompat.stopForeground(this, ServiceCompat.STOP_FOREGROUND_REMOVE)
+        stopSelf()
+    }
+
+    override fun onDestroy() {
+        if (!stopping.get()) {
+            stopSession(notifyPlugin = true)
+        }
+        mainHandler.removeCallbacksAndMessages(null)
+        super.onDestroy()
+    }
+
+    companion object {
+        private const val NOTIFICATION_ID = 48201
+        private const val ACTION_START = "org.kde.kdeconnect.continuitycamera.START"
+        private const val ACTION_STOP = "org.kde.kdeconnect.continuitycamera.STOP"
+        private const val ACTION_SWITCH_LENS = "org.kde.kdeconnect.continuitycamera.SWITCH_LENS"
+
+        private const val EXTRA_DEVICE_ID = "deviceId"
+        private const val EXTRA_WIDTH = "width"
+        private const val EXTRA_HEIGHT = "height"
+        private const val EXTRA_FPS = "fps"
+        private const val EXTRA_INCLUDE_MIC = "includeMic"
+        private const val EXTRA_LENS = "lens"
+
+        fun createStartIntent(
+            context: Context,
+            deviceId: String,
+            config: ContinuityCameraProtocol.StreamConfig,
+        ): Intent = Intent(context, ContinuityCameraService::class.java).apply {
+            action = ACTION_START
+            putExtra(EXTRA_DEVICE_ID, deviceId)
+            putExtra(EXTRA_WIDTH, config.width)
+            putExtra(EXTRA_HEIGHT, config.height)
+            putExtra(EXTRA_FPS, config.fps)
+            putExtra(EXTRA_INCLUDE_MIC, config.includeMic)
+            putExtra(EXTRA_LENS, config.lens)
+        }
+
+        fun createStopIntent(context: Context): Intent =
+            Intent(context, ContinuityCameraService::class.java).apply {
+                action = ACTION_STOP
+            }
+
+        fun createSwitchLensIntent(context: Context, lens: String): Intent =
+            Intent(context, ContinuityCameraService::class.java).apply {
+                action = ACTION_SWITCH_LENS
+                putExtra(EXTRA_LENS, lens)
+            }
+    }
+}
