+    @Test
+    fun audioQueuePrioritizesAudioAndEvictsOldestChunkOnCap() {
+        val q = ContinuityStreamQueue(maxVideoFrames = 4, maxAudioChunks = 2)
+        val cfg = byteArrayOf(0, 0, 0, 1, 0x67, 0x42)
+        val key = byteArrayOf(0, 0, 0, 1, 0x65, 0x88.toByte())
+        val delta = byteArrayOf(0, 0, 0, 1, 0x41, 0x11)
+
+        assertTrue(q.offerCodecConfig(10L, cfg))
+        assertTrue(q.offerVideoFrame(20L, key, isKeyframe = true))
+        assertTrue(q.offerVideoFrame(30L, delta, isKeyframe = false))
+        assertTrue(q.offerAudioChunk(40L, byteArrayOf(1, 1)))
+        assertTrue(q.offerAudioChunk(50L, byteArrayOf(2, 2)))
+        // 3rd chunk must evict oldest (ptsUs=40) and accept newest (ptsUs=60).
+        assertTrue(q.offerAudioChunk(60L, byteArrayOf(3, 3)))
+        q.finish()
+
+        val allBytes = ByteArrayOutputStream()
+        val buf = ByteArray(256)
+        while (true) {
+            val n = q.read(buf)
+            if (n <= 0) break
+            allBytes.write(buf, 0, n)
+        }
+        q.close()
+
+        val reader = ContinuityCameraProtocol.FrameReader()
+        val frames = mutableListOf<ContinuityCameraProtocol.Frame>()
+        assertTrue(reader.feed(allBytes.toByteArray(), frames))
+        assertEquals(6, frames.size)
+        assertEquals(ContinuityCameraProtocol.FrameKind.CODEC_CONFIG, frames[0].kind)
+        assertEquals(ContinuityCameraProtocol.FrameKind.AUDIO_PCM_CHUNK, frames[1].kind)
+        assertEquals(50L, frames[1].ptsUs)
+        assertEquals(ContinuityCameraProtocol.FrameKind.AUDIO_PCM_CHUNK, frames[2].kind)
+        assertEquals(60L, frames[2].ptsUs)
+        assertEquals(ContinuityCameraProtocol.FrameKind.VIDEO_ACCESS_UNIT, frames[3].kind)
+        assertEquals(20L, frames[3].ptsUs)
+        assertEquals(ContinuityCameraProtocol.FrameKind.VIDEO_ACCESS_UNIT, frames[4].kind)
+        assertEquals(30L, frames[4].ptsUs)
+        assertEquals(ContinuityCameraProtocol.FrameKind.CONTROL_EOS, frames[5].kind)
+    }
