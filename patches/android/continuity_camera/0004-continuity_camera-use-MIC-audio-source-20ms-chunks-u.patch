+    private fun insertAudioPacketLocked(pkt: QueuedPacket) {
+        val it = queue.listIterator()
+        while (it.hasNext()) {
+            val existing = it.next()
+            if (existing.kind == ContinuityCameraProtocol.FrameKind.VIDEO_ACCESS_UNIT ||
+                existing.kind == ContinuityCameraProtocol.FrameKind.CONTROL_EOS
+            ) {
+                it.previous()
+                break
+            }
+        }
+        it.add(pkt)
+    }
