+
+    private fun dropOldestAudioPacketLocked(): Boolean {
+        val iter = queue.iterator()
+        while (iter.hasNext()) {
+            val pkt = iter.next()
+            if (pkt.kind == ContinuityCameraProtocol.FrameKind.AUDIO_PCM_CHUNK) {
+                iter.remove()
+                if (queuedAudio > 0) queuedAudio--
+                return true
+            }
+        }
+        return false
+    }
 }
