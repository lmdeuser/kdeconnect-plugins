# Copy to .state/local.env (chmod 600) and fill in your local machine values.
KDECONNECT_DESKTOP_SRC=/path/to/kdeconnect-kde
KDECONNECT_ANDROID_SRC=/path/to/kdeconnect-android
TMPDIR=/var/tmp/kdeconnect-plugins
OBS_STAGING_PROJECT=home:dwolfF:kdeconnect:staging
OBS_STABLE_PROJECT=home:dwolfF:kdeconnect
OBS_DISTRO=xUbuntu_26.04
OBS_ARCH=x86_64
RUNNER_HOST=runner-host.example.invalid
RUNNER_DIR=~/runners/kdeconnect-plugins
